	[12278] = {
		Title = "Hacia el lago Bakonawa...",
		Description = {
			"Inicio: NPC: Taho en Ubicacion: ma_scene01 (174, 179). Entró al lago para detener a Bakonawa. No creo que necesite volver al lago dentro de una semana."
		},
		Summary = ""
	},
	[12279] = {
		Title = "Deshazte de Bakonawa",
		Description = {
			"Inicio: NPC: Taho en Ubicacion: ma_scene01 (174, 179). Si se deja a Bakonawa como está, se desatará una gran pelea. Debe ser derrotado."
		},
		Summary = ""
	},
	[12280] = {
		Title = "Un prisionero sospechoso",
		Description = {
			"Inicio: NPC: Eclage Guard en Ubicacion: ecl_in02 (98, 32). Parece que hay un preso sospechoso en la cárcel. ¿No sería bueno escuchar su historia por una vez?"
		},
		Summary = "Un prisionero sospechoso"
	},
	[12281] = {
		Title = "un favor no deseado",
		Description = {
			"Clever pide 1 ^000099Té de hierbas con extracto de uva^000000. Es un gran favor viniendo de un prisionero, pero trata de obtenerlo cuando sea posible."
		},
		Summary = "un favor no deseado"
	},
	[12282] = {
		Title = "Rey del chisme inteligente",
		Description = {
			"Clever conoce muchos chismes. Dado que sus conocimientos pueden resultar útiles para futuras aventuras, escuchémoslos. Puede haber información muy útil."
		},
		Summary = "Rey del chisme inteligente"
	},
	[12283] = {
		Title = "El investigador de la grieta",
		Description = {
			"Hay una joven Dona llamada ^000099Hielle^000000 que es conocida por llevar a cabo investigaciones relacionadas con fragmentos de grieta. Busque al investigador."
		},
		Summary = "El investigador de la grieta"
	},
	[12284] = {
		Title = "La fuente de información de un comerciante de gatos",
		Description = {
			"Entre los comerciantes de gatos, hay un gato que se supone que sabe mucho sobre la investigación de Midgard sobre las fisuras. Busque ^000099Midgard Post^000000 conocido por su actividad."
		},
		Summary = "La fuente de información de un comerciante de gatos"
	},
	[12285] = {
		Title = "Una forma de calmar a un gato",
		Description = {
			"Si se impide que el gato pelee, es posible obtener información útil. ¿Cómo se puede calmar? ¿Dijeron que no podían recibir su salario mensual de ^000099Malangdo Canned Specialties^000000?"
		},
		Summary = "Una forma de calmar a un gato"
	},
	[12286] = {
		Title = "Información comercializada por algunos alimentos enlatados.",
		Description = {
			"Se dice que ^0000991 Dark Debris, 2 de cada piedra preciosa roja/amarilla/azul^000000 son necesarias para activar el fragmento de grieta. Parece que a Hiel le está costando conseguirlos..."
		},
		Summary = "Información comercializada por algunos alimentos enlatados."
	},
	[12287] = {
		Title = "una experiencia rara",
		Description = {
			"Experimente con Hiel si se produce una reacción suficiente con el fragmento de grieta."
		},
		Summary = "una experiencia rara"
	},
	[12288] = {
		Title = "Una experiencia exitosa",
		Description = {
			"Con el arreglo actual de Hiel, no parece que vaya a reaccionar adecuadamente. Intente tocar la configuración experimental para activarla."
		},
		Summary = "Una experiencia exitosa"
	},
	[12289] = {
		Title = "Otra visita",
		Description = {
			"Las identidades encontradas a través de la reacción de ruptura deben ser figuras reales de la historia. Pregúntele al historiador Clever sobre ellos."
		},
		Summary = "Otra visita"
	},
	[12290] = {
		Title = "Los documentos históricos de Clever",
		Description = {
			"Hay individuos que parecen ser Lapines según los documentos históricos de Clever. Escuche sus historias."
		},
		Summary = "Los documentos históricos de Clever"
	},
	[12291] = {
		Title = "Documentos históricos ocultos (?)",
		Description = {
			"Según el diagrama dibujado por Clever, el documento no parece demasiado oculto. Más bien, parece bien presentado en las estanterías. Busque lugares donde se organizan libros en Eclage."
		},
		Summary = "Documentos históricos ocultos (?)"
	},
	[12292] = {
		Title = "los desconocidos",
		Description = {
			"Los individuos responsables de construir el Árbol Hogar y restaurar la tierra de Bifrost no son la Asamblea de Ancianos, sino dos Donas desconocidas. Pregúntale a Clever sobre dos Donas llamados Etran y Robert."
		},
		Summary = "los desconocidos"
	},
	[12293] = {
		Title = "figuras de la historia",
		Description = {
			"Clever pidió hablar directamente con las figuras históricas del pasado a través del dispositivo de ruptura. No estoy seguro de si es posible, pero ve a visitar Hiel."
		},
		Summary = "figuras de la historia"
	},
	[12294] = {
		Title = "Tour de Éclage",
		Description = {
			"Tomemos como ejemplo a Robert, que apareció en el pasado en los numerosos lugares de Eclage. ¿No se sentiría conmovido si viera el estado actual de Home Tree?"
		},
		Summary = "Tour de Éclage"
	},
	[12295] = {
		Title = "error",
		Description = {
			"Robert desapareció de repente. Vuelve con Hiel para averiguar si algo salió mal con el dispositivo de ruptura."
		},
		Summary = "error"
	},
	[12296] = {
		Title = "Momentos divertidos con el reactor.",
		Description = {
			"Usa el reactor de grieta de Hiel para explorar varias áreas de Eclage. Puede que haya un lugar donde aparezca Etran."
		},
		Summary = "Momentos divertidos con el reactor."
	},
	[12297] = {
		Title = "Encuentro con Etran",
		Description = {
			"Se encontró la ubicación donde se puede llegar a Etran. Sería una buena oportunidad para confirmar si él fue el responsable de restaurar la tierra."
		},
		Summary = "Encuentro con Etran"
	},
	[12298] = {
		Title = "dos deseos",
		Description = {
			"Entrega el collar de Etran a Robert. Obtén la hoja dorada de Home Tree. Se pidieron dos favores. Pregúntale a Hiel sobre el método para obtener una hoja de Árbol Hogar."
		},
		Summary = "dos deseos"
	},
	[12299] = {
		Title = "Revisando a Robert",
		Description = {
			"Está prohibido dañar Home Tree obteniendo una hoja. Sin embargo, si el propio creador proporciona uno, puede estar bien. Sin embargo, ¿no fue abandonado Robert frente a Home Tree la última vez?"
		},
		Summary = "Revisando a Robert"
	},
	[12300] = {
		Title = "Revisando Etran",
		Description = {
			"Muestra la hoja de Home Tree y anima a Etran. Aunque la negativa de Robert a recibir el collar fue crítica..."
		},
		Summary = "Revisando Etran"
	},
	[12301] = {
		Title = "Dos amigos restantes",
		Description = {
			"Robert y Etran llevarán a cabo su destino hasta el final. Hasta que la tierra del pasado (aunque presente para ellos¡¦) se convierta en la tierra abundante del presente. Habla con Hiel y Clever que hicieron posibles los encuentros."
		},
		Summary = "Dos amigos restantes"
	},
	[12302] = {
		Title = "Salim Hamid",
		Description = {
			"Inicio: NPC: Salim Hamid en Ubicacion: iz_ac02 (50, 169). Hablé con un formador de comerciantes llamado Salim Hamid."
		},
		Summary = "Habla con el formador de comerciantes."
	},
	[12303] = {
		Title = "Solicitante de comerciante",
		Description = {
			"Inicio: NPC: Salim Hamid en Ubicacion: iz_ac02 (50, 169). Dicen que la única persona con 100 zenys tiene derecho a recibir la famosa lección mercantil de Salim Hamid. No es tan zeny, por lo que necesitas encontrar y vender algunos artículos."
		},
		Summary = "Obtener 100 zenis"
	},
	[12304] = {
		Title = "Introducción a la mercantilología",
		Description = {
			"Inicio: NPC: Salim Hamid en Ubicacion: iz_ac02 (50, 169). Los comerciantes tienen diversas habilidades para ganar dinero de forma legal. Escuche las explicaciones del azafato junto a Salim Hamid."
		},
		Summary = "Secreto de negociación"
	},
	[12305] = {
		Title = "Sobre la cifra de capacidad",
		Description = {
			"Inicio: NPC: Salim Hamid en Ubicacion: iz_ac02 (50, 169). Los comerciantes también tienen el estado del elemento principal. Simplemente estudie la cifra de capacidad de cada estado. Por supuesto, depende de ti..."
		},
		Summary = "No te está empujando a hacer"
	},
	[12306] = {
		Title = "Experiencia de descuentos",
		Description = {
			"Inicio: NPC: Salim Hamid en Ubicacion: iz_ac02 (50, 169). Vaya a la ruidosa máquina expendedora en el aula de comerciantes y regrese después de verificar los precios con descuento de Garlets y Zargons. Para consultar los precios con descuento, debe equipar el manual del comerciante."
		},
		Summary = "Ver descuentos usando el Manual del Comerciante"
	},
	[12307] = {
		Title = "Camino al comerciante",
		Description = {
			"Inicio: NPC: Salim Hamid en Ubicacion: iz_ac02 (50, 169). Según Salim Hamid, para convertirse en comerciante, hay que ir a la ciudad de Alberta. Vaya al edificio de la refinería en dirección a las 5 en punto."
		},
		Summary = "Viajar a Alberta"
	},
	[12308] = {
		Title = "Eliminación de colas de gusano",
		Description = {
			"Recientemente se han entregado muchos paquetes a Prontera. Para una entrega más fluida, debe reducir la cantidad de Worm Tails cerca de Alberta. Regresa después de cazar 20 Colas de Gusano."
		},
		Summary = "Caza 20 colas de gusano"
	},
	[12309] = {
		Title = "Eliminación de boa",
		Description = {
			"Cada vez son más frecuentes los accidentes en los que los comerciantes recolectores de setas tocan serpientes por error. Vuelve con el comerciante coleccionista después de cazar 20 boas."
		},
		Summary = "Caza 20 boas"
	},
	[12310] = {
		Title = "Eliminación de esporas",
		Description = {
			"Los comestibles que se entregan en la capital se están contaminando con las semillas de Spore. Regresa con el comerciante coleccionista después de cazar 20 esporas."
		},
		Summary = "Caza 20 esporas"
	},
	[12311] = {
		Title = "Eliminación de esqueletos piratas",
		Description = {
			"A Salim Hamid parece gustarle utilizar el barco abandonado cerca de Alberta después de las reparaciones. Regresa después de eliminar 10 esqueletos piratas."
		},
		Summary = "Caza 10 esqueletos piratas"
	},
	[12312] = {
		Title = "Complementario a la lección teórica.",
		Description = {
			"Le dije a Salim Hamid que escuchara la lección teórica."
		},
		Summary = "Complementario a la lección teórica."
	},
	[12313] = {
		Title = "Acerca de las estadísticas",
		Description = {
			"Decidió tomar la lección teórica sobre el efecto del estatus mercantil."
		},
		Summary = "Figura de capacidad del comerciante."
	},
	[12314] = {
		Title = "Acerca de las habilidades",
		Description = {
			"Repite la lección teórica sobre las habilidades de los comerciantes aunque ya la hayas leído antes."
		},
		Summary = "Repite la lección sobre las habilidades del comerciante."
	},
