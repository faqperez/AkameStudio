	[11182] = {
		Title = "Informe teórico",
		Description = {
			"Inicio: NPC: Theore en Ubicacion: mid_camp (148, 222). Theore parece estar en un estado maníaco. Espera a que se calme y vuelve a hablar con él."
		},
		Summary = ""
	},
	[11183] = {
		Title = "el favor de teore",
		Description = {
			"Inicio: NPC: Theore Set Guid en Ubicacion: sec_in02 (35, 175). Theore te pidió que encontraras a los Lapine que vienen a Splendide Field."
		},
		Summary = "Busca en el área suroeste de Splendide Field 2"
	},
	[11184] = {
		Title = "Lapine en fuga",
		Description = {
			"Encontraste a un Lapine desarmado en un arbusto pero se fue volando."
		},
		Summary = "Continúe su búsqueda en Splendide Field 2"
	},
	[11185] = {
		Title = "una pequeña bolsa",
		Description = {
			"Encontraste una pequeña bolsa entre los arbustos. Deberías llevárselo a Theore."
		},
		Summary = ""
	},
	[11186] = {
		Title = "una pequeña bolsa",
		Description = {
			"Lleva la bolsa a Splendide para encontrar a su dueño."
		},
		Summary = ""
	},
	[11187] = {
		Title = "Devolviendo la bolsa de hadas",
		Description = {
			"Encontraste un Hada de aspecto cansado pero la bolsa no le pertenece. Reúne pistas para ver si puedes descubrir quién es el dueño y díselo al Hada de aspecto cansado."
		},
		Summary = ""
	},
	[11188] = {
		Title = "El dueño de la bolsa de hadas",
		Description = {
			"Si prometes no decírselo a nadie, puedes volver a hablar con Kusmi."
		},
		Summary = "Habla con Kusmi otra vez."
	},
	[11189] = {
		Title = "Ruta de suministro de Bifrost",
		Description = {
			"Inicio: NPC: Kusmi en Ubicacion: splendide (119, 138). Kusmi todavía necesita ayuda porque la ruta de suministro al continente ha sido cortada."
		},
		Summary = "Habla con Kusmi otra vez."
	},
	[11190] = {
		Title = "Ruta de suministro de Bifrost",
		Description = {
			"Encuentra un soldado lapino en Splendide para informar sobre la ruta de suministro."
		},
		Summary = ""
	},
	[11191] = {
		Title = "Grietas en Bifrost",
		Description = {
			"Puedes llegar a Alfheim atravesando el Laberinto del Bosque Brumoso. Sin embargo, nadie ha regresado jamás del Laberinto del Bosque Brumoso."
		},
		Summary = "Volver a Kusmi"
	},
	[11192] = {
		Title = "Pueblo de Mora...",
		Description = {
			"Si vas al almacén en Mora Village, el gerente te dirá más. Además, en el camino de regreso, ¿podrías comprobar que mi amigo Rondo esté en Mora Villagee?"
		},
		Summary = "Encuentra al amigo de Kusmi, Rondo, en Mora Village."
	},
	[11193] = {
		Title = "El amigo de Kusmi",
		Description = {
			"Inicio: NPC: Rondo en Ubicacion: mora (35, 119). Por favor, dile a Kusmi que si quiere vernos, podemos vernos en cualquier momento. No hay nada de qué preocuparse."
		},
		Summary = "Volver a Kusmi"
	},
	[11194] = {
		Title = "Bolsa pequeña",
		Description = {
			"Si realmente quieres escuchar la respuesta, habla conmigo nuevamente. Necesito tiempo para pensar."
		},
		Summary = "Habla con Theodore otra vez."
	},
	[11195] = {
		Title = "bifrost",
		Description = {
			"Inicio: NPC: Theodore en Ubicacion: splendide (304, 295). Y como dije antes, lo que te dije es un secreto y no debes contárselo a nadie. Necesitamos ayuda; pero estamos acorralados y no queremos que los demás lo sepan."
		},
		Summary = "Habla con Theodore otra vez."
	},
	[11196] = {
		Title = "bifrost",
		Description = {
			"La ruta de suministro pasa por Bifrost y puedes llegar a ella desde la parte trasera del Splendide Basecamp. Si se aventura allí, pregúntele a un guardia cómo son las cosas allí."
		},
		Summary = "Encuentra un soldado lapino en Splendide para informar sobre la ruta de suministro."
	},
	[11197] = {
		Title = "Grietas en Bifrost",
		Description = {
			"Puedes llegar a Alfheim atravesando el Laberinto del Bosque Brumoso. Sin embargo, nadie ha regresado jamás del Laberinto del Bosque Brumoso."
		},
		Summary = "volver a teodoro"
	},
	[11198] = {
		Title = "Pueblo de Mora...",
		Description = {
			"Si habla con el gerente de almacén de Mora Village, podrá obtener más información. Y si no es mucha molestia, también podrías pasarte por lo de mi amiga Lilitia..."
		},
		Summary = "Encuentra a Lilitia, la amiga de Theodore, en Mora Village."
	},
	[11199] = {
		Title = "El amigo de Teodoro",
		Description = {
			"Inicio: NPC: Lilitia en Ubicacion: mora (98, 66). ¿Qué? ¿Theodore te envió? ¡¡Por favor dile que estoy tan enojado!!"
		},
		Summary = "volver a teodoro"
	},
	[11200] = {
		Title = "Bolsa pequeña",
		Description = {
			"No es fácil para mí responder... Te agradezco que hayas encontrado mi bolsa... Hmm... Por favor, dame algo de tiempo para pensar."
		},
		Summary = "Habla con Pauchon otra vez."
	},
	[11201] = {
		Title = "bifrost",
		Description = {
			"Inicio: NPC: Pauchon en Ubicacion: splendide (168, 301). Me comería la corteza de ese árbol si pudiera. Si tan solo alguien pudiera ayudar. *sollozo*"
		},
		Summary = "Habla con Pauchon otra vez."
	},
	[11202] = {
		Title = "bifrost",
		Description = {
			"Un camino gigante se aleja de la parte trasera de Splendide. ¡Oh! El guardia de allí podría saber algo. Si se dirige hacia allí, averigüe qué pasa."
		},
		Summary = "Encuentra un soldado lapino en Splendide para informar sobre la ruta de suministro."
	},
	[11203] = {
		Title = "Grietas en Bifrost",
		Description = {
			"Puedes llegar a Alfheim atravesando el Laberinto del Bosque Brumoso. Sin embargo, nadie ha regresado jamás del Laberinto del Bosque Brumoso."
		},
		Summary = "Volver a Pauchon"
	},
	[11204] = {
		Title = "Pueblo de Mora...",
		Description = {
			"Es un tipo tan voluble, puede que ya se haya ido, pero se suponía que nos encontraríamos en Mora Village."
		},
		Summary = "Encuentra al amigo de Pauchon, Humming, en Mora Village."
	},
	[11205] = {
		Title = "El amigo de Pauchon",
		Description = {
			"Inicio: NPC: Humming en Ubicacion: mora (139, 102). Si llegas a Splendide antes que yo, por favor dile a Pauchon que estoy atravesando el Laberinto del Bosque Brumoso."
		},
		Summary = "Volver a Pauchon"
	},
	[11206] = {
		Title = "Entrega rápida",
		Description = {
			"Inicio: NPC: Warehouse Manager en Ubicacion: mora (185, 163). Si planea regresar a Splendide, visite Jones at the Inn. Tiene algo que debe entregarse urgentemente al ejército de Splendide."
		},
		Summary = "Encuentra a Jones en Mora Village"
	},
	[11207] = {
		Title = "Una carga muy pesada",
		Description = {
			"Estás cargando demasiado peso. Por favor, aligere su carga y regrese."
		},
		Summary = "Aligera el peso de tu inventario y vuelve a hablar con Jones."
	},
	[11208] = {
		Title = "daphrer",
		Description = {
			"Por favor cuídalo bien. Es para Daphrer en Splendide."
		},
		Summary = "Lleva el kit de suministros a Daphrer"
	},
	[11209] = {
		Title = "La angustia del señor Tomás",
		Description = {
			"Inicio: NPC: Tomas en Ubicacion: mal_in02 (22, 62). Todos los humanos que visitan Malangdo vienen a mí, por eso tengo demasiado trabajo. Hay ^0000FFMalangdo reunión ordinaria^000000, sólo ve allí. El lugar está ubicado en ^0000FF, al otro lado del extremo del corredor^000000."
		},
		Summary = "Participa en la reunión."
	},
	[11210] = {
		Title = "reunión ordinaria de malangdo",
		Description = {
			"La agenda de hoy es ^ff99ccStar Candy^000000. Si alguien tiene una opinión sobre el próximo tema, por favor hable."
		},
		Summary = "Escuchemos la opinión de Scottfold."
	},
	[11211] = {
		Title = "reunión ordinaria de malangdo",
		Description = {
			"Está ^0000FFinterpreter Biscuit^000000 junto a él, pero es realmente difícil tener una conversación detallada."
		},
		Summary = "Escuchemos la opinión de Koon"
	},
	[11212] = {
		Title = "reunión ordinaria de malangdo",
		Description = {
			"Déjame contarte sobre la producción del estudio."
		},
		Summary = "Escuchemos la producción de estudio del lingüista Devore."
	},
	[11213] = {
		Title = "reunión ordinaria de malangdo",
		Description = {
			"^0000FFSEl estudio del lenguaje Starfish^000000 comenzó cuando nos instalamos en Malangdo pero no logra lo que esperaba. Está disponible una conversación simple, pero eso es falta de rendimiento."
		},
		Summary = "Escuchemos la producción del estudio del Geólogo Mali."
	},
	[11214] = {
		Title = "reunión ordinaria de malangdo",
		Description = {
			"Hay varias grietas en el terreno. Nadie sabe cuándo se moverá el Star Candy, así que tenemos que repararlo rápidamente."
		},
		Summary = "Escuchemos la opinión de Brie."
	},
	[11215] = {
		Title = "reunión ordinaria de malangdo",
		Description = {
			"Inicio: NPC: Brie en Ubicacion: mal_in02 (181, 55). Prácticamente entendemos que la lesión del Sr. Rican podría afectar el comercio de Yggdrasilberry, así que no se preocupe por eso."
		},
		Summary = "Escuchemos la historia de Brie."
	},
	[11216] = {
		Title = "Yggdrasilberry",
		Description = {
			"De todos modos, no sé exactamente sobre Yggdrasilberry. Si tienes alguna pregunta, ve a mi casa en ^6666ccWestern Malangdo^000000. Mi padre se aburrirá muchísimo allí..."
		},
		Summary = "Conozcamos al padre de Brie, el Sr. Rican."
	},
	[11217] = {
		Title = "Yggdrasilberry",
		Description = {
			"^6666ccEl Yggdrasilberry está en todas partes.^000000 Puedes llegar fácilmente a la isla Malangdo, así que trae unos 30 de ellos."
		},
		Summary = "Traigamos 30 Yggdrasilberry frescas."
	},
	[11218] = {
		Title = "Yggdrasilberry",
		Description = {
			"¿Por qué no pones Yggdrasilberry en la máquina?"
		},
		Summary = "Pongamos Yggdrasilberry en esa máquina."
	},
	[11219] = {
		Title = "Yggdrasilberry",
		Description = {
			"Al presionar el botón, la máquina se puso en marcha."
		},
		Summary = "Hablemos con Rican."
	},
	[11220] = {
		Title = "Yggdrasilberry",
		Description = {
			"Después de que me lesioné la rodilla, él podría ir al Dr. Mali todos los días. Si ves a mi hijo, dile que vuelva conmigo ~"
		},
		Summary = "Busquemos a Brie."
	},
	[11221] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"Inicio: NPC: Geologist Mali en Ubicacion: mal_in02 (179, 57). Si necesita más detalles, pregúntele a mi ^6666asistente Bob^000000. Podría estar en ^6666cc la habitación de al lado^000000."
		},
		Summary = "Conozcamos al asistente Bob."
	},
	[11222] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"Rellene la grieta con una mezcla de arcilla gris y blanca. Fije el espacio con una grapadora."
		},
		Summary = "Reparemos la grieta con el kit de reparación. cuando todos dicen ok...."
	},
	[11223] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"La grieta también se llena. Informemos a Bob."
		},
		Summary = "Volvamos a Bob."
	},
	[11224] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"¡Emperatriz! ¡mágico! ¡chocante! ¡¡¡bien hecho!!! ¡Se lo diré al Dr. Mali!"
		},
		Summary = "Veamos al Dr. Mali."
	},
	[11225] = {
		Title = "Esfuerzo de no intersección de la carretera.",
		Description = {
			"Inicio: NPC: Geologist Mali en Ubicacion: mal_in02 (179, 57). ¡¡¡Todos saben cómo el Dr. Devore concentra su estudio del lenguaje de las estrellas de mar!!! ¡Por favor tenga confianza! ¡lo estás haciendo bien!"
		},
		Summary = "El lingüista Devore podría caer en una depresión. Hablemos con él."
	},
	[11226] = {
		Title = "Esfuerzo de no intersección de la carretera.",
		Description = {
			"El lenguaje de las estrellas de mar es muy misterioso. No lo sé en absoluto. No estoy seguro de que eso sea realmente \"lenguaje\" o no. ¡Realmente quiero saber qué quieren allí!"
		},
		Summary = "Investiguemos sobre la estrella de mar."
	},
	[11227] = {
		Title = "Esfuerzo de no intersección de la carretera.",
		Description = {
			"Biscuit podría tener un lenguaje muy fluido, a diferencia del dicho del Dr. Devore. Le contaré este hecho al Dr. Devore."
		},
		Summary = "Vayamos con el Dr. Devore."
	},
	[11228] = {
		Title = "Esfuerzo de no intersección de la carretera.",
		Description = {
			"Eso es increíble. Bueno, ¿no solo habló frente a mí? ¡¡Vamos a escuchar!!"
		},
		Summary = "Volvamos a Biscuit."
	},
	[11229] = {
		Title = "Para el caramelo estrella",
		Description = {
			"Inicio: NPC: Biscuit en Ubicacion: mal_dun01 (136, 122). Puedes hablar con Biscuit como de la misma especie. Cualquier conversación ayudará a mi estudio."
		},
		Summary = "Hablemos con Biscuit."
	},
	[11230] = {
		Title = "Para el caramelo estrella",
		Description = {
			"Escuché varias cosas sobre Star Candy, Biscuit y Malangdo."
		},
		Summary = "Continúe la conversación."
	},
	[11231] = {
		Title = "Para el caramelo estrella",
		Description = {
			"Solo consigue algo de gelatina deliciosa por aquí de Siorava. Creo que 30 Delicious Jelly son suficientes para una comida."
		},
		Summary = "Volvamos con 30 deliciosas gelatinas."
	},
	[11232] = {
		Title = "Para el caramelo estrella",
		Description = {
			"¡Hola, caramelo estrella! no comes tan bien. ¿No tienes apetito?"
		},
		Summary = "Averigüemos qué está pasando."
	},
	[11233] = {
		Title = "Para el caramelo estrella",
		Description = {
			"Tenemos que llevar agua, así que traiga un balde y un cepillo para limpiar Star Candy. Es posible que estén almacenados."
		},
		Summary = "Busquemos un cubo de limpieza y un cepillo."
	},
	[11234] = {
		Title = "Para el caramelo estrella",
		Description = {
			"Trajiste cosas también. ¡Ahora puedes frotar tu piel en sentido contrario a las agujas del reloj!"
		},
		Summary = "Limpie la piel friable-> piel demacrada-> piel agrietada-> piel dura."
	},
	[11235] = {
		Title = "Para el caramelo estrella",
		Description = {
			"La piel friable, la piel demacrada, la piel agrietada y la piel dura se transforman en una piel suave y tan suave como la seda."
		},
		Summary = "Volvamos a Biscuit."
	},
	[11236] = {
		Title = "Intersección",
		Description = {
			"Inicio: NPC: Biscuit en Ubicacion: mal_dun01 (136, 122). No es necesario esperar hasta que se complete el estudio. Sólo díselo a Devore. Quiero hablar sobre la situación actual con él."
		},
		Summary = "Enviémoslo al Dr. Devore."
	},
	[11237] = {
		Title = "La angustia del señor Tomás",
		Description = {
			"Por favor envíe esta buena noticia al jefe Tomás."
		},
		Summary = "Veamos al jefe Tomás."
	},
	[11238] = {
		Title = "Yggdrasilberry",
		Description = {
			"Inicio: NPC: Rican en Ubicacion: mal_in01 (114, 169). El descuento es como antes. ¡¡Trae 30 Yggdrasilberry frescas a Rican que se encuentran fácilmente en la isla Malangdo!!"
		},
		Summary = "Trae 30 Yggdrasilberry frescas."
	},
	[11239] = {
		Title = "Yggdrasilberry",
		Description = {
			"Inicio: NPC: Rican en Ubicacion: mal_in01 (114, 169). No podrás recibir ninguna solicitud de Rican durante un día."
		},
		Summary = ""
	},
	[11240] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"Inicio: NPC: Geologist Mali en Ubicacion: mal_in02 (179, 57). Si necesita más detalles, pregúntele a mi ^6666asistente Bob^000000. Podría estar en ^6666cc la habitación de al lado^000000."
		},
		Summary = "Veamos al asistente Bob."
	},
	[11241] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"Rellene la grieta con una mezcla de arcilla gris y blanca. Fije el espacio con una grapadora."
		},
		Summary = "Reparemos la grieta con el kit de reparación. cuando todos dicen ok...."
	},
	[11242] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"La grieta también se llena. Informemos al Dr. Mali."
		},
		Summary = "Volvamos al Dr. Mali."
	},
	[11243] = {
		Title = "La gelatina más suave del mundo.",
		Description = {
			"Inicio: NPC: Geologist Mali en Ubicacion: mal_in02 (179, 57). No puedes recibir ninguna solicitud del Dr. Mali durante un día."
		},
		Summary = ""
	},
	[11244] = {
		Title = "Jalea suave",
		Description = {
			"Inicio: NPC: Biscuit en Ubicacion: mal_dun01 (136, 122). Solo consigue algo de gelatina deliciosa por aquí de Siorava. Creo que 30 Delicious Jelly son suficientes para una comida."
		},
		Summary = "Volvamos con 30 Delicious Jelly."
	},
	[11245] = {
		Title = "Jalea suave",
		Description = {
			"Inicio: NPC: Biscuit en Ubicacion: mal_dun01 (136, 122). No puedes recibir ninguna solicitud de Biscuit durante un día."
		},
		Summary = ""
	},
	[11246] = {
		Title = "Descanso en el trabajo a tiempo parcial",
		Description = {
			"El trabajo a tiempo parcial de hoy ha terminado."
		},
		Summary = "¡Trabajemos duro de nuevo mañana!"
	},
