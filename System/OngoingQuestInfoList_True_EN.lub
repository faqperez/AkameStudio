	[7591] = {
		Title = "Limpieza constante",
		Description = {
			"Elizabeth... La limpieza debe hacerse de manera constante, todos los días. Vuelve mañana a esta hora."
		},
		Summary = "tómate un día libre"
	},
	[7592] = {
		Title = "La durabilidad de la seda",
		Description = {
			"¡La seda crujiente es perfecta para practicar! Pero la ropa bonita es tan frágil que se arruina rápidamente, así que ¡consigamos más seda mañana!"
		},
		Summary = "¡Llegar de nuevo!"
	},
	[7593] = {
		Title = "Subyugación del Dios Demonio",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Hishieh en Ubicacion: moro_vol (95, 108). Es hora de terminar el trabajo: derrotar a Morroc en el Templo del Dios Demonio."
		},
		Summary = ""
	},
	[7594] = {
		Title = "Araña helada y lobo de fuego",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Adjutant Abidal en Ubicacion: moro_vol (110, 90). Derrota a las creaciones de Morroc y a sus seguidores: Frost Spider Brinaranea y Fire Wolf Muspellskoll."
		},
		Summary = ""
	},
	[7595] = {
		Title = "Magia del orbe errante",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Hishieh en Ubicacion: moro_vol (95, 108). Recoge el maná robado de Yggdrasil y el Orbe: golpea y dispersa Brilliant Manas, Life Manas y Earth Manas."
		},
		Summary = ""
	},
	[7596] = {
		Title = "Cualificaciones de los invitados",
		Description = {
			"Inicio: NPC: Yggdrasil Lookalike en Ubicacion: moro_cav (45, 75). Para entrar al Templo del Dios Demonio, necesitas una llave. Derrota al portero Ahat y Shnaim y usa sus almas para abrir la entrada del templo."
		},
		Summary = "1 alma de Ahat, 1 alma de Shnaim"
	},
	[7597] = {
		Title = "Caída del falso Dios",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Commander Hibba Agip en Ubicacion: moro_vol (108, 88). Derrotaste al Dios Demonio Morroc, que quería crear un mundo nuevo y jugar a ser Dios. Preséntate ante el comandante Hiva Agip."
		},
		Summary = "Informe al comandante"
	},
	[7598] = {
		Title = "Dios enjaulado",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Commander Hibba Agip en Ubicacion: moro_vol (108, 88). Confinado en su propio mundo, el Dios Demonio está condenado a sufrir por la eternidad. Vuelve mañana y sácalo de su miseria una vez más."
		},
		Summary = "Vuelve mañana"
	},
	[7599] = {
		Title = "Caza interminable",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Adjutant Abidal en Ubicacion: moro_vol (110, 90). La caza continúa hasta que todos los demonios del Templo del Dios Demonio sean derrotados. El ayudante Abidal le pidió que volviera cuando estuviera completamente descansado."
		},
		Summary = "Vuelve mañana"
	},
	[7600] = {
		Title = "Mañana prometedor",
		Description = {
			"Requisitos: Nivel Base: 160+. Inicio: NPC: Hishieh en Ubicacion: moro_vol (95, 108). El Orbe de Eclage y Yggdrasil han perdido una cantidad sustancial de maná y, por lo tanto, el trabajo de recolección de maná continúa hasta que se recupera la mayor parte. Descansa y regresa a Hishieh antes de pasar al Templo del Dios Demonio."
		},
		Summary = "Vuelve mañana"
	},
	[7601] = {
		Title = "Templo del Dios Demonio Fase 1",
		Description = {
			"Inicio: NPC: Yggdrasil Lookalike en Ubicacion: moro_cav (45, 75). Derrota a Frost Spider Brinaranea para pasar a la siguiente área."
		},
		Summary = ""
	},
	[7602] = {
		Title = "Templo del Dios Demonio Fase 1 completada",
		Description = {
			"Inicio: NPC: Yggdrasil Lookalike en Ubicacion: moro_cav (45, 75). Derrotaste a la Araña Helada Brinaranea."
		},
		Summary = ""
	},
	[7603] = {
		Title = "Templo del Dios Demonio Fase 2",
		Description = {
			"Inicio: NPC: Yggdrasil Lookalike en Ubicacion: moro_cav (45, 75). Derrota a Fire Wolf Muspellskoll para pasar a la siguiente área."
		},
		Summary = ""
	},
	[7604] = {
		Title = "Templo del Dios Demonio Fase 2 completada",
		Description = {
			"Inicio: NPC: Yggdrasil Lookalike en Ubicacion: moro_cav (45, 75). Derrotaste al Lobo de Fuego Muspellskoll."
		},
		Summary = ""
	},
	[7605] = {
		Title = "Bendición del guardián",
		Description = {
			"Inicio: NPC: Yggdrasil Lookalike en Ubicacion: moro_cav (45, 75). Su último contrato con The Guardian aún no ha expirado. Hasta entonces no se podrán realizar nuevos contratos."
		},
		Summary = ""
	},
	[7606] = {
		Title = "Reclutamiento de excavadoras Phantasmagorika",
		Description = {
			"Las Ruinas de Juperos han sido ampliadas. ¡Únase a nosotros para explorar la recién descubierta Phantasmagorika!"
		},
		Summary = ""
	},
	[7607] = {
		Title = "Líder del grupo Edén",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 1 de 8] Requisitos: Nivel Base: 140+ | Objetos: Insignia del Grupo Edén. Siguiente mision: 7608 (Equipo de excavación de Atnad - 1). Inicio: NPC: Secretaria Lime Evenor en Ubicacion: Sede del Grupo Edén (moc_para01 38, 175). El líder del Grupo Eden ha sido revelado. Quiere hablar contigo como si fuera Phantasmagorika. Vaya a la habitación más alejada del lado izquierdo en el segundo piso."
		},
		Summary = "Habla con el comandante del grupo Eden"
	},
	[7608] = {
		Title = "Equipo de excavación de Atnad - 1",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 2 de 8] Requisitos: Nivel Base: 140+ | Mision previa: 7607 (Líder del grupo Edén). Siguiente mision: 7609 (Equipo de excavación de Atnad - T2). Inicio: NPC: Comandante del Grupo Edén en Ubicacion: Segundo Piso del Grupo Edén (moc_para01). El comandante del Grupo Eden le ha pedido que hable con Lime Evenor en la oficina de empleados para unirse al proyecto de excavación. La oficina de empleados es la habitación de al lado."
		},
		Summary = "Habla con Lime en la oficina de empleados."
	},
	[7609] = {
		Title = "Equipo de excavación de Atnad - T2",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 3 de 8] Requisitos: Nivel Base: 140+ | Mision previa: 7608 (Equipo de excavación de Atnad - 1). Siguiente mision: 7610 (Excavadora registrada). Inicio: NPC: Secretaria Lime Evenor en Ubicacion: Oficina de Empleados (moc_para01 38, 175). Usa la mazmorra de Juperos para moverte al área recién descubierta. No olvide registrarse en el Centro de Comando Central a su llegada. Dile que el nombre de tu equipo es ^0000FFAtnad^000000."
		},
		Summary = "Regístrese como miembro del equipo de excavación de Atnad"
	},
	[7610] = {
		Title = "Excavadora registrada",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 4 de 8] Requisitos: Nivel Base: 140+ | Mision previa: 7609 (Equipo de excavación de Atnad - T2). Siguiente mision: 7611 (Limpieza de pasajes). Inicio: NPC: Oficial de Registro en Ubicacion: Campamento Central de Juperos / Verus. Ahora eres miembro oficial del equipo de excavación de Atnad y puedes participar en el proyecto de excavación de Phantasmagorika."
		},
		Summary = ""
	},
	[7611] = {
		Title = "Limpieza de pasajes",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 5 de 8] Requisitos: Nivel Base: 140+ | Mision previa: 7610 (Excavadora registrada). Siguiente mision: 7612 (Limpieza de paso - en espera). Inicio: NPC: Comandante de Seguridad en Ubicacion: Verus (verus04). ¿Podrías ayudarnos a cuidar de los monstruos en el túnel y por aquí? Cuando hayas terminado, informa al comandante Louis."
		},
		Summary = ""
	},
	[7612] = {
		Title = "Limpieza de paso - en espera",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 6 de 8] Requisitos: Nivel Base: 140+ | Mision previa: 7611 (Limpieza de pasajes). Siguiente mision: 7623 (Invocación de Atnad). Inicio: NPC: Comandante de Seguridad en Ubicacion: Verus (verus04). Deberías descansar. Nuestros mercenarios pueden encargarse de los monstruos en el pasaje. Puedes volver a realizar la misión del Comandante Louis."
		},
		Summary = "Espera de misión diaria"
	},
	[7613] = {
		Title = "Eliminando riesgos",
		Description = {
			"Inicio: NPC: Commander Louis en Ubicacion: verus04 (179, 165). Los robots en el sitio de excavación principal se interponen en nuestro camino. Por favor, deshazte de ellos."
		},
		Summary = ""
	},
	[7614] = {
		Title = "Eliminación de riesgos - en espera",
		Description = {
			"Inicio: NPC: Commander Louis en Ubicacion: verus04 (179, 165). Podemos limpiar el sitio de excavación de esos robots. Por favor vuelve la próxima vez."
		},
		Summary = "Espera de misión diaria"
	},
	[7615] = {
		Title = "Colección principal",
		Description = {
			"Inicio: NPC: Ian Atnad en Ubicacion: verus04 (144, 193). Recoge 20 dispositivos de control de energía de los robots. Pueden ser la clave para una civilización altamente avanzada."
		},
		Summary = "20 dispositivos de control de energía"
	},
	[7616] = {
		Title = "Colección principal: en espera",
		Description = {
			"Inicio: NPC: Archaeologist Aures en Ubicacion: verus04 (141, 193). El equipo de excavación de Atnad se centra en estudiar los dispositivos de control de energía. Deberías descansar mientras puedas."
		},
		Summary = "Espera de misión diaria"
	},
	[7617] = {
		Title = "Entrega del informe de excavación",
		Description = {
			"Inicio: NPC: Commander Louis en Ubicacion: verus04 (179, 165). Lleve el informe de excavación diario del equipo de excavación de Atnad a Louis en el Centro de Comando Central. ¡Después de eso, tu trabajo del día estará hecho!"
		},
		Summary = "Entregar el informe a Louis."
	},
	[7618] = {
		Title = "Informar los resultados - en espera",
		Description = {
			"Inicio: NPC: Commander Louis en Ubicacion: verus04 (179, 165). Espere el próximo informe del equipo de excavación de Atnad."
		},
		Summary = "Espera de misión diaria"
	},
	[7619] = {
		Title = "Ayudar al equipo de excavación",
		Description = {
			"Inicio: NPC: Archaeologist Aures en Ubicacion: verus04 (141, 193). Ahora eres miembro oficial del equipo de excavación. Ve a Aureth."
		},
		Summary = "Habla con Aureth"
	},
	[7620] = {
		Title = "¿Sangre joven?",
		Description = {
			"Inicio: NPC: Archaeologist Aures en Ubicacion: verus04 (141, 193). Aureth te ha pedido que vayas con Lloyd y Luke en la plaza en medio de Verus."
		},
		Summary = "encontrar a lloyd"
	},
	[7621] = {
		Title = "Embotellar la energía",
		Description = {
			"Inicio: NPC: Machinist Lloyd en Ubicacion: verus03 (103, 177). Lloyd ha pedido su ayuda en su investigación energética. Usa ^4d4dffEmpty Bottles^000000 para recolectar 10 energías condensadas de los escombros de todo Verus."
		},
		Summary = "10 energías condensadas"
	},
	[7622] = {
		Title = "¡Buenas noticias!",
		Description = {
			"Inicio: NPC: Machinist Lloyd en Ubicacion: verus03 (103, 177). Informe Aureth con los resultados de la investigación de Lloyd."
		},
		Summary = "Habla con Aureth"
	},
	[7623] = {
		Title = "Invocación de Atnad",
		Description = {
			"[Episodio 15.1: Phantasmagorika - Paso 7 de 8] Requisitos: Nivel Base: 140+ | Mision previa: 7612 (Limpieza de paso - en espera). Siguiente mision: 11363 (¡A Fantasmagorika!). Inicio: NPC: Dr. Atnad en Ubicacion: Campamento de Excavación (verus04). El equipo de excavación de Atnad tiene algunas tareas guardadas para usted. Habla con él."
		},
		Summary = "Habla con Atnad"
	},
	[7624] = {
		Title = "En busca de un manjar",
		Description = {
			"Inicio: NPC: Ian Atnad en Ubicacion: verus04 (144, 193). Encuentre algo que esté listo para comer, jugoso, refrescante y de sabor limpio. Busque consejo de otros miembros del equipo."
		},
		Summary = "encontrar un manjar"
	},
	[7625] = {
		Title = "cuenta conmigo",
		Description = {
			"Inicio: NPC: Luke Lapez en Ubicacion: verus03 (107, 177). Luke te cocinará algo si puedes traer 2 carnes, 1 mora mandarina y 1 plátano."
		},
		Summary = "2 Carnes, 1 Mora Mandarina y 1 Plátano"
	},
	[7626] = {
		Title = "Delicadeza para él",
		Description = {
			"Inicio: NPC: Luke Lapez en Ubicacion: verus03 (107, 177). Lleva Luke's Beef Toast, la especialidad de Mora, a Atnad."
		},
		Summary = "a ian"
	},
	[7627] = {
		Title = "Última Exploración",
		Description = {
			"Inicio: NPC: Ian Atnad en Ubicacion: verus04 (144, 193). Pregúntale a Ian Atnad sobre su último esfuerzo de exploración."
		},
		Summary = ""
	},
	[7628] = {
		Title = "Nueva fuente de energía",
		Description = {
			"Inicio: NPC: Machinist Lloyd en Ubicacion: verus03 (103, 177). Se le encarga recolectar energías condensadas para la investigación de Lloyd. Necesitas 10 botellas vacías."
		},
		Summary = "10 energías condensadas"
	},
	[7629] = {
		Title = "Mañana para la energía del mañana",
		Description = {
			"Inicio: NPC: Archaeologist Aures en Ubicacion: verus04 (141, 193). Regrese con Lloyd mañana para continuar ayudándolo con su investigación."
		},
		Summary = "Espera de misión diaria"
	},
	[7630] = {
		Title = "Unicornio azul legendario",
		Description = {
			"¡Se rumorea que hay un pony azul furioso en el bosque cerca de Payon! ¡Alguien me ayuda a encontrar la verdad sobre este animal!"
		},
		Summary = "Caza e informa a Fury."
	},
	[7631] = {
		Title = "Límite de caza",
		Description = {
			"Espere al menos 23 horas antes de volver a cazar. ¡Pero intenta no cazar más de una vez al día!"
		},
		Summary = ""
	},
	[7632] = {
		Title = "Å¥ÆêÀ¯´ÏÄÜÁ¦ÀÛ",
		Description = {
			"Å¥Æê ºí.ç À¯´ÏÄÜÀ\" Á¦ÀÛÇß´Ù."
		},
		Summary = ""
	},
	[7641] = {
		Title = "Acceso permitido",
		Description = {
			"Inicio: NPC: Access Controller Damhw en Ubicacion: verus03 (167, 257). Acceso aprobado para áreas restringidas \"Laboratorios\" e \"Instalaciones de Investigación\". A partir de ahora es posible el libre acceso a laboratorios e instalaciones de investigación."
		},
		Summary = ""
	},
	[7642] = {
		Title = "Explorar las instalaciones de investigación",
		Description = {
			"Inicio: NPC: Ian Atnad en Ubicacion: verus04 (144, 193). Mire a su alrededor y busque cosas de investigación especial y valor de investigación en el área de instalaciones de investigación. Informe incluso cosas pequeñas pero importantes a Ian Atnad"
		},
		Summary = ""
	},
	[7643] = {
		Title = "Pieza misteriosa",
		Description = {
			"Inicio: NPC: Strewn paper en Ubicacion: verus02 (60, 30). Encontrado algún tipo de componente en las instalaciones de Investigación. Informe a Ian Atnad."
		},
		Summary = "Informe a Ian"
	},
	[7644] = {
		Title = "Tocadiscos",
		Description = {
			"Inicio: NPC: Ian Atnad en Ubicacion: verus04 (144, 193). Se necesita un tocadiscos para conocer el contenido de Memory Record. El comandante Arquien del Paradise Squad conoce el paradero del tocadiscos."
		},
		Summary = "Conversar con Arquien"
	},
	[7645] = {
		Title = "Pedazo de registro de memoria",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: moc_para01 (133, 170). Se necesitan al menos 5 piezas para reproducir Memory Record intacto. Recoge el resto de los registros de memoria en las instalaciones de investigación y llévaselos al comandante Arquien, que llegó al sitio de excavación de Verus."
		},
		Summary = "5 registros de memoria"
	},
	[7646] = {
		Title = "Reproducir registro de memoria",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Conversa con el comandante Arquien después de jugar Memory Record"
		},
		Summary = "Operar tocadiscos"
	},
	[7647] = {
		Title = "Informe de registro de memoria",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Informe a Ian Atnad sobre lo que descubrió sobre Memory Records."
		},
		Summary = "Informe a Ian"
	},
	[7648] = {
		Title = "Registros de Memoria de los Laboratorios",
		Description = {
			"Inicio: NPC: Ian Atnad en Ubicacion: verus04 (144, 193). Recoge 5 \"Registros de memoria de los laboratorios\" en las instalaciones subterráneas de los laboratorios y llévaselos a Arquien para conocer el contenido."
		},
		Summary = "5 Registros de Memoria de los laboratorios"
	},
	[7649] = {
		Title = "Informar contenido del registro de memoria",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Informe a Ian Atnad sobre el contenido conocido de los Registros de Memoria de los laboratorios."
		},
		Summary = "Conversar con Ian"
	},
	[7650] = {
		Title = "Recopilar registros de memoria de las instalaciones de investigación.",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Recoge 5 registros de memoria en las instalaciones de investigación y llévaselos a Arquien para descifrar el contenido."
		},
		Summary = "5 registros de memoria"
	},
	[7651] = {
		Title = "Un recuerdo al día",
		Description = {
			"Inicio: NPC: Record player en Ubicacion: verus04 (170, 150). Recopile registros de memoria solo una vez al día. Ve a Arquien a la hora prometida."
		},
		Summary = ""
	},
	[7652] = {
		Title = "Recopilar registros de memoria de laboratorios.",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Recoge 5 registros de memoria en los laboratorios y llévaselos a Arquien para descifrar el contenido."
		},
		Summary = "5 Registros de Memoria de Laboratorios"
	},
	[7653] = {
		Title = "Un recuerdo al día 2",
		Description = {
			"Inicio: NPC: Record player en Ubicacion: verus04 (170, 150). Recoge registros de memoria en los laboratorios sólo una vez al día. Ve a Arquien a la hora prometida."
		},
		Summary = ""
	},
	[7654] = {
		Title = "Jugar Instalaciones de investigación Registros de memoria",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Descubra el contenido tocando el tocadiscos."
		},
		Summary = "Reproducir tocadiscos"
	},
	[7655] = {
		Title = "Reproducir registros de memoria de laboratorios",
		Description = {
			"Inicio: NPC: Commander Arquien en Ubicacion: verus04 (172, 149). Descubra el contenido tocando el tocadiscos."
		},
		Summary = "Reproducir tocadiscos"
	},
	[7656] = {
		Title = "Invitación de Rekenber",
		Description = {
			"Rekenber te ha invitado a la sede corporativa. Visite la sede de Rekenber Corporation ubicada en Rihrtarzen."
		},
		Summary = "Conversar con Tatio"
	},
	[7670] = {
		Title = "°í¾çÀÌ¼ÕÃ¢°í È\"º¸Àü´ÜÁö ±³È¯",
		Description = {
