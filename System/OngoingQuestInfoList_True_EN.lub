	[9240] = {
		Title = "<Notas de la declaración de Luen>",
		Description = {
			"Notas de la declaración de ^0000FFLuen^000000: dio un paseo por la tierra de las flores, vio a una persona con cabello corto y rojo apurado, incapaz de decir el género, desconocido debido al raro color de cabello. Solía pensar que Luen fue el primero en descubrirme, pero en realidad la madre de Luen fue la primera."
		},
		Summary = ""
	},
	[9241] = {
		Title = "<Notas de la declaración de Luen>",
		Description = {
			"Notas de la declaración de ^0000FFLuen^000000: dio un paseo por la tierra de las flores en flor, vio a una persona con cabello corto y rojo a toda prisa, desconocida debido al raro color de cabello. Vio al amigo de su padre, Balumin, pasar por la casa. Me pregunto por qué simplemente pasó cuando me habría visto."
		},
		Summary = ""
	},
	[9242] = {
		Title = "<Notas de la declaración de Luen>",
