	},
	[9142] = {
		Title = "Logro",
		Description = {
			"Recibiste el sombrero del Señor de la Serpiente Malvada"
		},
		Summary = ""
	},
	[9155] = {
		Title = "Conseguir materiales para la Corona Jaty",
		Description = {
			"Inicio: NPC: Tribal Chief Paiko en Ubicacion: dew_in01 (15, 49). Caza a Cendrawasih y llévale ^404040Consigue 15 plumas de Cendrawasih^000000 al jefe tribal Paiko."
		},
		Summary = ""
	},
	[9156] = {
		Title = "hacer la corona de jaty",
		Description = {
			"^404040Parece que la fabricación de Jaty Crown va bien.^000000"
		},
		Summary = "Continúe hablando con el jefe tribal Paiko."
	},
	[9157] = {
		Title = "Recompensa del sabio Kasyapa",
		Description = {
			"Mensaje de ^0000FFJefe tribal Paiko^000000: ^404040Sage, Kasyapa te está buscando.^000000"
		},
		Summary = "Obtén una recompensa de Sage, Kasyapa."
	},
	[9158] = {
		Title = "Entrega de buenas noticias(1)",
		Description = {
			"Inicio: NPC: Tribal Chief Paiko en Ubicacion: dew_in01 (15, 49). Mensaje de ^0000FFJefe tribal Paiko^000000: ^404040Entregue el Satay a nuestro guerrero tribal.^000000"
		},
		Summary = "Entrega el Satay al guerrero tribal Jaty."
	},
	[9159] = {
		Title = "Volver a Paiko",
		Description = {
			"Mensaje de ^0000FFJaty Tribal Warrior^000000: ^404040Espero que tu perseverancia y orgullo te acompañen en tus viajes.^000000"
		},
		Summary = "Volver al Jefe Tribal Paiko"
	},
	[9160] = {
		Title = "Entrega de buenas noticias(2)",
		Description = {
			"Mensaje de ^0000FFJefe tribal Paiko^000000: ^404040Entregue el Satay al administrador de la tribu ubicado fuera de la aldea.^000000"
		},
		Summary = "Entrega el Satay al administrador de la tribu."
	},
	[9161] = {
		Title = "Volver a Paiko",
		Description = {
			"Mensaje de ^0000FFTribe Manager^000000: ^404040No te olvides del valor de la tradición.^000000"
		},
		Summary = "Volver al Jefe Tribal Paiko"
	},
	[9162] = {
		Title = "Entrega de buenas noticias(3)",
		Description = {
			"Mensaje de ^0000FFJefe tribal Paiko^000000: ^404040Entrega el Satay al guardián del volcán Krakatau.^000000"
		},
		Summary = "Entrega el Satay al guardián del volcán Krakatau."
	},
	[9163] = {
		Title = "Volver a Paiko",
		Description = {
			"Mensaje de ^0000FFGuardián del volcán Krakatau^000000: ^404040Pon a prueba tu coraje subiendo al volcán Krakatau.^000000"
		},
		Summary = "Vuelve con el jefe tribal Paiko."
	},
	[9164] = {
		Title = "Entrega de buenas noticias(4)",
		Description = {
			"Mensaje de ^0000FFJefe tribal Paiko^000000: ^404040Entregue el Satay al administrador del templo de Borobudur.^000000"
		},
		Summary = "Entrega el Satay al administrador del templo de Borobudur."
	},
	[9165] = {
		Title = "Recompensa de Paiko por el éxito de Jaty Crown",
		Description = {
			"Mensaje de ^0000FF Administrador del templo de Borobudur^000000: ^404040La isla Dewata y la tribu Jaty están llenas de misterio.^000000"
		},
		Summary = "Vuelve con el jefe tribal Paiko y recibe la recompensa."
	},
	[9167] = {
		Title = "Tutorial - Mercenario a sueldo",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). Encuentra al oficial del gremio de mercenarios, contrata a un mercenario y habla con el instructor tutorial mientras el mercenario aún está contratado."
		},
		Summary = ""
	},
	[9168] = {
		Title = "Comprobación de ventana de misión",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). El material que debes contarle al Instructor Tutorial es 10 \"Jellopy\"."
		},
		Summary = ""
	},
	[9169] = {
		Title = "Catálogo de escaparates",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). Encuentre el ^0000ffCatalogue Wizard^000000 ubicado en South Prontera y obtenga 1 ^006400Window Shopper Catalogue^000000"
		},
		Summary = ""
	},
	[9170] = {
		Title = "Catálogo de escaparates",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). Utilice el catálogo de Window Shopper y luego regrese al Tutorial Instructor para ver otra lección."
		},
		Summary = ""
	},
	[9171] = {
		Title = "Objetos encantadores",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). Lo siguiente que debemos aprender son los objetos encantadores. Recuerde traer 10 Jellopy y asegurarse de que su inventario esté bastante vacío, luego hable con el instructor tutorial para aprender sobre encantamientos."
		},
		Summary = ""
	},
	[9172] = {
		Title = "Objetos encantados",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). Examina los mantos tutoriales que has recibido y observa las diferencias entre las versiones normal y encantada. Luego devuélvalos al instructor tutorial."
		},
		Summary = ""
	},
	[9173] = {
		Title = "Enfriamiento del temporizador del tutorial",
		Description = {
			"Inicio: NPC: Tutorial Instructor en Ubicacion: moc_para01 (34, 178). Tienes que esperar 20 horas antes de poder volver a tomar las lecciones del Instructor Tutorial."
		},
		Summary = ""
	},
