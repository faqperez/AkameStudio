	[13000] = {
		Title = "RWC 2011Recolección de Tarjetas",
		Description = {
			"Inicio: NPC: RWC2011 Agent en Ubicacion: prontera (114, 81). Derrota a los Porings dorados que se encuentran aleatoriamente alrededor de Rune Midgard y recolecta suficientes tarjetas azules para deletrear \"RWC 2011\"."
		},
		Summary = ""
	},
	[13001] = {
		Title = "RWC2011Recolección de cartas - Temporizador",
		Description = {
			"Inicio: NPC: RWC2011 Agent en Ubicacion: prontera (114, 81). Espere 23 horas antes de llevar más Tarjetas Azules al Nuevo Agente"
		},
		Summary = ""
	},
	[13002] = {
		Title = "Brigan coleccionando",
		Description = {
			"Inicio: NPC: Gelkah en Ubicacion: moc_para01 (37, 95). Recoge 50 piezas de Brigan de Turtle Island o Glastheim y tráelas a Gelkah en Eden Group."
		},
		Summary = "Recupera 50 Brigan"
	},
	[13003] = {
		Title = "Solicitud de quilates",
		Description = {
			"Esta solicitud es de un comerciante de Marruecos. Carats vende helados todo el año y no puede obtener ningún beneficio. El equipo de Eden Group sabe que ese no es el verdadero motivo, pero una solicitud es una solicitud."
		},
		Summary = "Caza 30 quilates y regresa a Gelkah."
	},
	[13004] = {
		Title = "Temporizador de solicitud de quilates",
		Description = {
			"Espere a que expire el temporizador antes de volver a aceptar esta solicitud."
		},
		Summary = ""
	},
	[13005] = {
		Title = "Solicitud de Arclouise",
		Description = {
			"¿Sabes que aquí en Rune Midgard se utilizan frijoles como alimento? Cuando un Arclouse rueda, se parece a un frijol."
		},
		Summary = "Caza 22 Arclouse y regresa a Gelkah."
	},
	[13006] = {
		Title = "Temporizador de solicitud de Arclouse",
		Description = {
			"Espere a que expire el temporizador antes de volver a aceptar esta solicitud."
		},
		Summary = ""
	},
	[13007] = {
		Title = "Solicitud anoliana",
		Description = {
			"Glastheim parece ser un buen lugar sagrado no sólo para los aventureros sino también para los monjes. No tengo idea de qué es lo que realmente les atrae allí."
		},
		Summary = "Caza 30 Anolian y regresa a Gelkah."
	},
	[13008] = {
		Title = "Temporizador de solicitud anoliana",
		Description = {
			"Espere a que expire el temporizador antes de volver a aceptar esta solicitud."
		},
		Summary = ""
	},
	[13009] = {
		Title = "Solicitud de picadura",
		Description = {
			"¿Has oído hablar de la peregrinación de un monje? Hay tantas picaduras en el canal subterráneo y en la cueva que perturban a los pacíficos monjes."
		},
		Summary = "Caza 30 Sting y regresa a Gelkah."
	},
	[13010] = {
		Title = "Temporizador de solicitud de picadura",
		Description = {
			"Espere a que expire el temporizador antes de volver a aceptar esta solicitud."
		},
		Summary = ""
	},
	[13011] = {
		Title = "Solicitud de Majoruros",
		Description = {
			"El destino de peregrinación de los monjes se encuentra en el segundo piso de la cueva subterránea del castillo de Glastheim. No es un viaje fácil pero será una buena experiencia."
		},
		Summary = "Caza 30 Majoruros y regresa a Gelkah."
	},
	[13012] = {
		Title = "Majoruros Solicitar temporizador",
		Description = {
			"Espere a que expire el temporizador antes de volver a aceptar esta solicitud."
		},
		Summary = ""
	},
	[13013] = {
		Title = "Solicitud de Pinguicula",
		Description = {
			"Pinguicula es uno de los primeros monstruos que los aventureros encuentran cuando entran en Ash Vacuum. Esperan que reduzcamos los monstruos alrededor del Campamento de Expedición."
		},
		Summary = "Caza 30 Pinguicula y regresa a Gelkah."
	},
	[13014] = {
		Title = "Temporizador de solicitud de Pinguicula",
		Description = {
			"Espere a que expire el temporizador antes de volver a aceptar esta solicitud."
		},
		Summary = ""
	},
	[13015] = {
		Title = "Solicitud de Luciola Vespa",
		Description = {
			"Rohtert fue picado por uno de estos monstruos parecidos a abejas, por lo que solicitó exterminarlos..."
		},
		Summary = "Caza 30 Luciola Vespa y regresa a Gelkah."
