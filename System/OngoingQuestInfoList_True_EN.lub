	[2000] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Inicio: NPC: Guildsman en Ubicacion: ein_in01 (18, 28). Queremos comprobar la dedicación y entusiasmo de los Comerciantes que nos solicitan convertirse en Herreros. Para la primera prueba, ve a Einbech y ayuda a uno de los miembros de nuestro gremio, Geschupenschte."
		},
		Summary = "Conoce a Geschupenschte, herrero de Einbech"
	},
	[2001] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Me duele decir esto, pero parece que necesitas estudiar un poco más. ¡Nunca podrás ser un herrero con esta puntuación!"
		},
		Summary = "Estudia un poco más sobre cómo convertirte en herrero y vuelve a intentarlo."
	},
	[2002] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡No tendrás ningún problema con esta puntuación! ¡Te confiaré un trabajo! Dame un poco de tiempo para hacer los arreglos necesarios. ¡Cuando regreses estaré listo!"
		},
		Summary = "Hablar con Geschupenschte"
	},
	[2003] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Necesito algunos materiales para gestionar tantos pedidos. ¿Podrías traer 2 aceros, 1 vendaje podrido, 2 piedras preciosas azules y una varita de arco de la tienda? Esto es sólo para una prueba, ni siquiera creas que los herreros son pobres. Tararear."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2004] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Necesito algunos materiales para gestionar tantos pedidos. ¿Podrías traer 2 Star Dust, 1 Skel Bone, 1 Zargon y un Gladius de la tienda? Esto es sólo para una prueba, ni siquiera creas que los herreros son pobres. Tararear."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2005] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Necesito algunos materiales para gestionar tantos pedidos. ¿Podrías traer 2 Carbón, 2 Shell, 2 Red Blood y un Tsurugi de la tienda? Esto es sólo para una prueba, ni siquiera creas que los herreros son pobres. Tararear."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2006] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Necesito algunos materiales para gestionar tantos pedidos. ¿Podrías traer 8 minerales de hierro, 1 parche en el ojo, 2 piedras preciosas azules y una ballesta de la tienda? Esto es sólo para una prueba, ni siquiera creas que los herreros son pobres. Tararear."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2007] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Necesito algunos materiales para gestionar tantos pedidos. ¿Podrías traer de la tienda 8 hierros, 20 hierbas verdes, 2 pieles de animales y un sable con pomo de anillo? Esto es sólo para una prueba, ni siquiera creas que los herreros son pobres. Tararear."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2008] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Todo listo! Bueno. Dale esta varita de arco a Baisulist que se encuentra actualmente en Geffen del Reino de Rune-Midgarts. Asegúrate de traerme el recibo."
		},
		Summary = "Entrega la varita de arco a Baisulist en Geffen."
	},
	[2009] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Todo listo! Bueno. Dale este Gladius a Wickebine en Marruecos del Reino Rune-Midgarts. Asegúrate de traerme el recibo."
		},
		Summary = "Entregar Gladius a Wickebine en Marruecos"
	},
	[2010] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Todo listo! Bueno. Dale este Tsurugi a Krongast que está en Lighthalzen. Asegúrate de traerme el recibo."
		},
		Summary = "Entrega Tsurugi a Krongast en Lighthalzen."
	},
	[2011] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Todo listo! Bueno. Dale este Arbalest a Talpiz que está en Payon del Reino de Rune-Midgarts. Asegúrate de traerme el recibo."
		},
		Summary = "Entregar Arbalesta a Talpiz en Payón"
	},
	[2012] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Todo listo! Bueno. Dale este Ring Pommel Sabre a Bismarc que está en Hugel. Asegúrate de traerme el recibo."
		},
		Summary = "Entrega el sable con pomo de anillo a Bismarc en Hugel"
	},
	[2013] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Bien hecho! ¡Eres un gran comerciante! ¡Bien, ve a Altiregen en Einbroch!"
		},
		Summary = "Volver a Altiregen"
	},
	[2014] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"Algunos otros herreros tienen malos modales y son estafadores y sobrevaloradores. ¡Nos traen vergüenza! Por eso hacemos que la prueba de cambio de trabajo sea más difícil. Deberías hablar con el Guildsman interno."
		},
		Summary = "Habla con Mitehmaeeuh, miembro del gremio de herrero."
	},
	[2015] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Felicitaciones! ¡Pasaste la segunda prueba! Te daré este Martillo de Herrero como certificado."
		},
		Summary = "Volver a Altiregen"
	},
	[2016] = {
		Title = "Cambio de trabajo a herrero",
		Description = {
			"¡Felicitaciones! ¡Pasaste todas las pruebas! Doy permiso para utilizar el arte de la artesanía con fuego."
		},
		Summary = ""
	},
	[2017] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Inicio: NPC: Rogue Guildsman en Ubicacion: in_rogue (363, 122). Pasaste la primera prueba para convertirte en un pícaro. El \"Sr. Smith\" administrará la siguiente prueba."
		},
		Summary = "Habla con el Sr. Smith"
	},
	[2018] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Hay una tarifa de registro para convertirse en Rogue. Te diré lo que necesitas recolectar y cuánto cuesta la tarifa de registro: 10,000 zeny, 10 Hueso de Skel, 6 Hierba azul, 10 Clavo podrido, 10 Boca horrenda."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2019] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Hay una tarifa de registro para convertirse en Rogue. Te diré lo que necesitas recolectar y cuánto cuesta la tarifa de registro: 10,000 zeny, 10 Hierba verde, 10 Concha de cangrejo, 10 Escama de serpiente, 10 Garlet."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2020] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Hay una tarifa de registro para convertirse en Rogue. Te diré lo que necesitas recolectar y cuánto cuesta la tarifa de registro: 10,000 zeny, 10 Hierba amarilla, 10 Concha, 10 Pata de saltamontes, 10 Piel de pie de oso."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2021] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Llévale 10 hojas de mapache y 5 de cada crisálida, botella vacía, mineral de hierro, corazón de piedra, hierba roja, piel de animal, piedra preciosa amarilla, dientes de murciélago, colas de escorpión, cola de yoyo, alimento de monstruo, pelusa, trébol, plumas de pájaro, garra y engendro al Sr. Smith."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2022] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Visita a Aragham Jr, que vive al sur de la Fortaleza Sandarman. Esa área está ubicada un campo al este de aquí. La contraseña es: ^0000FF'Aragham nunca acumuló elementos de mejora.'^000000"
		},
		Summary = "Habla con Aragham Jr."
	},
	[2023] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Visita a Antonio Jr., que vive cerca de la playa de Kokomo en Comodo. La contraseña es: ^0000FF'A Antonio no le gusta destruir elementos de mejora.'^000000"
		},
		Summary = "Habla con Antonio Jr."
	},
	[2024] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Visita a Hollgrehenn Jr., que se encuentra en el campo al sur de la Fortaleza Sandarman, que está de camino a Marruecos desde aquí. Él te hará la prueba de Pícaro adecuada. La contraseña es: ^0000FF'Mi padre nunca acumuló artículos de mejora.'^000000"
		},
		Summary = "Habla con Hollgrehenn Jr."
	},
	[2025] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Visita a Hermanthorn Jr., que vive en el faro de Paros. ¡Pero por favor no hables de mejorar elementos delante de él!"
		},
		Summary = "Habla con Hermanthorn Jr."
	},
	[2026] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"Solo necesitas caminar hasta Rogue Guild desde un túnel subterráneo, ¡prueba simple! Pero no puedo garantizar que sea totalmente seguro."
		},
		Summary = "Camina por el túnel subterráneo hasta Rogue Guild."
	},
	[2027] = {
		Title = "Cambio de trabajo a pícaro",
		Description = {
			"¡Felicitaciones! ¡Te has convertido en un pícaro!"
		},
		Summary = ""
	},
	[2028] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Inicio: NPC: Alchemist Guildsman en Ubicacion: alde_alche (27, 185). Debes traer 7 pociones Berserk antes de poder comenzar tu entrenamiento formal para convertirte en alquimista."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2029] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Inicio: NPC: Alchemist Guildsman en Ubicacion: alde_alche (27, 185). Debes traer 100 Mini Furnace antes de poder comenzar tu entrenamiento formal para convertirte en Alquimista."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2030] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Inicio: NPC: Alchemist Guildsman en Ubicacion: alde_alche (27, 185). Debes traer 500 Flechas de Fuego antes de poder comenzar tu entrenamiento formal para convertirte en Alquimista."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2031] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Raspuchin te está llamando. Ve a hablar con él. No estoy muy seguro de qué hablarás con él..."
		},
		Summary = "Habla con el exigente alquimista Raspuchin"
	},
	[2032] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Puedo ver que eres inteligente por tus ojos. Vale, excelente. Ahora ve a Darwin. Él le mostrará cómo hacer los experimentos."
		},
		Summary = "Charla con el hombre que estudia, Darwin"
	},
	[2033] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Te enseñaré cómo hacer una medicina sencilla. Así que traiga 3 tazones de medicina, 3 botellas vacías, 1 hierba roja, 1 hierba amarilla y 1 hierba blanca de inmediato."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2034] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"¡¡Ahora eres un Alquimista!! ¡Ve a la Unión y desecha los últimos vestigios de la vida mercantil!"
		},
		Summary = "Habla con el maestro alquimista"
	},
	[2035] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Ve a la siguiente habitación y habla con Van Helmont para continuar tu entrenamiento."
		},
		Summary = "Habla con Van Helmont"
	},
	[2036] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Te daré una tarea. Debes aprender algo nuevo y volver. Vamos a ver. Aprenda a hacer un contraagente y una mezcla de Molgenstein."
		},
		Summary = "Habla con Molgenstein"
	},
	[2037] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Bien, ahora sabes algo sobre la experimentación. Sal y encuentra la habitación al lado de ésta y habla con Nicholas. Él continuará tu entrenamiento."
		},
		Summary = "Charla con el investigador jefe Nicholas"
	},
	[2038] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"1 Mezcla, 5 Árbol Quemado, 5 Arena Fina, 3 Oridecon Bruto y 3 Elunium Bruto. Bain y Bajin necesitarán todos estos elementos para continuar con sus experimentos."
		},
		Summary = "Habla con Bain y Bajin"
	},
	[2039] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Acabo de recibir un mensaje de Bain y Bajin. Me hicieron saber que estaban muy contentos con su asistencia. ¡Todo lo que tienes que hacer ahora es hablar con el líder sindical en el segundo piso! ¡Felicitaciones, muy pronto te convertirás en Alquimista!"
		},
		Summary = "Habla con el maestro alquimista"
	},
	[2040] = {
		Title = "Cambio de trabajo a alquimista",
		Description = {
			"Ahora es miembro de nuestra ilustre Unión. ¡Espero que aprendas mucho y recuerdes comportarte con orgullo como Alquimista!"
		},
		Summary = ""
	},
	[2041] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Inicio: NPC: Staff of the Academy en Ubicacion: yuno_in03 (154, 35). Para realizar el examen de ingreso, debes hablar con el profesor Claytos. Él está en la habitación de la izquierda."
		},
		Summary = "Charla con el evaluador escrito, Claytos."
	},
	[2042] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Metheus Sylphe: \"¿No tienes suficiente zeny para la cuota de inscripción? Aceptaré 30.000 zenys como cuota de inscripción si me traes 50 plumas de pájaro, 50 pelusas y 25 minerales de hierro. Puedes traer 70.000 zenys o traer un libro mágico antiguo y un collar de sabiduría como cuota de inscripción\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2043] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Inicio: NPC: Staff of the Academy en Ubicacion: yuno_in03 (154, 35). Metheus Sylphe: \"Aceptaré 30.000 zenys como tarifa de inscripción si me traes 50 plumas de pájaro, 50 pelusas y 25 minerales de hierro. También puedes traer 70.000 zenys como regla general o traer un libro mágico antiguo y un collar de sabiduría como tarifa de inscripción\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2044] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Inicio: NPC: Staff of the Academy en Ubicacion: yuno_in03 (154, 35). Metheus Sylphe: \"Aceptaré 30.000 zenys como cuota de inscripción si me traes 50 tréboles, 50 plumas y 25 tintas de calamar. También puedes traer 70.000 zenys como regla general o traer un Libro Mágico Antiguo y un Collar de Sabiduría como cuota de inscripción en su lugar\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2045] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Inicio: NPC: Staff of the Academy en Ubicacion: yuno_in03 (154, 35). Metheus Sylphe: \"Aceptaré 30.000 zenys como cuota de inscripción si me traes 50 plumas de pájaro, 50 pelusas, 50 tréboles y 50 plumas. También puedes traer 70.000 zenys como regla general o traer un libro mágico antiguo y un collar de sabiduría como cuota de inscripción\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2046] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Has superado la prueba escrita. Ahora, ¿por qué no vas con el profesor Hermes y haces el examen práctico?"
		},
		Summary = "Habla con el probador práctico Hermes."
	},
	[2047] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Veamos cómo te fue en el examen escrito y en el examen práctico. Bien... según tu puntuación. Te sugiero que investigues sobre el Yggdrasil. Obtenga ayuda del profesor Saphien en la sala de conferencias académicas."
		},
		Summary = "Habla con el profesor Saphien en la sala de conferencias académicas."
	},
	[2048] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Veamos cómo te fue en el examen escrito y en el práctico. Bien... según tu puntuación. Te sugiero que estudies los diversos monstruos que se extienden por este mundo. Obtén ayuda del profesor Lucius en el Museo de los Monstruos."
		},
		Summary = "Habla con el profesor Lucius en el Museo de los Monstruos."
	},
	[2049] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Veamos cómo te fue en el examen escrito y en el práctico. Bien... según tu puntuación. Te sugiero que estudies las propiedades de la magia. Obtenga ayuda del profesor Aebecee en el laboratorio de somatología."
		},
		Summary = "Charla con el profesor Aebecee en el laboratorio de somatología"
	},
	[2050] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Encuentra cualquier artículo relacionado con el Yggdrasil. Prefiero una semilla o un fruto. Son raros pero encuentra uno de ellos."
		},
		Summary = "Encuentra un objeto relacionado con el Yggdrasil"
	},
	[2051] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"La próxima vez, tendrás que escribir un artículo por tu cuenta, prepárate. Trae 1 Pluma de Pájaro, 1 Piel de Animal, 1 Tronco, 1 Tinta de Calamar y 1 Botella vacía."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2052] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Si ha terminado con el trabajo, llévelo al Decano de la Academia."
		},
		Summary = "Habla con el decano de la academia."
	},
	[2053] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Soy el profesor Lucius y no olvides que mi clase tiene muchas excursiones. Así que primero necesito que encuentres estas cosas: 5 tentáculos, 5 células individuales y 5 colas de pez."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2054] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Soy el profesor Lucius y no olvides que mi clase tiene muchas excursiones. Entonces necesito que encuentres estas cosas primero: 5 Nipper, 5 Clam Flesh y 5 Heart of Mermaid."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2055] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Soy el profesor Lucius y no olvides que mi clase tiene muchas excursiones. Así que primero necesito que encuentres estas cosas: 5 tendones, 5 pinzas y 5 escamas afiladas."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2056] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Bueno, ¿aprenderemos sobre los insectos esta vez? Comenzaré la clase tan pronto como me traigas estos artículos: 5 telarañas, 5 conchas y 5 sensores de insectos."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2057] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Bueno, ¿aprenderemos sobre los insectos esta vez? Comenzaré la clase tan pronto como me traigas estos artículos: 5 cuernos, 5 caparazones de caracol y 5 polvo de polilla."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2058] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Bueno, ¿aprenderemos sobre los insectos esta vez? Comenzaré la clase tan pronto como me traigas estos artículos: 5 Mantis Scythe, 5 Worm Peeling y 5 Rainbow Shell."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2059] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Bueno, ¿aprenderemos sobre los insectos esta vez? Comenzaré la clase tan pronto como me traigas estos artículos: 5 Cobweb, 5 Mantis Scythe y 5 Solid Shell."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2060] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Antes de comenzar la clase, necesitas ayudarme con algo. No es difícil. Lo harás por mí, ¿verdad?"
		},
		Summary = "Trae 30 piedras y regresa con el profesor Aebecee."
	},
	[2061] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Te daré estos minerales. ¡Pero no son regalos! Haz flechas con estos minerales. Si tienes amigos arqueros, ellos te ayudarán a hacer flechas. Trae 50 flechas de cristal, 50 flechas de piedra y 50 flechas de viento."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2062] = {
		Title = "Cambio de trabajo a Sage",
		Description = {
			"Trae 1 Agua Bendita para la próxima clase. ¿Tienes un amigo sacerdote? Si no lo haces, haz uno. Hohoho."
		},
		Summary = "Llévale 1 agua bendita al profesor Aebecee."
	},
	[2063] = {
		Title = "El cuervo del destino - 1",
		Description = {
			"Inicio: NPC: Book-Touching Man en Ubicacion: moc_ruins (137, 70). Acepto la solicitud de Benjamin de traer el libro \"El Cuervo del Destino\" de la Biblioteca Prontera."
		},
		Summary = "Chicos del curador de la biblioteca"
	},
	[2064] = {
		Title = "El cuervo del destino - 2",
		Description = {
			"No puedes encontrar el libro en la Biblioteca Prontera. Dirígete a la Biblioteca Juno y mira si puedes encontrarlo allí."
		},
		Summary = "Biblioteca Juno"
	},
	[2065] = {
		Title = "El cuervo del destino - 3",
		Description = {
			"El libro contaba la escena exacta que vi en mi sueño. Quiero leer artículos de noticias sobre incendios."
		},
		Summary = "Encuentre un artículo de noticias sobre incendios."
	},
	[2066] = {
		Title = "El cuervo del destino - 4",
		Description = {
			"Descubrí que el incendio en el laboratorio realmente ocurrió. Tengo que encontrar la aldea de las cuevas."
		},
		Summary = "Pueblo de cuevas en el campo Schwaltzvalt"
	},
	[2067] = {
		Title = "El cuervo del destino - 5",
		Description = {
			"Zid me dijo que sería mejor que despertara del sueño y siguiera con mi vida real. Frustrado por la conversación con Zid, he decidido volver a Marruecos y olvidarme de todo."
		},
		Summary = "Benjamín en Marruecos"
	},
	[2068] = {
		Title = "El cuervo del destino - 6",
		Description = {
			"Decidí leer <El rastro del destino> como sugirió Benjamin."
		},
		Summary = "Biblioteca Juno"
	},
	[2069] = {
		Title = "Batalla de la garganta de Tierra",
		Description = {
			"Inicio: NPC: Lieutenant Eyor en Ubicacion: bat_room (58, 204). Has recibido un indicador que muestra que has participado en la Batalla de Tierra Gorge. Guillaume Army no te permitirá participar en ninguna otra batalla hasta que se apague el indicador."
		},
		Summary = "Espera para Tierra Gorge Battle hasta que pase el límite de tiempo."
	},
	[2070] = {
		Title = "Batalla de Flavio",
		Description = {
			"Inicio: NPC: bat_b02_rp1_b_warp en Ubicacion: bat_b02 (389, 10). Has recibido un indicador que muestra que has participado en la Batalla de Flavius. El oficial del ejército de Croix no te permitirá participar en ninguna otra batalla hasta que se apague el indicador."
		},
		Summary = "Espera para Flavius Battle hasta que pase el límite de tiempo."
	},
	[2071] = {
		Title = "Propiedad maldita",
		Description = {
			"Inicio: NPC: Buender Hikeman en Ubicacion: einbech (165, 105). Buender Hikeman malinterpreta lo que quiere y comienza a llorar por su pasado."
		},
		Summary = "Continúe escuchando la historia de Buender Hikeman."
	},
	[2072] = {
		Title = "Propiedad maldita",
		Description = {
			"Huyes de él mientras Buender Hikeman llora pidiendo un nombre, \"Shinokas\" y se desploma."
		},
		Summary = "Encuentra dónde está Shinokas"
	},
	[2073] = {
		Title = "Propiedad maldita",
		Description = {
			"Shinokas te dice que confesará la verdad sobre el colapso del túnel de la mina."
		},
		Summary = "Continúe escuchando la historia de Shinokas."
	},
	[2074] = {
		Title = "Propiedad maldita",
		Description = {
			"Shinokas te pide que vayas a la casa de Kapellthaines, uno de los hombres más ricos de la ciudad, y busques un mineral único."
		},
		Summary = "Infiltrarse en la casa de Kapellthaines."
	},
	[2075] = {
		Title = "Propiedad maldita",
		Description = {
			"Shinokas te pide que busques el mineral en una fábrica que parece sospechosa."
		},
		Summary = "Busca una fábrica para el mineral."
	},
	[2076] = {
		Title = "Propiedad maldita",
		Description = {
			"Shinokas te pide que busques el mineral en el laboratorio de Einbroch."
		},
		Summary = "Infíltrate en el laboratorio Einbroch"
	},
	[2077] = {
		Title = "Propiedad maldita",
		Description = {
			"Un hombre borracho confiesa que el mineral encontrado en Einbech es el pedazo del corazón de Ymir."
		},
		Summary = "Regreso a Shinokas"
	},
	[2078] = {
		Title = "Propiedad maldita",
		Description = {
			"El mineral está identificado pero Shinokas ya fue asaltado por tipos sospechosos. Deja un mensaje. \"Ellos... estaban...\" y muere."
		},
		Summary = "Volver a Buender Hikeman"
	},
	[2079] = {
		Title = "El pasado salió mal",
		Description = {
			"Inicio: NPC: Crewman en Ubicacion: airplane (47, 61). Kain Himere, la tripulación del dirigible, le pide que entregue el objeto perdido a un cliente que se aloja en el hotel Einbroch."
		},
		Summary = "Entregar lo perdido en el hotel Einbroch."
	},
	[2080] = {
		Title = "El pasado salió mal",
		Description = {
			"Elle Cherno, a quien conoces en el hotel, te dice que vayas a su casa detrás del hotel y veas a su madre."
		},
		Summary = "Conoce a Tarsha Cherno"
	},
	[2081] = {
		Title = "El pasado salió mal",
		Description = {
			"Tarsha Cherno dice que su padre desaparecido era minero. Le prometes que encontrarás a su padre y dejarás su casa."
		},
		Summary = "Encuentra a una persona que parezca el padre de Tarsha Cherno."
	},
	[2082] = {
		Title = "El pasado salió mal",
		Description = {
			"Necesitas pruebas para demostrar que Tarsha y Kain son familia. Kain Himere le dice que el diario de su esposa le será útil."
		},
		Summary = "Consulta el diario de la madre de Tarsha."
	},
	[2083] = {
		Title = "El pasado salió mal",
		Description = {
			"Después de consultar el diario de su madre, se lo llevas."
		},
		Summary = "Habla con Tarsha Cherno"
	},
	[2084] = {
		Title = "El pasado salió mal",
		Description = {
			"Tarsha Cherno te agradece y te deja usar la máquina de reparación gratis y te pide que vuelvas a ver a su hija."
		},
		Summary = "Conoce a Elle Cherno"
	},
	[2085] = {
		Title = "El pasado salió mal",
		Description = {
			"Recibe el correo con fotografías que Elle Cherno preparó para su abuelo."
		},
		Summary = "Regreso a Kain Hemere"
	},
	[2086] = {
		Title = "La empresa",
		Description = {
			"Inicio: NPC: Book en Ubicacion: yuno_in04 (168, 117). No estás seguro desde cuándo pero has estado escuchando alucinaciones auditivas."
		},
		Summary = "Investigar la alucinación auditiva"
	},
	[2087] = {
		Title = "La empresa",
		Description = {
			"Gracias a la ayuda de un anciano, descubres que ese espíritu extraño en la Corporación Rekenber te guía."
		},
		Summary = "Ingrese a la Corporación Rekenber"
	},
	[2088] = {
		Title = "La empresa",
		Description = {
			"La recepcionista de Rekenber te informa que puedes encontrar la historia de Rekenber en la biblioteca."
		},
		Summary = "Habla con un bibliotecario en Rekenber libraray"
	},
	[2089] = {
		Title = "La empresa",
		Description = {
			"Puede encontrar información sobre la historia de Rekenber en libros y bibliotecarios."
		},
		Summary = "Obtenga más información sobre Rekenber"
	},
	[2090] = {
		Title = "La empresa",
		Description = {
			"Wolfchev, un investigador de Rekenber, dice que quiere algo brillante y redondo."
		},
		Summary = "Trae a Wolfchev lo que quiere y habla con él."
	},
	[2091] = {
		Title = "La empresa",
		Description = {
			"Adquieres un colgante antiguo que no fue abierto en el pasado por alguien relacionado con Rekenber."
		},
		Summary = "Encuentra una manera de abrir el colgante."
	},
	[2092] = {
		Title = "La empresa",
		Description = {
			"El anciano te pide algunos objetos para eliminar la maldición del colgante. Trae 5 Agua Bendita y 1 Ramo."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2093] = {
		Title = "La empresa",
		Description = {
			"Con la ayuda del anciano, puedes abrir el colgante y ver la imagen en la que hay una niña sentada en una silla y un hombre que se parece a su hermano."
		},
		Summary = "Encuentra de quién es el colgante"
	},
	[2094] = {
		Title = "La empresa",
		Description = {
			"Concluyes que la causa principal de todas las maldiciones es Rekenber y decides ir a Rekenber nuevamente para descubrir la verdad."
		},
		Summary = "Habla con los oficiales de Rekenber"
	},
	[2095] = {
		Title = "La empresa",
		Description = {
			"Sueii Slierre, secretaria de Rekenber, dice que Wolfchev se ha jubilado y el caso está cerrado."
		},
		Summary = "Confirman que Wolfchev se ha retirado"
	},
	[2109] = {
		Title = "Un mago en la cueva de hielo",
		Description = {
			"Inicio: NPC: Sincere Follower Urstia en Ubicacion: rachel (157, 183). \"¡Muchas gracias! Por favor, cuida este collar y pídele a Maheo que le devuelva el brillo. Entonces, será un tributo apropiado para nuestra amorosa diosa Freya\"."
		},
		Summary = "Encuentra al mago arcano Maheo"
	},
	[2110] = {
		Title = "Un mago en la cueva de hielo",
		Description = {
			"\"Estoy seguro de que mi maestro sabrá una manera de liberarme de esta prisión de hielo. Se le puede encontrar cerca del Manantial de Freya: ¡suplicadle en mi nombre!\""
		},
		Summary = "Encuentra al maestro de Maheo"
	},
	[2111] = {
		Title = "Un mago en la cueva de hielo",
		Description = {
			"\"Necesito construir un artefacto para romper ese hielo mágico. Mmm... ¿Me ayudarías? Necesito conseguir 5 vientos agitados, 1 martillo y 1 pergamino en blanco\". -Hamión"
		},
		Summary = "Trae los materiales requeridos."
	},
	[2112] = {
		Title = "Un mago en la cueva de hielo",
		Description = {
			"\"Toma, toma este martillo de viento y úsalo para liberar a Maheo. ¡Este martillo solo funcionará una vez, así que asegúrate de romper el hielo correctamente!\""
		},
		Summary = "Libera a Maheo con el Martillo de Viento"
	},
	[2113] = {
		Title = "Un mago en la cueva de hielo",
		Description = {
			"\"Bueno, supongo que aquí es donde nos separamos. Toma, toma esto como un regalo... Y por favor no le menciones a nadie más el hecho de que me quedé atrapado en el hielo, ¿vale?\""
		},
		Summary = "Llévale el collar brillante a Urstialla."
	},
	[2114] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Inicio: NPC: High Priest Zhed en Ubicacion: ra_temin (277, 159). El Sumo Sacerdote Zhed quiere que te cueles en el campamento del Volcán Thor para proteger la paz internacional y que te cueles en la habitación del Sumo Sacerdote Vildt."
		},
		Summary = ""
	},
	[2115] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Has encontrado una carpeta de archivos en la habitación del Sumo Sacerdote Vildt. Llévaselo al sumo sacerdote Zhed en Rachel."
		},
		Summary = "Sumo Sacerdote Zhed"
	},
	[2116] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Encuentra al geólogo encargado de investigar el volcán Thor."
		},
		Summary = ""
	},
	[2117] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"El geólogo Gio te pidió que fueras al campamento de geología en el volcán Thor en su lugar y tomaras medidas de temperatura. Pero primero debes ir a su oficina y encontrar un pirómetro y un informe de su escritorio."
		},
		Summary = ""
	},
	[2118] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Ha registrado la primera temperatura en el informe. Encuentre otras superficies calientes y registre sus hallazgos."
		},
		Summary = ""
	},
	[2119] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Ha encontrado otra superficie caliente y ha registrado sus hallazgos en el informe. Encuentre otras superficies calientes y registre sus hallazgos."
		},
		Summary = ""
	},
	[2120] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Ha encontrado otra superficie caliente y ha registrado sus hallazgos en el informe. Esto debería ser suficiente para enviar el informe al campamento geológico."
		},
		Summary = ""
	},
	[2121] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"El guardia dice que entres y le pidas a Sahedi que te ayude en la aeronave justo al sur de la estación de tren."
		},
		Summary = "encontrar sahedi"
	},
	[2122] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Sahedi te pidió que revisaras el campamento para ver si podían evitar cualquier desastre causado por el volcán."
		},
		Summary = ""
	},
	[2123] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Responde las preguntas del coronel Vito para la primera parte del entrenamiento de soldado."
		},
		Summary = ""
	},
	[2124] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Antes de pasar a la siguiente parte del entrenamiento, el coronel Vito te ha enviado a inspeccionar las máquinas en la zona de tuberías al norte del edificio."
		},
		Summary = ""
	},
	[2125] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Encontró un panel de control que parece funcionar sin problemas. Informe al coronel Vito que todo parece estar en orden."
		},
		Summary = ""
	},
	[2126] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Para el segundo ejercicio de entrenamiento, el coronel Vito pidió cortar el muñeco de práctica 10 veces."
		},
		Summary = ""
	},
	[2127] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Parece que has terminado con el entrenamiento. Ahora que eres reconocido como soldado deberías poder investigar más libremente."
		},
		Summary = ""
	},
	[2128] = {
		Title = "Campamento base del volcán Thor",
		Description = {
			"Usted fue testigo de cómo la gente llevaba cajas con el sello de la República de Schwaltzvalt. Estos deben ser los suministros militares para el campamento. Regresa con Sahedi e infórmale del estado actual del volcán."
		},
		Summary = "Sahedí"
	},
	[2129] = {
		Title = "Para Arunafeltz",
		Description = {
			"Inicio: NPC: Foreign Merchant en Ubicacion: moc_ruins (77, 167). Un comerciante que viene de un país extranjero siente dolor por una bebida que vende un comerciante que aparece en Oasis."
		},
		Summary = "Encuentra un comerciante que venda bebidas alrededor de Oasis."
	},
	[2130] = {
		Title = "Para Arunafeltz",
		Description = {
			"Conseguiste una bebida muy conocida y decidiste volver con un comerciante que conociste al principio."
		},
		Summary = "Hablar con comerciante extranjero"
	},
	[2131] = {
		Title = "Para Arunafeltz",
		Description = {
			"Recibiste el telegrama de Zhed de un comerciante extranjero."
		},
		Summary = "Habla con el Sumo Sacerdote Zhed de Raquel"
	},
	[2132] = {
		Title = "Para Arunafeltz",
		Description = {
			"El Sumo Sacerdote Zhed dijo que necesita la ayuda de Niren para tomar prestado el poder de un Papa."
		},
		Summary = "Habla con la suma sacerdotisa Niren"
	},
	[2133] = {
		Title = "Para Arunafeltz",
		Description = {
			"Niren expresó su fuerte desconfianza hacia el Sumo Sacerdote."
		},
		Summary = "Volver a Zhed"
	},
	[2134] = {
		Title = "Para Arunafeltz",
		Description = {
			"Recibiste una carta de Jed para Niren."
		},
		Summary = "Entrega la carta de Zhed a Niren."
	},
	[2135] = {
		Title = "Para Arunafeltz",
		Description = {
			"Niren exige reunirse con un Papa y investigar detenidamente la información sobre un funcionario recién nombrado."
		},
		Summary = "hablar con el papa"
	},
	[2136] = {
		Title = "Para Arunafeltz",
		Description = {
			"El Papa, que no ha visto a su familia durante mucho tiempo, se sintió afligido por los funcionarios recién nombrados que se preocupaban de que el Papa no pudiera ver a su familia durante mucho tiempo."
		},
		Summary = "Volver a Niren"
	},
	[2137] = {
		Title = "Para Arunafeltz",
		Description = {
			"Niren entrega los documentos y pide que se los entreguen a Ismael, que vive en un pueblo nativo del norte."
