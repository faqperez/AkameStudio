	},
	[14646] = {
		Title = "Tengo salsa para usar hoy",
		Description = {
			"Aún queda mucha salsa. Descansa hoy y mañana te lo volveré a pedir."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14647] = {
		Title = "¾óÀ½ Á¶°¢",
		Description = {
			"³ìÁö ¾Ê´Â ¾óÀ½ Á¶°¢ÀÌ ÇÊ¿äÇØ. ¹\"½¼ ¸\"ÀÎÁö ¾ËÁö? ¾óÀ½ Á¶°¢ ¸\"ÀÌ¾ß. 10°³ Á¤µµ¸é ¿À´Ã ¾µ Á¤µµ´Â µÉ °Í °°¾Æ. ±×.³ ºÎÅ¹ÇØ!"
