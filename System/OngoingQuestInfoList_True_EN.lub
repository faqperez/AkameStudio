	[9000] = {
		Title = "Cambio de trabajo a Caballero",
		Description = {
			"Inicio: NPC: Chivalry Captain en Ubicacion: prt_in (88, 101). El Capitán de Caballería \"Herman\" dice que necesitas la aprobación de otros Caballeros para poder convertirte en Caballero."
		},
		Summary = "Habla con otros miembros de Chivalry."
	},
	[9001] = {
		Title = "Lealtad de un caballero",
		Description = {
			"¡La primera prueba de Sir Andrew! Trae 5 de cada bigote de duende anciano, ala de murciélago rojo, vale orco, polvo de polilla, lengua de reptil y melena."
		},
		Summary = "Trae los materiales requeridos."
	},
	[9002] = {
		Title = "Lealtad de un caballero",
		Description = {
			"¡La primera prueba de Sir Andrew! Trae 5 de cada pata de insecto, corazón de sirena, flor devoradora de hombres, carne de almeja, sartén vieja y concha de caracol."
		},
		Summary = "Trae los materiales requeridos."
	},
	[9003] = {
		Title = "El honor de un caballero",
		Description = {
			"\"Sir Andrew\" te dice que visites a Sir Siracuse para continuar con las pruebas."
		},
		Summary = "Habla con Sir Siracusa"
	},
	[9004] = {
		Title = "El honor de un caballero",
		Description = {
			"\"James Siracuse\" te dice que visites a Sir Windsor para continuar con las pruebas."
		},
		Summary = "Habla con Sir Windsor"
	},
	[9005] = {
		Title = "Tenacidad de un caballero",
		Description = {
			"\"Sir Windsor\" sólo te ordena que lo sigas...."
		},
		Summary = "Habla con Sir Windsor"
	},
	[9006] = {
		Title = "Tenacidad de un caballero",
		Description = {
			"\"Sir Windsor\" nunca habla mucho. Te ordena derrotar a todos los monstruos dentro de la sala de pruebas."
		},
		Summary = "Derrota a todos los monstruos en 3 minutos."
	},
	[9007] = {
		Title = "El honor de un caballero",
		Description = {
			"\"Sir Windsor\" le dice que visite a \"Amy Beatrice\" para la próxima prueba."
		},
		Summary = "Habla con Amy Beatriz"
	},
	[9008] = {
		Title = "Etiqueta como caballero",
		Description = {
			"\"Amy\", una orgullosa Dama Caballero de la Caballería de Prontera, te dice que respondas sus preguntas como Caballero."
		},
		Summary = "Habla con Amy Beatriz"
	},
	[9009] = {
		Title = "La vida como un caballero",
		Description = {
			"\"Amy Beatrice\" te dice que visites a \"Sir Edmond\" para la próxima prueba."
		},
		Summary = "Habla con Sir Edmond"
	},
	[9010] = {
		Title = "Calidad de reverencia",
		Description = {
			"\"Sir Edmond\" le da consejos sobre la actitud mental y le dice que tenga paciencia."
		},
		Summary = "Meditación"
	},
	[9011] = {
		Title = "La vida como un caballero",
		Description = {
			"\"Sir Edmond\" te dice que busques a \"Sir Gray\" para la prueba final."
		},
		Summary = "Habla con Sir Gray"
	},
	[9012] = {
		Title = "¡Gloria de un Caballero!",
		Description = {
			"'Sir Gray' te dice que cambies de trabajo y veas al capitán, ya que has hablado con todos los demás miembros. ¡Finalmente es el momento de convertirse en Caballero!"
		},
		Summary = "Habla con el Capitán Herman"
	},
	[9013] = {
		Title = "Cambio de trabajo al asistente",
		Description = {
			"Inicio: NPC: Wizard Guildsman en Ubicacion: gef_tower (111, 37). La primera prueba de Catherine, Wizard Guildman, es recolectar piedras preciosas. Recoge 3 de cada piedra preciosa roja, azul y amarilla."
		},
		Summary = "Trae los materiales requeridos."
	},
	[9014] = {
		Title = "Cambio de trabajo al asistente",
		Description = {
			"Inicio: NPC: Wizard Guildsman en Ubicacion: gef_tower (111, 37). La primera prueba de Catherine, Wizard Guildman, es reunir algunas piedras de propiedad. Recoge 5 de cada \"Crystal Blue\", \"Green Live\", \"Red Blood\" y \"Wind of Verdure\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[9015] = {
		Title = "Cambio de trabajo al asistente",
		Description = {
			"Inicio: NPC: Wizard Guildsman en Ubicacion: gef_tower (111, 37). Pasaste la primera prueba de \"Catherine\". Ella dice que deberías ir a ver al Mago Sombrío."
		},
		Summary = "Encuentra y habla con Gloomy Wizard"
	},
	[9016] = {
		Title = "Cambio de trabajo al asistente",
		Description = {
			"El segundo paso de la prueba de Cambio de Trabajo es dar respuestas correctas a las preguntas de \"Raulel\"."
		},
		Summary = "Habla con Raulel"
	},
	[9017] = {
		Title = "Cambio de trabajo al asistente",
		Description = {
			"La tercera etapa de la prueba de cambio de trabajo consiste en comprender 3 propiedades diferentes de Magic."
		},
		Summary = "Prueba práctica utilizando 3 propiedades diferentes."
	},
	[9018] = {
		Title = "¡Certificado como Mago!",
		Description = {
			"Has superado todas las pruebas que te ha dado \"Raulel\". ¡Habla con Catherine para la última parte de la prueba!"
		},
		Summary = "Habla con 1Catherine"
	},
	[9024] = {
		Title = "Un chico de los recados de Einbroch",
		Description = {
			"Ayuda al mandadero que viene a Prontera desde Einbroch en busca de gelatina."
		},
		Summary = "Recoge 100 gelatinas y vuelve con el hombre de los recados."
	},
	[9028] = {
		Title = "Hidra extraña",
		Description = {
			"Inicio: NPC: Lucia en Ubicacion: brasilis (192, 133). La extraña Hidra ha aparecido en ^8B4513Brasilis^000000. Usa la ^006400Hydra Ball^000000 de Lucia para capturar una ^FF0000Strange Hydra^000000."
