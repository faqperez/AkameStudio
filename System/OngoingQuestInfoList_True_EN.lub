			"Inicio: NPC: Wandering Bard en Ubicacion: verus03 (129, 21). Wandering Bard no tiene historias que contarte por el momento. Vuelve con él mañana."
		},
		Summary = "Inicializado a las 04:00"
	},
	[4297] = {
		Title = "La historia de Bard: alguna corporación",
		Description = {
			"Investiga la historia sobre la corporación con sede en Lighthalzen y luego regresa con el Bardo. Un hombre llamado Fishburne en el barrio pobre sabrá algo."
		},
		Summary = ""
	},
	[4298] = {
		Title = "La historia de Bard: el presidente",
		Description = {
			"¿Qué pasa con el presidente? El hombre común podría decirte algo."
		},
		Summary = ""
	},
	[4299] = {
		Title = "La historia de Bardo: un erudito en Juno",
		Description = {
			"Un erudito en Juno estudia las reliquias de Juperos. Ve a hablar con el erudito."
		},
		Summary = ""
	},
	[4300] = {
		Title = "La historia de Bard: un científico loco",
		Description = {
			"Hay un científico loco en Juno. Ve a comprobar si los rumores sobre él son ciertos."
		},
		Summary = ""
	},
	[4301] = {
		Title = "La historia de Bardo: Hugel",
		Description = {
			"Alguien en Hugel necesita tu ayuda. Ve a hablar con él."
		},
		Summary = ""
	},
	[4302] = {
		Title = "La historia del bardo: el templo de Odín",
		Description = {
			"Solicite la excavación del Templo de Odin. Algo está pasando en el sitio de excavación."
		},
		Summary = ""
	},
