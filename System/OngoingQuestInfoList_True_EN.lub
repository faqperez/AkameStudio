	},
	[12335] = {
		Title = "Distorsión espacial",
		Description = {
			"Hugin ha distorsionado el espacio dentro de Glast Heim (Avanzado). Quién sabe qué cosas extrañas pueden pasar dentro del castillo."
		},
		Summary = "Distorsión espacial"
