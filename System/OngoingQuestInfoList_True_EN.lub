	[14373] = {
		Title = "Encontrar escultor",
		Description = {
			"Mi esposa quiere que le haga una estatua pero el escultor no quiere recibirme. Por favor, conócelo a él en lugar de a mí. si también tú eres rechazado por él, busca su aprendiz."
		},
		Summary = ""
	},
	[14374] = {
		Title = "Volver al escultor",
		Description = {
			"¡El aprendiz te dijo que escuchó a su maestro hablar solo!"
		},
		Summary = "al escultor"
	},
	[14375] = {
		Title = "Encuentra al alquimista",
		Description = {
			"¡El escultor dice que tal vez un alquimista pueda ayudar a convertir la piedra en carne! Escuchó de uno alrededor del campo 3 de Mjolnir."
		},
		Summary = "al alquimista"
	},
	[14376] = {
		Title = "Encuentra al monje",
		Description = {
			"El Alquimista dijo que un monje podría ayudarte a darle vida a la piedra y que podría estar al este de Prontera."
		},
		Summary = ""
	},
	[14377] = {
		Title = "Encuentra al sacerdote oscuro",
		Description = {
			"Encuentra un sacerdote oscuro en el cementerio de Glastheim."
		},
		Summary = "Encuentra un sacerdote oscuro maldito"
	},
	[14378] = {
		Title = "volver a mario",
		Description = {
			"Pregúntale al escultor Mario hasta dónde está dispuesto a llegar para que su estatua de María cobre vida."
		},
		Summary = ""
	},
	[14379] = {
		Title = "estoy listo",
		Description = {
			"Mario está decidido a hacer lo que sea necesario para darle vida a su amada estatua de María."
		},
		Summary = "regresa con el Sacerdote Oscuro en Glastheim"
	},
	[14380] = {
		Title = "Ofrendas rituales",
		Description = {
			"3 semillas de Yggdrasil, 44 corazones inmortales, 1 rubí maldito y 3 migas de estrellas"
		},
		Summary = "Obtenga las ofertas requeridas"
	},
	[14381] = {
		Title = "De vuelta al escultor",
		Description = {
			"Lleva las ofrendas al escultor en Marruecos."
		},
		Summary = "al escultor"
	},
	[14382] = {
		Title = "algo anda mal",
		Description = {
			"¡Algo debe estar mal! ¡El hechizo no fue efectivo a pesar de que todas las ofrendas estaban allí!"
		},
		Summary = "Regreso al Sacerdote Oscuro"
	},
	[14383] = {
		Title = "Más ofrendas rituales",
		Description = {
			"Falta alguna parte de la oferta. 3 Agua Maldita, 3 Agua Bendita y 1 Chocolate Artesanal. Llévalos a la estatua y haz el ritual nuevamente, ¡esta vez funcionará!"
		},
		Summary = "Encuentra más ofertas"
	},
	[14384] = {
		Title = "piedra blanda",
		Description = {
			"Ahora necesitas piedras blandas. Puedes encontrarlos después de derrotar a Stalactic Golems."
		},
		Summary = "Recupera 30 piedras blandas"
	},
	[14385] = {
		Title = "piedra blanda",
		Description = {
			"Ahora necesitas piedras blandas. Puedes encontrarlos después de derrotar a Bradium Golems."
		},
		Summary = "Recupera 30 piedras blandas"
	},
	[14386] = {
		Title = "24 horas",
		Description = {
			"Tengo suficiente material para hoy, por favor vuelve más tarde."
		},
		Summary = "temporizador de 24 horas"
	},
	[14387] = {
		Title = "Cuida mi cariño",
		Description = {
			"Mi amor dijo que está preparando un evento de propuesta y eso me pone nerviosa. ¿Puedes controlarlo? Está en Geffen."
		},
		Summary = "Buscando a Hans"
	},
	[14388] = {
		Title = "Florista legendario",
		Description = {
			"Eh... Escuché que hay un florista legendario en el área de Marruecos... ¿Puedes controlarlo? No ha respondido ninguno de mis mensajes."
		},
		Summary = "Encuentra el florista legendario"
	},
	[14389] = {
		Title = "¿Sin agua?",
		Description = {
			"Humm... esto es extraño... el agua no corre. Es crucial hacer crecer mis flores. ¿Quieres conocer al director de las instalaciones de agua en Marruecos? Y el fertilizante aún no llegó aquí. visite Payon una vez."
		},
		Summary = ""
	},
	[14390] = {
		Title = "Problema desconocido",
		Description = {
			"Ah, también me preguntaba qué pasó porque pensé que los ingenieros terminarían en un día, pero aún no está terminado, encuéntrelos en el Oasis de Marruecos."
		},
		Summary = "Encuentra a los ingenieros"
	},
	[14391] = {
		Title = "Necesito fertilizante",
		Description = {
			"Aunque el proceso fue lento, se realizará según lo previsto. Ahora toca buscar abono en Payón"
		},
		Summary = "A la fábrica de fertilizantes"
	},
	[14392] = {
		Title = "al florista",
		Description = {
			"No hay nada que puedas hacer. Conviene visitar a la floristería para informarle de esta situación."
		},
		Summary = "al florista"
	},
	[14393] = {
		Title = "emparejamiento - Marruecos",
		Description = {
			"¿Por qué no eres casamentero? Trae una bebida de chocolate, sería útil."
		},
		Summary = "Jugar casamentero"
	},
	[14394] = {
		Title = "emparejamiento - Geffen",
		Description = {
			"¿Por qué no eres casamentero? Trae una bebida de chocolate, sería útil."
		},
		Summary = "Jugar casamentero"
	},
	[14395] = {
		Title = "al florista",
		Description = {
			"¡¡Éxito en el emparejamiento!! ¡Visita al florista y consigue una semilla de él!"
		},
		Summary = "al florista"
	},
	[14396] = {
		Title = "tengo una semilla",
		Description = {
			"Volvamos a Hans con la semilla."
		},
		Summary = "A Geffen"
	},
	[14397] = {
		Title = "Hasta Al de Baran",
		Description = {
			"Volvamos a Al de Baran para informarle que la preparación de Hans estuvo bien."
		},
		Summary = "Hasta Al de Baran"
	},
	[14398] = {
		Title = "A Geffen",
		Description = {
			"¿La propuesta sería exitosa con una flor en flor? Debería visitarlo una vez más para comprobarlo."
		},
		Summary = "A Geffen"
	},
	[14399] = {
		Title = "Fertilizante extraño",
		Description = {
			"Para poder cultivar estas flores especiales necesito el mejor fertilizante natural. Puedes conseguirlo cazando monstruos Sasquatch en Lutie."
		},
		Summary = "30 fertilizantes naturales"
	},
	[14400] = {
		Title = "Fertilizante extraño",
		Description = {
			"Para poder cultivar estas flores especiales necesito el mejor fertilizante natural. Puedes conseguirlo cazando monstruos Tatacho en Ash Vacuum."
		},
		Summary = "30 fertilizantes naturales"
	},
	[14401] = {
		Title = "24 horas",
		Description = {
			"Tengo suficiente fertilizante para hoy. Por favor vuelve más tarde."
		},
		Summary = "Retraso - 24 horas"
	},
	[14402] = {
		Title = "Reuniendo chocoins",
		Description = {
			"Bitta nerviosa. Está luchando por recordar Chocoins. Recoge Chocoins derrotando a Chocos."
		},
		Summary = "Lleva chocoins a Bitta en Einbroch"
	},
