	[1194] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Recoge 10 piezas de tela roja atrapando calcetines de mapache, hurra al equipo en el campo."
		},
		Summary = "Habla con \"Quercus\", miembro del equipo Raccoon Hurray en la plaza Prontera"
	},
	[1195] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Es hora de considerar qué es un calcetín como almacén para el regalo. Encuentra a Castanea, el mapache que está ocupado con las citas en la plaza Geffen."
		},
		Summary = "Habla con \"Castanea\", miembro del equipo Raccoon Hurray en la plaza Geffen"
	},
	[1196] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Puestos callejeros al final de East Geffen. Encuentra el regalo en la esquina de Ghez (mujer joven) detrás."
		},
		Summary = "Puestos callejeros al final de East Geffen. Cerca del mapache, \"Bean\""
	},
	[1197] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Descubrí el regalo, calcetines a rayas. Volvamos a Castanea."
		},
		Summary = "Habla con \"Castanea\", miembro del equipo Raccoon Hurray en la plaza Geffen"
	},
	[1198] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
