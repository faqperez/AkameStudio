	[11070] = {
		Title = "Rey Veneno",
		Description = {
			"Inicio: NPC: Poison King en Ubicacion: lou_in02 (123, 39). ¿Por qué quieres aprender sobre esto? Incluso si quisiera enseñar, soy demasiado mayor para recordarlo todo. Ve a buscar a mi último discípulo, ^0000FF'Song Zhi Du'^000000, ya que puede decirte algo útil."
		},
		Summary = "Encuentra a Song Zhi Du trabajando en el consultorio del médico y pregúntale sobre el uso de veneno."
	},
	[11071] = {
		Title = "Rey Veneno",
		Description = {
			"Ve a hacer lo que fuera que ibas a hacer. Simplemente estoy decepcionado..."
		},
		Summary = "Song Zhi Du parece estar enojado ahora. Puede hacerlo sentir mejor llevándole algo."
	},
	[11072] = {
		Title = "Rey Veneno",
		Description = {
			"¡Si realmente sientes lástima por mí, entonces debes ayudarme a llevar a cabo mi venganza! Ve a buscarme, ^0000FF4 Bee Sting, 10 Venom Canine, 10 Vacuum Potion, 30 Green Potion^000000."
		},
		Summary = "Regrese a Song Zhi Du con los materiales que pidió."
	},
	[11073] = {
		Title = "Rey Veneno",
		Description = {
			"Todo lo que queda es crear este veneno y luego conseguir que el señor de Louyang lo beba..."
		},
		Summary = "Habla con él nuevamente y escucha la historia, luego hazle el favor a Song Zhi Du."
	},
	[11074] = {
		Title = "Rey Veneno",
		Description = {
			"Ahora que la tarifa está pagada, llévele esto a Song Zhi Du."
		},
		Summary = "Has obtenido el material. Volver a Song Zhi Du"
	},
	[11075] = {
		Title = "Rey Veneno",
		Description = {
			"¡¡No!! ¡Fallé de nuevo! Y pasé mucho tiempo preparando todos esos materiales..."
		},
		Summary = "Se necesitan más materiales"
	},
	[11076] = {
		Title = "Rey Veneno",
		Description = {
			"Por favor, entra sigilosamente en el Castillo del Dragón. Quiero que pongas este veneno en algún lugar donde Lord Bai Long pueda quedarse. De todos modos, estoy seguro de que mi maestro estará feliz de saber que finalmente creé el ^0000FFveneno que él deseaba crear^000000."
		},
		Summary = "¿Qué debo hacer?"
	},
	[11077] = {
		Title = "Rey Veneno",
		Description = {
			"Encontraste una botella de bebida que posiblemente sea propiedad de Bai Long, señor de Louyang. Pones el veneno mortal en la botella."
		},
		Summary = "Has hecho lo que pidió Song Zhi Du. volvamos"
	},
	[11078] = {
		Title = "Rey Veneno",
		Description = {
			"Le cuentas a Nagash Asses cómo Song Zhi Du creó esta botella de veneno mortal y su plan para vengarse del señor de Louyang."
		},
		Summary = "Parece que necesita algo de tiempo a solas."
	},
	[11079] = {
		Title = "Rey Veneno",
		Description = {
			"Te lo ruego. Por favor, no dejes que le cause ningún daño al señor. Estoy bastante seguro de que te ha estado pidiendo ayuda a ti y a otros... Por favor, interrumpe que lleve a cabo su plan."
		},
		Summary = "Deshazte de la botella de bebida de Bai Long."
	},
	[11080] = {
		Title = "Rey Veneno",
		Description = {
			"Tomas la botella de bebida y la reemplazas con una botella llena de Sticky Mucus. ¡Ojalá Bai Long no se dé cuenta!"
		},
		Summary = "¡Reemplazo exitoso! Volver a los culos de Nagash"
	},
	[11081] = {
		Title = "Rey Veneno",
		Description = {
			"Este es un diario que he estado escribiendo durante 15 años sobre mis sentimientos de culpa y lo que realmente sucedió en el pasado. Espero que puedas entregarle esto al señor de mi parte."
		},
		Summary = "Entrega el diario de Nagash Arses al señor."
	},
	[11082] = {
		Title = "Rey Veneno",
		Description = {
			"Por favor, tómalo como muestra de gratitud. Y por favor, entrega esta carta a Nagash y Song Zhi Du de mi parte."
		},
		Summary = "Diario entregado. Entregar la carta a Nagash."
	},
	[11083] = {
		Title = "Rey Veneno",
		Description = {
			".....Oh~ ¡gracias, muchas gracias!"
		},
		Summary = "Nagash Asses parece estar satisfecho. Cuéntale la noticia a Song Zhi Du."
	},
	[11084] = {
		Title = "Nuevo entorno",
		Description = {
			"Inicio: NPC: Marian en Ubicacion: mid_camp (222, 283). Familiarícese con su nuevo entorno hablando con el instructor Lugen. Él te ayudará a adaptarte."
		},
		Summary = "Conoce al instructor Lugen"
	},
	[11085] = {
		Title = "Nuevo entorno",
		Description = {
			"Debes registrarte para el equipo de encuesta con la recepcionista dentro del gran edificio en el centro del campamento."
		},
		Summary = "Reunirse con la recepcionista"
	},
	[11086] = {
		Title = "Nuevo entorno",
		Description = {
			"Sólo puedes asumir que has sido registrado con alguna que otra recepcionista."
		},
		Summary = "Volver al Instructor Lugen"
	},
	[11087] = {
		Title = "Reparación de la tienda",
		Description = {
			"Inicio: NPC: Receptionist Brink en Ubicacion: mid_campin (106, 122). Has aceptado ayudar a Diego a arreglar su tienda consiguiendo materiales que pueda usar como poste y cuerda para atarlo."
		},
		Summary = "20 ramas ordinarias y 20 vides fuertes"
	},
	[11088] = {
		Title = "Reparación de la tienda",
		Description = {
			"Diego sostiene el poste improvisado de su tienda y lucha por mantenerlo recto. Deberías ayudarlo con ramas y vides."
		},
		Summary = ""
	},
	[11089] = {
		Title = "Reparación de la tienda",
		Description = {
			"Este poste parece aguantar su peso. Entonces deberías ayudar con la otra publicación."
		},
		Summary = ""
	},
	[11090] = {
		Title = "Reparación de la tienda",
		Description = {
			"¡Todos los postes rotos están reparados! Deberías hablar con Diego ahora."
		},
		Summary = ""
	},
	[11091] = {
		Title = "Entrega de suministros",
		Description = {
			"Inicio: NPC: Instructor en Ubicacion: mid_camp (261, 284). Habla con Marian para recibir los suministros del continente que el instructor Lugen te ha pedido que distribuyas."
		},
		Summary = "mariano"
	},
	[11092] = {
		Title = "Entrega de suministros",
		Description = {
			"Marian te ha dado 3 cajas de suministros, regresa a Lugen y descubre dónde debes entregarlas."
		},
		Summary = "lugen"
	},
	[11093] = {
		Title = "Entrega de suministros",
		Description = {
			"Lugen dice que le entregue la primera caja a Jan, que está en el extremo noroeste del campamento, cerca de la valla."
		},
		Summary = "Entrega la primera caja de suministros a Jan."
	},
	[11094] = {
		Title = "Entrega de suministros",
		Description = {
			"Le entregaste la primera caja de suministros a Jan. Vuelve con el instructor Lugen."
		},
		Summary = "lugen"
	},
	[11095] = {
		Title = "Entrega de suministros",
		Description = {
			"Entrega la segunda caja de suministros a Gerard a través del puente oeste fuera del campamento."
		},
		Summary = "Entrega la segunda caja de suministros a Gerard."
	},
	[11096] = {
		Title = "Entrega de suministros",
		Description = {
			"Le entregaste la segunda caja de suministros a Gerard. Vuelve con el instructor Lugen."
		},
		Summary = "lugen"
	},
	[11097] = {
		Title = "Entrega de suministros",
		Description = {
			"Entrega la última caja de suministros a Alberto que está en la entrada del campo este."
		},
		Summary = "Entrega la última caja de suministros a Alberto."
	},
	[11098] = {
		Title = "Entrega de suministros",
		Description = {
			"Le entregaste la última caja de suministros a Alberto. Vuelve con el instructor Lugen."
		},
		Summary = "lugen"
	},
	[11099] = {
		Title = "A mi amigo¡¦",
		Description = {
			"Inicio: NPC: Instructor en Ubicacion: mid_camp (261, 284). Lugen te pidió que le entregaras una carta a su amigo Otto, que está trabajando en la barrera del oeste."
		},
		Summary = "Otón"
	},
	[11100] = {
		Title = "A mi amigo¡¦",
		Description = {
			"Otto te pidió que le llevaras su carta a Lugen y le dijeras que lo visitará cuando tenga sus próximas vacaciones."
		},
		Summary = "lugen"
	},
	[11101] = {
		Title = "Nota secreta de Bazett",
		Description = {
			"Inicio: NPC: Bazett Teablack en Ubicacion: mid_camp (283, 198). Ayuda a Bazett a realizar estudios sobre las hadas y los gigantes buscando señales de su existencia."
		},
		Summary = ""
	},
	[11102] = {
		Title = "Nota secreta de Bazet",
		Description = {
			"Investiga a los gigantes."
		},
		Summary = "Envíe la nota después de investigar."
	},
	[11103] = {
		Title = "Nota secreta de Bazett",
		Description = {
			""
		},
		Summary = ""
	},
	[11104] = {
		Title = "tiempo de descanso",
		Description = {
			"Inicio: NPC: Bazett Teablack en Ubicacion: mid_camp (283, 198). ¡La investigación está hecha! Será mejor que descanses un poco antes de la próxima investigación."
		},
		Summary = "solo descansa"
	},
	[11105] = {
		Title = "Cuerno de Hillslion",
		Description = {
			"Inicio: NPC: Worker en Ubicacion: manuk (193, 135). Necesito algo para arreglar la tienda, si puedes conseguir^0000FF 30 Horn of Hillslion^000000, puedo convertirlos en tornillos lo suficientemente resistentes."
		},
		Summary = "30 Cuerno de Hillslion"
	},
	[11106] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Inicio: NPC: Guild Master en Ubicacion: spl_in02 (80, 108). Habla con el asistente con cola de caballo."
		},
		Summary = ""
	},
	[11107] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Encuentra un ^000077Cristal brillante^000000 y ^000077Fragmento de bradio gigante^000000. Debes equipar las Piedras Mágicas mientras cazas Naga y Bradium Golems para conseguirlas."
		},
		Summary = "Llévalos al laboratorio de Yoop que está en la parte noroeste de Splendide."
	},
	[11108] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Vuelve con la Maestra Egnoloria mientras Yoop fabrica la piedra mágica. Tiene que haber una de esas distorsiones en algún lugar de Splendide para volver con ella."
		},
		Summary = "Habla con la Maestra Egnoloria"
	},
	[11109] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Habla con Yoop y síguelo hasta la habitación mágica."
		},
		Summary = ""
	},
	[11110] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Cuando estés listo, ve a la sala de espera para que te envíen a la Cámara de la Magia. Usa los Rainbow Rubies para ayudar a sobrevivir a los monstruos en la Cámara."
		},
		Summary = ""
	},
	[11111] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Has cristalizado con éxito la piedra hueca con suficiente poder mágico. Habla con el asistente de pelo morado para completar tu prueba."
		},
		Summary = ""
	},
	[11112] = {
		Title = "Cambio de trabajo a brujo",
		Description = {
			"Ya has terminado con todas las pruebas. Ahora puedes volverte más poderoso convirtiéndote en brujo."
		},
		Summary = "Habla con la Maestra Egnoloria para convertirte en un brujo."
	},
	[11113] = {
		Title = "Hasta que el radering esté funcionando",
		Description = {
			"Creo que radering no funciona. Es mejor esperar más."
		},
		Summary = "tal vez será mañana?"
	},
	[11114] = {
		Title = "Caza de Hornet",
		Description = {
			"[Tablón de Misiones (Nv. 11 - 25)] Requisitos: Nivel Base: 11+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 20 Hornet al sur de Prontera."
		},
		Summary = "Caza 20 Hornet"
	},
	[11115] = {
		Title = "Caza de Condor",
		Description = {
			"[Tablón de Misiones (Nv. 11 - 25)] Requisitos: Nivel Base: 11+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 20 Condor en el desierto de Morocc."
		},
		Summary = "Caza 20 Condor"
	},
	[11116] = {
		Title = "Patas de Saltamontes",
		Description = {
