	[5727] = {
		Title = "Una tarea inesperada",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: rebel_in (78, 66). De repente apareció un hombre llamado Vero y te pidió que trabajaras con él. Dice que la salida está prevista después de las 4 de la mañana del día siguiente, así que una vez pasado el tiempo, ve a buscarlo."
		},
		Summary = ""
	},
	[5728] = {
		Title = "dolor de cabeza",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: rebel_in (78, 66). Vero parece tener dolor de cabeza por usar la cabeza, lo cual no suele hacer. Hagamos una pequeña pausa y empecemos de nuevo."
		},
		Summary = ""
	},
	[5729] = {
		Title = "Hasta Einbech",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: rebel_in (78, 66). Lleva el ^C33120objeto rebosante de energía del elemento Fuego^000000 al último vagón del tren de carga Einbech."
		},
		Summary = ""
	},
	[5730] = {
		Title = "Algo para destruir el dispositivo",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: einbech (212, 212). Parece que necesitas un objeto lleno de energía del elemento Agua para destruir el dispositivo. Dicen que uno no es suficiente, ¿traemos tres?"
		},
		Summary = ""
	},
	[5731] = {
		Title = "Al Klana Nemieli",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: einbech (212, 212). Destruiste el dispositivo en Einbech. Volvamos a Klana Nemieli por ahora."
		},
		Summary = ""
	},
	[5732] = {
		Title = "Hasta Lihitarzen",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: rebel_in (78, 66). El informante ha obtenido la información. La mansión Lihitarzen está rodeada de agua, así que trae 1 Mystic Frozen y 3 Rough Wind."
		},
		Summary = ""
	},
	[5733] = {
		Title = "Al Klana Nemieli",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: lighthalzen (135, 233). Destruiste el dispositivo en Lihitarzen. Volvamos a Klana Nemieli por ahora."
		},
		Summary = ""
	},
	[5734] = {
		Title = "El ingrediente clave es siempre el problema",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: rebel_in (78, 66). Pregunta con tanta descaro que es difícil negarse. Dice que puede repararlo de inmediato con solo 1 fragmento de estrella, así que busquemos uno."
		},
		Summary = ""
	},
	[5735] = {
		Title = "A Yuno",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: rebel_in (78, 66). Se han confirmado las coordenadas donde está instalado el dispositivo. Vero, lleva 4 Great Nature a Yuno en las coordenadas 206 224."
		},
		Summary = ""
	},
	[5736] = {
		Title = "Hasta Einbroch",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: yuno (204, 226). Vero parece apresurarse como si algo lo persiguiera. Trae 1 Gran Naturaleza y 3 Corazones de Llamas y dirígete a donde está el generador de energía eólica Einbroch."
		},
		Summary = ""
	},
	[5737] = {
		Title = "Al Klana Nemieli",
		Description = {
			"Inicio: NPC: Arivero Yurhik en Ubicacion: einbroch (262, 42). En el momento en que destruiste el dispositivo, Vero también desapareció repentinamente. ¿Volvemos a Klana Nemieli por ahora?"
		},
		Summary = ""
	},
