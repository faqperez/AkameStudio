	},
	[60921] = {
		Title = "Investigadores perplejos",
		Description = {
			"El agente York dice que un grupo de niños está en el Museo Brasilis investigando un crimen."
		},
		Summary = "Museo Brasilis (ubicación - suroeste de Brasilis)"
	},
	[60922] = {
		Title = "Anomalías LLC",
		Description = {
			"El grupo de investigadores dice que este misterio es el caso más difícil que han tenido."
		},
		Summary = "Continúe su conversación con Velmenna."
	},
	[60923] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"La señora Moneybags no ha salido de su habitación desde que ocurrió el asesinato. Encuéntrala en el hotel Brasilis."
		},
		Summary = "Vaya al Hotel Brasilis en la zona sureste de Brasilis."
	},
	[60924] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"La señora Moneybags dice que necesitas hablar con el curador jefe del museo."
		},
		Summary = "Encuentra al curador principal en el segundo piso del museo Brasilis."
	},
	[60925] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"El curador jefe dijo que el guardia de seguridad de turno está siendo interrogado abajo."
		},
		Summary = "Habla con el guardia de seguridad Sr. Herring."
	},
	[60926] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Red Herring dijo que al Sr. Moneybags le robaron un relicario que siempre llevaba alrededor del cuello."
		},
		Summary = "Informe sus hallazgos al grupo Anomalies LLC en el museo."
	},
	[60927] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Les ha dicho a los investigadores que Red Herring asesinó al Sr. Moneybags."
		},
		Summary = "Vuelve con Red y cuéntale tu acusación."
	},
	[60928] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Has decidido que necesitas encontrar más pistas antes de acusar a alguien todavía. La señora Moneybags podría tener alguna idea sobre el asesinato."
		},
		Summary = ""
	},
	[60929] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Red Herring culpa a Broddy por ser acusado del asesinato."
		},
		Summary = ""
	},
	[60930] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Una vez más has pillado a la señora Moneybags metiéndose algo en el bolsillo mientras entrabas..."
		},
		Summary = "Habla con la señora Moneybags"
	},
	[60931] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"La señora Moneybags está claramente angustiada. Es posible que los investigadores hayan encontrado pistas mientras usted no estaba."
		},
		Summary = "Habla con los niños investigadores en el museo."
	},
	[60932] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Parece que los niños encontraron un pasaje secreto al que no se puede acceder desde aquí. Será mejor que le preguntes a alguien que conozca más sobre el museo."
		},
		Summary = ""
	},
	[60933] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"El curador jefe dijo que al lado de la mansión hay una casa que perteneció a los antiguos dueños del museo."
		},
		Summary = "Encuentra la casa y derriba la puerta."
	},
	[60934] = {
		Title = "Misterio del asesinato del museo",
		Description = {
