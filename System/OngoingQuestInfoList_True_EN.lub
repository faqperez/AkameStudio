	[9267] = {
		Title = "La forma de ser un mago fuerte - 1",
		Description = {
			"Sal a la salida este de ^8B4513Geffen^000000 y caza 30 ^0000FFChonchons^000000, 30 ^0000F Pabres^000000. Vaya a la salida del campo en dirección a las 5 en punto y conozca a ^0000FMago asistente maestro^000000."
		},
		Summary = ""
	},
	[9268] = {
		Title = "La forma de ser un mago fuerte - 2",
		Description = {
			"Caza 30 ^0000FFRanas Roda^000000, 30 ^0000FSavage Bebes^000000. Vaya a la salida del campo en dirección a las 5 en punto y conozca al asistente ^0000FMage Master^000000."
		},
		Summary = ""
	},
	[9269] = {
		Title = "La manera de ser un mago fuerte - 3",
		Description = {
			"Vaya a la salida del campo en dirección a las 5 en punto y conozca a ^0000FMago asistente maestro^000000."
		},
		Summary = ""
	},
