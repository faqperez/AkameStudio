	},
	[9230] = {
		Title = "Incidente de robo misterioso 6",
		Description = {
			"Comenzar el examen de campo. Informe a Luen los hallazgos del examen de Poppy, el diario de Luen, un libro dañado, un recipiente para latas de refresco, una mesa desordenada y un objeto extraño tirado en el suelo."
		},
		Summary = ""
	},
	[9231] = {
		Title = "Incidente de robo misterioso 7",
		Description = {
