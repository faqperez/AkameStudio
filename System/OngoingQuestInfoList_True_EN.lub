	[12325] = {
		Title = "Efectos secundarios del nido del gusano facial",
		Description = {
			"Inicio: NPC: Interdimensional Device en Ubicacion: dali (72, 55). No puedes volver a ingresar al nido del Faceworm hasta que el cronómetro haya expirado."
		},
		Summary = ""
	},
	[12326] = {
		Title = "El dueño del viejo anillo.",
		Description = {
			"Inicio: NPC: An Old Woman en Ubicacion: payon (157, 54). Has descubierto al dueño del antiguo anillo."
		},
		Summary = ""
	},
	[12327] = {
		Title = "El recuerdo del viejo álbum de fotos.",
		Description = {
			"Inicio: NPC: Exotic Merchant en Ubicacion: payon (161, 54). El comerciante se alegrará si recibe el álbum de fotos. Busquemos otros álbumes de fotos que pueda haber perdido y se los llevemos."
		},
		Summary = ""
	},
	[12328] = {
		Title = "El dolor de Dol-Seoi",
		Description = {
			"Inicio: NPC: Strong Looking Man en Ubicacion: payon (161, 50). Dol-Seoi lloró cuando le diste las pastillas que encontraste. Trae otras pastillas si encuentras más en el nido del gusano facial."
		},
		Summary = ""
	},
	[12329] = {
		Title = "La pulsera de Keaton",
		Description = {
			"Inicio: NPC: A dreary man en Ubicacion: payon (139, 68). ¿Por qué esta alma no puede descansar en paz? Lleva todas las pulseras que encuentres en Faceworm's Nest a Keaton."
		},
		Summary = ""
	},
	[12330] = {
		Title = "Chica con cara de calavera",
		Description = {
			"Inicio: NPC: Catherine Jet Johnson en Ubicacion: xmas (237, 303). Escuché una historia de una chica con apariencia extraña."
		},
		Summary = "Chica con cara de calavera"
	},
	[12331] = {
		Title = "Sendero de la fábrica de juguetes",
		Description = {
			"Inicio: NPC: Factory Dimension Telep en Ubicacion: xmas (233, 305). Hay un rastro de entrada a la fábrica de juguetes. No se puede volver a ingresar durante 23 horas."
		},
		Summary = "Sendero de la fábrica de juguetes"
	},
