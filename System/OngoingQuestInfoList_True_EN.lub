	[14642] = {
		Title = "Trabajando duro en ello",
		Description = {
			"Todavía estoy haciendo souvenirs con lo que trajiste antes. Vuelve, descansa un poco y vuelve a buscarme."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14643] = {
		Title = "´Ü´ÜÇÑ Á¶°³\"ì",
		Description = {
