	[19118] = {
		Title = "El ojo del infierno",
		Description = {
			"Le dijiste a Grout'he lo que decía la losa debajo del piso de madera. Te dice que revises la enorme estatua de piedra en Archer Village al norte."
		},
		Summary = ""
	},
	[19119] = {
		Title = "El ojo del infierno",
		Description = {
			"Has obtenido una tableta Payon de la estatua de Buda. Deberías llevárselo a Chilias'Tyus en Marruecos."
		},
		Summary = ""
	},
	[19120] = {
		Title = "El ojo del infierno",
		Description = {
			"Has recibido una tableta Morocc. Chilias'Tyus dice que deberías viajar a Geffen y encontrar a un hombre llamado Welshyun."
		},
		Summary = ""
	},
	[19121] = {
		Title = "El ojo del infierno",
		Description = {
			"Welshyun te pidió que encontraras a su alumno Enoz en la torre Geffen. Asegúrate de que tenga el informe llamado \"Vida de monstruos en el área de Geffen\"."
		},
		Summary = ""
	},
	[19122] = {
		Title = "El ojo del infierno",
		Description = {
			"Puede que tu insulto no haya sido tan buena idea. Intenta hacer las paces con Welshyun."
		},
		Summary = ""
	},
	[19123] = {
		Title = "El ojo del infierno",
		Description = {
			"Welshyun dice que tiene sed. Tráele una poción y trata de secarle la garganta."
		},
		Summary = ""
	},
	[19124] = {
		Title = "El ojo del infierno",
		Description = {
			"Parece que Enoz ha perdido el libro Monster Life. Vuelve con Welshyun y cuéntaselo."
		},
		Summary = ""
	},
	[19125] = {
		Title = "El ojo del infierno",
		Description = {
			"Welshyun dice que debes entregarle el libro a Enoz en la torre Geffen y traer 1 piedra preciosa azul cuando regreses."
		},
		Summary = ""
	},
	[19126] = {
		Title = "El ojo del infierno",
		Description = {
			"Regresa con Welshyun y no olvides traer 1 piedra preciosa azul. Si te hace una pregunta extraña, respóndele \"Valaskjalf\"."
		},
		Summary = ""
	},
	[19127] = {
		Title = "El ojo del infierno",
		Description = {
			"Ha recibido una tableta Geffen. Lleva todas las tabletas a Sir Chilias'Tyus en Marruecos."
		},
		Summary = ""
	},
	[19128] = {
		Title = "El ojo del infierno",
		Description = {
			"Chilias'Tyus dice que Welshyun es el único que puede combinar las piezas de la tableta en su forma completa."
		},
		Summary = ""
	},
	[19129] = {
		Title = "El ojo del infierno",
		Description = {
			"Tienes la tableta completa. Llévaselo a Chilias'Tyus para que sepa que la tarea está completa."
		},
		Summary = ""
	},
	[19200] = {
		Title = "RPS con Troya",
		Description = {
			"Solo podrás desafiar a Troy una vez que el cronómetro haya expirado."
		},
		Summary = ""
	},
	[21001] = {
		Title = "Escape del naufragio",
		Description = {
			"Inicio: NPC: Wounded Swordsman en Ubicacion: iz_int (56, 32). Debes escapar del barco que naufragó en una isla tras una tormenta. Busca heridos que sigan a bordo."
		},
		Summary = "Habla con el capitán"
	},
	[21002] = {
		Title = "Primera batalla",
		Description = {
			"Inicio: NPC: Sailor en Ubicacion: int_land (58, 69). Encuentra materiales de reparación de barcos robados por Poring. La tripulación me pidió que trajera 2 piezas de madera. Derrota a Poring y recupera la madera."
		},
		Summary = "Entrega 2 piezas de madera a la tripulación."
	},
	[21003] = {
		Title = "La mejor medicina para el mareo",
		Description = {
			"Decido ayudar a Reno, un amigo que conocí mientras viajaba, encontrando algo para aliviar su mareo. Vamos a preguntarle ^4d4dff sobre medicina herbaria al terapeuta^000000 en la ^4d4dffCriatura Academy Clinic^000000."
		},
		Summary = "Pregunte sobre las medicinas herbarias al terapeuta."
	},
	[21004] = {
		Title = "Medicina herbaria básica",
		Description = {
			"El terapeuta te pide que encuentres el ingrediente de la poción, Red Herb. Encuentra ^4d4dffRed Plant^000000 en ^4d4dffPuerta principal de la academia Criatura^000000."
		},
		Summary = "Encuentra la Planta Roja fuera de la academia Criatura."
	},
	[21005] = {
		Title = "¡Guardar ubicación!",
		Description = {
			"Lo bueno que tengo."
		},
		Summary = ""
	},
	[21006] = {
		Title = "Buenas noticias para Reno",
		Description = {
			"Creo que le daré a Reno lo que me dio el terapeuta."
		},
		Summary = "hablar con reno"
	},
	[21007] = {
		Title = "mi primer amigo",
		Description = {
			"he encontrado un buen amigo"
		},
		Summary = ""
	},
	[21008] = {
		Title = "Primera batalla",
		Description = {
			"Inicio: NPC: Captain Carocc en Ubicacion: int_land (78, 103). Encuentra los materiales de reparación del barco que fueron robados por los Porings. La tripulación te pidió 2 piezas de Madera (Trunk / Lumber). Derrota a los Porings y recupera la madera."
		},
		Summary = "Entrega 2 piezas de Madera (Trunk / Lumber) a la tripulación"
	},
