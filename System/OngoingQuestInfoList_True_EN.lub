	[11555] = {
		Title = "En busca del sabor del hogar - Enfriamiento",
		Description = {
			"La olla está demasiado caliente para cocinar [Sopa de pastel de arroz con pulpo recién hervido]. Hagámoslo de nuevo mañana."
		},
		Summary = "Enfriamiento del caldero"
	},
	[11556] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Coughing young man en Ubicacion: einbroch (149, 242). Steven parece haber ido a la mina Einbech 1F. Vayamos a la mina Einbech 1F y busquemos rastros de Steven."
		},
		Summary = "A la mina Einbech 1F"
	},
	[11557] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Teddy Bear en Ubicacion: ein_dun01 (198, 79). El grito de un hombre se puede escuchar desde el principio de la fila. Revisemos la situación que se avecina."
		},
		Summary = "Al frente de la fila"
	},
	[11558] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Teddy Bear en Ubicacion: ein_dun01 (189, 85). Por alguna razón, el osito de peluche que estaba delante te dejó pasar. Entremos."
		},
		Summary = "en la mazmorra"
	},
	[11559] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Steven en Ubicacion: ein_d02_i (170, 193). Los ositos de peluche que sostenían a Steven se escaparon."
		},
		Summary = "hablar con steven"
	},
	[11560] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Coughing young man en Ubicacion: einbroch (149, 242). Steven está preocupado por la salud de San y te pide que le entregues las facturas del hospital. Volvamos a San en Einbroch."
		},
		Summary = "Hasta Einbroch"
	},
	[11561] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Coughing young man en Ubicacion: einbroch (149, 242). San está preocupado por Steven y dice que él mismo irá a la mina. Vayamos a la mina con San."
		},
		Summary = "De vuelta a la mina"
	},
	[11562] = {
		Title = "El desaparecido Steven",
		Description = {
			"Inicio: NPC: Steven en Ubicacion: ein_d02_i (170, 193). Steven dice que le parece escuchar un sonido extraño desde el norte. Dirigámonos al norte y comprobemos la fuente del sonido."
		},
		Summary = "al norte"
	},
	[11563] = {
		Title = "La conspiración de Nassarian",
		Description = {
			"Inicio: NPC: Steven en Ubicacion: ein_d02_i (170, 193). Nassarian alberga la ambición de gobernar esta tierra. Parece que han descubierto tu escondite, así que volvamos a la entrada."
		},
		Summary = "Habla con Steven en la entrada."
	},
	[11564] = {
		Title = "La conspiración de Nassarian",
		Description = {
			"Inicio: NPC: Steven en Ubicacion: ein_d02_i (170, 193). Fuiste descubierto mientras escuchabas la conversación de los Nassarianos. Mata a 10 de cada uno de los osos de peluche azules y blancos que te persiguen, luego habla con Steven en la entrada."
		},
		Summary = "Dirígete a la entrada mientras matas a los nassarianos."
	},
	[11565] = {
		Title = "¡¡¡Huye!!!!",
		Description = {
			"Inicio: NPC: Steven en Ubicacion: ein_d02_i (170, 193). A menos que estés acostumbrado a pelear, no será fácil para los fabricantes de muñecas salir de aquí. Por favor ayuda matando a 10 Pitmen de tipo laborioso, fragmentos de alma y obsidiana llena de rencor."
		},
		Summary = "10 Pitmen de tipo laborioso, fragmentos de alma y obsidiana llenos de rencor"
	},
	[11566] = {
		Title = "¡¡¡Huye!!!! - Enfriamiento",
		Description = {
			"Inicio: NPC: Steven en Ubicacion: ein_d02_i (170, 193). Has completado la misión diaria. Debes esperar hasta poder recibirlo nuevamente."
		},
		Summary = ""
	},
	[11567] = {
		Title = "Un ser que no debería existir",
		Description = {
			"Inicio: NPC: Gloomy Teddy Bear en Ubicacion: ein_d02_i (168, 206). ^ff0000Elimina alrededor de 10 osos de peluche rojos, osos de peluche amarillos y osos de peluche verdes^000000 y envíalos a las profundidades de la tierra... de regreso al reposo..."
		},
		Summary = "Mata a 10 de cada osito de peluche."
	},
	[11568] = {
		Title = "Un ser que no debería existir",
		Description = {
			"Inicio: NPC: Gloomy Teddy Bear en Ubicacion: ein_d02_i (168, 206). ^ff0000Elimina alrededor de 10 osos de peluche azules y osos de peluche blancos^000000 y envíalos a las profundidades de la tierra... de regreso al reposo..."
		},
		Summary = "Mata a 10 de cada osito de peluche."
	},
	[11569] = {
		Title = "Un ser que no debería existir - Enfriamiento",
		Description = {
			"Inicio: NPC: Gloomy Teddy Bear en Ubicacion: ein_d02_i (168, 206). Has completado la misión diaria. Debes esperar hasta poder recibirlo nuevamente."
		},
		Summary = ""
	},
	[11570] = {
		Title = "Que la luz se trague la oscuridad.",
		Description = {
			"Inicio: NPC: Porcelain Doll Craftsman en Ubicacion: ein_d02_i (191, 192). ¿No has visto cerca un enorme ^ff0000oso de peluche brillante^000000? Llegué hasta la entrada, pero cada vez que intento salir, esa cosa aparece, así que me he estado escondiendo aquí durante días."
		},
		Summary = "Elimina el osito de peluche resplandeciente"
	},
	[11571] = {
		Title = "Que la luz se trague la oscuridad. - Enfriamiento",
		Description = {
			"Inicio: NPC: Porcelain Doll Craftsman en Ubicacion: ein_d02_i (191, 192). Has completado la misión diaria. Debes esperar hasta poder recibirlo nuevamente."
		},
		Summary = ""
	},
