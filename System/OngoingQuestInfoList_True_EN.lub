	[16096] = {
		Title = "A la isla tortuga desconocida",
		Description = {
			"Inicio: NPC: Knight Aylvar en Ubicacion: alberta (211, 28). Mientras hablabas con Aylvar, terminaste en un lugar extraño. Hablemos con la chica frente a ti."
		},
		Summary = "habla con la chica"
	},
	[16097] = {
		Title = "Isla Tortuga Extraño 1",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). La chica te habló de varios lugares. Busquemos rastros del profesor Leiphen en Lonely Good Turtle Village."
		},
		Summary = "Encuentra a la persona en Lonely Good Turtle Village"
	},
	[16098] = {
		Title = "Isla Tortuga Extraño 2",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). La chica te habló de varios lugares. Busquemos rastros del profesor Leiphen en Lonely Good Turtle Village."
		},
		Summary = "Encuentra a la persona en Lonely Good Turtle Village"
	},
	[16099] = {
		Title = "Isla Tortuga Extraño 3",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). La chica te habló de varios lugares. Busquemos rastros del profesor Leiphen en el Gloomy Turtle Palace."
		},
		Summary = "Encuentra a la persona en el Gloomy Turtle Palace."
	},
	[16100] = {
		Title = "Isla Tortuga Extraño 4",
		Description = {
			"Inicio: NPC: Fragile Woman en Ubicacion: tur_d04_i (96, 112). Hay un lugar más del que te habló la chica. Busquemos rastros del profesor Leiphen en el Gloomy Turtle Palace."
		},
		Summary = "Encuentra a la persona en el Gloomy Turtle Palace."
	},
	[16101] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Archeologist Leiphen en Ubicacion: tur_d04_i (26, 167). Lleva la botella de vino culinario a Lecollane en la Academia Kiel Hyre al sureste de aquí."
		},
		Summary = ""
	},
	[16102] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Archeologist Leiphen en Ubicacion: tur_d04_i (26, 167). Elly podría necesitar ayuda. Habla con ella."
		},
		Summary = ""
	},
	[16103] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Archeologist Leiphen en Ubicacion: tur_d04_i (26, 167). Encuentra los ingredientes para las galletas de Elly. Puedes conseguir vino en un pub en Juno, cacaos en Yoyos y harina y huevos en el Toast Stand en Juno."
		},
		Summary = ""
	},
	[16104] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Fragile Woman en Ubicacion: tur_d04_i (96, 112). Ve con el propietario del molino de viento en los barrios bajos de Lighthalzen para conseguir harina y huevos para Cezu."
		},
		Summary = ""
	},
	[16105] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). Lleva el paquete de entrega a Cezu en Juno."
		},
		Summary = ""
	},
	[16106] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). Lleva el paquete de entrega a Elly en la Academia Kiel Hyre."
		},
		Summary = ""
	},
	[16107] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Archeologist Leiphen en Ubicacion: tur_d04_i (26, 167). Espera a que Elly termine de hornear las galletas."
		},
		Summary = ""
	},
	[16108] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). Llévale las galletas bien horneadas al abuelo de Elly en la cabaña de Kiel Hyre, un mapa al norte de la Academia."
		},
		Summary = ""
	},
	[16109] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Impatient Man en Ubicacion: tur_d03_i (80, 180). Vuelve con Elly y dile que su abuelo no está en la cabaña."
		},
		Summary = ""
	},
	[16110] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Impatient Man en Ubicacion: tur_d03_i (80, 180). Vuelve a la cabaña de Kiel Hyre. Elly te dio una llave de la cabaña que debería permitirte pasar por una puerta lateral."
		},
		Summary = ""
	},
	[16111] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Fragile Woman en Ubicacion: tur_d04_i (96, 112). Encuentra una nota doblada que dice \"6 adelante, 3 izquierda, 3 adelante, 4 izquierda\"."
		},
		Summary = ""
	},
	[16112] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Fragile Woman en Ubicacion: tur_d04_i (96, 112). Encontraste una dirección de carta para Elly. Será mejor que se lo devuelvas."
		},
		Summary = ""
	},
	[16113] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Fragile Woman en Ubicacion: tur_d04_i (96, 112). Continúe su conversación con Elly."
		},
		Summary = ""
	},
	[16114] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Knight Aylvar en Ubicacion: alberta (211, 28). Busca en el estudio de la cabaña señales de que el abuelo de Elly pudo haberle dejado. Ve al dormitorio detrás de la Academia Kiel Hyre cuando encuentres algo en la cabaña."
		},
		Summary = ""
	},
	[16115] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Portal en Ubicacion: tur_d03_i (132, 194). Encontraste una hoja de papel en blanco con el sello de la Fundación Kiel Hyre. Es extraño que haya un sello en un papel en blanco..."
		},
		Summary = ""
	},
	[16116] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). Has encontrado un poema extraño usando la tinta azul en el papel en blanco escrito por el ^0000ffpequeño diablo perdido^000000. ¿Qué podría significar?"
		},
		Summary = ""
	},
	[16117] = {
		Title = "Mapa del mundo misterioso",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: tur_d03_i (139, 186). Encuentra algo que te ayude a soltar el mapa de la pared."
		},
		Summary = ""
	},
	[16118] = {
		Title = "poema escondido",
		Description = {
			"Encontraste un trozo de papel detrás del mapa con un poema. Puede que también haya otras pistas escondidas por aquí."
		},
		Summary = ""
	},
	[16119] = {
		Title = "espadas de serpiente",
		Description = {
			"Al presionar el botón en la piscina, se escuchó un ruido metálico desde las escaleras del pasillo."
		},
		Summary = ""
	},
	[16120] = {
		Title = "¿Un sueño?",
		Description = {
			"Tu mente ha sido arrastrada a alguna parte... Investiga los tubos de ensayo."
		},
		Summary = ""
	},
	[16121] = {
		Title = "¿Código secreto?",
		Description = {
			"La voz del tubo de ensayo te dijo que no olvidaras los números ^FF00004^333333, ^FF00007^333333, ^FF00007^333333, ^FF00002^333333, ^FF00009^333333, ^FF00006^333333, ^FF00001^333333."
		},
		Summary = ""
	},
	[16122] = {
		Title = "Vieja llave de cobre",
		Description = {
			"Has encontrado una vieja llave de cobre dentro de una calabaza. ¿Para qué podría ser esta clave?"
		},
		Summary = ""
	},
	[16123] = {
		Title = "Tarjeta verde",
		Description = {
			"Ha encontrado una tarjeta de acceso verde dentro de la caja cerrada. ¿Para qué podría usarse esta clave?"
		},
		Summary = ""
	},
	[16124] = {
		Title = "Caja de acero",
		Description = {
			"Has encontrado una caja de acero dentro de la caja fuerte detrás de la estantería. ¡Esto podría ser lo que el abuelo de Elly quería que ella encontrara!"
		},
		Summary = ""
	},
	[16125] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Encontraste una nota en la canasta de galletas de Elly que dice que vio al fantasma. Recuerdas vagamente que ella dijo que si estaba maldecida debías gritar: \"¡Despierta, Elly!\"."
		},
		Summary = ""
	},
	[16126] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Elly se despertó por un segundo y dejó caer una llave dorada y un botón de lujo. ¡Mira si Elly se despierta!"
		},
		Summary = ""
	},
	[16127] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Debes encontrar la habitación secreta de la fábrica en la tumba frente al dormitorio. Utilice la tarjeta amarilla para acceder."
		},
		Summary = ""
	},
	[16128] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Has obtenido acceso a la fábrica. Encuentra el escondite de Allysia y usa la tarjeta azul para acceder."
		},
		Summary = ""
	},
	[16129] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Has convencido a Allysia de que estás ayudando a Elly mostrándole la Llave Dorada."
		},
		Summary = ""
	},
	[16130] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Has obtenido una tarjeta de acceso roja que te permitirá acceder a las zonas secretas de la fábrica. Úselo para encontrar Kiel Hyre."
		},
		Summary = ""
	},
	[16131] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Has encontrado a Kiel Hyre atrapado detrás de una puerta. Te dio un fragmento de metal que te pidió que le llevaras a Allysia."
		},
		Summary = ""
	},
	[16132] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Ve a la mansión Kiel Hyre en Lighthalzen. Está ubicado justo al norte de la Sala de Subastas. Presentar la Llave Dorada para ser admitido al recinto."
		},
		Summary = ""
	},
	[16133] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Kiel Hyre está agradecido por ayudarlo. Parece que tu papel aquí ha terminado. Deja que Kiel Hyre descanse por ahora y abandona la mansión."
		},
		Summary = ""
	},
	[16134] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Fuiste emboscado por el agente Mitchell Layla de Rekenber Corporation. Ella te dijo que buscaras una anciana en Juno que pudiera tener más información sobre Allysia."
		},
		Summary = ""
	},
	[16135] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Has obtenido las llaves de la mansión Rosimier. Busca minuciosamente en la mansión y cuéntale a la anciana lo que encontraste."
		},
		Summary = ""
	},
	[16136] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"La anciana dice que hable con el pescador que vive al sur de la Academia Kiel Hyre. Él fue quien encontró el cuerpo de Allysia en el río..."
		},
		Summary = ""
	},
	[16137] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Investiga la cabaña cerca del campamento de guardias de Schwartzvalt, al este de la Academia Kiel Hyre."
		},
		Summary = ""
	},
	[16138] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Ya tienes suficiente información, por lo que debes informar a Mitchell en la mansión Kiel Hyre en Lighthalzen."
		},
		Summary = ""
	},
	[16139] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Enfréntate a Kiel Hyre para descubrir quién es realmente Kiehl y cuál es su relación con Rekenber."
		},
		Summary = ""
	},
	[16140] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Kiel Hyre te ha dado un dispositivo de poder que debilitará a Kiehl. Habla con Kiel Hyre cuando estés listo para que te envíen a la habitación de Kiehl."
		},
		Summary = ""
	},
	[16141] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"En la parte inferior del jarrón se lee \"El conejo a menudo observa la puerta. Abre la puerta\"."
		},
		Summary = ""
	},
	[16142] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"La puerta grande al final de la habitación emite un sonido de campanilla y la caja se abre para revelar una llave de juguete. Busca a Kiehl en el calabozo."
		},
		Summary = ""
	},
	[16143] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Derrota a los robots que aparecen."
		},
		Summary = ""
	},
	[16144] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Derrota a Kiehl."
		},
		Summary = ""
	},
	[16145] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Recupera el anillo de Allysia del antiguo cuerpo de Kiehl y escapa."
		},
		Summary = ""
	},
	[16146] = {
		Title = "Academia Kiel-Hyre",
		Description = {
			"Lleva el anillo de Allysia a Kiel Hyre en su mansión en Lighthalzen."
		},
		Summary = ""
	},
