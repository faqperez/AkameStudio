			"Æ÷¸µÀÌ ¸¶´©Å©ÁÖÈ¸¦ ÁÙ°Å¾ß. ±×°Å 5°³ ÁÞ¾î¿Í"
		},
		Summary = "¸¶´©Å©ÁÖÈ 5°³"
	},
	[14004] = {
		Title = "Anillo Valquiria",
		Description = {
			"Recibe la caja del anillo Valkyrie."
		},
		Summary = ""
	},
	[14118] = {
		Title = "La preocupación de Wuhari",
		Description = {
			"Inicio: NPC: Wuhari en Ubicacion: eclage (282, 255). Wuhari está preocupado por su hermano en prisión. Encuentra una manera de entrar a la prisión y entrega la sincera carta de Wuhari a su hermano en la cárcel."
		},
		Summary = ""
	},
	[14119] = {
		Title = "Prueba de paciencia",
		Description = {
			"Inicio: NPC: Wuhuru en Ubicacion: ecl_in02 (149, 117). El prisionero no responde cuando se le habla. Parece poner a prueba mi paciencia."
		},
		Summary = "Hablando con el prisionero"
	},
	[14120] = {
		Title = "Prueba de paciencia 2",
		Description = {
			"El prisionero todavía no responde incluso después de haber hablado con él varias veces. Intentemos de nuevo."
		},
		Summary = "Hablando con el prisionero"
	},
	[14121] = {
		Title = "Prueba de paciencia 3",
		Description = {
			"El tipo parece mantener la boca cerrada pase lo que pase. Me pregunto si hay otras formas."
		},
		Summary = "Hablando con el prisionero"
	},
	[14122] = {
		Title = "tiempo para dos",
		Description = {
			"La carta de Wuhari fue entregada a Wuhuru. Pidió algo de tiempo para leer la carta. No lo molestes cuando esté leyendo la carta."
		},
		Summary = "Dale tiempo para leer la carta."
	},
	[14123] = {
		Title = "El favor de Wuhuru",
		Description = {
			"Después de leer la carta de su hermano, Wuhuru comenzó a compartir su historia extensamente y pidió enviarle saludos a su hermano. Vuelve con Wuhari y dale saludos de su hermano."
		},
		Summary = "Enviando saludos a Wuhari"
	},
	[14124] = {
		Title = "Primera solicitud",
		Description = {
			"El animal de Jade fue robado anoche. Investigadlo y denunciad lo sucedido."
		},
		Summary = "La casa de Jade"
	},
	[14125] = {
		Title = "Investigando la zona",
		Description = {
			"Inicio: NPC: Wuhari en Ubicacion: eclage (282, 255). Wuhari está buscando formas de recuperar el cuerpo de Wuhuru. Sin embargo, no sabe cómo. ¿La gente de las zonas cercanas no sabría algo? investigar las zonas cercanas."
		},
		Summary = "Habla con la gente del pueblo."
	},
	[14126] = {
		Title = "Buscando a la Sra. Goatie",
		Description = {
			"Inicio: NPC: Masione en Ubicacion: eclage (200, 272). El señor Masione dijo que no sabe mucho. Pero se refiere a la Sra. Goatie que es mucho más astuta con estas cosas..."
		},
		Summary = "Busque a la Sra. Goatie"
	},
	[14127] = {
		Title = "Buscando al marido de la Sra. Goatie",
		Description = {
			"La Sra. Goatie habló de cómo Wuhuru estaba muy feliz mientras agitaba un trozo de papel en el aire. Cuando se le preguntó sobre el artículo, dijo que es posible que su marido sepa más al respecto."
		},
		Summary = "Búsqueda del marido de la Sra. Goatie"
	},
	[14128] = {
		Title = "Obtención del informe de investigación.",
		Description = {
			"El Sr. Svery, que siempre fue cercano a Wuhuru, sabía algo más. Dentro de la carta que dejó Wuhuru antes de ser llevado a prisión estaba el informe de la investigación. Llévalo a Wuhari."
		},
		Summary = "entregando el informe"
	},
	[14131] = {
		Title = "Tiempo de análisis",
		Description = {
			"Wuhari recibió el informe, pero afirmó que llevará algún tiempo analizarlo. Intenta hablar con él un poco más tarde. No molestes a alguien cuando está estudiando."
		},
		Summary = "Tiempo de análisis"
	},
	[14132] = {
		Title = "Nuestra investigación",
		Description = {
			"Una vez encontrado el animal, primero tenemos que investigar qué está pasando."
		},
		Summary = "Nuestra investigación"
	},
	[14133] = {
		Title = "Otro favor",
		Description = {
			"Inicio: NPC: Wuhari en Ubicacion: eclage (282, 255). Wuhari analizó el informe de la investigación, pero aún no estaba seguro de cómo recuperar el cuerpo de su hermano. Intente encontrar y preguntarle al Lapine que solicitó originalmente la participación de Wuhuru en la investigación."
		},
		Summary = "Obteniendo la evidencia"
	},
	[14134] = {
		Title = "Sharp Sra. Cabra",
		Description = {
			"Aunque el Sr. Svery fue visitado para obtener más información, dijo que no tiene idea sobre el Lapine de alto nivel. Sin embargo, sugirió ver a su esposa, que es muy hábil con estas cosas."
		},
		Summary = "A la Sra. Goatie"
	},
	[14135] = {
		Title = "Buscando al Sr. Pompe",
		Description = {
			"Cuando se le preguntó sobre el paradero del alto nivel de Lapine, la Sra. Goatie no sabía mucho. Sin embargo, un vecino de la ciudad, el Sr. Pompe, compartió que vio a un Lapine en el campo que luego desapareció. Preguntémosle al Sr. Pompe con más detalle."
		},
		Summary = "Escuchar la historia del Sr. Pompe"
	},
	[14136] = {
		Title = "Una escena terrible en el campo.",
		Description = {
			"El señor Pompe tiene miedo de salir al campo. Habló de cómo un gran cadáver yacía allí desde que un Lapine de alto nivel sufrió una muerte terrible. Investiga el campo."
		},
		Summary = "Investigación de campo"
	},
	[14137] = {
		Title = "Una propuesta interesante",
		Description = {
			"Una muchacha lapina hizo una propuesta interesante. Parecía que la Lapine que le dio a Wuhuru el informe de la investigación es la misma persona que su padre perdido. Busquémoslo juntos."
		},
		Summary = "Investigación de campo"
	},
	[14138] = {
		Title = "el gran cadáver",
		Description = {
			"Inicio: NPC: A Laphine corpse en Ubicacion: ecl_fild01 (269, 165). Había un gran cadáver que parecía haber estado allí por un tiempo. Era el Lapine que todos buscaban. Tenemos que hacerle saber a la niña esta mala noticia."
		},
		Summary = "Informe a Giranni"
	},
	[14139] = {
		Title = "A Wuhuru",
		Description = {
			"La niña confirmó que el cadáver era el de su padre. Tengo que volver a Wuhari con las manos vacías ya que el Lapine de interés ha muerto. Antes de eso, vayamos a Wuhuru para contarle sobre el Lapine con el que había trabajado."
		},
		Summary = "A Wuhuru"
	},
	[14140] = {
		Title = "A Wuhari",
		Description = {
			"Wuhuru compartió toda su historia, pero no se puede compartir en su totalidad con Wuhari. Ve a Wuhari para al menos decirle que el Lapine ha muerto."
		},
		Summary = "Informe a Wuhari"
	},
	[14141] = {
		Title = "Ingredientes para la investigación",
		Description = {
			"Wuhari pidió ingredientes que pudiera utilizar para investigar por su cuenta. Proporciona a Wuhari los ingredientes necesarios. (1 trozo de ala, 1 cabello resistente, 1 bradio, 1 runa de oscuridad, 1 runa de sangre)."
		},
		Summary = "¡Obtén los artículos!"
	},
	[14142] = {
		Title = "¡A la ciudad del Arquero!",
		Description = {
			"Inicio: NPC: Archer Teacher en Ubicacion: iz_ac02 (65, 109). Termina la lección yendo al Gremio de Arqueros, yendo a Payon y viajando hacia el norte."
		},
		Summary = "Viaja al pueblo del Arquero."
	},
	[14143] = {
		Title = "Solicitud de cambio de trabajo del Arquero",
		Description = {
			"¡Por fin, solicité el cambio de trabajo de arquero! Ve al cambio de trabajo del Arquero en el Gremio de Arqueros."
		},
		Summary = "Solicitud de cambio de trabajo"
	},
	[14144] = {
		Title = "Volver a probar - Estadísticas",
		Description = {
			"Realice la prueba nuevamente después de conocer en profundidad sus estadísticas una vez más."
		},
		Summary = "Volver a realizar la prueba de estadísticas"
	},
	[14145] = {
		Title = "Habilidades de arquero",
		Description = {
			"Escuche los detalles sobre las habilidades de Archer."
		},
		Summary = ""
	},
	[14146] = {
		Title = "entrenamiento de caza",
		Description = {
			"¡El estudio teórico es bueno pero el ejercicio de campo es el mejor! Prueba el entrenamiento de caza con el entrenador ojo de águila."
		},
		Summary = "entrenamiento de caza"
	},
	[14147] = {
		Title = "Nueva prueba - Habilidades",
		Description = {
			"Realice el examen nuevamente después de aprender profundamente sobre las habilidades una vez más."
		},
		Summary = "Vuelva a realizar la prueba de habilidad"
	},
	[14148] = {
		Title = "al siguiente paso",
		Description = {
			"Escuche la explicación sobre el segundo cambio de trabajo."
		},
		Summary = "encontrar marlbron"
	},
	[14149] = {
		Title = "Escuchando el segundo cambio de trabajo",
		Description = {
			"Hay Hunter, Bard y Dancer para la segunda clase de trabajo de Archer. Los estudiantes deben aprender del personal de relaciones públicas de Hunter. El personal de relaciones públicas de los bailarines está fuera de posición ahora, el personal de Bard también dará explicaciones sobre la clase de bailarines."
		},
		Summary = "Escuchando la explicación sobre las clases del segundo trabajo."
	},
	[14150] = {
		Title = "al siguiente paso",
		Description = {
			"Ve a ver al Sr. Marlborn"
		},
		Summary = "Habla con Marlbron"
	},
	[14151] = {
		Title = "Entrenamiento de caza - Espora",
		Description = {
			"El primer paso del entrenamiento de caza. Informe después de cazar 10 esporas"
		},
		Summary = "Caza 10 esporas"
	},
	[14152] = {
		Title = "Entrenamiento de caza - Cremoso",
		Description = {
			"El segundo paso del entrenamiento de caza. Informe después de cazar 10 Creamy."
		},
		Summary = "Caza 10 Cremosos"
	},
	[14153] = {
		Title = "Entrenamiento de caza - Esqueleto",
		Description = {
			"El tercer paso del entrenamiento de caza. Informe después de cazar 10 esqueletos"
		},
		Summary = "Caza 10 esqueletos"
	},
	[14154] = {
		Title = "Mezcla de hierbas aromáticas",
		Description = {
			"Inicio: NPC: Dacquoise en Ubicacion: iz_ac01 (147, 50). Para hacer la mezcla de hierbas aromáticas, se necesitan los ingredientes. Encuentra y trae uno de cada trébol, hierba verde y hierba roja."
		},
		Summary = "Encontrar los ingredientes"
	},
	[14155] = {
		Title = "Ensalada crujiente",
		Description = {
			"Inicio: NPC: Dacquoise en Ubicacion: iz_ac01 (147, 50). Para hacer la ensalada crujiente se necesitan los ingredientes. Encuentra y trae 1 manzana y 2 zanahorias."
		},
		Summary = "Encontrar los ingredientes"
	},
	[14156] = {
		Title = "cualquier cosa shabushabu",
		Description = {
			"Inicio: NPC: Dacquoise en Ubicacion: iz_ac01 (147, 50). Para hacer cualquier cosa shabushabu, se requieren los ingredientes. Encuentra y trae 1 de cada gelatina, pelusa y pluma."
		},
		Summary = "Encontrar los ingredientes"
	},
	[14157] = {
		Title = "Manzana dorada al horno",
		Description = {
			"Inicio: NPC: Dacquoise en Ubicacion: iz_ac01 (147, 50). Para hacer la manzana dorada al horno se requieren los ingredientes. Encuentra y llévale 1 de cada manzana y trébol."
		},
		Summary = "Encontrar los ingredientes"
	},
	[14158] = {
		Title = "Presentación del manual Archer.",
		Description = {
			"Inicio: NPC: Archer Teacher en Ubicacion: iz_ac02 (65, 109). Presentación de la guía para experimentar la habilidad del arquero."
		},
		Summary = "Presentación del manual del arquero."
	},
	[14159] = {
		Title = "Me reuní con el personal de relaciones públicas.",
		Description = {
			"Me reuní con el personal de relaciones públicas del cazador."
		},
		Summary = "Me reuní con el personal de relaciones públicas."
	},
	[14160] = {
		Title = "Me reuní con el personal de relaciones públicas.",
		Description = {
			"Me reuní con el personal de relaciones públicas de Bard and Dancer."
		},
		Summary = "Me reuní con el personal de relaciones públicas."
	},
	[14161] = {
		Title = "Prueba de estadísticas",
		Description = {
			"Realiza la prueba del Archer Trainer sobre estadísticas."
		},
		Summary = ""
	},
	[14162] = {
		Title = "prueba de habilidades",
		Description = {
			"Realiza la prueba del Archer Trainer sobre habilidades."
		},
		Summary = ""
	},
	[14163] = {
		Title = "Esporas atrapadas",
		Description = {
			"Atrapó 10 esporas"
		},
		Summary = ""
	},
	[14164] = {
		Title = "atrapado cremoso",
		Description = {
			"Atrapados 10 Cremosos"
		},
		Summary = ""
	},
	[14165] = {
		Title = "Esqueletos atrapados",
		Description = {
			"Atrapaste 10 esqueletos."
