	[11055] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Inicio: NPC: Studying Officer en Ubicacion: lou_in02 (156, 38). Hace unos días alguien me pidió el mismo documento, así que pude volver a encontrarlo con bastante facilidad. Espero que te sea útil."
		},
		Summary = "¡Documento encontrado! Vuelve con Jiang Xiayou"
