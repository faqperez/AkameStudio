		},
		Summary = "º¹½ÇÇÑ ¾çÅÐ 5"
	},
	[7676] = {
		Title = "La ropa nueva siempre se hace de nuevo",
		Description = {
			"¡La demanda de lana ha aumentado! Si ayudas al pastor todos los días y le entregas la lana que recibes a Shiltarae, debería estar muy contento. Una vez que amanezca, volvamos a visitarlo."
		},
		Summary = "Se reinicia por la mañana"
	},
	[7681] = {
		Title = "Invitación al Banquete Real",
		Description = {
			"Inicio: NPC: Royal Messenger en Ubicacion: prontera (121, 72). Se celebra un banquete en el Palacio Prontera para honrar el sacrificio hecho por quienes continuaron la misión de expedición en Ash-Bakum para derrotar al atroz Marruecos y elogiar su dedicación. Estáis todos invitados a este banquete."
		},
		Summary = "Visita el Palacio Prontera"
	},
	[7682] = {
		Title = "Socializar comienza con un contacto visual",
		Description = {
			"Inicio: NPC: Chamberlain Bell en Ubicacion: prt_cas_q (26, 30). Visita a las siete familias reales para intercambiar saludos. Están las familias Heine, Nerius y Walther en la Villa Oeste, y están las familias Richard, Wigner, Roegenburg y Geoborg en la Villa Este."
		},
		Summary = "Visita a cada familia"
	},
	[7683] = {
		Title = "Visita las Heines",
		Description = {
			"Inicio: NPC: Nyhill M. Heine en Ubicacion: prt_cas_q (22, 80). Visitaste los Heines para intercambiar saludos."
		},
		Summary = ""
	},
	[7684] = {
		Title = "Visita el Nerio",
		Description = {
			"Inicio: NPC: Spica Nerius en Ubicacion: prt_cas_q (20, 139). Visitaste el Nerius para intercambiar saludos."
		},
		Summary = ""
	},
	[7685] = {
		Title = "¿Qué es lo siguiente en el cronograma?",
		Description = {
			"Inicio: NPC: Chamberlain Bell en Ubicacion: prt_cas_q (26, 30). Has completado todo lo previsto. Pregúntale a Chamberlain Bell en tu habitación sobre lo siguiente en el programa."
		},
		Summary = "hablar con bella"
	},
	[7686] = {
		Title = "Nyhill y Skia",
		Description = {
			"Inicio: NPC: Skia en Ubicacion: prt_cas_q (141, 39). Fuiste testigo de la conversación entre Nyhill y Skia en el pasillo."
		},
		Summary = ""
	},
	[7687] = {
		Title = "Participando en el banquete",
		Description = {
			"Inicio: NPC: Chamberlain Bell en Ubicacion: prt_cas_q (26, 30). Belle te pidió que participaras en el banquete ya que tenías tiempo libre. Te dijeron que Spica, la dama de la familia Nerius, quería conocerte."
		},
		Summary = "Habla con Spica"
	},
	[7688] = {
		Title = "Movimiento sospechoso",
		Description = {
			"Inicio: NPC: Court Mage Nillem en Ubicacion: prt_cas_q (28, 28). Mientras se movía para participar en el banquete, escuchó sobre la conversación entre los extraños en la habitación de invitados."
		},
		Summary = ""
	},
	[7689] = {
		Title = "encontrar nyhill",
		Description = {
			"Inicio: NPC: Chamberlain en Ubicacion: prt_cas (181, 154). Skia sintió que Nyhill no caminaba con rectitud. Skia te pidió que siguieras a Nyhill, quien abandonó temprano el banquete."
		},
		Summary = "Seguir a Nyhill"
	},
	[7690] = {
		Title = "¿Dónde está Nyhill?",
		Description = {
			"Inicio: NPC: Crux Findel en Ubicacion: prt_cas (108, 240). Cuando buscaba a Nyhill, escuchó a escondidas una conversación sospechosa. ¿Dónde está Nyhill?"
		},
		Summary = "Habla con Nyhill"
	},
	[7691] = {
		Title = "Esperando el ritual",
		Description = {
			"Inicio: NPC: Skia Nerius en Ubicacion: prt_cas (25, 35). Vuelve a la habitación para hablar con Belle. Se suponía que un mago vendría para el ritual..."
		},
		Summary = "hablar con bella"
	},
	[7692] = {
		Title = "Asiste al ritual",
		Description = {
			"Inicio: NPC: Chamberlain Bell en Ubicacion: prt_cas_q (26, 30). Participa en el ritual siguiendo el ejemplo del mago."
		},
		Summary = "Asiste al ritual"
	},
	[7693] = {
		Title = "Ataque sorpresa",
		Description = {
			"¡Se lanzó un ataque sorpresa durante el ritual!"
		},
		Summary = ""
	},
	[7694] = {
		Title = "Me gustaría ver eso también",
		Description = {
			"Inicio: NPC: Mage Nillem en Ubicacion: prt_lib (91, 85). Después de que todos se hayan ido, echemos un vistazo al documento real que Kronecker estaba mirando."
		},
		Summary = "Habla con el bibliotecario"
	},
	[7695] = {
		Title = "Escape de los recuerdos pasados de la familia real",
		Description = {
			"Inicio: NPC: Mage Nillem en Ubicacion: prt_lib (91, 85). Debes salir del lugar por la salida de emergencia en lugar de por la puerta que no funciona. El caballero que guarda frente a la puerta puede guiarte."
		},
		Summary = "Habla con el Caballero Guardián"
	},
	[7696] = {
		Title = "¿Qué sigue?",
		Description = {
			"Inicio: NPC: Overwatcher Terketh en Ubicacion: prt_pri00 (58, 128). No sé qué hacer ahora. Preguntémosle a Bella."
		},
		Summary = "hablar con bella"
	},
	[7697] = {
		Title = "Invitación del Nerius",
		Description = {
			"Inicio: NPC: Chamberlain Bell en Ubicacion: prt_cas_q (26, 30). Has sido invitado a la familia Nerius. Vayamos a visitar el Nerius."
		},
		Summary = "Visita el Nerio"
	},
	[7698] = {
		Title = "Heine ahora",
		Description = {
			"Inicio: NPC: Spica Nerius en Ubicacion: prt_cas_q (18, 136). Mientras hablaba con Nerius, llegó la solicitud para visitar a los Heines."
		},
		Summary = "Visita las Heines"
	},
	[7699] = {
		Title = "al pasado",
		Description = {
			"Inicio: NPC: Kronecker G. Heine en Ubicacion: prt_cas_q (19, 85). Se te ha pedido que visites los Recuerdos Pasados de la Familia Real con Nillem conectando los huecos en la dimensión. ¿Dónde está Nillem?"
		},
		Summary = "Habla con Nillem"
	},
	[7700] = {
		Title = "¡Una vez más!",
		Description = {
			"Inicio: NPC: Mage Nillem en Ubicacion: prt_lib (91, 85). Muévete una vez más a través del espacio en la dimensión que Nillem ha torcido por la fuerza. ¿Qué pasó en la Sala de la Conciencia en el pasado?"
		},
		Summary = "A la Sala de la Conciencia"
	},
	[7701] = {
		Title = "Corazón perdido de Imir",
		Description = {
			"Compruebe lo que le pasó al Corazón de Imir real en la Sala de la Conciencia."
		},
		Summary = ""
	},
	[7702] = {
		Title = "Prontera en ese momento",
		Description = {
			"Inicio: NPC: Nillem en Ubicacion: prt_lib_q (91, 85). Prontera ha sido atacada por los No-muertos antes y está ocurriendo ahora mismo. Has decidido salir después de una persistente persuasión por parte de Nillem."
		},
		Summary = "hacia el exterior"
	},
	[7703] = {
		Title = "¿Quién sabe la verdad?",
		Description = {
			"Inicio: NPC: Nillem en Ubicacion: prt_q (157, 334). Es el momento de volver al presente, abrir el documento y conocer la verdad. Todo reside en los Recuerdos Pasados de la Familia Real."
		},
		Summary = "Habla con Kronecker"
	},
	[7704] = {
		Title = "Pasado inmutable",
		Description = {
			"Tampoco pude salvar el Corazón de Imir infringido por Valkyrie hoy."
		},
		Summary = ""
	},
	[7705] = {
		Title = "Espero que no puedas dejarlo ir",
		Description = {
			"Inicio: NPC: Friedrich S. Heine en Ubicacion: prt_cas_q (21, 83). No estás seguro de si funcionaría o no, pero se te pide que vuelvas a desafiarte en la Sala de la Conciencia. Derrota a Bijou y defiende la pieza de Imir Heart."
		},
		Summary = "Habitación de la Conciencia en el Pasado"
	},
	[7706] = {
		Title = "Nillem no es todopoderoso",
		Description = {
			"Inicio: NPC: Kronecker G. Heine en Ubicacion: prt_lib (80, 79). La conexión múltiple es algo difícil incluso para Nillem. Creo que hay un cierto límite para conectarnos con la Sala de la Conciencia. Esperemos la recuperación de Nillem."
		},
		Summary = "Reiniciar a las 4 en punto"
	},
	[7711] = {
		Title = "Comienzo",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). ¡Yo Ho! ¡Soy un magnífico Doram de Pa~sta! Trepé la montaña Laviol y llegué al puerto de Lasagna. ¡Y voy a conquistar el nuevo continente de Midgard!"
		},
		Summary = "Habla con Ajena"
	},
	[7712] = {
		Title = "¿Dónde estoy? ¿Quién soy??",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). ¡Yo Ho! Soy un magnífico Doram de Pa~sta. En el camino al pueblo portuario de Lasagna, el miliciano Alio puede contarte más."
		},
		Summary = "Habla con Alio"
	},
	[7713] = {
		Title = "¡Primera batalla!",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Lo sabía: el miliciano Alio quiere comprobar mi capacidad. ¡Un Eggring no es nada contra mi puñetazo!"
		},
		Summary = "Derrota Eggrings"
	},
	[7714] = {
		Title = "Zumo de Manzana refrescante",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). No hay nada como una bebida dulce y fría después del trabajo. El miliciano Alio te dio Zumo de Manzana (Apple Juice)."
		},
		Summary = "Bebe Zumo de Manzana (Apple Juice)"
	},
	[7715] = {
		Title = "La caja perdida",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Un chico del pueblo dice que perdió una caja de entrega (Delivery Box). ¡El deber de un Doram es ayudar al chico! Caza Eggrings para encontrar la caja."
		},
		Summary = "Recoge la Caja de Entrega (Delivery Box)"
	},
	[7716] = {
		Title = "¡Al pueblo!",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Recuperé la caja de los Eggrings. El miliciano Alio quiere que la entregue al chico de la tienda de herramientas de Lasagna. ¡Efectivamente, entregar es una aventura!"
		},
		Summary = "Habla con el chico de la tienda de herramientas"
	},
	[7717] = {
		Title = "La amabilidad del mercader",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). El dueño de la tienda de herramientas me dio objetos útiles y me pidió que busque a ^4d4dffHaru la Healer^000000. La sanadora vive en ^4d4dffla casa llena de macetas, al este de la tienda de herramientas^000000."
		},
		Summary = "Habla con Haru la Healer"
	},
	[7718] = {
		Title = "Ya me estoy acostumbrando",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Ve al prado cerca del pueblo, trabaja con ^4d4dffHierba Roja (Red Herb)^000000 y vuelve con ^4d4dff1 Hierba Roja (Red Herb)^000000. Hace falta para la medicina, ¡así que ponte en marcha!"
		},
		Summary = "1 Hierba Roja (Red Herb)"
	},
	[7719] = {
		Title = "Hora de digerir",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Para ayudar al gato de la aldea de Lasagna, trabaja con ^4d4dffHierba Roja y recoge 2 Hierbas Rojas (Red Herb)^000000. ¡Pan comido!"
		},
		Summary = "2 Hierbas Rojas (Red Herb)"
	},
	[7720] = {
		Title = "Manual de servicios",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Aprendí mucho sobre cómo usar el almacén (Storage / Kafra) y el servicio para guardar objetos."
		},
		Summary = "Habla con la encargada"
	},
	[7721] = {
		Title = "Concurso de exhibición felina",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). ¡Se ha hecho una apuesta! Para ganar, caza lo más rápido posible 3 Lunatics y 2 Fabres. Parece que viven cerca."
		},
		Summary = "Tienes 10 minutos para cazar 3 Lunatics y 2 Fabres"
	},
	[7722] = {
		Title = "Primeros auxilios",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Aprendiste atención médica de emergencia."
		},
		Summary = ""
	},
	[7723] = {
		Title = "El potencial interior",
		Description = {
			"[Tutorial Doram: Lasagna] Requisitos: Nivel Base: 1+. Inicio: NPC: Miliciano Alio / Ajena en Ubicacion: Puerto de Lasagna (lasa_fild01). Aprendiste sobre atributos y habilidades. Habla más con el miliciano Nyoki sobre esto."
		},
		Summary = "Habla con Nyoki"
	},
	[7731] = {
		Title = "Movimiento encubierto",
		Description = {
			"Inicio: NPC: Nihil M. Heine en Ubicacion: prt_cas_q (21, 39). Has decidido buscar a un sirviente llamado Bruno en Lihitarzen. Primero, reunámonos con Crookes en el aeropuerto de Lihitarzen."
		},
		Summary = "Habla con Crooks"
	},
	[7732] = {
		Title = "Buscando al sospechoso",
		Description = {
			"Inicio: NPC: Crux en Ubicacion: lhz_airport (189, 39). Para encontrar a Bruno, has decidido buscar en el norte y noreste de Lihitarzen."
		},
		Summary = "encontrar bruno"
	},
	[7733] = {
		Title = "¡Buscar!",
		Description = {
			"Inicio: NPC: Skia en Ubicacion: lighthalzen (202, 167). Ya sabes hacia dónde se dirige Bruno. ¡Díselo a Skia, que está esperando cerca de los grandes almacenes Lihitarzen, y luego dirígete a los barrios marginales para encontrar a Bruno!"
		},
		Summary = "Buscar en los barrios marginales"
	},
	[7734] = {
		Title = "arresto",
		Description = {
			"Inicio: NPC: Man en Ubicacion: lighthalzen (309, 263). Has logrado capturar a Bruno. Primero, regresemos al Palacio Real de Prontera y analicemos el siguiente paso."
		},
		Summary = "Habla con Nihil"
	},
	[7735] = {
		Title = "Movimiento encubierto 2",
		Description = {
			"Inicio: NPC: Nihil M. Heine en Ubicacion: prt_cas_q (21, 39). Parece necesaria la cooperación con la inteligencia de la República de Schwartzwald. Has asumido el trabajo de escoltar a Spica, quien partió para realizar negociaciones secretas. Nos reunimos en el aeropuerto de Yuno."
		},
		Summary = "Habla con Crooks"
	},
	[7736] = {
		Title = "El turismo y las conversaciones secretas difieren por una hoja de papel",
		Description = {
			"Inicio: NPC: Crux en Ubicacion: y_airport (168, 41). Spica, que se uniría a vosotros en Yuno, se ha trasladado a un hotel en Lihitarzen por motivos de seguridad. Vayamos al hotel Lihitarzen para encontrarnos con Spica, que se aloja allí con el pretexto de hacer turismo."
		},
		Summary = "Habla con Spica"
	},
	[7737] = {
		Title = "Con la rebelión",
		Description = {
			"Inicio: NPC: Philopontess en Ubicacion: lhz_in02 (239, 148). Decidiste persuadir a la Rebelión junto con el agente que se está preparando para atraerlos. Reúnete con el agente negociador Rage en la estación de tren de Einbroch y negocia con éxito con la Rebelión."
		},
		Summary = "Rebelión"
	},
	[7738] = {
		Title = "Para la próxima operación",
		Description = {
			"Inicio: NPC: Rebellion Squadder en Ubicacion: rebel_in (65, 46). Una vez que logró obtener la cooperación de la Rebelión, el plan avanzó rápidamente. Dirigámonos al hotel Einbroch para escuchar las siguientes instrucciones."
		},
		Summary = "Habla con Nihil"
	},
	[7739] = {
		Title = "¡Encuentra la Estrella de Bendición!",
		Description = {
			"Inicio: NPC: Nihil en Ubicacion: ein_in01 (269, 285). El lugar de la operación se encuentra en el campo norte de Einbroch, en las coordenadas 280 332, según informan. Hagamos que la operación de la Rebelión sea un éxito y recuperemos la Estrella de Bendición."
		},
		Summary = "Recuperar la Estrella de Bendición"
	},
	[7740] = {
		Title = "La estrella recuperada",
		Description = {
			"Inicio: NPC: Central_room en Ubicacion: slabw01 (246, 88). Has recuperado la Estrella de la Bendición. Volvemos a la fiesta esperando los resultados en el hotel Einbroch."
		},
		Summary = "Habla con Nihil"
	},
	[7741] = {
		Title = "Regresar",
		Description = {
			"Inicio: NPC: Rebellion Squadder en Ubicacion: rebel_in (65, 46). Has recuperado la Estrella de la Bendición. Has decidido regresar al Palacio Real de Prontera para concluir el incidente."
		},
		Summary = "Habla con Skia"
	},
	[7742] = {
		Title = "Limpiando los restos",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: que_swat (150, 58). Una poderosa quimera que nunca antes se había visto apareció en la sala central del Laboratorio de Investigación Werner. Rookie te ha solicitado que elimines al monstruo quimera 'Cutie Pie'."
		},
		Summary = "Eliminar Cutie Pie"
	},
	[7743] = {
		Title = "Limpiando los restos - Enfriamiento",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: que_swat (150, 58). No está claro qué está pasando, pero las quimeras monstruosas siguen apareciendo. Tendrás que lidiar con ellos todos los días durante un tiempo."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[7744] = {
		Title = "Investigadores ocultos",
		Description = {
			"Inicio: NPC: Philopontess en Ubicacion: que_swat (145, 57). Los investigadores que no pudieron escapar a tiempo se esconden por todo el Laboratorio de Investigación Werner. Filopontes te pidió que encontraras al personal o investigadores ocultos."
		},
		Summary = "Encuentra 3 investigadores"
	},
	[7745] = {
		Title = "Investigadores ocultos: tiempo de reutilización",
		Description = {
			"Inicio: NPC: Philopontess en Ubicacion: que_swat (145, 57). Parece probable que la búsqueda en el laboratorio de Philopontes continúe. Vamos a ayudar cuando tengas tiempo."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[7746] = {
		Title = "Un par de anillos viejos",
		Description = {
			"Inicio: NPC: Knight Windsor en Ubicacion: prt_in (177, 26). Entregaste los efectos personales de Siren."
		},
		Summary = ""
	},
	[7747] = {
		Title = "Colgante Cohete",
		Description = {
			"Inicio: NPC: Knight Windsor en Ubicacion: prt_in (177, 26). Entregaste los efectos personales de Kathryne Keyron."
		},
		Summary = ""
	},
	[7748] = {
		Title = "Rosario de madera",
		Description = {
			"Inicio: NPC: Sister Margaret en Ubicacion: prt_monk (93, 254). Usted entregó los efectos personales de Margareta Sorin."
		},
		Summary = ""
	},
	[7749] = {
		Title = "Guante de tiro con arco decorado",
		Description = {
			"Inicio: NPC: Blacksmith Cleaver en Ubicacion: yuno_in01 (163, 31). Entregaste los efectos personales de Altaijen Howard."
		},
		Summary = ""
	},
	[7750] = {
		Title = "Daga con emblema de asesino",
		Description = {
			"Inicio: NPC: Guile Marovitz en Ubicacion: que_job01 (89, 91). Entregaste los efectos personales de Eremes Gail."
		},
		Summary = ""
	},
	[7751] = {
		Title = "Kit de costura portátil",
		Description = {
