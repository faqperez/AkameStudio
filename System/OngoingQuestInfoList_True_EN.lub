	[17000] = {
		Title = "Reúnase con el padre Bamph",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: pub_cat (106, 69). Un agente del dirigible internacional te dice que el padre Bamph está esperando tu llegada a la iglesia de Prontera. Probablemente deberías ir a encontrarlo allí."
		},
		Summary = "Habla con el padre Bamph"
	},
	[17001] = {
		Title = "Reúnete con Larjes",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: pub_cat (105, 58). El padre Bamph te cuenta que un hombre de alto rango desapareció repentinamente hace un tiempo y que fue visto por última vez en Comodo. Encuentra a Larjes y él te ayudará en la búsqueda del funcionario perdido."
		},
		Summary = "Habla con Larjes"
	},
	[17002] = {
		Title = "Informe al padre Bamph",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: pub_cat (105, 58). Larjes te dijo que el funcionario fue secuestrado de una organización de Arunafeltz. Deberías informar de esto al padre Bamph."
		},
		Summary = "Habla con el padre Bamph"
	},
	[17003] = {
		Title = "Viajar a Raquel",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: einbroch (42, 208). El padre Bamph te pide que vayas con Rachel en su nombre para continuar la investigación del funcionario desaparecido."
		},
		Summary = "Dirigible de Izlude a Rachel"
	},
	[17004] = {
		Title = "Viajar a las venas",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: einbroch (42, 208). Después de escuchar a escondidas la conversación junto a tu mesa, decides ir a Veins para ver si puedes encontrar más peces espinosos rayados de Veins."
		},
		Summary = "venas"
	},
	[17005] = {
		Title = "Magistrado frustrado",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: lighthalzen (259, 215). El magistrado Al Hamad le dice que no se siente cómodo hablando con completos desconocidos sobre sus problemas... Busque a alguien que pueda conocer la situación."
		},
		Summary = ""
	},
	[17006] = {
		Title = "Contrabandistas interrogados",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: lighthalzen (336, 266). Deberías preguntarle al magistrado si pudo interrogar a los contrabandistas antes de que se los llevaran."
		},
		Summary = "Magistrado Al Hamad"
	},
	[17007] = {
		Title = "Órdenes escritas",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: lighthalzen (108, 163). Si insistes en aprender más sobre los contrabandistas, entonces debes llevar una orden escrita de un oficial de alto rango a Al Hamad."
		},
		Summary = ""
	},
	[17008] = {
		Title = "investigando",
		Description = {
			"Inicio: NPC: Staff en Ubicacion: lhz_in01 (107, 137). El Sumo Sacerdote Zhed dijo que estaba demasiado preocupado por otros asuntos, pero que la Suma Sacerdotisa Niren tal vez sepa algo sobre los contrabandistas de Veins."
		},
		Summary = "Suma Sacerdotisa Niren"
	},
	[17009] = {
		Title = "Más investigando",
		Description = {
			"Inicio: NPC: Staff en Ubicacion: lhz_in01 (163, 258). La suma sacerdotisa Niren te ha pedido que averigües si el funcionario de alto rango de Rune-Midgarts todavía está vivo. Dirígete al magistrado Al Hamad y él te proporcionará información útil para tu viaje."
		},
		Summary = "Magistrado Al Hamad"
	},
	[17010] = {
		Title = "Investigaciones adicionales",
		Description = {
			"Inicio: NPC: Laboratory Staff en Ubicacion: rgsr_in (161, 85). El magistrado Al Hamad dio más detalles sobre sus tratos con los contrabandistas y el alto funcionario de Rune-Midgarts. Deberías viajar a Venas y averiguar si alguien sabe de sus desapariciones."
		},
		Summary = ""
	},
	[17011] = {
		Title = "El padre de Kurdi",
		Description = {
			"Inicio: NPC: Secretary en Ubicacion: lhz_in01 (80, 210). El borracho dijo algo sobre un fantasma en el mar. Deberías preguntarle al padre de Kurdi, ya que es pescador y quizás sepa algo al respecto."
		},
		Summary = "El padre de Kurdi."
	},
	[17012] = {
		Title = "El barco de Karyn",
		Description = {
			"Inicio: NPC: Secretary en Ubicacion: lhz_in01 (80, 210). Al papá de Karyn no se le permite salir al mar en este momento. Pero Karyn dijo que estaría bien si le prestaras el barco. Es el único barco ubicado en South Beach por lo que no debería ser difícil encontrarlo."
		},
		Summary = ""
	},
	[17013] = {
		Title = "a la isla",
		Description = {
			"Inicio: NPC: Kaya Tos en Ubicacion: ein_fild01 (95, 146). Larjes ha revelado que te ha estado siguiendo y se ofrece a ayudarte a navegar hasta el monasterio. Investiga la isla una vez que aterrices allí."
		},
		Summary = ""
	},
	[17014] = {
		Title = "Investigando la isla",
		Description = {
			"Inicio: NPC: Kaya Tos en Ubicacion: ein_fild01 (95, 146). Larjes ha decidido esperarte en el barco mientras investigas los misterios de la isla."
		},
		Summary = ""
	},
	[17015] = {
		Title = "La nota de investigación",
		Description = {
			"Inicio: NPC: Advance Squad en Ubicacion: sp_cor (168, 81). Encontraste un diario manchado de rojo con sangre. Es difícil distinguir las entradas, pero una de ellas afirma que el autor aprendió a convocar a una criatura. Deberías continuar tu investigación."
		},
		Summary = ""
	},
	[17016] = {
		Title = "regicidio",
		Description = {
			"Inicio: NPC: Kaya en Ubicacion: sp_cor (165, 79). Examinaste el cuerpo del Hombre Muerto y descubriste que tenía una Señal del Rey... Eso debe significar que era Tristam III... Deberías volver con Larjes y hacérselo saber."
		},
		Summary = "Larjes"
	},
	[17017] = {
		Title = "Informar de la muerte del rey",
		Description = {
			"Inicio: NPC: Tes en Ubicacion: sp_cor (166, 81). La impactante noticia de la muerte de Tristam III no debe tomarse a la ligera. Debes informar esto y llevarle la nota de investigación a la suma sacerdotisa Niren."
		},
		Summary = "Suma Sacerdotisa Niren"
	},
	[17018] = {
		Title = "La condición de los pacientes",
		Description = {
			"Inicio: NPC: Tes en Ubicacion: sp_cor (122, 141). El señor Ash dice que tiene asuntos urgentes que informar a la señora Kaya Tos."
		},
		Summary = "a ceniza"
	},
	[17019] = {
		Title = "Una situación crítica",
		Description = {
			"Inicio: NPC: Aas en Ubicacion: sp_cor (135, 147). ¡Necesitamos más buscadores para buscar a los investigadores fugitivos! ¡Únete al otro grupo de búsqueda de la izquierda!"
		},
		Summary = "Únete a la búsqueda"
	},
	[17020] = {
		Title = "Reanudar la investigación",
		Description = {
			"Inicio: NPC: Kaya Tos en Ubicacion: sp_cor (137, 146). Debo pedirle que continúe la investigación sobre el Sr. Patrick Kaufman. Alguien que haya trabajado aquí podría darte una pista."
		},
		Summary = "a los trabajadores"
	},
	[17021] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Worker en Ubicacion: sp_cor (132, 144). De todos modos, si estás buscando a alguien, deberías preguntarle a los investigadores. La mayoría se escapó, así que no quedan muchos... pero aún quedan algunos asistentes, así que echa un vistazo."
		},
		Summary = "a los investigadores"
	},
	[17022] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Researcher en Ubicacion: sp_cor (224, 77). Si buscas a alguien, prueba con la persona que se encargó de lavar la ropa. Lleva aquí mucho tiempo y viaja mucho."
		},
		Summary = "Al encargado de la lavandería"
	},
	[17023] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Worker en Ubicacion: sp_cor (151, 180). Si estás buscando algo, prueba el incinerador. Dicen que están reuniendo y clasificando los materiales esparcidos por ahí, para que tal vez encuentres algo."
		},
		Summary = "al incinerador"
	},
	[17024] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Worker en Ubicacion: sp_cor (70, 263). Dijeron que hay un sitio de eliminación separado para las cosas que están demasiado contaminadas o que no se pueden quemar. Lo llaman de alguna manera entre ellos..."
		},
		Summary = "A Ludo"
	},
	[17025] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Suspicious Evidence en Ubicacion: sp_rudus (227, 351). Puedes escuchar voces desde algún lugar. Vamos a buscarlos."
		},
		Summary = "Sigue la voz"
	},
	[17026] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Discarded Person en Ubicacion: sp_rudus (15, 280). También podrías buscar un brazalete de identificación en la pila de basura. Debería haberse caído en algún lugar del suelo."
		},
		Summary = "Pulsera de identificación de muestras"
	},
	[17027] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Hurgó cuidadosamente en la basura y encontró algunas pulseras de identificación, pero la del Sr. Kaufman no estaba entre ellas. Miremos hacia otro lado."
		},
		Summary = "miremos hacia otro lado"
	},
	[17028] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Hurgaste en la basura y encontraste algunas pulseras de identificación de otras personas. Miremos hacia otro lado."
		},
		Summary = "Busca en los montones de basura"
	},
	[17029] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Buscaste mucho, pero no era más que basura. Miremos hacia otro lado."
		},
		Summary = "mira en otro lado"
	},
	[17030] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Cavaste y cavaste de nuevo, pero parece que no hay nada que valga la pena salvar. Miremos hacia otro lado."
		},
		Summary = "A otra pila de basura"
	},
	[17031] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Aquí no había nada en absoluto. ¿Alguna vez encontraremos una pista sobre el Sr. Kaufman? Busquemos en otra parte."
		},
		Summary = "A otra pila de basura"
	},
	[17032] = {
		Title = "Buscando al Sr. Pack",
		Description = {
			"Inicio: NPC: Suspicious Evidence en Ubicacion: sp_rudus (55, 137). Sacaste un brazalete que había sido enterrado en la basura. Llevémosle esto a la Sra. Kaya."
		},
		Summary = "A la Sra. Kaya Tos"
	},
	[17033] = {
		Title = "Manejando todos los asuntos adicionales",
		Description = {
			"Inicio: NPC: Aas en Ubicacion: sp_cor (135, 147). Maneje todos los demás asuntos a través del Sr. Ash, que está aquí. También puedes entregarle las pulseras recolectadas al Sr. Ash."
		},
		Summary = "a ceniza"
	},
	[17034] = {
		Title = "A Ludo",
		Description = {
			"Inicio: NPC: Aas en Ubicacion: sp_cor (135, 147). Entonces, por favor, concede reposo a los 20 especímenes llamados Dolores y tráeme 10 pulseras de identificación de especímenes. - Ceniza"
		},
		Summary = "Pulsera de identificación de muestras 10"
	},
	[17035] = {
		Title = "- Enfriamiento: A Ludos",
		Description = {
			"Inicio: NPC: Aas en Ubicacion: sp_cor (135, 147). Nos volveremos a ver cuando haya pasado la madrugada. Realmente has trabajado duro. - Ceniza"
		},
		Summary = "Hora de reinicio 04:00"
	},
	[17036] = {
		Title = "Ãß¼öÁ¦ÀÇ ÀÇ¹Ì",
		Description = {
			"\"ç°ú¸¦ ¶¤´Ù"
		},
		Summary = "\"ç°ú µû±â"
	},
	[17037] = {
		Title = "- Enfriamiento: Cambiar atributo",
		Description = {
			"Puedes cambiar el atributo otorgado a la Túnica del Guardián del Tiempo de forma gratuita una vez al día. Grabador de atributos"
		},
		Summary = "Se reinicia a las 04:00"
	},
	[18001] = {
		Title = "Entrega para Rooney",
		Description = {
			"Inicio: NPC: ??????????????? en Ubicacion: ba_pw02 (90, 93). Encuentra a Lasda Midar y entrega la carta a Rooney."
		},
		Summary = "Lasda Midar"
	},
	[18002] = {
		Title = "Entrega para Rooney",
		Description = {
			"Inicio: NPC: Cleaning Robot en Ubicacion: ba_maison (357, 291). Dale el dinero que te dio Lasda a Rooney."
		},
		Summary = "rooney"
	},
	[18003] = {
		Title = "Entrega para Rooney",
		Description = {
			"Volver a Lasda Midar"
		},
		Summary = "Lasda Midar"
	},
	[18004] = {
		Title = "La petición de Lasda",
		Description = {
			"Lasda te ha pedido que encuentres a su amigo en una prisión temporal en Marruecos."
		},
		Summary = "Encuentra Vitré"
	},
	[18005] = {
		Title = "La petición de Jesse",
		Description = {
			"El pabellón de prisión Jesse te ha pedido que le lleves 1 plato de colas de mono fritas. Si se lo llevas, dijo que te dejará entrar en la prisión temporal."
		},
		Summary = "1 plato de Colas de Mono Fritas"
	},
	[18006] = {
		Title = "La aprobación de Sir Krieg",
		Description = {
			"Encuentra a Sir Krieg en algún lugar de Marruecos. Si obtienes su aprobación, Jesse te dejará entrar a la prisión temporal."
		},
		Summary = "Señor Krieg"
	},
	[18007] = {
		Title = "La confianza de Sir Krieg",
		Description = {
			"Gánate la confianza de Sir Krieg obteniendo una carta de aprobación. Quizás deberías preguntarle a alguien que sepa algo sobre Vitre..."
		},
		Summary = "carta de recomendacion"
	},
	[18008] = {
		Title = "La confianza de Sir Krieg",
		Description = {
			"Ha obtenido una carta de recomendación de Lasda Midar. Llévaselo a Sir Krieg y es posible que te deje entrar a la prisión."
		},
		Summary = "Señor Krieg"
	},
	[18009] = {
		Title = "en la prision",
		Description = {
			"Sir Krieg ha enviado un mensaje a la sala de la prisión para que te dejen hablar con Vitre."
		},
		Summary = "Sala de prisión Jesse"
	},
	[18010] = {
		Title = "fuga de la cárcel",
		Description = {
			"Vitre necesita algunos elementos que le ayuden a salir de la prisión temporal. Encuentre a alguien que sepa dónde conseguir los artículos que necesita."
		},
		Summary = "1 Megáfono y 1 Violín"
	},
	[18011] = {
		Title = "trabajo de guardaespaldas",
		Description = {
			"Hianna te prestará su megáfono por 500.000 zenys si actúas como guardaespaldas de sus bailarines. Encuentra a los bailarines y escoltalos a la República de Schwaltzvalt."
		},
		Summary = "Los bailarines de Hianna"
	},
	[18012] = {
		Title = "trabajo de guardaespaldas",
		Description = {
			"Habla con los bailarines de Hianna."
		},
		Summary = ""
	},
	[18013] = {
		Title = "trabajo de guardaespaldas",
		Description = {
			"Inicio: NPC: Cleaning Robot en Ubicacion: ba_maison (357, 291). Habla con el gerente del hotel."
		},
		Summary = ""
	},
	[18014] = {
		Title = "trabajo de guardaespaldas",
		Description = {
			"Inicio: NPC: Elena Bolkova en Ubicacion: ba_maison (303, 141). Habla con el hombre misterioso."
		},
		Summary = ""
	},
	[18015] = {
		Title = "trabajo de guardaespaldas",
		Description = {
			"Inicio: NPC: Elena Bolkova en Ubicacion: ba_in01 (20, 145). Habla con el gerente del hotel."
		},
		Summary = ""
	},
	[18016] = {
		Title = "trabajo de guardaespaldas",
		Description = {
			"Inicio: NPC: Elyumina en Ubicacion: ba_in01 (15, 147). Vuelve con Hianna y consigue el Megahpone. Recuerde que también debe pagarle 500.000 zenys para que se lo preste."
		},
		Summary = "hiana"
	},
	[18017] = {
		Title = "fuga de la cárcel",
		Description = {
			"Inicio: NPC: Est en Ubicacion: ba_in01 (51, 157). Llévale 1 megáfono y 1 violín a Vitre para ayudarlo a escapar de la prisión temporal en Marruecos."
		},
		Summary = "Vitré"
	},
	[18018] = {
		Title = "fuga de la cárcel",
		Description = {
			"Requisitos: Nivel Base: 170+. Inicio: NPC: Est en Ubicacion: ba_in01 (51, 157). Habla con Vitré"
		},
		Summary = ""
	},
	[18019] = {
		Title = "Canciones de Vitré",
		Description = {
			"Inicio: NPC: Manager Beta Almond en Ubicacion: ba_in01 (28, 255). Encuentra a los amigos de Vitre en este orden: Chada en Prontera, Ghez en Geffen y Nosdan en Comodo, escucha sus canciones y cántalas ante Vitre."
		},
		Summary = "Encuentra Chada, Ghez y Nosdan"
	},
	[18020] = {
		Title = "Canciones de Vitré",
		Description = {
			"Inicio: NPC: Nyhill M. Heine en Ubicacion: prt_cas (325, 263). Has escuchado la canción de Chada, ahora es el momento de encontrar a Ghez en Geffen."
		},
		Summary = "encontrar ghez"
	},
	[18021] = {
		Title = "Canciones de Vitré",
		Description = {
			"Inicio: NPC: Smart Elly en Ubicacion: ba_in01 (26, 266). Ya escuchaste la canción de Ghez, ahora es el momento de encontrar a Nosdan en Comodo."
		},
		Summary = "Encuentra a Nosdan"
	},
	[18022] = {
		Title = "Canciones de Vitré",
		Description = {
			"Inicio: NPC: Manager Beta Almond en Ubicacion: ba_in01 (28, 255). Ya escuchaste la última canción de Nosdan. Es hora de volver y cantarle las tres canciones a Vitre."
		},
		Summary = "Vitré"
	},
	[18023] = {
		Title = "Vitré el espía",
		Description = {
			"Inicio: NPC: Sweety en Ubicacion: ba_in01 (32, 250). El Servicio Secreto se ha llevado a Vitré por espionaje. Probablemente deberías volver con Lasda y contarle lo que le pasó a Vitre."
		},
		Summary = "Lasda Midar"
	},
	[18030] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Inicio: NPC: Busy Boy en Ubicacion: prontera (248, 212). ¡Muchas gracias! No entiendes cuánto temo a esos dirigibles. Ahora, ¿podría entregar estos libros a ^ff0000Mr. ¿Karlomoff^000000 cerca de la biblioteca Juno?"
		},
		Summary = "Sr. Karlomoff"
	},
	[18031] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Sería de gran ayuda para mí si pudiera hacerle llegar este informe de inmediato. Ah, su nombre es Rodafrian. Estoy seguro de que podrás encontrarla en algún lugar de ese pueblo desértico."
		},
		Summary = "rodafrian"
	},
	[18032] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Encuentra a Mondo en el monte Mjolnir. Cuéntale tu versión de la historia La gran serpiente se tragó el mar. El águila del arco iris se tragó a la serpiente. Entonces el águila construyó su nido. Un nido sobre el mar tragado."
		},
		Summary = "Mundo"
	},
	[18033] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Ahh, si quieres aprender más, entonces deberías intentar encontrar al niño que estaba cantando la canción. Hmm, podría estar alrededor de ^3131ddel río cerca de aquí^000000. Esperemos que no sea demasiado difícil encontrarlo."
		},
		Summary = "Chico aturdido"
	},
	[18034] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Entrega las hierbas de la mujer de aspecto exhausto al padre Bamph en la iglesia de Prontera."
		},
		Summary = "Padre Bamph"
	},
	[18035] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Visita a Bonnie Imbullea en el Monte Mjolnir para ver si puedes aprender más sobre esa canción o sobre lo que sucedió después del intento de exorcismo de la maldición Jormungand."
		},
		Summary = "Bonnie Imbullea"
	},
	[18036] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Regresa a la Iglesia Prontera y cuéntale al Padre Bamph lo que aprendiste al hablar con Bonnie Imbullea."
		},
		Summary = "Padre Bamph"
	},
	[18037] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Ven conmigo, aventurero, a los terrenos ceremoniales secretos de la familia real. Simplemente usa el interruptor escondido dentro de la estantería y te encontraré allí."
		},
		Summary = "interruptor oculto"
	},
	[18038] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Has examinado el cuerpo del primer hijo del rey, el príncipe heredero. Examina el cuerpo del segundo príncipe."
		},
		Summary = "Segundo príncipe"
	},
	[18039] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Has examinado el cuerpo del segundo hijo del rey. Examina el cuerpo del tercer príncipe."
		},
		Summary = "tercer príncipe"
	},
	[18040] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Valiente aventurero, ¿podrías visitar el Gremio de Asesinos en Marruecos y ver si puedes aprender algo sobre cómo podemos verificar si se usó veneno para derrotar a los príncipes?"
		},
		Summary = "Gremio de asesinos"
	},
	[18041] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Hay un Assassin's Private Pub en dirección a las 7 en punto en Marruecos. Ve a buscar a alguien llamado ^3131ffMarjana^000000 adentro."
		},
		Summary = "marjana"
	},
	[18042] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Bueno, ahora me resulta más fácil visitar a Rodafrian. Ella es mucho más cercana que el padre Bamph, así que supongo que iré a hablar con ella primero."
		},
		Summary = "rodafrian"
	},
	[18043] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Bueno, es más importante que vaya a ver al padre Bamph e investigue los cuerpos del príncipe. Será mejor que me dirija a Prontera de inmediato."
		},
		Summary = "Padre Bamph"
	},
	[18044] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Joder, ella no me dio ninguna ayuda... ¡Todo lo que hice fue revelarle un gran secreto que podría difundir! Oh, bueno, supongo que será mejor que regrese con los sacerdotes..."
		},
		Summary = "Iglesia Prontera"
	},
	[18045] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Rodafrian parecía muy feliz y empezó a leer el informe de Karlomoff. Por ahora, lo mejor sería volver con el padre Bamph."
		},
		Summary = "Padre Bamph"
	},
	[18046] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"Entonces, ¿podrías traer 1 piedra preciosa amarilla y 1 poción verde al recinto ceremonial secreto tan pronto como puedas? Te esperaré allí una vez más."
		},
		Summary = "1 piedra preciosa amarilla y 1 poción verde"
	},
	[18047] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"La solución funcionó para eliminar las marcas de escamas de los príncipes. Informe sus hallazgos al padre Bamph."
		},
		Summary = "Padre Bamph"
	},
	[18048] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
			"El padre Bamph le agradece por ayudarlos a descubrir la verdad. Habla con el padre Biscuss y cuéntale también tus hallazgos."
		},
		Summary = "Padre Biscuss"
	},
	[18049] = {
		Title = "Maldición de la familia Gaebolg",
		Description = {
