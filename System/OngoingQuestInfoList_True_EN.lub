	[11284] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Inicio: NPC: Nurse en Ubicacion: malaya (55, 72). Parece sucio, pero las \"vendas podridas\" se empaparon en un jugo especial y tienen poderes especiales. Sólo se necesitan 2 de estas vendas para cubrir ambos pies."
		},
		Summary = "Entrega 2 vendas podridas y habla de nuevo."
	},
	[11285] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"No sé si la puerta está cerrada o si está atascada pero como no se puede abrir sola, ¡hagámoslo juntos!"
		},
		Summary = "Abre la puerta con Las"
	},
	[11286] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Empujó la puerta con todas sus fuerzas pero no se movió."
		},
		Summary = "hablar con las"
	},
	[11287] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Me pondré en contacto con la oficina central nuevamente. ¿Le preguntarás a los aldeanos sobre este hospital?"
		},
		Summary = "Habla con la chica del pueblo de la derecha."
	},
	[11288] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Realmente no lo sé. El hospital lleva cerrado mucho tiempo. Es extraño que venga una nueva enfermera."
		},
		Summary = "La chica del pueblo no parece saber mucho. Regreso a Las"
	},
	[11289] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"La central no me enviaría a un lugar como este si no estuviera seguro de sí mismo. ¿Intentarás hablar con otro aldeano?"
		},
		Summary = "Habla con el hombre del pueblo, al sur del hospital."
	},
	[11290] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Tendré que reportar esta información rápidamente. Lo siento, pero ¿irás con la enfermera a la posada que está en el centro del pueblo?"
		},
		Summary = "Regreso a Las por ahora"
	},
	[11291] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Me duelen los pies y ya no puedo moverme. ¿Puedes ir solo a la posada?"
		},
		Summary = "Reúnete con el médico en la posada ubicada en el centro del pueblo."
	},
	[11292] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"No puedo ir al hospital ahora porque tengo pacientes que atender. ¿Puedes regresar con la llave y decirle \"Haz lo que desees\"?"
		},
		Summary = "Regreso a Las"
	},
	[11293] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Introduzca la llave en el ojo de la cerradura de la puerta del hospital. Pero la puerta no parece estar cerrada."
		},
		Summary = "hablar con las"
	},
	[11294] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Parece que la voz proviene del césped cercano a la entrada del hospital."
		},
		Summary = "Investigar cerca"
	},
	[11295] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"No lo he visto bien pensando que me podrían atrapar, pero sí recuerdo haber visto un palo cuando fui allí hace mucho tiempo, después de que falleciera mi abuela."
		},
		Summary = "Investigar los alrededores del hospital."
	},
	[11296] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Sacó el palo profundamente atascado. La atmósfera melancólica del hospital parece duplicarse."
		},
		Summary = "Mejor lleva este agimat a Las"
	},
	[11297] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"¿Visitas a mi abuela, por favor? Iré a revisar el hospital aquí."
		},
		Summary = "Visita a su abuela al oeste del pueblo, un poco al norte del hospital."
	},
	[11298] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Esperaba que sucediera algo como esto cuando talaron el árbol centenario del pueblo para construir el hospital."
		},
		Summary = "Continuar hablando con la abuela."
	},
	[11299] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"La enfermera Las podría estar en peligro sola frente al hospital."
		},
		Summary = "Regreso al hospital"
	},
	[11300] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Entremos juntos ya que la puerta del primer piso está abierta."
		},
		Summary = "Habla con Las dentro del hospital."
	},
	[11301] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Primero miré a mi alrededor, pero es posible que me haya perdido algunos detalles. ¿Podrías echar un vistazo a la entrada del segundo piso?"
		},
		Summary = "Investiga la entrada del segundo piso."
	},
	[11302] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Encontré un agimat. Busquemos más. ¿Es curioso encontrarse con algo como esto en un lugar como este?"
		},
		Summary = "esta cerca"
	},
	[11303] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"¿Cómo logró la enfermera cerrar la entrada con llave?"
		},
		Summary = "Regreso a Las"
	},
	[11304] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"¿No sabría de este agimat la abuela que pegó el agimat fuera del hospital?"
		},
		Summary = "hablar con la abuela"
	},
	[11305] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Le pedí al chamán del norte de la aldea que creara esto."
		},
		Summary = "Visita a Shaman al norte del pueblo."
	},
	[11306] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Siento algo muy siniestro de tu parte."
		},
		Summary = "Recibió un agimat. Regreso a Las"
	},
	[11307] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Peguemos ese agimat en el agimat que vimos en la entrada del 2F. Podría ayudar a bloquear la energía siniestra de ese."
		},
		Summary = "Pasa el agimat hacia el agimat de entrada 2F"
	},
	[11308] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Tan pronto como pegas el agimat encima del otro, la siniestra energía se siente desvanecida tal como dijo Las."
		},
		Summary = "Siente como si Las estuviera jugando contigo. Habla con la enfermera frente al hospital."
	},
	[11309] = {
		Title = "Enfermera en Port Malaya",
		Description = {
			"Inicio: NPC: Bangungot Gate en Ubicacion: sec_in02 (27, 30). No sólo interrumpiste mi trabajo sino que también la trajiste a la habitación haciéndote responsable. No pienses en huir."
		},
		Summary = "Deshazte de Bangungot y regresa."
	},
	[11310] = {
		Title = "Entrada de Eclage",
		Description = {
			"Inicio: NPC: Security Guard en Ubicacion: ecl_fild01 (94, 322). Después de completar su nombre, ocupación y nivel, envíe los documentos al Oficial de Inmigración."
		},
		Summary = "Espera un minuto"
	},
	[11311] = {
		Title = "Entrada de Eclage",
		Description = {
			"Habla con el guardia de seguridad para entrar a la ciudad."
		},
		Summary = "Habla con el guardia de seguridad."
	},
	[11312] = {
		Title = "Goliat",
		Description = {
			"Inicio: NPC: Fairy Carpenter en Ubicacion: eclage (102, 32). Habla con el hada carpintera nuevamente para obtener información sobre el puente."
		},
		Summary = "Información sobre el puente"
	},
	[11313] = {
		Title = "Goliat",
		Description = {
			"Obtén el puente de Golie cerca de la Torre en las afueras de la ciudad."
		},
		Summary = "ir a golie"
	},
	[11314] = {
		Title = "Goliat",
		Description = {
			"Vuelve a Fon con el puente."
		},
		Summary = "Volver a Carpintero Fon"
	},
	[11315] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Dile al amigo de Fon, Glaces, cerca de la entrada de Eclage, que Fon no puede asistir hoy."
		},
		Summary = "Habla con Glaces"
	},
	[11316] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Encuentra a Yube en algún lugar de la ciudad."
		},
		Summary = "Encuentra a Yube"
	},
	[11317] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Vuelve a Glaces y pregunta por la edad de Moreng."
		},
		Summary = "Habla con Glaces"
	},
	[11318] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Vuelve con Murah en la plaza y pregúntale sobre la edad de Moreng."
		},
		Summary = "Habla con Murah"
	},
	[11319] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Ve a buscar a Shul en el extremo este de la ciudad y pregunta por la edad de Moreng."
		},
		Summary = "Habla con Shul"
	},
	[11320] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Ve a buscar a Tato en el extremo oeste de la ciudad y pregúntale sobre la edad de Moreng."
		},
		Summary = "hablar con tato"
	},
	[11321] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Utilizando la información recopilada de Yube, Glaces, Murah, Shul y Tato, calcula la edad de Moreng y díselo a Yube."
		},
		Summary = "Habla con Yube"
	},
	[11322] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Trae tantas bolas de polvo como la edad de Moreng para hacer velas mientras Yube hace mechas para velas."
		},
		Summary = "Obtener bolas de polvo"
	},
	[11323] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Entrega velas de cumpleaños a Glaces."
		},
		Summary = "Entregar velas de cumpleaños"
	},
	[11324] = {
		Title = "Y el tiempo sigue fluyendo",
		Description = {
			"Pregúntale a Moreng, cuyo cumpleaños se acerca, qué quiere."
		},
		Summary = "Habla con Moreng"
	},
	[11325] = {
		Title = "La gallina o el huevo",
		Description = {
			"Para hacer un nuevo Yai, Moreng dijo que quiere el huevo de un pájaro legendario como se conoce en los mitos. Escuche la leyenda."
		},
		Summary = "Habla con Moreng"
	},
	[11326] = {
		Title = "La gallina o el huevo",
		Description = {
			"Pregúntale al anciano de la plaza sobre el pájaro legendario."
		},
		Summary = "Habla con el viejo"
	},
	[11327] = {
		Title = "La gallina o el huevo",
		Description = {
			"Pregúntale al viajero quién está relacionado con la pluma fuera del pueblo."
		},
		Summary = "Habla con el viajero"
	},
	[11328] = {
		Title = "La gallina o el huevo",
		Description = {
			"Las historias del viajero fueron inventadas. Encuentra al comerciante en la plaza que vendió la pluma al viajero."
		},
		Summary = "hablar con el comerciante"
	},
	[11329] = {
		Title = "La gallina o el huevo",
		Description = {
			"Se obtuvo información sobre la enorme pluma. Vuelve a Moreng."
		},
		Summary = "Habla con Moreng"
	},
	[11330] = {
		Title = "La gallina o el huevo",
		Description = {
			"Se obtuvo información sobre lo que quería Moreng. Vuelve a Glaces."
		},
		Summary = "Habla con Glaces"
	},
	[11331] = {
		Title = "La gallina o el huevo",
		Description = {
			"Glaces va a visitar Moreng. Ella sugiere hablar con Yube."
		},
		Summary = "Habla con Yube"
	},
	[11332] = {
		Title = "La gallina o el huevo",
		Description = {
			"Es necesario empaquetar la semilla que se enviará a Splendide en una caja de semillas. Tenga cuidado ya que es un proceso difícil."
		},
		Summary = "Habla con Yube"
	},
	[11333] = {
		Title = "Semilla roja y semilla verde.",
		Description = {
			"La semilla fue empaquetada de manera segura en el contenedor de semillas. Dáselo al repartidor que espera en la plaza."
		},
		Summary = "Registrar la entrega"
	},
	[11334] = {
		Title = "Semilla roja y semilla verde.",
		Description = {
			"La caja de semillas fue entregada al repartidor. Vuelve a la casa de Yube."
		},
		Summary = "Habla con Yube"
	},
	[11335] = {
		Title = "niño soñando",
		Description = {
			"Oliver, el niño soñador, pide bellotas. Consigue bellotas."
		},
		Summary = "1 manojo de bellotas"
	},
	[11336] = {
		Title = "niño soñando",
		Description = {
			"Con Oliver, el Niño Soñador, desapareciendo tan repentinamente, tuvo que salir corriendo de la casa, pero regresar a la casa."
		},
		Summary = "Vuelve a la casa"
	},
	[11337] = {
		Title = "niño soñando",
		Description = {
			"Oliver, el niño soñador, no estaba por ningún lado. ¿Qué pasó? Habla con el grupo de Du."
		},
		Summary = "Habla con el grupo de Du."
	},
	[11338] = {
		Title = "Habla con Subino",
		Description = {
			"Inicio: NPC: Battle Instructor en Ubicacion: iz_ac01 (59, 83). Habla con Subino a cargo de las misiones de caza en la Academia Criatura."
		},
		Summary = "Habla con Subino"
	},
	[11339] = {
		Title = "Lo mas delicioso del mundo",
		Description = {
			"Caza 10 Porings y 5 Jellopy. Conoce a Subino esperando en la Academia Criatura. Los poros se pueden encontrar en el campo al oeste de Izlude."
		},
		Summary = "Porings(10), gelatina(5)"
	},
	[11340] = {
		Title = "¡Las zanahorias están deliciosas!",
		Description = {
			"Caza a 10 lunáticos y consigue una zanahoria saludable y sabrosa, luego llévasela a Subino. Los lunáticos se pueden encontrar en el campo al oeste de Izlude."
		},
		Summary = "Lunáticos(10), Zanahoria(1)"
	},
	[11341] = {
		Title = "La ropa de Rolling Fabre",
		Description = {
			"Vuelve a Subino cazando 10 Fabres y 3 Fluff. Fabres se puede encontrar fácilmente en el campo al oeste de Izlude."
		},
		Summary = "Fabres(10), Pelusa(3)"
	},
	[11342] = {
		Title = "Material del antídoto ~",
		Description = {
			"Regresa con Subino después de cazar 10 avispones, que son el material para el antídoto, y encontrar 3 picaduras de abeja. Los avispones se pueden encontrar fácilmente en el campo al oeste de Prontera."
		},
		Summary = "Avispones(10), Picadura de abeja(3)"
	},
	[11343] = {
		Title = "hablar con alicia",
