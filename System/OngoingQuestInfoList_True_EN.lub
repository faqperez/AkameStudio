	[9248] = {
		Title = "<Notas de la declaración de Rosa>",
		Description = {
			"Notas de la declaración de ^0000FFRosa^000000: regresó después de comprar, trató de ayudarme a entrar, pero estaba demasiado asustada para volver a salir después de encontrar la casa en desorden, no sospecha de los miembros de su familia."
		},
		Summary = ""
	},
	[9249] = {
		Title = "<Notas de la declaración de Rosa>",
		Description = {
			"Notas de la declaración de ^0000FFRosa^000000: regresó después de comprar, trató de ayudarme a entrar, pero tenía demasiado miedo para volver a salir después de encontrar la casa en desorden, se pregunta por qué le robaron el collar cuando no es muy caro."
		},
		Summary = ""
	},
	[9250] = {
		Title = "<Notas de la declaración de Rosa>",
		Description = {
			"Notas de la declaración de ^0000FFRosa^000000: regresó después de comprar, nada era particularmente sospechoso aparte de la casa en desorden, el collar parece ser muy importante, no sospecha de los miembros de su familia."
		},
		Summary = ""
	},
	[9251] = {
		Title = "<Notas de la declaración de Rosa>",
