	},
	[11435] = {
		Title = "Guardia de Parepele",
		Description = {
			"Inicio: NPC: Vigilante Guide en Ubicacion: lasagna (174, 160). Encuentra al Jefe de la Guardia de Parepele, el Jefe Peperoncino. Lo encuentras en el (Club de Aventureros), al este de la aldea de Lasagna."
