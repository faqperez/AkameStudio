	[9221] = {
		Title = "El noveno cumpleaños del mundo",
		Description = {
			"^8B4513Prontera^000000's ^0000FF Agente de promoción del noveno aniversario^000000 dice: ^404040Parece que nuestra promoción aún no es suficiente para que muchas personas sepan sobre el noveno aniversario. Ven a buscarme nuevamente después de que haya pasado un día; ¡¡Puede que haya algo en lo que pueda ayudarte~!!.^000000"
		},
		Summary = "Vayamos a buscar al agente de promoción del noveno aniversario después de que haya pasado un día."
	},
	[9222] = {
		Title = "Deshazte de Bangungot del Hospital 2F",
		Description = {
