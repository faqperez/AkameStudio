	[1317] = {
		Title = "La elaboración de Vin Chaud de hoy ha terminado",
		Description = {
			"Broild Vin Chaud está agotado ahora. Volvamos a las 4 a.m. cuando Vin Chaud esté listo nuevamente."
		},
		Summary = "Visita Ballery después de las 4 a.m."
	},
	[1318] = {
		Title = "El favor de Elena",
		Description = {
			"Elena pide ayudar a su hermana como sea. Para ver qué está pasando, busca a Ballery frente a la iglesia de Prontera."
		},
		Summary = "Encuentra a Ballery frente a la iglesia de Prontera"
	},
	[1319] = {
		Title = "Memoria de la Ramita de Acebo",
		Description = {
			"Ballery le regaló Ramita de Acebo para agradecer la ayuda, que puede convertirse en un hermoso artículo tejiendo. Encuentra a Brechen para pedirle que teja la ramita. La encontrarás en la plaza Izlude a las 7 en punto."
		},
		Summary = "Izlude¿¡¼Brechen"
	},
	[1320] = {
		Title = "Hacer una corona navideña",
		Description = {
			"Brechen dijo que recolecta 10 ramitas de acebo para hacer una corona navideña."
		},
		Summary = "Recoge 10 ramitas de acebo."
	},
	[1321] = {
		Title = "Spotty y su anillo",
		Description = {
			"Inicio: NPC: Mrs. McPhy en Ubicacion: harboro1 (347, 65). Spotty se llevó el anillo de la Sra. McPhy y el Sr. McPhy tiene demasiado miedo de los Buffalo Bandits como para ir a buscarlo. Debería ayudarlos."
		},
		Summary = "Encuentra el anillo que tomó Spotty."
	},
	[1322] = {
		Title = "Encontré algo",
		Description = {
			"Inicio: NPC: Mrs. McPhy en Ubicacion: harboro1 (347, 65). Encontré algo brillante dentro de uno de los agujeros que cavó Spotty, pero no es un anillo de oro. Ya he buscado bastante a lo largo de la valla de alambre de púas. Debería volver con la señora McPhy."
		},
		Summary = "Regresar con la Sra. McPhy"
	},
	[1323] = {
		Title = "Manchado, ¡no!",
		Description = {
			"Spotty llevó más cosas de la casa al terreno baldío, para consternación de la señora McPhy. Debería buscar los elementos que faltan."
		},
		Summary = "Busque artículos del hogar que Spotty tomó"
	},
	[1324] = {
		Title = "Manchado, ¡no!",
		Description = {
