	},
	[5053] = {
		Title = "Arma Tradicional",
		Description = {
			"Inicio: NPC: Gatti en Ubicacion: dew_fild01 (127, 240). Obtener la aprobación de la tribu Jaty era mi deseo más anhelado... De todos modos... obtuviste la aprobación de la tribu Jaty, por favor trae 100 cueros de Comodo en mi lugar."
