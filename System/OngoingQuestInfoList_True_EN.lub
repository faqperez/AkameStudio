	},
	[11436] = {
		Title = "Guardia de Parepele",
		Description = {
			"Inicio: NPC: Chief Peperoncino en Ubicacion: lasagna (235, 198). Hablaste con el Jefe de la Guardia Peperoncino. Para cualquier otra cosa, habla con Olio."
		},
		Summary = "Habla con Olio"
	},
	[11437] = {
		Title = "Guardia de Parepele",
		Description = {
