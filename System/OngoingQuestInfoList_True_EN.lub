		Summary = "Tienes la medicina. volver al medico"
	},
	[11057] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Por favor, reúna... ^3355FF2 Garra de leopardo^000000, ^3355FF10 Melocotón sólido^000000, ^3355FF5 Piel de sapo venenoso^000000, ^3355FF20 Raíz marrón^000000, ^3355FF10 Brote^000000 y ^3355FF5 Tarro de miel^000000."
		},
		Summary = "Obtenga los materiales que pidió Hua Tuo"
	},
