	[1009] = {
		Title = "Cambio de trabajo a comerciante",
		Description = {
			"Obtenga el paquete de entrega del almacén y luego vaya a la antigua Asociación de espadachines en Prontera. Cuando llegue allí, visite al empleado de Kafra estacionado allí. Su nombre es Flor."
