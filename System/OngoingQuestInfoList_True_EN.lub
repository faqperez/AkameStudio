	[13021] = {
		Title = "Solicitud del Titán de Hielo",
		Description = {
			"¿Has estado en la cueva de hielo al norte de Rachel? Hay monstruos llamados Titanes de Hielo en lo profundo de la mazmorra. Los estudiosos quieren determinar si son golems o no."
