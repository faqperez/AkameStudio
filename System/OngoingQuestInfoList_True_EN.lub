	[12267] = {
		Title = "Caza celacanto extraño",
		Description = {
			"¡El héroe de Culvert, fijamos una semana de caza ^0000ffWeird Coelacanth^000000 y alzamos la voz! ¡Te daré sólo una semana para terminar este trabajo! Termiante todos ellos en modo normal en mazmorra de alcantarilla!"
