	},
	[8181] = {
		Title = "Lanzador de mira",
		Description = {
			"Esta habilidad parece fácil pero es bastante difícil de aprender. Los caballeros son expertos con habilidades que hacen retroceder a los enemigos, así que busca uno que te explique la teoría de Push Back en Prontera. Verifique la dirección de las 11 en punto en su minimapa."
		},
		Summary = ""
	},
	[8182] = {
		Title = "Teoría del retroceso",
		Description = {
			"Bueno, te he explicado cómo empujar lo mejor que puedo. Concéntrate y practica la teoría por tu cuenta y podrás hacerlo."
		},
		Summary = "volver a miau"
	},
	[8183] = {
		Title = "Lanzador de mira",
		Description = {
			"No soy filántropo, así que espero algo de matrícula por toda mi instrucción y esfuerzo. ¡Ve y tráeme ^ff000010 Crystal Blues, 10 Green Lives, 10 Red Bloods, 10 Winds of Verdure^000000!"
		},
		Summary = "Lleva los materiales a Meow."
	},
	[8184] = {
		Title = "Convertidor elemental",
		Description = {
			"Traiga los materiales necesarios para que podamos construir un convertidor elemental básico. Necesitas ^ff00007 cuernos, 12 conchas de arcoíris, 10 conchas de caracol, 4 pergaminos en blanco, 10 colas de escorpión^000000."
		},
		Summary = "Regresa a Mishuna con los materiales."
	},
	[8185] = {
		Title = "Cambio elemental",
		Description = {
			"Ahora estás listo para aprender la otra habilidad, ^ff0000Cambio elemental^000000....Necesito preparar algunas cosas para esta lección, así que nos reuniremos y discutiremos esto más tarde, ¿de acuerdo?"
		},
		Summary = ""
	},
	[8186] = {
		Title = "Cambio elemental de fuego",
		Description = {
			"Por favor trae ^ff000020 Red Bloods, 1 Payon Solution, 1 Morocc Solution^000000, entonces podrás aprender ^ff0000Fire Elemental Change^000000."
		},
		Summary = "Regresa a Mishuna con los materiales."
	},
	[8187] = {
		Title = "Cambio elemental de tierra",
		Description = {
			"Traiga ^ff000020 vidas verdes, 1 solución Payon, 1 solución Morocc^000000 y luego podrá aprender ^ff0000Cambio elemental de la Tierra^000000."
		},
		Summary = "Regresa a Mishuna con los materiales."
	},
	[8188] = {
		Title = "Cambio elemental de viento",
		Description = {
			"Por favor trae ^ff000020 Winds of Verdure, 1 Payon Solution, 1 Morocc Solution^000000, entonces podrás aprender ^ff0000Wind Elemental Change^000000."
		},
		Summary = "Regresa a Mishuna con los materiales."
	},
	[8189] = {
		Title = "Cambio elemental de agua",
		Description = {
			"Traiga ^ff000020 Crystal Blues, 1 solución Payon, 1 solución Morocc^000000 y luego podrá aprender ^ff0000Cambio elemental de agua^000000."
		},
		Summary = "Regresa a Mishuna con los materiales."
	},
	[8190] = {
		Title = "guiño encantador",
		Description = {
			"¡Debes traerme ^FF00001 Crystal Mirror^0000000! Esta herramienta es imprescindible para la lección, ¡así que búscala y tráemela rápidamente!"
		},
		Summary = "Llevar 1 espejo de cristal a Canell"
	},
	[8191] = {
		Title = "Asesor encantador",
		Description = {
			"Ahora que has establecido la actitud adecuada hacia la belleza, es hora de que aprendas una técnica avanzada de seducción. Ve a buscar a mi hermana en Prontera Church. Ella estará dispuesta a enseñarte."
		},
		Summary = ""
	},
	[8192] = {
		Title = "Asesor egoísta",
		Description = {
			"Quiero tomar una bebida de verdad, ^FF0000Alcohol^000000ic. ¡Ah, y necesito algunos refrigerios para mantener toda mi energía docente! ^FF00001 Manzana, 3 plátanos, 5 galletas bien horneadas^000000 puesta una multa ^FF0000China^000000."
		},
		Summary = "Regreso a Aelle con bebida alcohólica y guarnición."
	},
	[8193] = {
		Title = "Asesor egoísta",
		Description = {
			"Ahora bien, el gesto más fácil, sutil y atractivo de todos los tiempos es el ^FF0000guiño^000000. Me ha salvado en tiempos de crisis y dominarlo realzará tus encantos."
		},
		Summary = ""
	},
	[8194] = {
		Title = "Asesor borracho",
		Description = {
			"V-vete. Habla con Canell, mi hermana...!..ZzzzzZzZZZzzzzZZ.."
		},
		Summary = ""
	},
	[8195] = {
		Title = "Amable Canell",
		Description = {
			"Ahora, un verdadero bailarín debería poder descubrir por sí solo el secreto para guiñar un ojo. Pero como soy una mujer tan amable, me dignaré explicártelo. Ho-ho ~"
		},
		Summary = ""
	},
	[8196] = {
		Title = "La disputa de la Unión Tripartita",
		Description = {
			"Inicio: NPC: Research Official en Ubicacion: mid_campin (376, 120). Esos investigadores se quejan mucho estos días. Están terriblemente estresados y creo que alguien debería escuchar sus problemas. Especialmente aquellos que se ocupan de archivos de documentos discuten entre sí muchas veces. Quizás quieras empezar hablando con ellos."
		},
		Summary = ""
	},
	[8197] = {
		Title = "Entrega de documentos",
		Description = {
			"Bien, ahora, entregue el archivo a Hue y Hansenne. Hue está a cargo de los documentos de Schwartzvalt y Hansenne está a cargo de Arunafeltz. Deberías ir a ver a Hue a la oficina de Schwartzvalt, de lo contrario, se quejaría de ello."
		},
		Summary = "Entrega los documentos a Hue y Hansenne y regresa con Ryosen."
	},
	[8198] = {
		Title = "Informe al funcionario de investigación de United",
		Description = {
			"Bueno, ya es agua derramada. Necesito ir a esa reunión, me guste o no. ¿Podría enviar esto al funcionario de United Research? Mientras tanto, debería prepararme para la reunión."
		},
		Summary = "Entregar los documentos al Oficial de Investigación de United."
	},
	[8199] = {
		Title = "El favor del funcionario de investigación de United",
		Description = {
			"¡Por favor, debe participar en la reunión y mediar con ellos si algo sale mal! Primero, debe reunirse con esas 3 personas y verificar cómo se preparan para la reunión. Aunque espero que no estén preparando armas."
		},
		Summary = ""
	},
	[8200] = {
		Title = "Solicitudes de documentos de Ryosen",
		Description = {
			"Solicité algo a la oficina de Arunafeltz pero aún no tengo nada. ¿Podrías conseguirlo de Hansenne? Lo necesito para la reunión pero nunca me lo envía. ¡Debe haberlo olvidado otra vez!"
		},
		Summary = ""
	},
	[8201] = {
		Title = "Documento faltante",
		Description = {
			"Lo perdí. ¡Creo que se me cayó al río o algo así cuando jugaba a buscar tesoros en un puente! Pero claro, esos gatitos del suroeste pueden enseñarnos a pescar, ¿sabes? ¡Quizás podamos atrapar ese documento pescando en el río!"
		},
		Summary = "Vuelve con Hansenne con el documento que atrapaste."
	},
	[8202] = {
		Title = "Restauración de Documentos",
		Description = {
			"La gente de Schwartzwalt tiene talento para restaurar cosas como ésta... ¿Por qué no le pides a Hue que restaure esto? Gritaría tan fuerte que las ventanas podrían romperse."
		},
		Summary = ""
	},
	[8203] = {
		Title = "Restauración de Documentos",
		Description = {
			"Está completamente empapado. Primero debería secar esto y planchar estos arrugados. Entonces, debería restaurar los textos. Necesito algunos materiales. Tienes que ayudarme con esto. Necesito ^0000ff1 abanico plegable de Cat Ghost, 1 sartén vieja, 1 piedra flameada, 1 tinta de calamar^000000."
		},
		Summary = "Trae 1 abanico plegable de Cat Ghost, 1 sartén vieja, 1 piedra de llama, 1 tinta de calamar."
	},
	[8204] = {
		Title = "ryosen",
		Description = {
			"La encuadernación estaba demasiado floja, así que reorganicé y encuaderné todo el archivo. Por favor, entregue este archivo antes de que sea demasiado tarde."
		},
		Summary = ""
	},
	[8205] = {
		Title = "Informe al funcionario de investigación de United",
		Description = {
			"¿Podría pedirle al funcionario que me espere un rato? Tengo que buscar otro documento para la reunión."
		},
		Summary = ""
	},
	[8206] = {
		Title = "Reunión de investigadores",
		Description = {
			"Participa en la reunión"
		},
		Summary = ""
	},
	[8207] = {
		Title = "Hansenne no es culpable",
		Description = {
			"Todo lo que quería era permitir que esas personas estuvieran cerca unas de otras, que se volvieran más amigables... Pero los problemas surgen cada vez. ¿Se te ocurre alguna idea de cómo hacer que esas personas se lleven bien?"
		},
		Summary = ""
	},
	[8208] = {
		Title = "El favor de Hansenne",
		Description = {
			"Estará bien pronto. Llegará a pensar que en realidad no fue gran cosa. Pero la cosa es que... la relación entre Ryosen y Hue no pinta nada bien. ¿Por qué no los ayudas a llevarse bien entre ellos?"
		},
		Summary = ""
	},
	[8209] = {
		Title = "Informe de Hue",
		Description = {
			"Toma, este es el informe de Rune-Midgard que llevé conmigo cuando todo salió mal en la sala de reuniones. ¿Podrías dárselo a Ryosen?"
		},
		Summary = ""
	},
	[8210] = {
		Title = "Informe al funcionario de investigación de United",
		Description = {
			"Bien. Debería programar otra reunión lo antes posible. ¿Podrías ir a ver al funcionario en lugar de a mí y concertar una reunión?"
		},
		Summary = ""
	},
	[8211] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). ¿Has estado aprendiendo el arte de usar Bash? ¡Creo fervientemente que la habilidad Bash es la esencia del manejo de la espada!"
		},
		Summary = "Domina la habilidad Bash y regresa con Shurank."
	},
	[8212] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). Veo que entiendes un poco sobre la habilidad Bash. Pero aún así, no es suficiente."
		},
		Summary = "Domina la habilidad Bash y regresa con Shurank."
	},
	[8213] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). Veo que has adquirido cierta competencia con la habilidad Bash. Pero aún así, no es suficiente."
		},
		Summary = "Domina la habilidad Bash y regresa con Shurank."
	},
	[8214] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). ¡Esos callos...! Sólo un maestro de la habilidad Bash tiene ese tipo de manos. Gran trabajo, espadachín. Estoy muy impresionado."
		},
		Summary = "Escuche la conferencia de Shurank"
	},
	[8215] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). A estas alturas, creo que sabes lo suficiente sobre la habilidad Aumentar la recuperación de HP. La próxima vez te enseñaré lo que sé sobre la habilidad Provocar."
		},
		Summary = "Escuche la conferencia de Shurank"
	},
	[8216] = {
		Title = "Orden de Shurank",
		Description = {
			"Deseo que encuentres un Caballero llamado ^5D478BDequ'ee^000000 en ^5D478BGeffen^000000. Escuche atentamente, este es el mensaje: ^0000FF¿Qué pasó con el asesino? ^0000FF¿Descubriste quién es? Si lo hiciste, ¿qué se supone que debemos hacer ahora?^000000"
		},
		Summary = "Entrega el mensaje de Shurank a Dequ'ee en Geffen."
	},
	[8217] = {
		Title = "El mensaje de Dequ'ee",
		Description = {
			"Entonces Shurank pregunta: \"¿Qué pasó con el asesino? ¿Descubriste quién es? Si lo hiciste, ¿qué se supone que debemos hacer ahora?\". No hemos descubierto con seguridad quién es el asesino. Sin embargo, tenemos una lista de sospechosos y lo resolveremos pronto."
		},
		Summary = "Entrega el mensaje de Dequ'ee a Shurank en Izlude"
	},
	[8218] = {
		Title = "La conferencia de Shurank",
		Description = {
			"¿Aún no has aprendido Provocar? Ahora te pido que te capacites en el uso de Provoke."
		},
		Summary = "Domina la habilidad, provoca y regresa con Shurank."
	},
	[8219] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Mmm. Parece que tienes un conocimiento básico de Provocar, pero déjame darte algunos detalles para que puedas comprender mejor el uso de esa habilidad."
		},
		Summary = "Domina la habilidad, provoca y regresa con Shurank."
	},
	[8220] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Ah, veo que tienes un conocimiento bastante bueno de la habilidad Provocar. La próxima vez que hablemos, te diré lo que sé sobre la habilidad ^5D478BEndure^000000. Cuando estés listo para aprender, vuelve a mí."
		},
		Summary = "Escuche la conferencia de Shurank"
	},
	[8221] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). Activar Endure te permite hacer caso omiso de los ataques. Recibirás daño, pero los ataques enemigos no te impedirán tanto. Esto significa que puedes contrarrestar los ataques enemigos o escapar si es necesario. Está bien. Ahora quiero que entrenes en el uso de la habilidad Aguantar. Puedes convertirte en un gran espadachín."
		},
		Summary = "Domina la habilidad, aguanta y regresa con Shurank."
	},
	[8222] = {
		Title = "La orden de Shurank",
		Description = {
			"Inicio: NPC: Shurank en Ubicacion: izlude_in (82, 163). Ah, una vez más, tengo otra tarea que debes realizar. Visita a Dequ'ee en Geffen ya que parece que tiene algo que pedirte. Date prisa y reúnete con Dequ'ee y regresa conmigo cuando completes lo que él desea que hagas."
		},
		Summary = "Ir a Dequ'ee"
	},
	[8223] = {
		Title = "La orden de Dequ'ee",
		Description = {
			"Ahora quiero que vayas a Marruecos e interrogues a cuatro sospechosos. Sus nombres son ^5D478BMuetro^000000, ^5D478BGeil^000000, ^5D478BHans^000000 y ^5D478BBankley^000000. No debería ser demasiado difícil. Después de hablar con todos ellos, regresa e infórmame."
		},
		Summary = "Regreso a Dequ'ee después de encontrar la evidencia en Marruecos."
	},
	[8224] = {
		Title = "la pista",
		Description = {
			"TheisWesomeof... Muy bien, genial. Ahora todo lo que tenemos que hacer es descubrir qué significa todo esto. Esto va a ser realmente difícil. Tenemos que resolver esto, es la única pista que tenemos..."
		},
		Summary = ""
	},
	[8225] = {
		Title = "El razonamiento de Dequ'ee",
		Description = {
			"¡Está bien! ¡Parece que Bankley es el asesino! Aunque no podemos confiar en esto al 100%, esta evidencia es bastante concluyente. Apresúrate a ir a Marruecos y vigila a Bankley por si hace algo desesperado. Si pasa algo, ¡infórmame de inmediato!"
		},
		Summary = "Observe de cerca a Bankley en Marruecos"
	},
	[8226] = {
		Title = "La muerte de Bankley",
		Description = {
			"-¡Está muerto! Bankley tenía una expresión triste y compasiva en su rostro. Como el color aún está fresco en sus mejillas, murió hace poco tiempo. Aquí hay una herida larga y profunda en su pecho, y un cuchillo empapado de sangre aprieta en su mano derecha."
		},
		Summary = "Informe la muerte de Bankley a Dequ'ee"
	},
	[8227] = {
		Title = "Regreso a Shurank",
		Description = {
			"¿Suicidio...? ¡Algo turbio está pasando aquí! En cuanto a los otros tres sospechosos, me aseguraré de que sean monitoreados por miembros de la Swordman Association. Parece que este caso está cerrado por ahora. Una vez más, gracias por tu ayuda. ¿Por qué no le informas a Shurank ahora? Supongo que todavía quiere mostrarte los entresijos del manejo de la espada."
		},
		Summary = "Regreso a Shurank"
	},
	[8228] = {
		Title = "La conferencia de Shurank",
		Description = {
			"Esta será mi última conferencia para ustedes. Escuche atentamente mientras le cuento todo sobre Magnum Break."
		},
		Summary = "Escuche la conferencia de Shurank"
	},
	[8229] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Realmente no puedes ser un comerciante si ni siquiera puedes transportar bienes para vender. Aumenta la habilidad de límite de peso hasta el nivel 4. Después de eso, podemos hablar más sobre cómo convertirte en un verdadero comerciante."
		},
		Summary = "Regresa a Guarnien después de dominar la habilidad Aumentar el límite de peso."
	},
	[8230] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Hablaré de la habilidad Mammonite, solo una habilidad básica como Evaluación de artículos. Por ahora, permítanme tomarme un pequeño descanso de toda esta ardua conferencia."
		},
		Summary = "Escuche la conferencia de Guarnien"
	},
	[8231] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Ahora, iba a hablarte sobre la habilidad ^FF0000Discount^000000, ¿verdad?"
		},
		Summary = "Escuche la conferencia de Guarnien"
	},
	[8232] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). ¡Está bien! Ahora, para estar más cerca de convertirte en un verdadero Comerciante, quiero que aprendas la habilidad de Descuento hasta el Nivel 4."
		},
		Summary = "Regresa a Guarnien después de dominar la habilidad, Descuento"
	},
	[8233] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Muy bien, espero que mi próxima lección les ofrezca un desafío un poco mayor. Vuelve cuando creas que estás listo, ¿de acuerdo?"
		},
		Summary = "Escuche la conferencia de Guarnien"
	},
	[8234] = {
		Title = "Investigación de mercado de Prontera",
		Description = {
			"Encontrarás algunos NPC vendiendo 10 pociones rojas en Prontera. Tu tarea es comprar las pociones al precio más barato."
		},
		Summary = "Compra 10 botellas de la poción roja más barata en Prontera y regresa a Guarnien."
	},
	[8235] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Déjame contarte sobre ^871F78Over Charge^000000."
		},
		Summary = "Escuche la conferencia de Guarnien"
	},
	[8236] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Al igual que el descuento, la sobrecarga es una habilidad pasiva que se puede dominar en el nivel de habilidad 10. ¡Personalmente, creo que deberías aprender esta habilidad con seguridad! Para tu próxima tarea, aprende Sobrecarga hasta el nivel 4. No debería ser demasiado difícil de hacer."
		},
		Summary = "Regresa a Guarnien después de dominar la habilidad Over Charge."
	},
	[8237] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Habilidad de empujar el carrito. Esté preparado para esta conferencia, ya que Push Cart es una de las habilidades más importantes para un comerciante."
		},
		Summary = "Escuche la conferencia de Guarnien"
	},
	[8238] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). En primer lugar, necesita conocer el límite de aumento de peso de nivel 5 antes de poder aprender la habilidad Empujar carrito. Como puede ver, esta habilidad es una forma avanzada de la habilidad Aumentar límite de peso. Puede adquirir un PushCart en la mayoría de Kafra Ladies por una tarifa determinada. Por ahora, ¿por qué no aprendes la habilidad Empujar carrito hasta el nivel 4?"
		},
		Summary = "Regresa a Guarnien después de dominar la habilidad Carro."
	},
	[8239] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Creo que es hora de mi conferencia final. Hablaré de la habilidad definitiva del Comerciante: ^871F78Vending^000000."
		},
		Summary = "Escuche la conferencia de Guarnien"
	},
	[8240] = {
		Title = "La conferencia de Guarnien",
		Description = {
			"Inicio: NPC: Guarnien en Ubicacion: alberta_in (70, 51). Para tu tarea final, te pediré que aprendas la habilidad de venta hasta el nivel de habilidad 4. Por supuesto, una vez que lo hagas, te daré una pequeña recompensa. Estaré esperando, así que haz lo mejor que puedas ~"
		},
		Summary = "Regresa a Guarnien después de dominar la habilidad de venta."
	},
	[8241] = {
		Title = "Colección de joya roja",
		Description = {
			"¡Has recogido una joya roja de una tumba que almacena voz en ella!"
		},
		Summary = "Le llevas esta piedra al erudito de magia en Ash-Vacuum en Rune-Midgarts."
	},
	[8242] = {
		Title = "Colección de joya azul",
		Description = {
			"¡Recogiste una joya azul de una tumba que almacena voz en ella!"
		},
		Summary = "Le llevas esta piedra al erudito de magia en Ash-Vacuum en Rune-Midgarts."
	},
	[8243] = {
		Title = "Aprender nuevos idiomas",
		Description = {
			"Inicio: NPC: Schwarzwald Mechanic en Ubicacion: mid_camp (197, 237). Los tres reinos están trabajando juntos investigando los idiomas hablados por la gente de Ash Vacuum. Busque ^0000ffel erudito en idiomas de Arunafeltz^000000."
		},
		Summary = ""
	},
	[8244] = {
		Title = "Hadas y árboles gigantes",
		Description = {
			"Inicio: NPC: Arunafeltz Linguist en Ubicacion: mid_campin (168, 82). Encuentre muestras de los idiomas hablados por las hadas y los árboles gigantes y luego informe al Linguist Dictionary qué están diciendo exactamente."
		},
		Summary = "Informe al estudioso de la lengua de Arunafeltz."
	},
	[8245] = {
		Title = "Investigación de muestra de idioma",
		Description = {
			"Inicio: NPC: Arunafeltz Linguist en Ubicacion: mid_campin (168, 82). Encuentra al mago Rune-Midgarts deambulando por el campamento de expedición."
		},
		Summary = ""
	},
	[8246] = {
		Title = "Investigación de muestra de idioma",
		Description = {
			"Inicio: NPC: Rune-Midgarts Magician en Ubicacion: mid_camp (147, 256). ¿Te reuniste con las dos nuevas razas? Los asesinos enterraron joyas por allí. Pero ten cuidado al recolectarlos, ya que tienen algunas trampas."
		},
		Summary = "Encuentra las joyas y tráelas al mago Rune-Midgart."
	},
	[8247] = {
		Title = "Progreso de la investigación",
		Description = {
			"Inicio: NPC: Rune-Midgarts Magician en Ubicacion: mid_camp (147, 256). Enviaré la voz extraída de las joyas al erudito en idiomas de Arunafeltz. Si no está tan ocupado, ¿puede comprobar el progreso de la investigación del estudioso del idioma?"
		},
		Summary = ""
	},
	[8248] = {
		Title = "Progreso de la investigación",
		Description = {
			"Inicio: NPC: Arunafeltz Linguist en Ubicacion: mid_campin (168, 82). ¿Cómo vamos a reunir estos tremendos datos y convertirlos en un traductor portátil? ¿Puede pedirle la opinión al ingeniero mecánico de Schwartzwalt?"
		},
		Summary = ""
	},
	[8249] = {
		Title = "Comprimir información",
		Description = {
			"Inicio: NPC: Schwarzwald Mechanic en Ubicacion: mid_camp (197, 237). Vuelve con Rune-Midgart Magician y mira si sabe cómo comprimir información usando su magia."
		},
		Summary = ""
	},
	[8250] = {
		Title = "Gema de almacenamiento",
		Description = {
			"Inicio: NPC: Rune-Midgarts Magician en Ubicacion: mid_camp (147, 256). Fuera de Ash-Vacuum, hay ^0000ff piedras considerablemente misteriosas que no se encuentran en Midgard^000000. ¿Puedes traerme uno de ellos?"
		},
		Summary = "Encuentra un mineral no identificado y tráelo a Magician Whisper."
	},
	[8251] = {
		Title = "Inyección de magia",
		Description = {
			"Inicio: NPC: Rune-Midgarts Magician en Ubicacion: mid_camp (147, 256). Espere un momento mientras Magician Whisper trabaja con la joya."
		},
		Summary = ""
	},
	[8252] = {
		Title = "Joyas trabajadas a mano",
		Description = {
			"Inicio: NPC: Rune-Midgarts Magician en Ubicacion: mid_camp (147, 256). Esta es la última petición. Por favor, lleve esta joya trabajada al ingeniero mecánico de Schwartzwalt."
		},
		Summary = ""
	},
	[8253] = {
		Title = "Dispositivo de traducción de idiomas",
		Description = {
			"Inicio: NPC: Schwarzwald Mechanic en Ubicacion: mid_camp (197, 237). Necesito hacer el dispositivo que pueda leer el código mágico de las joyas. Solo debería tomarme 1 hora terminar de hacerlo."
		},
		Summary = "Regreso después de 1 hora"
	},
	[8254] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Inicio: NPC: Survival Instructor en Ubicacion: tur_dun01 (156, 36). Antes de cambiar de trabajo necesitas purificar tu cuerpo y tu mente haciendo que tu peso sea igual a 0."
		},
		Summary = "Haz que tu peso sea 0 y luego ve a Instructor Rescue"
	},
	[8255] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Es hora de poner a prueba tu poder para recibir tu primera calificación."
		},
		Summary = "Habla con Rescue para iniciar la prueba de poder de supervivencia."
	},
	[8256] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Dirígete hacia el área noroeste de Turtle Island y encuentra al instructor de pruebas Teardrop."
		},
		Summary = ""
	},
	[8257] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Obtenga una ^0000ffDragon Tail^000000, traiga 1 Wing of Dragonfly^000000 y tráigasela al instructor de pruebas Teardrop."
		},
		Summary = ""
	},
	[8258] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Teardrop se va a comer el ala de Dragonfly. Continúe su conversación con ella."
		},
		Summary = "Continúe su conversación con el instructor Teardrop"
	},
	[8259] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Realiza las 3 pruebas en la sala de exámenes y pásalas para convertirte en Ranger."
		},
		Summary = ""
	},
	[8260] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Inicio: NPC: Staff Rust en Ubicacion: job3_rang02 (111, 56). Navega a través de los monstruos y entrega la Carta de precaución. Asegúrese de usar las 10 cápsulas de Bomb Ring antes de llegar a la Advertencia del supervisor de pruebas."
		},
		Summary = ""
	},
	[8261] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Inicio: NPC: Test Supervisor en Ubicacion: job3_rang02 (251, 49). La tercera prueba es cómo puedes utilizar un lobo de forma eficaz. ¡Controla al lobo y desmantela todas las bombas que se invocan!"
		},
		Summary = ""
	},
	[8262] = {
		Title = "Cambio de trabajo a guardabosques",
		Description = {
			"Finalmente has superado todas las pruebas para convertirte en Ranger."
		},
		Summary = "Habla con el Ranger Master para cambiar tu trabajo."
	},
	[8265] = {
		Title = "¡Una vez cada una hora!",
		Description = {
			"¡Exagerar un juego será perjudicial!"
		},
		Summary = "No puedes jugar con Yohean en una hora."
	},
	[8266] = {
		Title = "Caza de Poison Spore",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 10 Poison Spores para Sponiac en Geffen."
		},
		Summary = "Caza 10 Poison Spores"
	},
	[8267] = {
		Title = "Caza de Smokie",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 10 Smokies para Sponiac en Geffen."
