		Summary = "Baba Yaga, el Horrible"
	},
	[18075] = {
		Title = "Conteniendo el discurso de la gente",
		Description = {
			"Debes encontrar y contener las voces de 3 personas. Desde un niño, un joven y una persona de mediana edad. Necesitas contener la frase de deseo, no quiero que llegue el invierno, de las 3 personas diferentes."
