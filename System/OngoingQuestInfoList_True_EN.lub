	[14232] = {
		Title = "¡¡Otra vez mañana!!",
		Description = {
			"Hablar con los animales parece curar tanto el cuerpo como la mente. Mañana volveré a hablar con ellos."
		},
		Summary = "Visita a los animales de nuevo."
	},
	[14233] = {
		Title = "¡Un desafío diario!",
		Description = {
			"El bulto del Sr. Rakumas parece contener todo tipo de cosas sin usar. Mañana volveré a asumir el desafío."
		},
		Summary = "¡Un desafío diario!"
	},
	[14234] = {
		Title = "Ahora no es un buen momento",
		Description = {
			"Tendré que volver mañana con bocadillos."
		},
		Summary = "un dia de espera"
	},
	[14235] = {
		Title = "Prontera invadida",
		Description = {
			"Annie dijo que se reunirá contigo cerca de las puertas del castillo en Prontera. Dijo que se esconderá, por lo que es posible que tengas que buscar."
		},
		Summary = "encontrar a annie"
	},
	[14236] = {
		Title = "jardinero de frutas",
		Description = {
			"Encuentra a la fruticultora que crees recordar que tenía su puesto en el suroeste de Prontera."
		},
		Summary = ""
	},
	[14237] = {
		Title = "Al gremio de mercenarios",
		Description = {
			"Para ingresar al castillo, necesitarás ayuda. Ve al gremio de mercenarios para ver si hay alguien vivo."
		},
		Summary = "Al gremio de mercenarios"
	},
	[14238] = {
		Title = "Derrota a los arqueros orcos",
		Description = {
			"Has aceptado hacerle un favor al líder del gremio. Derrota a 50 arqueros orcos e intenta mantener vivo al mercenario."
		},
		Summary = ""
	},
	[14239] = {
		Title = "padre tomillo",
		Description = {
			"El padre Thyme tiene una solicitud para el gremio de mercenarios. Ve a la iglesia de Prontera y habla con el padre Thyme."
		},
		Summary = "padre"
	},
	[14240] = {
		Title = "Obtenga los suministros",
		Description = {
			"Todos los soldados fueron atacados cuando entregaban ayuda a la Iglesia. Encuentra suministros en los edificios abandonados de Prontera."
		},
		Summary = "5 vendas limpias, 5 alcoholes isopropílicos, 5 hierba agria, 5 botiquín de primeros auxilios, 5 alimentos de socorro"
	},
	[14241] = {
		Title = "De vuelta al castillo",
		Description = {
			"El padre Thyme envió algunos de los soldados recuperados para derrotar a algunos de los Orcos cerca del castillo. Volvamos a la entrada del castillo."
		},
		Summary = ""
	},
	[14242] = {
		Title = "¡Derrota al guardián!",
		Description = {
			"El portero descubrió que estamos intentando entrar al castillo. ¡Derrota al guardián!"
		},
		Summary = ""
	},
	[14243] = {
		Title = "¡Entra al castillo!",
		Description = {
			"El portero se ha ido. Entra en el castillo y descubre los planes del Orco."
		},
		Summary = "¡Entra al castillo!"
	},
	[14244] = {
		Title = "Más allá del portal",
		Description = {
			"Un Goblin Shaman está intentando abrir el portal. Detenga su plan ingresando al portal."
		},
		Summary = ""
	},
	[14245] = {
		Title = "A la cueva del Payón",
		Description = {
			"A Annie le dijeron que hay una pista para detener a los Orcos. Vayamos a Payon Cave para encontrarlo."
		},
		Summary = ""
	},
	[14246] = {
		Title = "Encuentra una pista 1",
		Description = {
			"El dueño de la lechería dijo que escondió la nota que tiene una manera de detener esta amenaza en alguna parte. Busquemos una pista."
		},
		Summary = ""
	},
	[14247] = {
		Title = "Encuentra una pista 2",
		Description = {
			"El dueño de la lechería dijo que escondió la nota que tiene una manera de detener esta amenaza en alguna parte. Busquemos una pista."
		},
		Summary = "Encuentra una pista 2"
	},
	[14248] = {
		Title = "A Glast Heim",
		Description = {
			"Hay una nota del propietario de una lechería en Glast Heim. Encuentra la nota cerca del centro de la iglesia."
		},
		Summary = "¡A Glast Heim!"
	},
	[14249] = {
		Title = "Hasta Lighthalzen",
		Description = {
			"En algún lugar del laboratorio Lighthalzen, hay una máquina antigua que mencionó el propietario de la lechería."
		},
		Summary = "¡Al Biolab!"
	},
	[14250] = {
		Title = "Informe a Annie",
		Description = {
			"Tienes el Note y la máquina rara. Muéstraselos a Annie."
		},
		Summary = "¡Informe a Annie!"
	},
	[14251] = {
		Title = "Partido final con el líder orco.",
		Description = {
			"El líder orco ha llegado. ¡Derrótalo y salva a Prontera!"
		},
		Summary = "Derrota al líder orco."
	},
	[14252] = {
		Title = "repetir el tiempo",
		Description = {
			"Espera a que acabe el cronómetro antes de volver a enfrentarte a los Orcos. Habla con Annie en Prontera si deseas enfrentarte a los Orcos nuevamente."
		},
		Summary = "repetir el tiempo"
	},
	[14253] = {
		Title = "Sombrero de jefe",
		Description = {
			"Dale el sombrero al jefe"
		},
		Summary = "Dale el sombrero al jefe"
	},
