	},
	[60340] = {
		Title = "V.I.P.E.R. Sede",
		Description = {
			"Las pruebas apuntan al campo 9 de Einbroch como el V.I.P.E.R. sede. Dirígete allí y busca una fábrica donde posiblemente esté detenido O'Riley."
		},
		Summary = ""
	},
	[60341] = {
		Title = "Encuentra a O'Riley",
		Description = {
			"Encontraste una nota en una pared que indica que O'Riley está detenido en el faro de Pharos de Beacon Island. Es probable que O'Riley esté detenido en un barco allí."
		},
		Summary = ""
	},
	[60351] = {
		Title = "Fantasma del baño",
		Description = {
			"Escuchas algo desde el baño. La segunda línea de la canción de Pedro era \"^FF0000Madre, ¡el agua se está inundando!^000000\" Si la luna desaparece 3 veces, no te preocupes."
		},
		Summary = ""
	},
	[60352] = {
		Title = "Fantasma del baño",
		Description = {
			"Escuchas algo del grifo. La tercera línea de la canción de Pedro era \"^FF0000Madre, ¡la sequía ha comenzado!^000000\" No te preocupes, la cascada te ayudará."
		},
		Summary = ""
	},
	[60353] = {
		Title = "Fantasma del baño",
		Description = {
			"Se oye algo desde la alfombra. La cuarta línea de la canción de Pedro era \"^FF0000Madre, ¿dónde están mis amigos?^000000\" Tus 7 amigos están durmiendo. ahora es el momento de despertarlos."
		},
		Summary = ""
	},
	[60354] = {
		Title = "Fantasma del baño",
		Description = {
			"Escuchas algo en el espejo. La quinta línea de la canción de Pedro era \"^FF0000¿Dónde estás mamá?^000000\" No te preocupes, la cascada te ayudará."
		},
		Summary = ""
	},
	[60355] = {
		Title = "Fantasma del baño",
		Description = {
