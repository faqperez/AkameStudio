		},
		Summary = ""
	},
	[60935] = {
		Title = "Misterio del asesinato del museo",
		Description = {
			"Estás convencido de que el culpable debe haber sido el conservador jefe. Es hora de ir y presentarle tu acusación."
		},
		Summary = ""
	},
	[60936] = {
		Title = "Misterio del asesinato del museo",
		Description = {
