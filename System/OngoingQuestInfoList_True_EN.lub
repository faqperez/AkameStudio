	[7365] = {
		Title = "Mejor que mi viejo botón-2",
		Description = {
			"Inicio: NPC: Old Man Nardo en Ubicacion: malaya (181, 353). Siguió el consejo de Mumbaki Phong y entregó objetos sagrados a los aldeanos para que los llevaran como agimats. Tendré que hablar con él nuevamente sobre qué hacer a continuación."
		},
		Summary = "Habla en serio con Mumbaki."
	},
	[7366] = {
		Title = "Protección espiritual tradicional y chica imprudente-1",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Imelda, la nieta de Mumbaki Phong, crea protecciones espirituales tradicionales. Se recibió una solicitud para conseguir materiales para realizar estas protecciones. Sal de las costas noroeste, Bambú de Baryo y Cruces de Plata de Pandoi."
		},
		Summary = "6 bolsas de sal, 6 bambúes afilados, 6 cruces de plata"
	},
	[7367] = {
		Title = "Protección espiritual tradicional y chica imprudente-2",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Espera a que la chica termine de hacer las Protecciones Espirituales. No tardará mucho. Quizás una taza de té para vencer al tiempo..."
		},
		Summary = ""
	},
	[7368] = {
		Title = "Entregar protección espiritual-Pedro",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Entrega la Protección Espiritual terminada a Pedro, Marinero en el puerto."
		},
		Summary = ""
	},
	[7369] = {
