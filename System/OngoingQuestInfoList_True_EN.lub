		Title = "Sector restringido F",
		Description = {
			"Inicio: NPC: Prisoner 117FM188 en Ubicacion: prt_prison (117, 188). Ha terminado de explorar el Sector F. Informe la situación actual a Ellond Lawrence."
		},
		Summary = ""
	},
	[5422] = {
		Title = "Sector restringido G",
		Description = {
			"Inicio: NPC: Prisoner 103GD214 en Ubicacion: prt_prison (103, 214). Ha terminado de explorar el Sector G. Informe la situación actual a Ellond Lawrence."
		},
		Summary = ""
	},
	[5423] = {
		Title = "Sector restringido H",
		Description = {
			"Inicio: NPC: Prisoner 55HK115 en Ubicacion: prt_prison (55, 115). Ha terminado de explorar el Sector H. Informe la situación actual a Ellond Lawrence."
		},
		Summary = ""
	},
	[5424] = {
		Title = "(Completo)Sector Restringido",
		Description = {
			"Inicio: NPC: Ellond Lawrence en Ubicacion: prt_pri00 (51, 116). Has terminado de explorar el Sector Restringido."
		},
		Summary = ""
	},
	[5425] = {
		Title = "A mi amado compañero",
		Description = {
			"Inicio: NPC: Prisoner 243AD265 en Ubicacion: prt_prison (243, 265). ¿Qué pasa si escuchas una voz familiar en una prisión oscura? Puede que te asuste un poco, pero te sentirás algo nostálgico. Busquemos la fuente de la voz."
		},
		Summary = ""
	},
	[5426] = {
		Title = "(en espera) A mi amado compañero",
		Description = {
			"Inicio: NPC: Prisoner 243AD265 en Ubicacion: prt_prison (243, 265). Has enviado la noticia del viejo amigo. ¿Por qué no le permites perder un tiempo en viejos recuerdos?"
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5427] = {
		Title = "(Repetir) A mi amado compañero",
		Description = {
			"Inicio: NPC: Prisoner 243AD265 en Ubicacion: prt_prison (243, 265). El intercambio regular de cartas es bueno para la salud mental de los presos. Consigue la carta del amigo en algún lugar de la prisión subterránea."
		},
		Summary = ""
	},
	[5428] = {
		Title = "Estándares humildes",
		Description = {
			"Inicio: NPC: Prisoner 267BD184 en Ubicacion: prt_prison (267, 184). El prisionero que parece coleccionar ojos bonitos te ha pedido que le traigas 20 ojos rojos del monstruo con alas de murciélago. ¿Es un problema de autoestima?"
		},
		Summary = ""
	},
	[5429] = {
		Title = "(en espera) Estándares humildes",
		Description = {
			"Inicio: NPC: Prisoner 267BD184 en Ubicacion: prt_prison (267, 184). El prisionero está enamorado de los ojos rojos. ¿Por qué no traes más después para calmar al prisionero otra vez?"
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5430] = {
		Title = "(Repetir) Estándares humildes",
		Description = {
			"Inicio: NPC: Prisoner 267BD184 en Ubicacion: prt_prison (267, 184). El prisionero te pidió que fueras a buscar más. Traigamos 20 ojos rojos para calmar al prisionero."
		},
		Summary = ""
	},
	[5431] = {
		Title = "vida limpia",
		Description = {
			"Inicio: NPC: Prisoner 265CM154 en Ubicacion: prt_prison (265, 154). Necesitas limpiar la sucia prisión subterránea. Limpia con el corazón lleno de alegría."
		},
		Summary = ""
	},
	[5432] = {
		Title = "La limpieza está completa",
		Description = {
			"Inicio: NPC: Rubbish heap en Ubicacion: prt_prison (118, 247). Has terminado de limpiar la prisión subterránea. ¿Por qué no regresas por un cheque?"
		},
		Summary = ""
	},
	[5433] = {
		Title = "(en espera) Vida limpia",
		Description = {
			"Inicio: NPC: Prisoner 265CM154 en Ubicacion: prt_prison (265, 154). ¿Lo sabes? Es el momento de esperar la diversión de hacer un desastre después del placer de limpiar."
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5434] = {
		Title = "(Repetir)Vida Limpia",
		Description = {
			"Inicio: NPC: Prisoner 265CM154 en Ubicacion: prt_prison (265, 154). Es el momento de sentir el placer de limpiar. Limpiemos la prisión subterránea con el corazón lleno de alegría."
		},
		Summary = ""
	},
	[5435] = {
		Title = "(Repetir)La limpieza está completa",
		Description = {
			"Inicio: NPC: Rubbish heap en Ubicacion: prt_prison (118, 247). Has terminado de limpiar la prisión subterránea. ¿Por qué no regresas por un cheque?"
		},
		Summary = ""
	},
	[5436] = {
		Title = "Encontrar luces",
		Description = {
			"Inicio: NPC: Prisoner 95EB72 en Ubicacion: prt_prison (95, 72). Este prisionero parece odiar la oscuridad. Traigamos una luz brillante desde la enorme antorcha a esta prisión."
		},
		Summary = ""
	},
	[5437] = {
		Title = "(en espera)Encontrar luces",
		Description = {
			"Inicio: NPC: Prisoner 95EB72 en Ubicacion: prt_prison (95, 72). Parece estar satisfecho con la luz brillante. Traigamoslo una vez más cuando la luz esté a punto de apagarse."
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5438] = {
		Title = "(Repetir)Encontrar luces",
		Description = {
			"Inicio: NPC: Prisoner 95EB72 en Ubicacion: prt_prison (95, 72). Traigamos nuevamente una luz brillante desde la enorme antorcha a esta prisión."
		},
		Summary = ""
	},
	[5439] = {
		Title = "Una refrescante vida carcelaria",
		Description = {
			"Inicio: NPC: Prisoner 117FM188 en Ubicacion: prt_prison (117, 188). El prisionero parece incómodo en la húmeda prisión. Traiga 20 deshumidificadores para la agradable vida carcelaria del preso."
		},
		Summary = ""
	},
	[5440] = {
		Title = "(en espera)Refrescante vida carcelaria",
		Description = {
			"Inicio: NPC: Prisoner 117FM188 en Ubicacion: prt_prison (117, 188). Como la prisión es un lugar húmedo, los deshumidificadores se acabarían tarde o temprano. Trae más cuando se acaben."
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5441] = {
		Title = "(Repetir) Una vida carcelaria refrescante",
		Description = {
			"Inicio: NPC: Prisoner 117FM188 en Ubicacion: prt_prison (117, 188). Como era de esperar, los deshumidificadores no duraron mucho. Trae 20 deshumidificadores nuevamente."
		},
		Summary = ""
	},
	[5442] = {
		Title = "Suprimiendo la oscuridad",
		Description = {
			"Inicio: NPC: Prisoner 103GD214 en Ubicacion: prt_prison (103, 214). Una flor no sólo ilumina la oscuridad sino que también trae paz a la mente. Trae una flor."
		},
		Summary = ""
	},
	[5443] = {
		Title = "(en espera) Suprimiendo la oscuridad",
		Description = {
			"Inicio: NPC: Prisoner 103GD214 en Ubicacion: prt_prison (103, 214). La oscuridad se ha calmado, pero puede volverse rebelde nuevamente. Cuando llegue el momento, quizá tenga que traer otra flor."
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5444] = {
		Title = "(Repetir)Suprimiendo la oscuridad",
		Description = {
			"Inicio: NPC: Prisoner 103GD214 en Ubicacion: prt_prison (103, 214). La oscuridad vuelve a arrasar. Trae una flor. ¿Qué flor debería traer esta vez?"
		},
		Summary = ""
	},
	[5445] = {
		Title = "Pequeña cosa molesta",
		Description = {
			"Inicio: NPC: Prisoner 55HK115 en Ubicacion: prt_prison (55, 115). Un pequeño golpe en la bocina... No puedo entenderlo ya que no tengo bocina, pero supongo que se supone que es algo molesto. Traigamos 20 trozos de papel de lija cazando los caramelos."
		},
		Summary = ""
	},
	[5446] = {
		Title = "(en espera) Cosita molesta",
		Description = {
			"Inicio: NPC: Prisoner 55HK115 en Ubicacion: prt_prison (55, 115). Este prisionero que realmente parece considerarme un conserje de este hotel penitenciario puede llamarme regularmente."
		},
		Summary = "Hora de reinicio 4:00 am"
	},
	[5447] = {
		Title = "(Repetir) Cosita molesta",
		Description = {
			"Inicio: NPC: Prisoner 55HK115 en Ubicacion: prt_prison (55, 115). ¿Por qué necesita más trozos de papel de lija? Ya que te lo pide, caza Taffies y trae 20 trozos de papel de lija."
		},
		Summary = ""
	},
	[5448] = {
		Title = "Solicitud del jefe de guardia",
		Description = {
			"Inicio: NPC: Pron Dungeon Helper en Ubicacion: prt_q (5, 5). El jefe de guardia de Prontera, Spiegel, te pidió que ayudaras a los aldeanos en peligro en los lugares marcados en el mapa."
		},
		Summary = ""
	},
	[5449] = {
		Title = "Solicitud del jefe de guardia",
		Description = {
			"Inicio: NPC: Pron Dungeon Helper en Ubicacion: prt_q (5, 5). El jefe de guardia de Prontera, Spiegel, te pidió que ayudaras a los aldeanos en peligro en los lugares marcados en el mapa."
		},
		Summary = ""
	},
	[5450] = {
		Title = "Solicitud del jefe de guardia",
		Description = {
			"Inicio: NPC: Pron Dungeon Helper en Ubicacion: prt_q (5, 5). El jefe de guardia de Prontera, Spiegel, te pidió que ayudaras a los aldeanos en peligro en los lugares marcados en el mapa."
		},
		Summary = ""
	},
	[5451] = {
		Title = "Solicitud del jefe de guardia",
		Description = {
			"Inicio: NPC: Pron Dungeon Helper en Ubicacion: prt_q (5, 5). El jefe de guardia de Prontera, Spiegel, te pidió que ayudaras a los aldeanos en peligro en los lugares marcados en el mapa."
		},
		Summary = ""
	},
	[5452] = {
		Title = "(en espera) Solicitud del jefe de guardia",
		Description = {
			"Inicio: NPC: Chief Guard en Ubicacion: prt_q (156, 324). Ayudaste al aldeano de Prontera. Durante un tiempo, tendrás que caminar por la ciudad trabajando para derrotar a los no-muertos."
		},
		Summary = ""
	},
	[5453] = {
		Title = "Ingrato(1)",
		Description = {
			"Inicio: NPC: Village Lad en Ubicacion: prt_q (221, 193). Conociste a un muchacho del pueblo que temblaba de miedo. En primer lugar, lleve al muchacho del pueblo a la oficina del pueblo, que es el refugio más cercano."
		},
		Summary = ""
	},
	[5454] = {
		Title = "Ingrato(2)",
		Description = {
			"Inicio: NPC: Village Lad en Ubicacion: prt_q (77, 98). Cuando llevaste al muchacho del pueblo al refugio cercano, te pidió que buscaras una bolsa de herramientas que perdió cerca de la fundición."
		},
		Summary = ""
	},
	[5455] = {
		Title = "Ingrato(3)",
		Description = {
			"Inicio: NPC: Tool Bag en Ubicacion: prt_q (178, 185). Encontraste la bolsa de herramientas perdida del muchacho del pueblo frente a la fundición Prontera."
		},
		Summary = ""
	},
	[5456] = {
		Title = "Ingrato(4)",
		Description = {
			"Inicio: NPC: Village Lad en Ubicacion: prt_q (77, 98). Entregaste la bolsa de herramientas del muchacho del pueblo de manera segura. No te sientes muy bien por eso, pero sigamos adelante ya que has hecho algo bueno."
		},
		Summary = ""
	},
	[5457] = {
		Title = "Encuentra a mi hermana(1)",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: prt_q (276, 242). Lleva a la niña que estaba llorando después de perder a su hermana a la catedral, que es el refugio más cercano."
		},
		Summary = ""
	},
	[5458] = {
		Title = "Encuentra a mi hermana (2)",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: prt_q (229, 317). Lleva a la niña con su hermana en el edificio de los Caballeros, que es otro refugio."
		},
		Summary = ""
	},
	[5459] = {
		Title = "Encuentra a mi hermana (3)",
		Description = {
			"Inicio: NPC: Rosa Erinin en Ubicacion: prt_q (55, 347). Ayudaste a la niña que lloraba después de ser separada de su hermana a conocer a su hermana."
		},
		Summary = ""
	},
	[5460] = {
		Title = "Un farol descarado(1)",
		Description = {
			"Inicio: NPC: Soldier en Ubicacion: prt_q (140, 304). Lleva al soldado al edificio de los Caballeros, que es el refugio más cercano."
		},
		Summary = ""
	},
	[5461] = {
		Title = "Farol descarado(2)",
		Description = {
			"Inicio: NPC: Soldier en Ubicacion: prt_q (68, 336). Podría haberse quedado en el edificio del Caballero, pero insistió en ir a otro lugar para retroceder. Llevémoslo a la oficina del pueblo como quiera."
		},
		Summary = ""
	},
	[5462] = {
		Title = "Farol descarado(3)",
		Description = {
			"Inicio: NPC: Soldier en Ubicacion: prt_q (79, 102). ¿Por qué esta soldadura farol de Geffen en Prontera? Consideremos significativo haberlo ayudado."
		},
		Summary = ""
	},
	[5463] = {
		Title = "Amor loco por la esposa (1)",
		Description = {
			"Inicio: NPC: Eryus en Ubicacion: prt_q (38, 261). Prometiste encontrar a la esposa de Eryus. Llevemos a Eryus a la catedral segura."
		},
		Summary = ""
	},
	[5464] = {
		Title = "Amor loco por la esposa (2)",
		Description = {
			"Inicio: NPC: Eryus en Ubicacion: prt_q (231, 310). Eryus te dijo que había perdido a su esposa cerca de la agencia de empleo Prontera. Vamos a buscarla cerca de la agencia de empleo."
		},
		Summary = ""
	},
	[5465] = {
		Title = "Amor loco por la esposa (3)",
		Description = {
			"Inicio: NPC: Female en Ubicacion: prt_q (108, 164). Conociste a Ellie. la esposa de Erius. Como es una mujer frágil, llevémosla rápidamente a la catedral segura."
		},
		Summary = ""
	},
	[5466] = {
		Title = "Amor loco por la esposa (4)",
		Description = {
			"Inicio: NPC: Eryus en Ubicacion: prt_q (231, 310). La enfermedad de Ellie parece haber empeorado a medida que se relajó un poco. Ve al lugar donde conociste a Ellie y busca su medicina perdida."
		},
		Summary = ""
	},
	[5467] = {
		Title = "Amor loco por la esposaQuest(5)",
		Description = {
			"Inicio: NPC: Emergency Medicine en Ubicacion: prt_q (111, 166). Encontraste la medicina. Llévaselo a Ellie antes de que su enfermedad se agrave."
		},
		Summary = ""
	},
	[5468] = {
		Title = "Amor loco por la esposa (6)",
		Description = {
			"Inicio: NPC: Eryus en Ubicacion: prt_q (231, 310). Has ayudado a la pareja, Ellie y Eryus, que parecen estar profundamente enamorados. Estás feliz de ver a los verdaderos tortolitos dentro de mucho tiempo."
		},
		Summary = ""
	},
