		},
		Summary = "Habla con Peperoncino"
	},
	[11438] = {
		Title = "Guardia de Parepele",
		Description = {
			"Inicio: NPC: Chief Peperoncino en Ubicacion: lasagna (235, 198). Ha comenzado la primera prueba. Sigue a Peperoncino."
		},
