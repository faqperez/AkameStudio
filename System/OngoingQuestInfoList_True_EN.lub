		Title = "Los juicios de Astrild",
		Description = {
			"Llévale el agua bendita a Chee Joo, el sacerdote principal, en el templo de Payon."
		},
		Summary = ""
	},
	[60721] = {
		Title = "Sello de Megingjard",
		Description = {
			"Debería avisarle a Rebarev Doug que estoy a punto de irme, oh, pero primero debería asegurarme de saber más sobre la MISIÓN FINAL."
		},
		Summary = ""
	},
	[60722] = {
		Title = "Sello de Megingjard",
		Description = {
			"no usado"
		},
		Summary = ""
	},
	[60723] = {
		Title = "Sello de Megingjard",
		Description = {
			"Pregúntale al bibliotecario Jekan si ha encontrado el papeleo de la misión final del primer escuadrón. Tiene mala vista y necesita una lupa y una linterna."
		},
		Summary = ""
	},
	[60724] = {
		Title = "Sello de Megingjard",
		Description = {
			"El bibliotecario Jekan parece estar ocupado, tal vez debería simplemente \"leer algunos documentos\" por un tiempo y luego revisar los estantes hasta que él descubra dónde debo buscar en los estantes \"The 3rd Platoon Records\"."
		},
		Summary = ""
	},
	[60725] = {
		Title = "Sello de Megingjard",
		Description = {
			"Jekan necesitará algunos elementos para hacer una copia de los registros. 2 papeles resbaladizos y 1 papel al óleo de Amatsu, 3 plumas de pájaros de Marruecos y 20 gemas azules de Geffen."
		},
		Summary = "Llévale estos objetos a Jekan para que termine la copia más rápido."
	},
	[60726] = {
		Title = "Sello de Megingjard",
		Description = {
			"Tu copia de los registros tiene una extraña magia de búsqueda. Para encontrar información específica, primero debe buscar un tema amplio y luego ser más específico: crusader 3rd_company 3rd_platoon 1st_squad."
		},
		Summary = "Busque los nombres de los miembros individuales para saber dónde se encuentran hoy en día."
	},
	[60727] = {
		Title = "Sello de Megingjard",
		Description = {
			"Encuentra a Zan Huadoku dentro del gremio de herreros Geffen. Sea cortés cuando le pregunte cómo está antes de saltar a preguntarle sobre su misión final ultrasecreta. ¡Sí, ese es el boleto!"
		},
		Summary = ""
	},
	[60728] = {
		Title = "Sello de Megingjard",
		Description = {
			"Zan Huadoku te ha dicho todo lo que crees que es posible. Deberías dirigirte a Marruecos para encontrar a \"Cuaque Donon\", quien fue visto por última vez en la posada. Tienes la sensación de que quizás tengas que ser terco en Marruecos."
		},
		Summary = ""
	},
	[60729] = {
		Title = "Sello de Megingjard",
		Description = {
			"Cuaque Donon está en un escondite del Gremio Pícaro, probablemente en \"Fortaleza Saint Darmain (Sur)\" (use Ctrl del mapa + ~). La contraseña para ingresar debe ser \"Aragham nunca acumuló elementos de mejora\"."
		},
		Summary = "Cuaque sufre de trastorno de estrés postraumático extremo y \"se asusta\", así que fingir que es un niño pequeño ayudaría, tal vez incluso una muñeca jajaja."
	},
	[60730] = {
		Title = "Sello de Megingjard",
		Description = {
			"Cuaque dijo que el escuadrón encontró el \"Megingjard\" y estalló una discusión... Necesitas saber más sobre esa discusión, tal vez Jack.O en Alberta en los muelles pueda ayudar."
		},
		Summary = "Todavía es un cruzado activo, así que creo que hablar con él será mucho más sencillo."
	},
	[60731] = {
		Title = "Sello de Megingjard",
		Description = {
			"Jack.O encontró algo de alivio con \"Green Herb\". Quizás debería transmitir ese consejo a los demás cruzados que conozca. Emma Searth está en Aldebaran, ¡un barco rápido a Izlude y un viaje de Kafra a Aldebaran me llevarán allí en un santiamén!"
		},
		Summary = "Tal vez también debería contemplar una ayuda para la memoria de estos cruzados, algo que les ayude a recordar su lugar, como un \"clip de libro\" de una \"Palabra de viaje\"."
	},
	[60732] = {
		Title = "Sello de Megingjard",
		Description = {
			"Creo que tengo que darme prisa para ver a \"The Nineball\", trabaja como portero en la posada Jawaii. Escuché que hay un ex camarero de Jawaii trabajando en el Pub Central Prontera, ¡quizás sepa una manera de llegar a Jawaii sin casarse!"
		},
		Summary = "Alguien llamado Nineball y que es portero probablemente sea un tipo bastante cerrado, debería seguir hablando hasta que al menos reaccione a mis preguntas."
	},
	[60733] = {
		Title = "Sello de Megingjard",
		Description = {
			"Sal de Jawaii con un Butterflywing o bebe y vuelve a Rune-Midgarts. Vaya a Comodo para ver \"Royal Myst\" en el casino sur. De Marruecos a Comodo suele ser la forma más fácil de llegar a Comodo."
		},
		Summary = "Un \"par\" de tragos de \"Alcohol\" pueden soltar la lengua de Royal Myst."
	},
	[60734] = {
		Title = "Sello de Megingjard",
		Description = {
			"Has hablado con todos los cruzados que todavía están vivos, aparentemente algo sucedió, se pasó la culpa y el cruzado Egnigem murió en el proceso. Deberías regresar al Castillo de Prontera e informarle de tus hallazgos."
		},
		Summary = "Un salto kafra de Comodo a Marruecos y a Prontera es rápido a menos que estés guardado en Prontera"
	},
	[60735] = {
		Title = "Sello de Megingjard",
		Description = {
			"Deberías hablar con el último miembro del primer escuadrón, el difunto Egnigem. Un salto de Kafra desde Prontera a Marruecos, a Comodo, luego a Umbala y luego un viaje al norte hasta el Árbol de la Vida hasta Nifflheim puede llevarlo a él."
		},
		Summary = "Escuche a Egnigem y vea qué puede hacer para solucionar este problema"
	},
	[60736] = {
		Title = "Sello de Megingjard",
		Description = {
			"Por la misericordia de Odín, esto es terrible, nunca creíste que un santo cruzado haría un acto tan malvado para reclamar el poder de Megingjard. Sé valiente y regresa al Cuartel General de los Cruzados y cuéntale a Max Von Shedough lo que sabes."
		},
		Summary = ""
	},
	[60737] = {
		Title = "Sello de Megingjard",
		Description = {
			"Max Von Shedough aceptó mi informe y está profundamente preocupado por su contenido, pero una parte de mí realmente cree que, a pesar de las buenas intenciones, la realidad política puede intervenir para impedir que se haga justicia."
		},
		Summary = "Debo contarle a Egnigem al menos el resultado, él merece al menos saber por qué murió."
	},
	[60738] = {
		Title = "Sello de Megingjard",
		Description = {
			"Egnigem te ha bendecido con todas las fuerzas que le quedan. Tienes la sensación de que hay alguien especial a quien le gustaría saber su destino. Debes contarle a Emma Searth sobre su destino."
		},
		Summary = ""
	},
	[60739] = {
		Title = "Sello de Megingjard",
		Description = {
			"Emma no puede recordar, pero puede sentir la pérdida. Tu fe en la Justicia es débil ahora... Debes decirle a Max Von Shedough que él es el juez y que debe compartir esta carga de culpa."
		},
		Summary = "Regreso a Max Von Shedough en el Castillo de Prontera"
	},
	[60801] = {
		Title = "Criador de mascotas WoE",
		Description = {
			"Debes esperar a que expire el cronómetro antes de alquilar otra montura del criador de mascotas fuera de WoE Realms."
		},
		Summary = ""
	},
	[60810] = {
		Title = "Acceso VIP limitado",
		Description = {
			"Durante 3 días, esto le permite utilizar los servicios con descuento para empleados de Kafra, Primo d'Buffer, Warps del servicio VIP, el abuelo obtiene 2 misiones de caza y warps. Una vez que expire el temporizador, no podrá obtener acceso."
		},
		Summary = "*Nota: Los bonos VIP EXP, los espacios para personajes adicionales y el almacenamiento de 600 no están incluidos con este acceso."
	},
