		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Preocupado por la discusión de la pareja de mapaches. Atrapemos a los miembros del equipo Raccoon Hurray en el campo y recolectemos 5 piezas de dulces y galletas robadas cada una."
		},
		Summary = "Habla con \"Pyrus\", miembro del equipo Raccoon Hurray en la plaza Geffen"
	},
	[1203] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Consigue la ropa de \"Citrus\" cerca de \"Sage Welshyun\" en el norte de Geffen."
		},
		Summary = "Habla con \"Citrus\", miembro del equipo Raccoon Hurray en North Geffen"
	},
	[1204] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Recibí un paquete rojo de \"Citrus\". Entreguémosle esto al mapache, \"Kaki\"."
		},
		Summary = "Habla con \"Kaki\", miembro del equipo Raccoon Hurray en la plaza Geffen"
	},
	[1205] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Conseguí la decoración en forma de estrella. Volvamos a \"Quercus\"."
		},
		Summary = "Habla con \"Quercus\", miembro del equipo Raccoon Hurray en la plaza Prontera"
	},
	[1206] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"Quercus ordena una investigación fiable sobre el regalo que se va a recibir. Vayamos a la casa de Santa en Lutie y nos encontremos con el Pequeño Santa."
		},
		Summary = "Habla con el pequeño Santa en la casa de Santa en Lutie"
	},
	[1207] = {
		Title = "Mire por la ventana, ¡Salud por el equipo de Raccoon Hurray!",
		Description = {
			"El pequeño Papá Noel que dice que el regalo para los mapaches se elige como unas bonitas patatas dulces. Alimentemos a los mapaches que protestan fuera de casa."
		},
		Summary = "Habla con el pequeño Santa en la casa de Santa en Lutie"
	},
