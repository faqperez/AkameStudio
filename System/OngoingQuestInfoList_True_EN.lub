	[11606] = {
		Title = "Jack, la calabaza gigante - Tiempo de reutilización",
		Description = {
			"Para llegar al recinto del festival de Halloween, vuelve a visitarlo después de las 04:00."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[12000] = {
		Title = "un viejo amigo",
		Description = {
			"Inicio: NPC: Maku en Ubicacion: lighthalzen (337, 232). Encuentra al viejo amigo de Maku y habla con él."
		},
		Summary = ""
	},
	[12001] = {
		Title = "Digotz, el viejo amigo de Maku",
		Description = {
			"Has hablado con Digotz, un amigo de la infancia de Maku. Vuelve con Maku y habla con él."
		},
		Summary = "maku"
	},
	[12002] = {
		Title = "Mensajero de la amistad",
		Description = {
			"Conviértete en un mensajero entre Maku y Digotz por su amistad duradera."
		},
		Summary = "Ir y venir para entregar los mensajes."
	},
	[12003] = {
		Title = "El mensaje de Digotz",
		Description = {
			"Entrega el mensaje de Digotz a Maku \"-¡Bastardo desesperado! -¡Aún eres un idiota testarudo! -¡Me debes al menos 3 almuerzos! -¡Sin mencionar una disculpa! -¡Pero a quién le importa lo que pienses! -¡Estoy tan jodidamente feliz sin ti!\""
		},
		Summary = "maku"
	},
	[12004] = {
		Title = "El otro amigo de maku.",
		Description = {
			"Después de calmarse, Maku dice que su amigo Benkaistein siempre se aseguraba de que él se mantuviera alejado de las peleas. Quizás Digotz también conozca a ese Benkaistein..."
		},
		Summary = "digotz"
	},
	[12005] = {
		Title = "Benkaistein",
		Description = {
			"Digotz te dice que Benkaistein tiene una respuesta para el tipo de situación en la que él y Maku se encuentran. Está estudiando en un lugar con muchos libros..."
		},
		Summary = "Encuentra el paradero de Benkaistein"
	},
	[12006] = {
		Title = "El objeto perdido de Benkaistein",
		Description = {
			"Ayuda a Benkaistein a encontrar lo que ha perdido y devolvérselo."
		},
		Summary = ""
	},
	[12007] = {
		Title = "Kazien",
		Description = {
			"Inicio: NPC: Old Man en Ubicacion: lighthalzen (141, 162). Un anciano de Lighthalzen te pidió que encontraras a un hombre llamado Kazien dentro del edificio de la corporación para ver si podías ayudarlo."
		},
		Summary = "Encuentra a Kazien"
	},
	[12008] = {
		Title = "Investigador Garíns",
		Description = {
			"Visita a Garins en el Laboratorio Einbroch y confirma que recibió su pedido. Kazien te ha pedido que lo mantengas en secreto para nadie, así que sé discreto y ten cuidado con quién preguntas."
		},
		Summary = "Encuentra Garins en Einbroch"
	},
	[12009] = {
		Title = "misión fallida",
		Description = {
			"Has fracasado en tu misión para Kazien porque revelaste demasiada información. Kazien puede darte otra oportunidad si lo intentas..."
		},
		Summary = "Kazien"
	},
	[12010] = {
		Title = "Sin entrada",
		Description = {
			"Tienes dificultades para pasar a la guardia del laboratorio. Debes informar a Kazien de tus dificultades; de lo contrario, es posible que nunca termines este trabajo."
		},
		Summary = "Kazien"
	},
	[12011] = {
		Title = "Lyozien",
		Description = {
			"Encuentra a un hombre llamado Lyozien en el dirigible para vuelos internacionales. Como antes, manténgalo discreto y no le cuente a nadie más sobre el trabajo."
		},
		Summary = "Lyozien"
	},
	[12012] = {
		Title = "Conoce al Sr. Ahman",
		Description = {
			"Complete la misión reuniéndose con el Sr. Ahman en el aeropuerto de Izlude y regrese a Lyozien."
		},
		Summary = "Conoce al Sr. Ahman"
	},
	[12013] = {
		Title = "Entrega completa",
		Description = {
			"Después de hablar con el Sr. Ahman, debes informar a Lyozien que tu entrega se completó."
		},
		Summary = "Lyozien"
	},
	[12014] = {
		Title = "Más misiones",
		Description = {
			"Inicio: NPC: Fishbone en Ubicacion: lighthalzen (341, 224). Lyozien dice que su hermano Kazien puede tener otro trabajo para ti."
		},
		Summary = "Kazien"
	},
	[12015] = {
		Title = "Ghalstein",
		Description = {
			"Inicio: NPC: Switch en Ubicacion: lighthalzen (173, 167). Ha oído a Ghalstein en una conversación sospechosa. Intente obtener más información sobre lo que pudo haber escuchado."
		},
		Summary = ""
	},
	[12016] = {
		Title = "Colándose en el laboratorio",
		Description = {
			"Debes colarte en el laboratorio oculto investigando las desapariciones de personas de los barrios marginales del este y llevarle pruebas a Ghalstein."
		},
		Summary = ""
	},
	[12017] = {
		Title = "Membresía aprobada",
		Description = {
			"Encuentra a Gusharr cerca de Juno y él te informará sobre tu próxima misión. Muéstrele la tarjeta de miembro para demostrar que está trabajando con Ghalstein."
		},
		Summary = ""
	},
	[12018] = {
		Title = "Reunión con el presidente",
		Description = {
			"Muestre su tarjeta de Socio al secretario del Presidente. Solo puede visitar el Presidente Weierstrass de 8:00 p. m. a 11:00 p. m. y de 11:00 a. m. a 2:00 p. m. PST."
		},
		Summary = ""
	},
	[12019] = {
		Title = "La misión del presidente",
		Description = {
			"Lleve la carpeta de archivos a la secretaria del presidente, la Sra. Hes O'Neil, antes de irse y luego reúnase con Benith en la sede de Kafra en Al De Baran para conocer su próxima misión."
		},
		Summary = ""
	},
	[12020] = {
		Title = "Rescatar a un miembro del ala secreta",
		Description = {
			"Debes encontrar al agente Jargeah cerca de un puente roto en algún lugar entre Einbroch y Lighthalzen. Está herido y necesita ayuda, así que llega allí antes que el enemigo."
		},
		Summary = ""
	},
	[12021] = {
		Title = "La carpeta de archivos sellada",
		Description = {
			"Jargeah te dio una carpeta sellada. Deberías informar a Benith en la sede de Kafra."
		},
		Summary = ""
	},
	[12022] = {
		Title = "La carpeta de archivos sellada",
		Description = {
			"Entrega la carpeta sellada al presidente Weierstrass en Lighthalzen."
		},
		Summary = ""
	},
	[12023] = {
		Title = "Shinokas el investigador",
		Description = {
			"Tu próxima misión es encontrar a Shinokas, el investigador que tiene un secreto sobre Rekenber Corporation. Según los informes, lo han visto en algún lugar de Einbroch."
		},
		Summary = ""
	},
	[12024] = {
		Title = "Agente de la Corporación Kafra",
		Description = {
			"Inicio: NPC: Mr. President en Ubicacion: yuno_pre (69, 79). Encuentre al agente de Kafra Corporation en el campo Lighthalzen."
		},
		Summary = ""
	},
	[12025] = {
		Title = "El archivo secreto de Rekenber",
		Description = {
			"Utilice el pase para los edificios de Rekenber y reúnase con el agente Lestin, quien le explicará su misión."
		},
		Summary = ""
	},
	[12026] = {
		Title = "El archivo secreto de Rekenber",
		Description = {
			"Entra sigilosamente en el Archivo Secreto con el pase de Lestin (algo está escrito en la parte posterior del pase) cuando los guardias cambien de turno. Trae cualquier evidencia que puedas encontrar."
		},
		Summary = ""
	},
	[12027] = {
		Title = "El archivo secreto de Rekenber",
		Description = {
			"Encuentra a Esuna fuera de Lighthalzen y transmite la información que encontraste en el Archivo Secreto."
		},
		Summary = ""
	},
	[12028] = {
		Title = "Kurelle la traidora",
		Description = {
			"Vuelve con el presidente con noticias sobre Kurelle, la traidora del Ala Secreta. Luego regresa con Ghalstein en busca del antídoto para el veneno rojo que te dio."
		},
		Summary = ""
	},
	[12029] = {
		Title = "Anillo de compromiso perdido",
		Description = {
			"Inicio: NPC: Powerful-Looking Woman en Ubicacion: ayothaya (233, 105). Ayuda a Shuda a encontrar su anillo de compromiso perdido, que su prometido Annon arrojó al agua. Probablemente deberías encontrar algo para pescarlo."
		},
		Summary = ""
	},
	[12030] = {
		Title = "Anillo de compromiso encontrado",
		Description = {
			"Encontraste el anillo de compromiso de Shuda dentro de un Phen que pescaste fuera del agua. Devuélvemelo."
		},
		Summary = "Shuda"
	},
	[12031] = {
		Title = "encontrar a annon",
		Description = {
			"Ahora que Shuda ha recuperado su anillo de compromiso, debes buscar a Annon y hacérselo saber. Tiene que haber alguien que lo haya visto."
		},
		Summary = ""
	},
	[12032] = {
		Title = "Buscando a Annón",
		Description = {
			"Te topaste con un anciano que dijo que un joven pasó corriendo hacia el bosque. ¿Podría haber sido Annón? Busque cualquier rastro de su paradero en el bosque."
		},
		Summary = "Las huellas de Annon"
	},
	[12033] = {
		Title = "Rastros de sangre",
		Description = {
			"Encontraste rastros de sangre. Quienquiera que corriera en esa dirección podría haber resultado herido. El sendero conduce al norte... Annon debe estar en algún lugar cercano."
		},
		Summary = ""
	},
	[12034] = {
		Title = "El lado de la historia de Annon",
		Description = {
			"Has encontrado un lugar extraño con más rastros de sangre. Annon tiene que estar aquí... Cuando lo encuentres, deberías preguntarle por qué huyó de Shuda."
		},
		Summary = ""
	},
	[12035] = {
		Title = "Hilos santos",
		Description = {
			"Inicio: NPC: Dusit en Ubicacion: ayothaya (83, 132). Boonthom te pidió que trajeras los siguientes elementos para hacer el objeto con poder sagrado: 1 paquete de agujas, 1 carrete, 1 cáscara sólida y 1 botella de agua bendita. Luego obtendrás acceso al primer nivel de mazmorra subterránea."
		},
		Summary = ""
	},
	[12036] = {
		Title = "El mensaje de pizarra de piedra",
		Description = {
			"Ahora que has encontrado la última parte de la pizarra, debes transmitir el mensaje que encontraste a Boonthom."
		},
		Summary = "Chamán Boothom"
	},
	[12037] = {
		Title = "Hilos más sagrados",
		Description = {
			"Ahora debes traer materiales a Boonthom para poder ingresar al segundo nivel subterráneo. Trae 2 agua bendita, 1 hoja de Yggdrasil, 2 paquetes de agujas y 2 carretes."
		},
		Summary = ""
	},
	[12038] = {
		Title = "Buscando al tigre Sa-mhing",
		Description = {
			"Puedes ingresar al segundo nivel subterráneo de la mazmorra. Busca rastros del camarada de Boonthom, que pudo haber descubierto algo sobre el tigre Samhing."
		},
		Summary = ""
	},
	[12039] = {
		Title = "Camarada de Boonthom",
		Description = {
			"Deberías volver con Boonthom y contarle sobre su camarada."
		},
		Summary = "Chamán Boothom"
	},
	[12040] = {
		Title = "El diario de Benkaistein",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Kurupe en Ubicacion: Isla Malangdo (malangdo). Llévale el diario a Digotz para recordarle todos los buenos momentos que solían compartir juntos."
		},
		Summary = "digotz"
	},
	[12041] = {
		Title = "El diario de Benkaistein",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Llévale el diario a Maku para recordarle todos los buenos momentos que solían compartir juntos."
		},
		Summary = "maku"
	},
	[12042] = {
		Title = "El diario de Benkaistein",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Has entregado el Diario de Benkaistein a Digotz y Maku... Deberías comprobar cómo está Digotz y hacerle saber que Maku ha leído el diario."
		},
		Summary = "digotz"
	},
	[12043] = {
		Title = "Pase a los barrios marginales",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Booboo the Cow en Ubicacion: Isla Malangdo (malangdo). Habla con Benkaistein."
		},
		Summary = ""
	},
	[12044] = {
		Title = "Calmar a un niño que llora 1",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Torpy en Ubicacion: Isla Malangdo (malangdo). Encuentra a la madre de Torpy fuera del pueblo."
		},
		Summary = "Encontrar a la madre de Torpy"
	},
	[12045] = {
		Title = "Calmar a un niño que llora 2",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Entrega el mensaje de la madre a Torpy. (Volveré¡¦)"
		},
		Summary = "volveré¡¦"
	},
	[12046] = {
		Title = "Calmar a un niño que llora 3",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Encuentra al padre de Torpy que causó todos los problemas. Debe estar escondido en algún lugar del pueblo."
		},
		Summary = "Encuentra la causa del desorden."
	},
	[12047] = {
		Title = "Calmar a un niño que llora 4",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Llévale (pinzas para cangrejos al vapor) al hombre extraño."
		},
		Summary = "Consigue las pinzas para cangrejo al vapor"
	},
	[12048] = {
		Title = "Calmar a un niño que llora 5",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Ve y cuéntale a Torpy y a su madre sobre el ridículo comportamiento del extraño."
		},
		Summary = "Denuncia al hombre extraño"
	},
	[12049] = {
		Title = "Misión de trabajo 1: pícaro",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Entrega la carta al último hijo de Haijara Greg, Louis Greg."
		},
		Summary = "Entrega de correo1"
	},
	[12050] = {
		Title = "Búsqueda de trabajo 2 - Pícaro",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Entrega la carta al segundo hijo de Haijara Greg, Thor Greg."
		},
		Summary = "Entrega de correo2"
	},
	[12051] = {
		Title = "Búsqueda de trabajo 3 - Pícaro",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Entrega la carta al primer hijo de Haijara Greg, Jay Greg."
		},
		Summary = "Entrega de correo3"
	},
	[12052] = {
		Title = "Búsqueda de trabajo 4 - Pícaro",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Entrega la carta al primer hijo de Haijara Greg, Jay Greg."
		},
		Summary = "Entrega de correo4"
	},
	[12053] = {
		Title = "Misión de trabajo 5 - Pícaro",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Thor Greg iniciará la habilidad secreta de Pícaro por ti. Debes pasar la prueba de Thor Greg."
		},
		Summary = "Inclinando la habilidad secreta del pícaro"
	},
	[12054] = {
		Title = "Misión de trabajo 6 - Pícaro",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Vuelve con Haijara Greg para obtener más información."
		},
		Summary = "Escuche los detalles de la habilidad."
	},
	[12055] = {
		Title = "Búsqueda de trabajo - Asesino",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Habla con Defeattin para aprender la habilidad Venom Knife."
		},
		Summary = "¿Cuchillo venenoso?"
	},
	[12056] = {
		Title = "Búsqueda de trabajo - Asesino",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Escuche atentamente a Esmille sobre cómo aprender Aceleración sónica y traiga piedras preciosas de ciertos lugares que ella menciona."
		},
		Summary = "Trayendo la piedra preciosa"
	},
	[12057] = {
		Title = "Pase al laboratorio",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Usando el pase de tarjeta, entra sigilosamente al laboratorio."
		},
		Summary = "usa el pase"
	},
	[12058] = {
		Title = "Entrada restringida a la Torre 102",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Está restringido a generar la Torre 102."
		},
		Summary = "Entrada restringida"
	},
	[12059] = {
		Title = "Límite de tiempo de memoria del orco",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Dimensional Gorge Piece en Ubicacion: Isla Malangdo (malangdo). El tiempo límite para acceder a la Memoria del Orco es de 2 horas. Una vez transcurrido el tiempo, la mazmorra de tu instancia será destruida."
		},
		Summary = "Entrada restringida"
	},
	[12060] = {
		Title = "Pesca de hoy cerrada",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Ferocious Gorurug en Ubicacion: Isla Malangdo (malangdo). Gorurung no aceptará ninguno de tus trozos de pescado hasta que haya pasado un día."
		},
		Summary = "Espere un día antes de entregar más pescado."
	},
	[12061] = {
		Title = "Concentración",
		Description = {
			"[Misiones de la Isla Malangdo - Misión de Pesca Diaria] Requisitos: Nivel Base: 1+. Inicio: NPC: Lugar de pesca en Ubicacion: Isla Malangdo (malangdo). Por favor, guarden silencio en el lugar de pesca."
		},
		Summary = "¡Compórtate!"
	},
	[12062] = {
		Title = "Minería hoy cerrada",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Cat Paw Mining Agent en Ubicacion: Isla Malangdo (malangdo). No se permite minar hasta que pasen 24 horas."
		},
		Summary = "Eso es todo por hoy~"
	},
	[12070] = {
		Title = "Tiempo limitado para entrar.",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Solo se permite ingresar a la torre sin fin con tiempo limitado."
		},
		Summary = "Tiempo limitado para entrar a la torre."
	},
	[12071] = {
		Title = "Horario de acceso restringido",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Recibió una hoja de asistencia y registró su asistencia por separado."
		},
		Summary = "control de asistencia"
	},
	[12072] = {
		Title = "Caza de ranas Thara",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). ¿Has visto una rana roja? Se llama Thara Frog y es muy rara. Estamos intentando verificar dónde habita. Así que caza 20 ranas Thara en la mazmorra al este de Comodo."
		},
		Summary = "Caza 20 ranas Thara"
	},
	[12073] = {
		Title = "Caza de cruceros",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Escuché que algunos juguetes atacaban a la gente. ¡Es ridículo! ¡Mostrémosles nuestro poder! Tenemos que cazar 15 Cruiser en la fábrica de juguetes de Lutie."
		},
		Summary = "Caza 15 cruceros"
	},
	[12074] = {
		Title = "Caza de kukre",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). ¡Alguien fue asaltado cerca de la playa! El posible sospechoso es un monstruo criminal llamado Kukre. Por favor caza 30 Kukre en Byalan Dungeon."
		},
		Summary = "Caza 30 kukre"
	},
	[12075] = {
		Title = "Caza de bebés orcos",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Los bebés orcos se están volviendo más violentos estos días. Caza 15 bebés orcos en la aldea de los orcos en Geffen Field."
		},
		Summary = "Caza 15 bebés orcos"
	},
	[12076] = {
		Title = "Caza del guerrero orco",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Los guerreros orcos están aumentando su agresión. Caza 20 guerreros orcos alrededor de la aldea orca en Geffen Field."
		},
		Summary = "Caza 20 guerreros orcos"
	},
	[12077] = {
		Title = "Caza de vadones",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). ¿Has visto cangrejos con caparazones gruesos? Son vadones. Por favor caza 15 Vadons en Byalan Dungeon"
		},
		Summary = "Caza 15 vadones"
	},
	[12078] = {
		Title = "Caza del megalodón",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Hay peces muertos por toda la playa y la situación está empeorando. Caza 30 Megalodon en la mazmorra al este de Comodo."
		},
		Summary = "Caza 30 megalodones"
	},
	[12079] = {
		Title = "Caza de Marsé",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). ¿Puedes cazar a Marse? Necesito 15 Marse para mi estudio. ¡Por favor, ayúdame! Están en Byalan Dungeon."
		},
		Summary = "Caza 15 Marsé"
	},
	[12080] = {
		Title = "Caza de cornuto",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Un idiota Cornuto mordió el pie del alcalde. ¡El alcalde está molesto, así que tenemos que cazar 20 Cornutus en Byalan Dungeon para hacerlo feliz!"
		},
		Summary = "Caza 20 cornutos"
	},
	[12081] = {
		Title = "Caza Mística",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). La gente está enloquecida por culpa de Myst. Parece un fantasma y asusta a la gente. Por favor, caza 15 Myst en Mjolnir Dead Pit."
		},
		Summary = "Caza 15 misterio"
	},
	[12082] = {
		Title = "Caza de mariscos",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). No preguntes por qué, pero caza 30 mariscos. Es una misión secreta... puedes encontrarla 1 campo al sur de Hugel o alrededor del faro de Paros."
		},
		Summary = "Caza 30 mariscos"
	},
	[12083] = {
		Title = "Caza en la esfera marina",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). ¿Esfera Marina? ¿Sabes qué es una Esfera Marina? Tengo una misión para ti: cazar 15 esferas marinas, así que hazlo en Byalan Dungeon."
		},
		Summary = "Caza 15 esferas marinas"
	},
	[12084] = {
		Title = "Caza de Phen",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). El alcalde quiere comer un delicioso plato de pescado. Phen será el ingrediente perfecto para ello. ¡Por favor, caza 20 Phen en Byalan Dungeon!"
		},
		Summary = "Caza 20 fen"
	},
	[12085] = {
		Title = "Caza de esqueletos orcos",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Los monstruos orcos muertos regresaron a nuestra ciudad y revivieron como esqueletos orcos. ¡Estamos sumidos en el caos! Por favor, caza 15 esqueletos de orcos en el segundo piso de Orc Dungeon."
		},
		Summary = "Caza 15 esqueletos de orcos"
	},
	[12086] = {
		Title = "Caza Zenorc",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Unos monstruos extraños llamados Zenorc nos están atacando. Por favor caza 30 Zenorcs en Orc Dungeon."
		},
		Summary = "Caza 30 Zenorcs"
	},
	[12087] = {
		Title = "Caza de momias",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). ¡Prepárate! ¡Es una misión cruel! ¡¡Caza 15 momias!! Lo intenté una vez, pero no pude lograrlo. ¡Da demasiado miedo en la Pirámide!"
		},
		Summary = "Caza 15 momias"
	},
	[12088] = {
		Title = "41-55 Solicitud",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Mission [41 - 55] en Ubicacion: Isla Malangdo (malangdo). Estás en una misión del tablero de solicitudes 41~55."
		},
		Summary = ""
	},
	[12090] = {
		Title = "Cambio de trabajo a Guardia Real",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Middle-aged Gentleman en Ubicacion: Isla Malangdo (malangdo). Hainrich te dice que está buscando el rastro de Schmidtz y cualquier información sobre la Guardia Real."
		},
		Summary = "Continuar la conversación con el caballero de mediana edad Hainrich"
	},
	[12091] = {
		Title = "Cambio de trabajo a Guardia Real",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Demuestra tu ascetismo y resistencia llevando 100 corazones ardientes a Hainrich en el castillo de Prontera."
		},
		Summary = "Recoge 100 corazones ardientes"
	},
	[12092] = {
		Title = "Cambio de trabajo a Guardia Real",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Has recogido los 100 Corazones Ardientes. Continúe su conversación con Hainrich y escuche su historia."
		},
		Summary = ""
	},
	[12093] = {
		Title = "Cambio de trabajo a Guardia Real",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). El último rastro debería estar en algún lugar de la abadía de Glast Heim St. La investigación dice que debería estar en el área principal de la iglesia."
		},
		Summary = ""
	},
	[12094] = {
		Title = "Cambio de trabajo a Guardia Real",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). La inscripción dice: \"Tú eres alguien que tiene poder sagrado... Encuentra mi recuerdo cerca de mi antiguo castillo de Glast Heim. Mis habitaciones estaban al norte...\""
		},
		Summary = ""
	},
	[12096] = {
		Title = "Cambio de trabajo a hechicero",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Merito en Ubicacion: Isla Malangdo (malangdo). Encuentra a Karacas en el cuarto piso de la Torre Geffen."
		},
		Summary = "Habla con Karacas"
	},
	[12097] = {
		Title = "Cambio de trabajo a hechicero",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Lleva estos materiales a Karacas en la Torre Geffen para que comience la prueba. 3 Viento de Verdura, 3 Azul Cristal, 3 Sangre Roja y 3 Verde Vivo."
		},
		Summary = ""
	},
	[12098] = {
		Title = "recorrido por la mazmorra",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: Ubicacion: Isla Malangdo (malangdo). Lleva las 4 piedras elementales diferentes a estos lugares: primer piso de la cueva de hielo, primer piso de Thor Volcano Dungeon, tercer piso de Mjolnir Dead Pit, segundo piso de Kunlun Dungeon y encuentra los postes de detección de espíritus."
		},
		Summary = "Lleva 3 reactivos diferentes a Karacas en la Torre Geffen."
	},
	[12099] = {
		Title = "Eliminar la causa raíz",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Laponte en Ubicacion: Isla Malangdo (malangdo). Se informa que los dragones bebés cerca de las raíces de Yggdrasilberry están eclosionando. Eliminar al dragón bebé es importante porque esos dragones bebés eventualmente se convertirán en adultos malos, por lo que tenemos que eliminarlos mientras son jóvenes. Caza 10 huevos de Draco y preséntate ante el gerente del Departamento de Caza 1 dentro de las 23 horas."
		},
		Summary = "Caza 10 huevos de Draco"
	},
	[12100] = {
		Title = "Insecto alado violento",
		Description = {
			"[Misiones de la Isla Malangdo] Inicio: NPC: Laponte en Ubicacion: Isla Malangdo (malangdo). Recientemente recibí informes de avistamientos de un enorme insecto alado desconocido cerca del campamento de Lapine. No sabemos hasta dónde puede extenderse la infestación de este insecto, así que extermina a todos los que detectes. Caza 12 Luciola Vespas, preséntate ante el director del Departamento de Caza 1 en un plazo de 23 horas."
		},
		Summary = "Caza 12 Vespas Luciola"
	},
	[12101] = {
		Title = "Interferencia laboral",
		Description = {
			"Inicio: NPC: Laponte en Ubicacion: dicastes01 (187, 230). Esto me acaba de llegar de colegas que trabajan en la mina. Los dragones bebés que viven cerca de las raíces de Yggdrasilberry están destruyendo los terrenos cercanos a las minas. Se volverá peligroso si no lo cuidamos. Por favor, elimina a los dragones bebés cerca de Yggdrasilberry. Caza 5 Dracos, preséntate ante el gerente del Departamento de Caza 1 dentro de las 23 horas."
		},
		Summary = "Caza 5 Dracos"
	},
	[12102] = {
		Title = "Serpientes inteligentes",
		Description = {
			"Inicio: NPC: Laponte en Ubicacion: dicastes01 (187, 230). Una nueva raza llamada Naga fue encontrada en el pantano cerca del campamento de Lapine. El problema es que son intelectuales primitivos y violentos. Tendremos muchos conflictos con ellos en el futuro si expanden su colonia. Por favor, derrota a los Nagas adultos. Caza 10 Nagas, preséntate ante el Gerente del Departamento de Caza 1 dentro de las 23 horas."
		},
		Summary = "Caza 10 nagas"
	},
	[12103] = {
		Title = "Criatura legendaria",
		Description = {
			"Inicio: NPC: Laponte en Ubicacion: dicastes01 (187, 230). Recibimos continuamente informes de avistamientos de un legendario caballo blanco alado cerca de la base de Lapine. ¿Puedes ir allí y echar un vistazo? Podría ser una alucinación, así que asegúrese de tocarlo con la mano desnuda para asegurarse de que sea un ser vivo. Caza 1 Cornus, preséntate ante el gerente del Departamento de Caza 1 dentro de las 23 horas."
		},
		Summary = "Caza 1 Cornus"
	},
	[12104] = {
		Title = "Insectos con apetito",
		Description = {
			"Inicio: NPC: Laponte en Ubicacion: dicastes01 (187, 230). La reproducción de los ciempiés es otro problema, pero su apetito también amenaza nuestra supervivencia. Absorben minerales de bradio y dañan nuestras zonas mineras. Muchos de nuestros colegas de Sapha han perdido la vida a manos de los ciempiés. Por favor exterminarlos. Caza 15 ciempiés, preséntate ante el gerente del Departamento de Caza 1 dentro de las 23 horas."
		},
		Summary = "Caza 15 ciempiés"
	},
	[12105] = {
		Title = "Rocas en movimiento",
		Description = {
			"Inicio: NPC: Laponte en Ubicacion: dicastes01 (187, 230). Recibí un informe de que los minerales en bruto de bradio en las minas están vivos. Parece que los minerales en bruto de Bradium se convirtieron en Golems mediante un antiguo hechizo y ahora es posible que tengamos que cerrar nuestras minas debido a ellos. ¿Puedes ir y derrotarlos? Caza 10 Bradium Golems alrededor del Campo 2 de Manuk, preséntate ante el Gerente del Departamento de Caza 1 dentro de las 23 horas."
		},
		Summary = "Caza 10 gólems de bradium"
	},
	[12106] = {
		Title = "Un niño sobre una flor.",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). Nuestro explorador que fue a Splendide está siendo atacado por lindos monstruos que parecen niños. Así que inevitablemente tenemos que cazarlos, y tú eres quien debe cazarlos ya que no eres de Lapine. Caza 15 Pinguiculas, preséntate ante el Gerente del Departamento de Caza 2 dentro de las 23 horas."
		},
		Summary = "Caza 15 Pinguiculas"
	},
	[12107] = {
		Title = "Amor retorcido",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). ¿Eres consciente de la niña que parece flor, Pinguicula? La gente dice que ha habido una mutación de esa flor. Son muy violentos y agresivos. Por favor acuda a revisarlo y tratarlo antes de que se extiendan por toda la zona. Caza 10 pinguiculas oscuras en la mazmorra de Nidhoggur y preséntate ante el director del departamento de caza 2 en un plazo de 23 horas."
		},
		Summary = "Caza 10 pinguiculas oscuras"
	},
	[12108] = {
		Title = "Eliminación de plantas peligrosas",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). Faltan algunos recolectores de minerales, y parece que seguramente lo hicieron nepenthes. Nepenthes es similar a Mandrágora. Tenemos que hacer algo para proteger a la gente de más daños. Caza 12 Nepenthes, preséntate ante el gerente del Departamento de Caza 2 dentro de las 23 horas."
		},
		Summary = "Caza 12 Nepenthes"
	},
	[12109] = {
		Title = "Exterminio de larvas",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). Han descubierto el hábitat de las larvas de ciempiés. Podemos eliminarlos ahora para que haya menos ciempiés. ¿Los encontrarías y los derrotarías? Tendrás que tener cuidado con los ciempiés que los rodean. Caza 14 larvas de ciempiés y preséntate ante el gerente del Departamento de Caza 2 dentro de las 23 horas."
		},
		Summary = "Caza 14 larvas de ciempiés"
	},
	[12110] = {
		Title = "demonio del agua",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). Los mineros que se dirigían al nido de Nidhoggur informaron haber sido atacados por una extraña criatura acuática. Se dice que era una criatura acuática de aspecto humano. Quizás el Nidhoggur Dungeon sea el origen, así que visite allí para comprobarlo. Caza 7 Aqua Elementals, preséntate ante el Gerente del Departamento de Caza 2 dentro de las 23 horas."
		},
		Summary = "Caza 7 elementales de agua"
	},
	[12111] = {
		Title = "Pájaro con cara fea",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). Los tatachos eran originalmente pájaros hermosos y podían volar. Pero desde que se establecieron aquí donde no hay enemigos naturales, empezaron a ser gordos y holgazanes. Con el tiempo se convirtieron en pájaros tan feos como ahora. Serás un buen enemigo natural para ellos. Caza 10 Tatachos, preséntate ante el Gerente del Departamento de Caza 2 dentro de las 23 horas."
		},
		Summary = "Caza 10 tatachos"
	},
	[12117] = {
		Title = "Flor marchita",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). Esta zona fue un humedal hace mucho tiempo. Pero por alguna razón el entorno ha cambiado con los años. Hay un terreno preservado cerca del campamento de Lapine. ¿Puedes traerme una muestra de flor marchita? Se tratará de investigar sobre los cambios ambientales. Recoge 6 flores marchitas y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 6 flores marchitas"
	},
	[12118] = {
		Title = "Mineral bienvenido",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). La maquinaria de refinación de Bradium está averiada y ahora nos falta suministro de Bradium refinado a nuestros colegas que trabajan en la mina. Por eso estamos utilizando a todos nuestros aventureros para ayudar a recolectar Bradium refinado. Por favor trae 3 Bradiums refinados del Bradium Golem. Recoge 3 bradio refinado y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 3 bradio refinado"
	},
	[12119] = {
		Title = "Textil valioso",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). Tengo una solicitud para traer 16 Dragon's Manes. Los Dracos solo arrojan Dragon's Mane en pequeños volúmenes y es muy valioso. Se utiliza en nuestros diseños indígenas en nuestras banderas, ropa y equipo de campo. Recoge 16 melenas de dragón y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 16 melenas de dragón."
	},
	[12120] = {
		Title = "Carne Curiosa",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). Esta es una petición del pub de comida de personas de otros mundos. Quieren que Dragon Tails se utilice como ingrediente de cocina para alimentos de campo que puedan almacenarse ampliamente. Entonces a los humanos les gusta esto. Por favor trae 6 de ellos. Recoge 6 colas de dragón y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 6 colas de dragón"
	},
	[12121] = {
		Title = "Materiales para quitar la nieve",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). El camino que sale de la ciudad es ahora un camino peligroso y helado debido a la nieve que hemos estado acumulando. Untar trozos de cáscaras de huevo ayudará y necesitamos muchos. Alrededor de 26 aproximadamente serán suficientes. Recoge 26 piezas de cáscaras de huevo y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 26 piezas de cáscaras de huevo."
	},
	[12122] = {
		Title = "El mejor material más fresco",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). La maquinaria de procesamiento de bradio emite un calor tremendo cuando se usa y no se puede estabilizar con ningún tipo de agua. Entonces mezclamos Lágrimas cristalizadas obtenidas de Aqua Elementals a partir de nieve derretida. Necesitamos diariamente, así que traiga 6 de ellos. Recoge 6 lágrimas cristalizadas y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 6 lágrimas cristalizadas."
	},
	[12123] = {
		Title = "Mejor pintura",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). El Gerente de Suministros ha solicitado urgentemente pintura para utilizarla en el mantenimiento de edificios en toda la ciudad. Puede hacer suficiente pintura usando el líquido fluorescente obtenido de Aqua Elementals. Por favor, trae 26 contenedores. Recoja 26 líquidos fluorescentes y repórtese al gerente del Departamento de Suministros 1 dentro de las 23 horas."
		},
		Summary = "Recoge 26 líquidos fluorescentes."
	},
	[12124] = {
		Title = "Raro Valioso",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). La valiosa botella de agua interior de la habitación del ministro está rota. No podrán encontrar quién lo hizo porque hay muchos visitantes todos los días. ¿Puedes traerme este valioso artículo de Aqua Elemental? Solo necesito 1. Recoja 1 botella pequeña, repórtese al gerente del Departamento de Suministros 1 dentro de las 23 horas."
		},
		Summary = "Recoge 1 botella pequeña"
	},
	[12125] = {
		Title = "Material de armería",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). Se acabaron los suministros de revestimiento para las armaduras de los Guardias. Las carcasas de escamas de Naga son un material de revestimiento perfecto. Por favor, trae de vuelta 18 de ellos. Recoge 18 proyectiles de escamas y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 18 conchas de escala"
	},
	[12126] = {
		Title = "Material de armería avanzado",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). Te recibí una solicitud llamada material de revestimiento para armaduras suministrada a los comandantes de la guardia. Se diferencian del revestimiento normal. Por favor tráeme 11 escamas brillantes de Naga. No creo que sea mucho problema para ti. Recoge 11 escamas brillantes y preséntate ante el gerente del Departamento de Suministros 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 11 escamas brillantes"
	},
	[12127] = {
		Title = "Herramienta del supervisor",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Es hora de reparar las trompetas de los supervisores de Mina. Porque esas trompetas son necesarias para controlar a los mineros. El cuerno místico de Cornus es el material perfecto para trompeta, consigue 5 piezas de ellos. Recoge 5 cuernos místicos y preséntate ante el gerente del Departamento de Suministros 2 dentro de las 23 horas."
		},
		Summary = "Recoge 5 cuernos místicos y preséntate ante el gerente del Departamento de Suministros 2 en 23 horas."
	},
	[12128] = {
		Title = "Preparación para calentar",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Parece que no hay suficiente cantidad de piel para los aventureros. Será necesario conseguirle algo de piel a Tatacho. 21 grumos serán suficientes. Recoge 21 pieles y preséntate ante el gerente del Departamento de Suministros 2 dentro de las 23 horas."
		},
		Summary = "Recoge 21 pieles"
	},
	[12129] = {
		Title = "Comida sospechosa",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Hubo una solicitud del pub para recolectar 27 patas de insecto. No quieren revelar la razón por la que los necesitan. De todos modos, gracias. Recoge 27 patas de insecto y preséntate ante el gerente del Departamento de Suministros 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 27 patas de insecto"
	},
	[12130] = {
		Title = "Material útil",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Zargon es muy popular entre los residentes aquí. Es una hermosa bola de forma redonda y se puede utilizar como adhesivo cuando se mezcla su polvo con agua. ¿Conseguirías algunos? Con 26 Zargons bastará. Recoge 26 Zargon y preséntate ante el gerente del Departamento de Suministros 2 dentro de las 23 horas."
		},
		Summary = "Recoge 26 zargón"
	},
	[12131] = {
		Title = "Material esencial para la construcción",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Existe una solicitud que es encontrar un material para utilizar en los trabajos de reparación del edificio de cada trimestre. Obtenga 13 caparazones sólidos que se pueden obtener de Centipede y Centipede Larva. Será muy útil para los trabajos de reparación. Recoge 13 proyectiles sólidos y preséntate ante el gerente del Departamento de Suministros 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 13 conchas sólidas"
	},
	[12132] = {
		Title = "Material esencial para la construcción 2",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Existe una solicitud que es encontrar un material para utilizar en los trabajos de reparación del edificio de cada trimestre. Necesitas conseguir 16 enredaderas fuertes que se pueden obtener de los nepenthes. Es un material vital para los trabajos de reparación de edificios. Recoge 16 vides fuertes y preséntate ante el gerente del departamento de suministros 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 16 enredaderas fuertes"
	},
	[12133] = {
		Title = "Arreglo de decoración",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). La guarda necesita muchas hojas afiladas por motivos decorativos. Algunos otros aventureros comenzaron a buscarlos. Necesitan una gran cantidad de hojas, por lo que quieren 26 hojas afiladas de ti. Sé que es difícil. ¡Te deseo buena suerte! Recoge 26 hojas afiladas y preséntate ante el gerente del Departamento de Suministros 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 26 hojas afiladas"
	},
	[12134] = {
		Title = "Receptáculo instantáneo",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). El dueño del pub está en problemas debido a muchos aventureros del exterior. Quiere tener un utensilio que pueda usarse de forma sencilla e instantánea... Algo así como una hoja ancha. Recoge 11 hojas grandes y preséntate ante el gerente del Departamento de Suministros 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 11 hojas geniales"
	},
	[12135] = {
		Title = "No hay suficiente medicina",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Ha habido un par de ataques en el mío. Deben ser esos Nepenthes los que intentaban atacar a los mineros. Para hacer el medicamento necesitamos 16 raíces marrones. Encuéntralos y tráelos. Recoge 16 raíces marrones y preséntate ante el gerente del Departamento de Suministros 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 16 raíces marrones."
	},
	[12136] = {
		Title = "ladrón de miel",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). El dueño del pub vino y los culpó y culpó por el gran apetito de ustedes. Dijo que no tiene más existencias de miel y frutas. 2 tarros de miel serán suficientes para calmarlo. Recoge 2 miel, preséntate ante el gerente del Departamento de Suministros 2 dentro de las 23 horas."
		},
		Summary = "Recoge 2 miel"
	},
	[12137] = {
		Title = "Herramientas para experimentar",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). El centro de investigación industrial investiga formas de refinar bradio de manera eficiente, pero siempre les faltan materiales de prueba. Escuché que hay un comerciante en la ciudad de los aventureros que vende Life Force Pots. Necesitaré 4 de ellos. Recoja 4 tubos de vidrio y repórtese al gerente del Departamento de Transporte 1 dentro de las 23 horas."
		},
		Summary = "Recoge 4 tubos de vidrio."
	},
	[12138] = {
		Title = "Muestras de regalos finos",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). El dueño del pub dijo que quiere hacer un regalo a todos sus clientes habituales de Sapha. Pero no sabe qué regalar. Si ves algún regalo interesante en Midgard, ¿puedes traer 5 de ellos? Recoge 5 ramos, preséntate ante el gerente del Departamento de Transporte 1 dentro de las 23 horas."
		},
		Summary = "Recoge 5 ramos"
	},
	[12139] = {
		Title = "¡Respeto al Gusto!",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). El alto ministro está buscando estos días el producto Midgard, Witherless Roses. No estoy seguro de si es un buen regalo, pero... Entonces... Sé que es difícil pedirlo, pero por favor tráeme 1 rosa marchita. Esto es sólo entre tú y yo. Recoge 1 rosa marchita y preséntate ante el gerente del Departamento de Transporte 1 dentro de las 23 horas."
		},
		Summary = "Recoge 1 rosa marchita"
	},
	[12140] = {
		Title = "Cortesía para clientes habituales",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Una petición del dueño del pub. Dice que no puede utilizar platos de hojas desechables para los clientes habituales. Pide 15 porcelanas blancas y macizas de Midgard. Recoge 15 Chinas y preséntate ante el gerente del Departamento de Transporte 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 15 chinas"
	},
	[12141] = {
		Title = "Paquete especial",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Tengo una petición personal. Escuché que hay una artesanía redonda transparente en Midgard. Creo que se llaman Glass Beads. Tenemos artículos fabricados similares aquí, pero nada comparado con la elaborada esfera de allí. Por favor consígueme 10 de ellos. Recoge 10 cuentas de vidrio y preséntate ante el gerente del Departamento de Transporte 1 dentro de las 23 horas."
		},
		Summary = "Recoge 10 cuentas de vidrio."
	},
	[12142] = {
		Title = "Solicitud peligrosa",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Mmm... no sé cómo empezar. El alto ministro solicita títeres de Midgard. No sé qué es pero como el alto ministro lo pide, debe usarse para un propósito muy importante. Por favor trae 15 de ellos. Recoge 15 marionetas y preséntate ante el gerente del Departamento de Transporte 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 15 marionetas"
	},
	[12143] = {
		Title = "Tendencia extraña",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Escuché que hay una tendencia entre muchos de mis colegas aquí sobre un accesorio musical hecho con un Bill of Birds de Midgard. Estoy pensando en distribuirlos dentro del edificio de Operaciones. ¿Puedes comprar y traer 50 de ellos? Recoge 50 Bill of Birds y preséntate ante el gerente del Departamento de Transporte 1 dentro de las 23 horas."
		},
		Summary = "Recoge 50 Bill of Birds"
	},
	[12144] = {
		Title = "Uso desconocido",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). El dueño del pub dijo que quería decorar el pub con algo llamado Clam Shells. Por favor, trae unos 50 de ellos. No tengo idea de cómo los usará, pero creo que tiene un gusto único después de haber conocido a muchos aventureros. Recoge 50 conchas de almeja y preséntate ante el gerente del Departamento de Transporte 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 50 conchas de almeja"
	},
	[12145] = {
		Title = "Otra cocina del mundo",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). No tenemos cocina para nosotros, pero muchos aventureros parecen disfrutar del arte de comer. Por eso el dueño del pub necesita un plato para su nueva cocina. Pidió 20 conchas de cangrejo. No tengo idea de dónde puedes conseguirlos pero... buena suerte. Recoge 20 caparazones de cangrejo y preséntate ante el gerente del Departamento de Transporte 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 20 conchas de cangrejo."
	},
	[12146] = {
		Title = "Rellenar grietas",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Creo que el elemento Midgard más útil son Scells. Utilice Scells para rellenar cualquier grieta o agujero en un edificio y luego mezcle y enyese Garlet molido y el mantenimiento del edificio será rápido y sencillo. ¿Puedes traer de vuelta 30 de ellos? Recoge 30 Scells y preséntate ante el gerente del Departamento de Transporte 1 en un plazo de 23 horas."
		},
		Summary = "Recoge 30 celdas"
	},
	[12147] = {
		Title = "Material adhesivo",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Los garlets son un elemento en el mantenimiento de edificios. Es uno de los materiales más importantes en la edificación. Antes de que Garlets estuviera disponible, triturábamos y usábamos Zargons, pero se ha vuelto difícil conseguirlos. Por favor trae 40 de ellos. Recoge 40 Garlets y preséntate ante el gerente del Departamento de Transporte 1 en 23 horas."
		},
		Summary = "Recoge 40 Garlets"
	},
	[12148] = {
		Title = "Cebo para la Caza del Tatacho",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Esos Tatachos son muy rápidos si queremos atraparlos, lo cual es bastante difícil. Entonces los galtens de aquí los atraen con Monster's Feed. Se dice que hay un experto que hace ese trabajo, por favor consigue el feed de 100 Monster. Recoge 100 alimentos de monstruo y preséntate ante el gerente del Departamento de Transporte 2 dentro de las 23 horas."
		},
		Summary = "Recoge 100 alimentos de monstruo."
	},
	[12149] = {
		Title = "Práctica de manejo de la espada",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). El dueño del pub quiere manzanas para aprender a cocinar bien. Pero nunca escuché de ningún aventurero de Midgard al que le gustara su comida. De todos modos, dice que lo intentará, así que consíguele 100 manzanas. Recoge 100 manzanas y preséntate ante el gerente del Departamento de Transporte 2 en 23 horas."
		},
		Summary = "Recoge 100 manzanas"
	},
	[12150] = {
		Title = "Verdura bastante rojiza",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Esta es una petición del dueño del pub. Quiere algo de verdura para tener un plato colorido. Bueno... Zanahoria, ¿verdad? De todos modos se llama así en tu tierra... Yo mismo estaba hablando antes. Por favor trae 100 de ellos. Recoge 100 zanahorias y preséntate ante el gerente del Departamento de Transporte 2 en 23 horas."
		},
		Summary = "Recoge 100 zanahorias"
	},
	[12151] = {
		Title = "Tenacidad del dueño del pub.",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Se dice que hubo una explosión en el pub. La gente dice que fue por una verdura llamada Calabaza que se estaba asando al fuego. Trae 100 calabazas porque se acabaron todas. Recoge 100 calabazas y preséntate ante el gerente del Departamento de Transporte 2 dentro de las 23 horas."
		},
		Summary = "Recoge 100 calabazas"
	},
	[12152] = {
		Title = "Sabe a comida casera",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). El dueño del pub tiene otra petición... Extraña las patatas que comía cuando era joven. Quiere 50 batatas. Por casualidad, si visitas Midgard, intenta conseguirlos. Recoge 50 patatas y preséntate ante el director del Departamento de Transporte 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 50 patatas"
	},
	[12153] = {
		Title = "Planta peligrosa cuando se quema.",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). El dueño del pub quiere cocinar algo extraño. Dijo que sería plátano asado, pero supongo que habrá cocinado algo similar antes... Bueno, no recuerdo mucho. De todos modos... necesitas conseguir 100 plátanos. Recoge 100 plátanos y preséntate ante el gerente del Departamento de Transporte 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 100 plátanos"
	},
	[12154] = {
		Title = "Inesperadamente normal",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Esta solicitud es de... el dueño del pub. Quiere un poco de carne. Nada más en la dirección de su solicitud. Con 50 trozos bastará. Me pregunto si realmente está dirigiendo su negocio... Recoge 50 carnes y preséntate ante el gerente del Departamento de Transporte 2 en 23 horas."
		},
		Summary = "Recoge 50 carnes"
	},
	[12155] = {
		Title = "regalo con corazon",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Hace unos días, vi al dueño del pub frustrado por todos los cucharones rotos... Sentí pena por él, así que quiero que consigas 20 cucharones negros que se pueden comprar en Midgard. Recoge 20 cucharones negros y preséntate ante el gerente del Departamento de Transporte 2 en un plazo de 23 horas."
		},
		Summary = "Recoge 20 cucharones negros."
	},
	[12156] = {
		Title = "¡Respeta el apetito personal!",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). El alto ministro quería espejos hechos de cristal Midgard. Hay muchos espejos de Manukan pero parece preferir los de Midgard. De hecho, estoy un poco preocupado, pero debe haber una razón para nuestro \"sabio\" alto ministro. Recoge 5 espejos de cristal y preséntate ante el gerente del Departamento de Transporte 2 dentro de las 23 horas."
		},
		Summary = "Recoge 5 espejos de cristal."
	},
	[12157] = {
		Title = "Resolución del dueño del pub",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). El dueño del pub quiere intentar hacer un cóctel especial ya que era muy bueno haciendo venenos en sus días de asesino. Recoge 2 piñas y preséntate ante el gerente del Departamento de Transporte 2 dentro de las 23 horas."
		},
		Summary = "Recoge 2 piñas"
	},
	[12158] = {
		Title = "La ira del dueño del pub.",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Encuentra 2 melones para el dueño del pub en El Dicastes. Puedes conseguirlos cazando Galápagos o Grove. Recoge 2 melones y preséntate ante el gerente del Departamento de Transporte 2 dentro de las 23 horas."
		},
		Summary = "Recoge 2 melones"
	},
	[12159] = {
		Title = "Registro de misiones de Laponte",
		Description = {
			"Inicio: NPC: Laponte en Ubicacion: dicastes01 (187, 230). Recientemente recibió una solicitud de Laponte. Espere 23 horas antes de aceptar otra solicitud suya. Está esperando cerca del centro de El Dicastes."
		},
		Summary = "Espere a que expire el temporizador para aceptar otra solicitud"
	},
	[12160] = {
		Title = "Registro de misiones de Kalipo",
		Description = {
			"Inicio: NPC: Kalipo en Ubicacion: dicastes01 (175, 217). Recientemente recibiste una solicitud de Kalipo. Espere 23 horas antes de aceptar otra solicitud suya. Está esperando cerca del centro de El Dicastes."
		},
		Summary = "Espere a que expire el temporizador para aceptar otra solicitud"
	},
	[12161] = {
		Title = "Registro de misiones de Pura",
		Description = {
			"Inicio: NPC: Pura en Ubicacion: dicastes01 (208, 230). Recientemente recibiste una solicitud de Pura. Espere 23 horas antes de aceptar otra solicitud suya. Está esperando cerca del centro de El Dicastes."
		},
		Summary = "Espere a que expire el temporizador para aceptar otra solicitud"
	},
	[12162] = {
		Title = "Registro de misiones de Tragis",
		Description = {
			"Inicio: NPC: Tragis en Ubicacion: dicastes01 (225, 211). Recientemente recibiste una solicitud de Tragis. Espere 23 horas antes de aceptar otra solicitud suya. Está esperando cerca del centro de El Dicastes."
		},
		Summary = "Espere a que expire el temporizador para aceptar otra solicitud"
	},
	[12163] = {
		Title = "Registro de misiones de Calyon",
		Description = {
			"Inicio: NPC: Calyon en Ubicacion: dicastes01 (223, 190). Recientemente recibiste una solicitud de Calyon. Espere 23 horas antes de aceptar otra solicitud suya. Está esperando cerca del centro de El Dicastes."
		},
		Summary = "Espere a que expire el temporizador para aceptar otra solicitud"
	},
	[12164] = {
		Title = "Registro de misiones de Moltuka",
		Description = {
			"Inicio: NPC: Moltuka en Ubicacion: dicastes01 (211, 178). Recientemente recibiste una solicitud de Moltuka. Espere 23 horas antes de aceptar otra solicitud suya. Está esperando cerca del centro de El Dicastes."
		},
		Summary = "Espere a que expire el temporizador para aceptar otra solicitud"
	},
	[12165] = {
		Title = "Mareos",
		Description = {
			"Inicio: NPC: Mysterious Documents en Ubicacion: dic_in01 (25, 190). El fuerte y continuo olor a papel le produce mareos. Espere un par de horas antes de volver a leer estos documentos."
		},
		Summary = "Espera hasta que se acabe el tiempo"
	},
	[12166] = {
		Title = "Doc. de raíz de árbol.",
		Description = {
			"Los humanos lo utilizan como leña o material de construcción. Se encuentra comúnmente en los bosques de Midgard."
		},
		Summary = "Cerca de pay_fild03 144 95"
	},
	[12167] = {
		Title = "Doc de lengua de reptil.",
		Description = {
			"Lengua de un monstruo que vive en el terreno desértico de Midgard. A menudo se utiliza como medicamento después del secado."
		},
		Summary = "Cerca de prt_fild09 371 255"
	},
	[12168] = {
		Title = "Doctor en cola de escorpión.",
		Description = {
			"Cola de reptil venenoso de una criatura que vive en los desiertos. Los registros dicen que los humanos pueden perder la vida cuando son atacados."
		},
		Summary = "Cerca de prt_fild09 352 241"
	},
	[12169] = {
		Title = "Doctor del tallo.",
		Description = {
			"No hay nada como las plantas Midgard en Manuk. Estas plantas se utilizan como alimento y medicina y algunas incluso son venenosas."
		},
		Summary = "Cerca de pay_fild02 177 108"
	},
	[12170] = {
		Title = "Doc escala puntiaguda.",
		Description = {
			"Proviene de una forma de vida llena de baches. Se requiere investigación ya que se desconoce el uso."
		},
		Summary = "Cerca de pay_fild02 105 113"
	},
	[12171] = {
		Title = "Doc. de resina.",
		Description = {
			"Savia de un árbol viejo recogida y solidificada. Muy valioso en el mundo humano."
		},
		Summary = "Cerca de pay_fild01 152 171"
	},
	[12172] = {
		Title = "Generar Doc.",
		Description = {
			"Un huevo de un anfibio que vive en zonas cálidas. Se desconoce si este huevo puede eclosionar en las regiones frías de Manuk."
		},
		Summary = "Cerca de gef_fild01 104 111"
	},
	[12173] = {
		Title = "Doctor gelatina.",
		Description = {
			"Sustancia desconocida en las regiones de Manuk pero encontrada en todo Midgard. Se requiere investigación para ver posibilidades de su uso como material de construcción."
		},
		Summary = "Cerca de prt_fild08 299 332"
	},
	[12174] = {
		Title = "Doctor en cola de pez.",
		Description = {
			"Los humanos comen carne llamada pescado. Puede utilizarse como importante suministro de alimentos para los aventureros extranjeros que visitan la ciudad."
		},
		Summary = "Cerca de izlude 132 136"
	},
	[12175] = {
		Title = "Doctor pelador de gusanos.",
		Description = {
			"Dicen que unas peladuras de lombrices son valiosas. Pero esto se basa en el estándar de valor humano. Se requiere investigación."
		},
		Summary = "Cerca de prt_fild05 303 169"
	},
	[12176] = {
		Title = "Gill Doc.",
		Description = {
			"Hay criaturas de Midgard que viven en el mar y respiran por branquias. Sería útil realizar más investigaciones sobre su ecología."
		},
		Summary = "Cerca de iz_dun03 155 165"
	},
	[12177] = {
		Title = "Diente de Bat Doc.",
		Description = {
			"Rastros de una criatura nocturna desconocida para Manuk. No es una criatura fuerte por el tamaño de sus dientes."
		},
		Summary = "Cerca de mjo_dun01 222 226"
	},
	[12178] = {
		Title = "Doctor pelusa.",
		Description = {
			"Muchas de las criaturas de Midgard están cubiertas de pelo suave. El cabello puede utilizarse como una gran protección contra el frío. Se requiere más investigación."
		},
		Summary = "Cerca de prt_fild06 182 290"
	},
	[12179] = {
		Title = "Crisálida Doc.",
		Description = {
			"Gran saco de insectos que está vivo y contiene quién sabe qué. No está activo en absoluto, pero la estructura de vida que contiene es única y vale la pena investigarla."
		},
		Summary = "Cerca de prt_fild06 127 85"
	},
	[12180] = {
		Title = "Pluma de Aves Doc.",
		Description = {
			"Pluma de pájaro ubicada en todo Midgard. Las plumas no son buenas para protegerse del frío, pero pueden usarse como accesorios decorativos o herramientas para escribir."
		},
		Summary = "Cerca de moc_fild07 201 360"
	},
	[12181] = {
		Title = "Documento de Talon Doc.",
		Description = {
			"Garra puntiaguda conveniente para hacer agujeros o accesorios simples. Muy útil con las uñas de criaturas grandes de Manuk.^"
		},
		Summary = "Cerca de moc_fild12 116 122"
	},
	[12182] = {
		Title = "Doc pegajoso del pie web.",
		Description = {
			"Extraña estructura corporal encontrada en anfibios de Midgard. Evolucionado para adaptarse mejor a la vida oceánica."
		},
		Summary = "Cerca de prt_fild04 315 245"
	},
	[12183] = {
		Title = "Doctor en piel animal.",
		Description = {
			"Cuero de un mamífero. Muy cálido y suave y se puede utilizar de varias maneras. Procesado en Midgard y valioso."
		},
		Summary = "Cerca de mjolnir_08 108 99"
	},
	[12184] = {
		Title = "Doctor Garra de Lobo.",
		Description = {
			"Garra de una criatura llamada lobo. Se desconoce su uso, pero muchos Saphas curiosos se están interesando en él."
		},
		Summary = "Cerca de moc_fild03 175 201"
	},
	[12185] = {
		Title = "Doc. de esporas de hongos.",
		Description = {
			"Esporas de un hongo que se encuentra en todo Midgard. Parece que se puede cultivar aquí con un poco de investigación."
		},
		Summary = "Cerca de pay_fild08 188 153"
	},
	[12186] = {
		Title = "Fang Doc del orco.",
		Description = {
			"Monstruo de piel verde que vive en el bosque. La criatura es parecida a un humano pero es muy hostil hacia los humanos. Conocido por tener una relación amistosa entre las dos razas desde hace mucho tiempo."
		},
		Summary = "Cerca de gef_fild03 251 109"
	},
	[12187] = {
		Title = "Doc Cuerno Maligno.",
		Description = {
			"Objeto elaborado con Evil Horns que aparecen en áreas que no son sagradas. Se vende a un precio elevado pero no parece práctico."
		},
		Summary = "Cerca de c_tower2 170 9"
	},
	[12188] = {
		Title = "Polvo de Mariposa Doc.",
		Description = {
			"Polvo de insectos alados de Midgard. Algunos humanos lo usan como maquillaje o medicina."
		},
		Summary = "Cerca de gef_fild05 111 96"
	},
	[12189] = {
		Title = "Doc. Bill of Birds.",
		Description = {
			"Billete puntiagudo conveniente para hacer agujeros o accesorios simples. Se parece a las garras de un pájaro."
		},
		Summary = "Cerca de moc_fild11 237 273"
	},
	[12190] = {
		Title = "Doctor en escamas de serpiente.",
		Description = {
			"Escamas de un reptil que se mueve sin patas. Las escamas se desprenden de la criatura y se utilizan para manualidades sencillas."
		},
		Summary = "Cerca de pay_fild06 306 233"
	},
	[12191] = {
		Title = "Doctor en sonda de insectos.",
		Description = {
			"Sensor de insectos de un insecto con nervios agudos. Tema de investigación por su estructura única diferente a las criaturas Manuk."
		},
		Summary = "Cerca de pay_fild07 126 49"
	},
	[12192] = {
		Title = "Doctor del Corazón Inmortal.",
		Description = {
			"Corazón que nunca deja de latir. Obtenido de criaturas místicas llamadas sirenas. La fuerza impulsora del corazón aún se desconoce y vale la pena investigarla."
		},
		Summary = "Cerca de iz_dun02 112 96"
	},
	[12193] = {
		Title = "Doctor del vendaje podrido.",
		Description = {
			"Vendaje utilizado para cadáveres. Parece que los humanos creían en que los muertos regresaban por sus cuerpos."
		},
		Summary = "Cerca de moc_pryd02 134 112"
	},
	[12194] = {
		Title = "Doctor en uñas deterioradas.",
		Description = {
			"Clavo de un cadáver. Material importante para la investigación sobre el momento de la muerte y las condiciones de salud. Útil para descubrir la ecología humana."
		},
		Summary = "Cerca de moc_pryd02 36 75"
	},
	[12195] = {
		Title = "Horrible doctor de boca.",
		Description = {
			"Diente de un cadáver. Material importante para la investigación sobre el momento de la muerte y las condiciones de salud. Útil para descubrir la ecología humana."
		},
		Summary = "Cerca de moc_pryd02 148 184"
	},
	[12196] = {
		Title = "Doctor tentáculo.",
		Description = {
			"Sensor de criaturas del océano. A diferencia de los de los insectos, estos muestran un movimiento activo."
		},
		Summary = "Cerca de iz_dun01 210 77"
	},
	[12197] = {
		Title = "Doc. Shell.",
		Description = {
			"Concha que protege insectos o crustáceos. Estas criaturas tienen un caparazón que rodea su piel y tienen movimientos muy flexibles. Vale la pena investigar."
		},
		Summary = "Cerca de iz_dun01 191 92"
	},
	[12198] = {
		Title = "Escala Shell Doc.",
		Description = {
			"Escamas brillantes encontradas en algunos reptiles. La sustancia fluorescente contenida en la superficie se puede utilizar en varios lugares."
		},
		Summary = "Cerca de mjolnir_04 191 154"
	},
	[12199] = {
		Title = "Veneno Canino Doc.",
		Description = {
			"Diente canino con veneno. Los humanos usan esto para fabricar armas para derrotar."
		},
		Summary = "Cerca de mjolnir_04 162 168"
	},
	[12200] = {
		Title = "Doc de moco pegajoso.",
		Description = {
			"Líquido pegajoso al que le queda un poco de viscosidad. Puede usarse como material clave para la construcción y actualmente se usa para algunos estilos arquitectónicos de Manuk. Se encuentra comúnmente en todo Midgard."
		},
		Summary = "Cerca de prt_fild02 102 97"
	},
	[12201] = {
		Title = "Doctor en picadura de abeja.",
		Description = {
			"Aguijón extraído de un insecto vivo. Algunos humanos lo utilizan como tratamiento médico por su efecto medicinal."
		},
		Summary = "Cerca de mjolnir_09 99 100"
	},
	[12202] = {
		Title = "Doctor en pierna de saltamontes.",
		Description = {
			"Patas traseras de un insecto que puede saltar lejos. Es divertido investigar su estructura."
		},
		Summary = "Cerca de prt_fild07 76 122"
	},
	[12203] = {
		Title = "Doc Jalea Real.",
		Description = {
			"Una especie de droga maravillosa extraída de una abeja reina. A los humanos les encanta esto, pero no se ha encontrado eficacia para Manuk."
		},
		Summary = "Cerca de prt_fild03 64 35"
	},
	[12204] = {
		Title = "Doctor Yoyo Tail.",
		Description = {
			"Cola de una criatura parecida a un humano. La investigación sobre por qué los humanos no tienen este rastro sería divertida, pero dañaría la alianza actual con los humanos."
		},
		Summary = "Cerca de prt_fild03 180 163"
	},
	[12205] = {
		Title = "Doc. de carcasa sólida.",
		Description = {
			"Shell evolucionó por algún tipo de factor ambiental. Este puede ser un gran material para fabricar diversas herramientas o armería."
		},
		Summary = "Cerca de prt_fild03 226 170"
	},
	[12206] = {
		Title = "Ñame Doc.",
		Description = {
			"Comestible cuando está maduro, alimento amarillo. A los humanos les gusta mucho esto. Aún no lo he probado, pero huele a batatas maduras."
		},
		Summary = "Cerca de prt_fild03 262 201"
	},
	[12207] = {
		Title = "Doc de la hoja de mapache.",
		Description = {
			"Dicen que hay un animal que puede cambiar de forma con esto pegado. Vale la pena investigar para validar si este rumor es cierto."
		},
		Summary = "Cerca de prt_fild03 284 190"
	},
	[12208] = {
		Title = "Doc. Concha de caracol.",
		Description = {
			"Caparazón duro que protege el cuerpo de un enorme caracol. Criatura divertida para investigar por pura curiosidad."
		},
		Summary = "Cerca de gef_fild09 67 46"
	},
	[12209] = {
		Title = "Doctor Cuerno.",
		Description = {
			"Cuerno duro en forma de cuña de algunos insectos. No tiene mucho uso práctico."
		},
		Summary = "Cerca de prt_fild03 366 237"
	},
	[12210] = {
		Title = "Doctor en piel de pie de oso.",
		Description = {
			"Los humanos recolectan patas de oso cazados. Se desconoce el uso. Los humanos que recolectan las patas son sujetos de investigación."
		},
		Summary = "Cerca de pay_fild07 269 164"
	},
	[12211] = {
		Title = "Doctor pluma.",
		Description = {
			"Cabello cálido tan suave como el pelo sedoso. Debe usarse para protección contra el frío. Coleccionable en todo Midgard."
		},
		Summary = "Cerca de prt_fild02 142 116"
	},
	[12212] = {
		Title = "Doctor de hierbas rojas.",
		Description = {
			"Especie de planta roja medicinal. Los humanos usan esto para hacer medicamentos de recuperación. Planta que vale la pena investigar."
		},
		Summary = "Cerca de prt_fild02 97 209"
	},
	[12213] = {
		Title = "Doctor zanahoria.",
		Description = {
			"Planta de color rojo. El dueño del pub lo solicita todo el tiempo. Vale la pena investigar."
		},
		Summary = "Cerca de prt_fild02 280 328"
	},
	[12214] = {
		Title = "Doc. Aguja de cactus.",
		Description = {
			"Superficie de una planta que sobrevive en desiertos casi sin humedad."
		},
		Summary = "Cerca de moc_fild01 169 62"
	},
	[12215] = {
		Title = "Doctor del corazón de piedra.",
		Description = {
			"Dicen que una piedra enorme en una zona muerta de Midgard se mueve sola. El corazón de la enorme piedra sería un raro tema de investigación."
		},
		Summary = "Cerca de cmd_fild08 324 163"
	},
	[12216] = {
		Title = "Pouty Jahbong",
		Description = {
			"Jahbong parece estar haciendo un puchero serio. No puedes hablar con Jahbong durante 6 horas. ¿Sería útil darle pescado?"
		},
		Summary = ""
	},
	[12217] = {
		Title = "Solicitud - Huellas de caza de jabalí",
		Description = {
			"Como parece ineficaz atacar únicamente a los salvajes, necesitamos una operación especial. Mata a los salvajes vivos y frescos, vuelve a mí con 30 melenas de salvajes. Les advertiré esparciéndolo en el camino que usan para atacar."
		},
		Summary = "Recoge 30 melenas de jabalíes."
	},
	[12218] = {
		Title = "Creación de esencia de lava",
		Description = {
			"Inicio: NPC: Mysterious Documents en Ubicacion: dic_in01 (25, 190). Refina 40 corazones ardientes en el lugar más caliente del segundo piso de Thor Volcano Dungeon."
		},
		Summary = "Buscar alrededor de thor_v02 163 104"
	},
	[12219] = {
		Title = "Creación de esencia de llama",
		Description = {
			"Inicio: NPC: Mysterious Documents en Ubicacion: dic_in01 (25, 190). Refina 10 brasas en el terreno estable de Thor Volcano Dungeon."
		},
		Summary = "Buscar alrededor de thor_v01 185 91"
	},
	[12220] = {
		Title = "Creación de esencia de glaciar",
		Description = {
			"Inicio: NPC: Mysterious Documents en Ubicacion: dic_in01 (25, 190). Refina 10 corazones glaciales en lo profundo de la cueva de hielo."
		},
		Summary = "Buscar alrededor ice_dun03 137 148"
	},
	[12221] = {
		Title = "Creación de esencias fósiles",
		Description = {
			"Inicio: NPC: Mysterious Documents en Ubicacion: dic_in01 (25, 190). Refina 10 Jubileos en el segundo piso de Mine Dungeon."
		},
		Summary = "Buscar alrededor ein_dun02 181 124"
	},
	[12222] = {
		Title = "Creación de esencia de tormenta",
		Description = {
			"Inicio: NPC: Mysterious Documents en Ubicacion: dic_in01 (25, 190). Refina 10 dentaduras postizas de Dragon Masks en la mazmorra Kunlun."
		},
		Summary = "Buscar alrededor gon_dun02 252 198"
	},
