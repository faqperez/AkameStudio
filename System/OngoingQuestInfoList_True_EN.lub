		Summary = ""
	},
	[7350] = {
		Title = "Pueblo cauteloso",
		Description = {
			"Inicio: NPC: Rodel the Guard en Ubicacion: malaya (266, 76). Primera vez en Port Malaya. Me siento un poco confundido, pero será mejor que vaya a ver a Phong en Mumbaki, en el pueblo, como le dijeron. Estoy seguro de que me ayudará."
		},
		Summary = "Habla con Phong en Mumbaki"
	},
	[7351] = {
		Title = "Mejor que mi viejo botón",
		Description = {
			"Inicio: NPC: Leader Phong in Mumbaki en Ubicacion: malaya (185, 358). Los aldeanos están tratando de arrancarme los botones y tirarme de las mangas. Distribuyamos agua bendita y piedras preciosas azules. Eso podría mantenerlos tranquilos por un tiempo."
		},
		Summary = "Entrega objetos sagrados a Pedro, Nardo, Pandoi, Woeon, Talah y Romel."
	},
