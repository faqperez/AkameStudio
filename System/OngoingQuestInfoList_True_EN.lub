	[16386] = {
		Title = "El favor de hoy",
		Description = {
			"La prueba gratuita de perfumes de hoy ha finalizado. Antes de que llegue la madrugada, debes entregarle una Rosa de elección al Maestro Sidorus antes de poder probar sus perfumes."
