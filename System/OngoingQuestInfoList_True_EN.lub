	[7488] = {
		Title = "Conjunto trío de elementos de fuego.",
		Description = {
			"Kaiser derrotó a cada 5 monstruos del Elemento Fuego: \"Drops\", \"Picky\" y \"Baby Desert Wolf\" cerca de Morocc. Puedes encontrarlos en los campos del sur y sureste de Marruecos."
