	},
	[9252] = {
		Title = "<Observando a Amapola>",
		Description = {
			"Inicio: NPC: Poppy en Ubicacion: ecl_in04 (85, 104). ^0000FFPoppy^000000 notas de observación: es violento con los extraños, extraño cómo fue tranquilo con el ladrón, el culpable probablemente sea un conocido de la familia o alguien que trata muy bien con los animales."
		},
		Summary = ""
	},
	[9253] = {
		Title = "<Examinando una estantería desordenada>",
		Description = {
			"Inicio: NPC: Messy Bookshelves en Ubicacion: ecl_in04 (80, 112). ^0000FFMessy Bookshelf^000000 notas del examen: encontré el diario de Luen, leí sus preocupaciones sobre la oposición de su madre a su relación con su novio y el deseo de su novio de ganarse la confianza de su madre."
		},
		Summary = ""
	},
	[9254] = {
		Title = "<Examinando un libro dañado>",
		Description = {
			"Inicio: NPC: Damaged book en Ubicacion: ecl_in04 (78, 111). ^0000FFLibro dañado^000000 notas de examen: parecía dañado intencionalmente, parece crear intencionalmente una escena de robo."
		},
		Summary = ""
	},
	[9255] = {
		Title = "<Examinando un recipiente para latas de refresco>",
		Description = {
			"Inicio: NPC: Soda can container en Ubicacion: ecl_in04 (83, 111). ^0000FFContenedor para latas de refresco^000000 notas del examen: según las declaraciones de Dames, debería haber 15 botellas de alcohol, pero solo eran 13, es posible que al culpable le guste el alcohol."
		},
		Summary = ""
	},
	[9256] = {
		Title = "<Examinando una mesa desordenada>",
		Description = {
			"Inicio: NPC: A messed up table en Ubicacion: ecl_in04 (76, 107). ^0000FFMesa desordenada^000000 notas del examen: según las declaraciones de Rosa, el joyero parece ser más caro que el collar, es posible que el culpable haya apuntado solo al collar."
		},
		Summary = ""
	},
	[9257] = {
		Title = "<Examinar un objeto extraño>",
		Description = {
			"Inicio: NPC: A foreign substance en Ubicacion: ecl_in04 (80, 105). ^0000FFObjeto extraño encontrado en el suelo^000000 notas del examen: se hizo un descubrimiento indescriptiblemente significativo, habrá que ver cómo se desarrollan las cosas, la investigación puede encontrar su destino muy pronto."
		},
		Summary = ""
	},
	[9258] = {
		Title = "<Resultados del examen de campo>",
		Description = {
			"Un conocido o un entrenador de animales, el novio de Luen que no cuenta con la aprobación de la madre de Luen, la escena puede ser falsificada, al culpable le puede gustar el alcohol, la ganancia financiera puede no ser el motivo principal del robo, continuará la investigación junto con el importante descubrimiento en la casa de Luen."
		},
		Summary = ""
	},
	[9259] = {
		Title = "<Confirmando las declaraciones de Cruyan>",
		Description = {
			"Inicio: NPC: Cruyan en Ubicacion: eclage (164, 102). Confirme las declaraciones de ^0000FFCruyan^000000. Ve a la tierra de las flores y caza monstruos para ver si puedes obtener una poción de concentración de ellos. Caza 5 Menblatt, 30 pétalos."
		},
		Summary = "Habla con Balumin cerca de la entrada de Eclage cuando hayas terminado de cazar."
	},
	[9260] = {
		Title = "<Notas de investigación de la encuesta>",
		Description = {
			"Inicio: NPC: Wandering Merchant en Ubicacion: eclage (222, 131). La poción de concentración de ^0000FFCruyan^000000 no se puede obtener de un monstruo. La coartada no fue confirmada. ^0000FFBalumin^000000 no tiene testigos pero parte de su coartada fue confirmada. ^0000FFComerciante errante^000000 estaba borracho, le dio pociones de concentración como recompensa falsa por sus fraudes en el juego."
		},
		Summary = ""
	},
	[9262] = {
		Title = "Incidente de robo misterioso 16",
		Description = {
			"El caso ha sido resuelto. Habla con Balumin."
		},
		Summary = ""
	},
