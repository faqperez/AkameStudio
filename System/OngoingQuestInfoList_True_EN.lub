	},
	[14650] = {
		Title = "Actualmente en producción",
		Description = {
			"Todavía estoy elaborando los souvenirs. Por favor, ven a buscarme nuevamente después de que hayan pasado las primeras horas de la mañana."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14651] = {
		Title = "Decidir el divorcio con cuidado",
		Description = {
			"Durante el período de reflexión de 4 días, hable con su cónyuge y resuelva cualquier cosa que necesite ajustes. Después de eso, puede venir y completar el proceso de divorcio o puede retirar su solicitud de divorcio. - Oficina del Distrito de Prontera: Norton, Oficial de Divorcios"
		},
		Summary = "te veré en 4 días"
	},
	[14652] = {
		Title = "La historia completa 01",
		Description = {
			"Inicio: NPC: Grimm en Ubicacion: gef_dun01 (132, 223). ¿Podrías ayudarnos? Va a ser una larga historia, así que primero déjame beber un poco de agua."
		},
		Summary = "Habla con el sacerdote sombrío"
	},
	[14653] = {
		Title = "La historia completa 02",
		Description = {
			"Inicio: NPC: Grimm en Ubicacion: gef_dun01 (132, 223). Por favor lea esta nota por un momento."
		},
		Summary = "Habla con el sacerdote sombrío"
	},
	[14654] = {
		Title = "La historia completa 03",
		Description = {
			"Inicio: NPC: Grimm en Ubicacion: gef_dun01 (132, 223). Si has terminado de leer la nota, mírame."
		},
		Summary = "Habla con el sacerdote sombrío"
	},
	[14655] = {
		Title = "Los preparativos están hechos",
		Description = {
			"Inicio: NPC: Grimm en Ubicacion: gef_dun01 (132, 223). Si estás listo, házmelo saber."
		},
		Summary = "Habla con el sacerdote sombrío"
	},
	[14656] = {
		Title = "Encuentra el grupo del Sacerdote Siniestro",
		Description = {
			"Inicio: NPC: Grimm en Ubicacion: gef_dun01 (132, 223). Utilice esta nota para cruzar allí y encontrar a Sister Gem y a mi grupo, y comprobar que están a salvo. Cuento contigo."
		},
		Summary = "Encontremos a la hermana Gema"
	},
	[14657] = {
		Title = "El nombre del mago es Jojo",
		Description = {
			"Inicio: NPC: Gem en Ubicacion: gef_d01_i (113, 230). El mago que no ha regresado se llama Jojo. Es un mago normal y corriente, por lo que deberías poder encontrarlo rápidamente."
		},
		Summary = "Encontremos al mago"
	},
	[14658] = {
		Title = "El nombre del sacerdote es jubileo",
		Description = {
			"Inicio: NPC: Gem en Ubicacion: gef_d01_i (113, 230). El sacerdote que no ha regresado se llama Jubileo. Ella es un sacerdote común y corriente, por lo que deberías poder encontrarla rápidamente."
		},
		Summary = "busquemos al sacerdote"
	},
	[14659] = {
		Title = "Pensamientos largos y complicados",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (81, 135). Bomi parece perdida en sus pensamientos por un momento. Intentemos hablar de nuevo en un momento."
		},
		Summary = "Habla con Bomi"
	},
	[14660] = {
		Title = "Ingredientes para sangre falsa",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (81, 135). Necesitas algunos ingredientes para hacer sangre falsa: la sangre pegajosa de un Mat Drainear y la savia de un hongo luciérnaga. Aproximadamente 10 de cada uno deberían ser suficientes."
		},
		Summary = "Recoge sangre pegajosa, savia de hongos."
	},
	[14661] = {
		Title = "El nombre del mago es Jojo 02",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (81, 135). No somos los únicos aquí. Si estás buscando tu fiesta, será mejor que te des prisa."
		},
		Summary = "Encontremos al mago"
	},
	[14662] = {
		Title = "¿Por qué tan nervioso?",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (191, 96). ¡Todos, deténganse así! Algo huele..."
		},
		Summary = "hablar con el rey"
	},
	[14663] = {
		Title = "Una lucha que pide sangre",
		Description = {
			"Inicio: NPC: King en Ubicacion: gef_d01_i (185, 97). ¡¡Este es el olor a sangre!! ¡Estalló una pelea en alguna parte! ¡¡Sangre!!"
		},
		Summary = "Al lugar donde estalló la pelea."
	},
	[14664] = {
		Title = "Un profundo malentendido",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (81, 135). Ver a Drácula tirado allí derrotado ha puesto muchas cosas en la mente de Bomi. Démosle algo de tiempo para ordenar sus pensamientos."
		},
		Summary = "Habla con Bomi"
	},
	[14665] = {
		Title = "¿Se acabó la pelea?",
		Description = {
			"Inicio: NPC: Gem en Ubicacion: gef_d01_i (113, 230). Necesito un poco de tiempo. Aventurero, ve a buscar a tus compañeros."
		},
		Summary = "A la hermana gema"
	},
	[14666] = {
		Title = "El papel del observador",
		Description = {
			"Inicio: NPC: Grimm en Ubicacion: gef_dun01 (132, 223). Queremos velar por ellos aquí y hacer que se porten bien. Por favor, regresa y díselo al Grim Priest."
		},
		Summary = "Al sacerdote sombrío"
	},
	[14667] = {
		Title = "Todo lo que está muerto regresa a la Tierra",
		Description = {
			"Inicio: NPC: Gem en Ubicacion: gef_d01_i (113, 230). Estos son los que necesitan descansar. Envía todo lo que está muerto de vuelta a la tierra. Por favor elimine 10 de cada uno de los 3 tipos."
		},
		Summary = "Los privados del descanso"
	},
	[14668] = {
		Title = "Mucho descanso",
		Description = {
			"Inicio: NPC: Gem en Ubicacion: gef_d01_i (113, 230). Has trabajado duro. Tú también necesitas descansar, aventurero. Por favor regrese después de que hayan pasado las primeras horas de la mañana. - Hermana Gema"
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14669] = {
		Title = "dulces sueños",
		Description = {
			"Inicio: NPC: Antoine en Ubicacion: gef_d01_i (116, 228). ¿Podría la melena de Sweet Nightmare ser la fuente de las pesadillas? Me gustaría investigar eso. Necesito alrededor de 20 Swaying Manes y, por favor, también derrote alrededor de 10 Sweet Nightmares para poder observar los cambios en los sueños."
		},
		Summary = "20 melenas balanceándose"
	},
	[14670] = {
		Title = "Hora de soñar",
		Description = {
			"Inicio: NPC: Antoine en Ubicacion: gef_d01_i (116, 228). ¿Qué tal si duermes un poco, aventurero? Por favor regrese después de que hayan pasado las primeras horas de la mañana. - Antonio"
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14671] = {
		Title = "Sangre falsa inquietante",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (81, 135). Necesitas algunos ingredientes para hacer sangre falsa: la sangre pegajosa de un Mat Drainear y la savia de un hongo luciérnaga. Aproximadamente 10 de cada uno deberían ser suficientes. Puedes conseguirlos derrotando a 5 o más Mat Drainears y Firefly Mushrooms."
		},
		Summary = "Recoge sangre pegajosa y savia de hongos"
	},
	[14672] = {
		Title = "Preparándose para el festival de fuegos artificiales",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Demon en Ubicacion: harboro2 (164, 80). Los gasters arrojan pólvora venenosa mortal y pólvora explosiva. Tráeme 10 polvos venenosos mortales y 1 polvo explosivo. Ah, y no olvides sacrificar a Gasters cazando a 15 de ellos."
		},
		Summary = "10 polvos venenosos mortales y 1 polvo explosivo"
	},
	[14673] = {
		Title = "Es hora de hacer bombas",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Demon en Ubicacion: harboro2 (164, 80). Me has traído suficientes ingredientes para hacer bombas toda la noche. Vuelve mañana temprano en la mañana. Ese es el mejor momento para hacer las cosas. - demonio"
		},
		Summary = "La misión se reinicia a las 4:00 a. m."
	},
	[14674] = {
		Title = "Hora de digerir",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (81, 135). Todavía no tengo hambre. Después de que pasen las primeras horas de la mañana, volveré a morir de hambre. Ven a buscarme entonces. -Bomi"
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14675] = {
		Title = "Una cuestión de humor",
		Description = {
			"Inicio: NPC: King en Ubicacion: gef_d01_i (185, 97). Ese ruidoso Mat Drainear me está poniendo de los nervios. Sólo saca unos 10 de los que hay por aquí. Ah, y este tipo dice que necesita pelo de murciélago corto. ¿Alrededor de 20 de eso también?"
		},
		Summary = "Mat Drainear y pelo de murciélago corto"
	},
	[14676] = {
		Title = "El tiempo de descanso de todos",
		Description = {
			"Inicio: NPC: King en Ubicacion: gef_d01_i (185, 97). Gracias a que sacaste los Mat Drainears, ahora todo está en silencio. Pero con el tiempo volverán a aparecer como un enjambre. Entonces ven a cuidarlos de nuevo. - rey"
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14677] = {
		Title = "Estudiar a la luz de Firefly",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (191, 96). Si mezclas las esporas brillantes de un hongo luciérnaga con un trozo de Sweet Nightmare y lo pegas en la pared, se vuelve lo suficientemente brillante como para leer las palabras de un libro. 10 de cada uno, por favor."
		},
		Summary = "Esporas brillantes y bultos de pesadilla"
	},
	[14678] = {
		Title = "Hora de estudiar",
		Description = {
			"Inicio: NPC: Wizard en Ubicacion: gef_d01_i (191, 96). Cuando la luz de las esporas brillantes se apague, por favor ven a buscarme de nuevo. Mientras tanto estudiaré mucho. -jojo"
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14679] = {
		Title = "La curiosidad es instinto",
		Description = {
