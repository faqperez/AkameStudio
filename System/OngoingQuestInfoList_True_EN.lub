	[7565] = {
		Title = "El regreso de Rayan Moore",
		Description = {
			"La brecha dimensional se encontró basándose en la información de Rayan Moore. Descubra cómo le va mientras está cautivo en Eclage."
		},
		Summary = "Habla con Rayan Moore"
	},
	[7566] = {
		Title = "Viajero de dimensión",
		Description = {
			"Los dispositivos dimensionales están fabricados especialmente para entrar en la brecha dimensional entre el espacio y el tiempo."
		},
		Summary = ""
	},
	[7568] = {
		Title = "Explora la torre",
		Description = {
			"Inicio: NPC: Historian Shep en Ubicacion: dali02 (134, 119). Te han pedido que explores la Torre Thanatos a través de la brecha dimensional."
		},
		Summary = ""
	},
	[7569] = {
		Title = "Tratar a los heridos",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). Trate a los soldados heridos con los botiquines de primeros auxilios."
		},
		Summary = ""
	},
	[7570] = {
		Title = "¡Destruye a los demonios!",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). Los demonios están invadiendo desde el piso superior. Deshazte de las Sombras Malvadas que están invadiendo, habrá 7 de cada tipo para destruir."
		},
		Summary = "Destruye a los demonios"
	},
	[7571] = {
		Title = "Expedición a la Torre",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). La torre fue construida por una tribu de demonios encabezada por uno llamado Thanatos durante una guerra entre dioses y demonios. Fue activado por Satan Morocc en un intento de volver a ingresar a Rune Midgard."
		},
		Summary = ""
	},
	[7572] = {
		Title = "¿Lucile...?",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). Lucile, una chica misteriosa en la Torre del Demonio pidió ayuda para recuperar su cuerpo."
		},
		Summary = "Ayuda a Lucila"
	},
	[7573] = {
		Title = "El espadachín mágico Thanatos",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). El espadachín mágico Thanatos tiene que evitar que los Sellos Mágicos del demonio se acerquen para sellar con éxito al Satán Morocc."
		},
		Summary = "Deshazte de los Sellos Mágicos"
	},
	[7574] = {
		Title = "Torre de Tánatos",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). Se llama Torre Thanatos porque es donde el espadachín mágico selló el poder de Satan Morocc hace cientos de años."
		},
		Summary = ""
	},
	[7575] = {
		Title = "Seguidores malvados",
		Description = {
			"Destruye a los seguidores malvados"
		},
		Summary = ""
	},
	[7576] = {
		Title = "Sello del castillo de Marruecos",
		Description = {
			"Inicio: NPC: Dimensional Device en Ubicacion: dali02 (141, 120). Dentro de años, alguien intentará despertar a Satan Morocc en el castillo de Morocc ya que la Torre Thanatos está sellada."
		},
		Summary = ""
	},
	[7577] = {
		Title = "Distorsión espacial",
		Description = {
			"Inicio: NPC: Historian Shep en Ubicacion: dali02 (134, 119). Explorar el tiempo y el espacio hace que su cuerpo esté en constante cambio. Necesitas tomarte un descanso o perderás la cabeza."
		},
		Summary = "Espere el cronómetro antes de volver a ingresar."
	},
	[7578] = {
		Title = "Caja desenfrenada",
		Description = {
			"Inicio: NPC: Jeruth Hesranta en Ubicacion: moro_vol (136, 84). Flame Basin está invadido por cajas animadas con intenciones hostiles. Subyuga las cajas e identifícalas."
		},
		Summary = "1 caja de bradio"
	},
	[7579] = {
		Title = "Recogiendo bradios",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Jeruth Hesranta en Ubicacion: moro_vol (136, 84). Esas cajas arrasadoras son cajas Bradium encantadas. Subyuga las cajas y recoge Bradium Boxes."
		},
		Summary = "Caja de 10 bradio"
	},
	[7580] = {
		Title = "Coleccionando todos los días",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Jeruth Hesranta en Ubicacion: moro_vol (136, 84). Has decidido recolectar cajas de Bradium todos los días para intentar frustrar el plan de Chesher. Vuelve a Hasranta mañana."
		},
		Summary = "Espera un día"
	},
	[7581] = {
		Title = "Eliminando riesgos",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Magic Scholar en Ubicacion: moro_vol (98, 107). Morocc Fire Vassal, Morocc Twisted Vassal y Morocc Cold Vassal son la mayor amenaza para nuestra operación de subyugación. Por favor cuídalos."
		},
		Summary = ""
	},
	[7582] = {
		Title = "Limpieza Diaria",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Instructor Igrid en Ubicacion: moro_vol (111, 87). Déjelos a otros subyugadores por ahora. Te mereces un descanso."
		},
		Summary = "Espera un día"
	},
	[7583] = {
		Title = "Recolectando maná",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Magic Scholar en Ubicacion: moro_vol (98, 107). Lapine Magic Scholar Avant te ha pedido que recolectes Mana Crystallines de esos demonios anormalmente fuertes. Esta misión se puede realizar con la misión de la Alianza, Eliminando riesgos."
		},
		Summary = "3 cristalinos de maná\""
	},
	[7584] = {
		Title = "Batalla interminable",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Magic Scholar en Ubicacion: moro_vol (98, 107). Los demonios están desviando maná para mantener su fuerza. Has decidido volver a Avant todos los días para ayudarlo a recolectar Mana Crystallines."
		},
		Summary = "Espera un día"
	},
