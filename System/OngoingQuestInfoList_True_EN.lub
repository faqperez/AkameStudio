			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 10 Cocos para Sponiac en Geffen."
		},
		Summary = "Caza 10 Cocos"
	},
	[8270] = {
		Title = "Caza de Thara Frog",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 10 Thara Frogs para Sponiac en Geffen."
		},
		Summary = "Caza 10 Thara Frogs"
	},
	[8271] = {
		Title = "Entrega de Insecticida",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Consigue un insecticida de Dieshin Man en las Ruinas de Morocc y entrégalo al sureste de Payon."
		},
		Summary = "Entrega el insecticida"
	},
	[8272] = {
		Title = "Entrega de Miel",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Consigue miel de Dieshin Man en las Ruinas de Morocc y entrégala al oeste de la Abadía de Santa Capitolina."
		},
		Summary = "Entrega la miel"
	},
	[8273] = {
		Title = "Entrega de Mantas",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Consigue mantas de Dieshin Man en las Ruinas de Morocc y entrégalas al sur de Lutie."
		},
		Summary = "Entrega las mantas"
	},
	[8274] = {
		Title = "Recolección de Huesos",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Reúne 10 Skel-Bones y entrégaselos a Dashia en Payon."
		},
		Summary = "Reúne 10 Skel-Bones"
	},
	[8275] = {
		Title = "Recolección de Pieles",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Reúne 10 Bear\\"
		},
		Summary = ", "
	},
	[8276] = {
		Title = "Recolección de Cortezas",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Reúne 20 Worm Peelings y 20 Garlets y entrégaselos a Dashia en Payon."
		},
		Summary = "Reúne 20 Worm Peelings y 20 Garlets"
	},
	[8277] = {
		Title = "Recolección de Colas",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Reúne 10 Yoyo Tails, 10 Acorns y 10 Raccon Leafs y entrégaselos a Dashia en Payon."
		},
		Summary = "Reúne 10 Yoyo Tails, 10 Acorns y 10 Raccon Leafs"
	},
	[8278] = {
		Title = "Recolección de Galletas",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Reúne 5 Well-baked Cookies y 1 Piece of Cake y entrégaselos a Dashia en Payon."
		},
		Summary = "Reúne 5 Well-baked Cookies y 1 Piece of Cake"
	},
	[8279] = {
		Title = "Recolección de Bigotes",
		Description = {
			"[Tablón de Misiones (Nv. 26 - 40)] Requisitos: Nivel Base: 26+. Inicio: NPC: Tablón de Misiones de Caza en Ubicacion: Sede del Grupo Edén (moc_para01). Reúne 5 Mole Whiskers y 3 Mole Claws y entrégaselos a Dashia en Payon."
		},
