	[2256] = {
		Title = "8vo Aniversario",
		Description = {
			"Has conocido a un anciano que dice que sospecha que el gremio de Arqueología ha descubierto un tesoro. Pregúntale a la asistente de Metz si te permitirá informarte sobre las actividades del gremio."
		},
		Summary = "Encuéntrala en un edificio en Prontera alrededor del 263 279."
	},
	[2257] = {
		Title = "8vo Aniversario",
		Description = {
			"Zella dice que debes demostrarle que eres bueno investigando antes de que ella hable. Lee los libros detrás de ella y combina las pistas para resolver su acertijo."
		},
		Summary = "-¿Cómo se llamaba el trineo de infancia del señor Metz? -Zella"
	},
	[2258] = {
		Title = "8vo Aniversario",
		Description = {
			"Habla con el hermano de Zella, Einrich, en Alberta, quien coordina los equipos de excavación en las ciudades donde descubrieron algunos artefactos."
		},
		Summary = ""
	},
	[2259] = {
		Title = "8vo Aniversario",
		Description = {
			"Has encontrado a Einrich, pero te ha pedido que traigas algunos artículos que puedas comprar a un comerciante en Alberta."
		},
		Summary = "Trae 1 rifle de rama y 10 proyectiles sangrientos."
	},
	[2260] = {
		Title = "8vo Aniversario",
		Description = {
			"El primer artefacto fue encontrado en Louyang. Encuentra al líder del equipo de excavación allí."
		},
		Summary = ""
	},
	[2261] = {
		Title = "8vo Aniversario",
		Description = {
			"Hay monstruos guardianes rodeando los artefactos y reliquias que el gremio de Arqueología está intentando desenterrar."
		},
		Summary = "Caza a 60 Mi Gao y 40 guardianes Mantis."
	},
	[2262] = {
		Title = "8vo Aniversario",
		Description = {
			"Lleva a un miembro del grupo de clase Mago a la Runa excavada. Si no tienes un miembro del grupo Mage, puedes traer 50 piedras preciosas rojas para romper el hechizo."
		},
		Summary = "Informe al líder del equipo de excavación cuando haya disipado la runa excavada."
	},
	[2263] = {
		Title = "8vo Aniversario",
		Description = {
			"Viaja a Ayothaya y encuentra allí al líder del equipo de excavación que está excavando otra runa excavada."
		},
		Summary = ""
	},
	[2264] = {
		Title = "8vo Aniversario",
		Description = {
			"Encuentra a los tres miembros de la tripulación de Wounded Dig en Ayothaya y encuentra una manera de curarlos. Una vez que lo hayas hecho, dirígete al castillo, encuentra a la Princesa de Ayothaya y habla con ella."
		},
		Summary = ""
	},
	[2265] = {
		Title = "8vo Aniversario",
		Description = {
			"Lleva a un miembro del grupo de clase Acólito a la Runa excavada en Ayothaya. Si no tienes un miembro del grupo Acólito, puedes traer 50 piedras preciosas amarillas para romper el hechizo."
		},
		Summary = ""
	},
	[2266] = {
		Title = "8vo Aniversario",
		Description = {
			"Viaja a Kunlun y encuentra allí al líder del equipo de excavación que está excavando otra runa excavada."
		},
		Summary = ""
	},
	[2267] = {
		Title = "8vo Aniversario",
		Description = {
			"Encuentra la runa excavada en el área suroeste de Kunlun y ayúdalo a resolver el misterio de su tripulación dormida."
		},
		Summary = ""
	},
	[2268] = {
		Title = "8vo Aniversario",
		Description = {
			"Tienes un total de 3 fragmentos de roca. Zella y Einrich los están buscando. Es tu elección a quién se los quieres regalar."
		},
		Summary = "Dale los fragmentos de roca a Zella en Prontera o a Einrich en Alberta."
	},
	[2269] = {
		Title = "8vo Aniversario",
		Description = {
			"Ha recibido una clave que abre una puerta de enlace a la memoria ^0000FFold de Payon^000000. Algo está escrito en la llave."
		},
		Summary = "Encuentra la puerta de entrada a la vieja memoria de Payon."
	},
	[2270] = {
		Title = "8vo Aniversario",
		Description = {
			"Si deseas repetir la misión del aniversario, puedes hablar con el anciano en Prontera una vez que haya expirado el tiempo."
		},
		Summary = ""
	},
	[2271] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Guard en Ubicacion: malaya (305, 281). El guardia de Port Malaya dijo que todos los aldeanos están hablando de un tesoro."
		},
		Summary = "Charla con los aldeanos reunidos en Port Malaya."
	},
	[2272] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Port Malaya Villager::buwaya_A en Ubicacion: malaya (276, 288). Según el testimonio de un lugareño, Totoy de la posada podría saber dónde está el tesoro."
		},
		Summary = "Habla con Totoy"
	},
	[2273] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Totoy en Ubicacion: ma_in01 (47, 101). El maestro de caza de la tienda de artesanías puede saber sobre el monstruo."
		},
		Summary = "Habla con el Maestro de la Caza"
	},
	[2274] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Master of Hunting en Ubicacion: malaya (290, 152). El Maestro de Caza pidió recolectar 10 muestras de animales del lugar donde Totoy vio al monstruo."
		},
		Summary = "Recoge 10 muestras de animales."
	},
	[2275] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Master of Hunting en Ubicacion: malaya (290, 152). Estudia las muestras que has recogido con mucha dificultad con el Maestro de la Caza."
		},
		Summary = ""
	},
	[2276] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Master of Hunting en Ubicacion: malaya (290, 152). Totoy vio al espantoso Buwaya. ¡Informe esto a la Guardia!"
		},
		Summary = "Habla con el líder de la guardia."
	},
	[2277] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Guard Leader en Ubicacion: malaya (290, 340). La Guardia pide disparar una bomba de humo donde apareció Buwaya por la seguridad de los aldeanos."
		},
		Summary = "Encuentra dónde aparece Buwaya y dispara una bomba de humo."
	},
	[2278] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Dog en Ubicacion: ma_fild02 (312, 259). ¡Misión completada! Será mejor que primero lleves a Ed a Totoy."
