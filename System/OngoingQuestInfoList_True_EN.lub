	[11134] = {
		Title = "Una operación de limpieza del maldito diablo.",
		Description = {
			"ve a cazar ^4d4dff'button hombre del diablo'^000000 caminando por el pueblo."
		},
		Summary = ""
	},
	[11135] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Inicio: NPC: Bard en Ubicacion: alberta (196, 133). ¿Puedes ir a ^000077Prontera^000000 y recopilar \"^000077Información sobre Maestro Song^000000\"? Tengo algo que investigar en Alberta."
		},
		Summary = ""
	},
	[11136] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Pregúntale a un ^f57d7dman con gafas cerca de la puerta del castillo^000000 sobre una canción."
		},
		Summary = "Obtenga información de una persona cerca de la puerta del castillo."
	},
	[11137] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Sería mejor preguntarle a la ^f57d7dmujer parada frente al taller de herramientas^000000."
		},
		Summary = "Conversación"
	},
	[11138] = {
		Title = "Buscando canción del maestro",
		Description = {
			"La mujer dice que cree que el Maestro Song es su hijo perdido hace mucho tiempo. Vuelve con el Bardo en Alberta y cuéntale lo que pudiste descubrir en Prontera."
		},
		Summary = ""
	},
	[11139] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Karian escuchó que el Maestro Song pudo haber tomado un bote a Izlude, pero ese bote ya no estaba. Reúnete con él en el dirigible y viaja a Hugel."
		},
		Summary = ""
	},
	[11140] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Es la primera vez que Karian sube a la aeronave y se marea. Habla con él en Hugel."
		},
		Summary = ""
	},
	[11141] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Mientras Karian descansa de su enfermedad, te dice que vayas al pub para ver si alguien sabe sobre el paradero del Maestro Song."
		},
		Summary = ""
	},
	[11142] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Escuchaste una canción tortuosa de una persona sorda pero obtuviste más información sobre Maestro Song. Vuelve con Karian en el hotel Hugel e infórmale."
		},
		Summary = ""
	},
	[11143] = {
		Title = "Buscando canción del maestro",
		Description = {
			"No sé por qué ^000077Maestro Song'^000000 fue a ^000077Torre Thanatos^000000."
		},
		Summary = "Ir a la Torre Tánatos"
	},
	[11144] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Encontraste un recibo en la Torre Thanatos. Cambie el recibo con el gerente de la tienda Juno: haga clic"
		},
		Summary = "Encuentra al Sr. Click en Juno"
	},
	[11145] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Entre Einbroch y Lighthalzen hay campos donde hay osos de peluche. Caza a 33 de ellos y encuentra a Karian en el Hotel Lighthalzen."
		},
		Summary = ""
	},
	[11146] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Rion te dijo que vio al Maestro Song ir a la Cueva de Hielo donde trabaja su madre."
		},
		Summary = "Ve a la Cueva de Hielo para encontrar rastros del Maestro Song."
	},
	[11147] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Encontraste una canción escrita en la pared mientras explorabas la Cueva de Hielo."
		},
		Summary = "Habla con la anciana"
	},
	[11148] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Encuentra un barco en el campo al sur de Veins."
		},
		Summary = ""
	},
	[11149] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Sobreviviste al viaje en barco a Comodo. Continúe su conversación con Karian."
		},
		Summary = ""
	},
	[11150] = {
		Title = "Buscando canción del maestro",
		Description = {
			"¿Debería preguntarle a la gente del pueblo sobre el Maestro Song?"
		},
		Summary = "Pregunte por Maestro Song"
	},
	[11151] = {
		Title = "Buscando canción del maestro",
		Description = {
			"El Kayak Master dice que la anfitriona del restaurante es buena memorizando caras..."
		},
		Summary = "ir a la cena"
	},
	[11152] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Estuvo aquí en Comodo pero luego se retiró a un lugar tranquilo cerca de Marruecos donde se reúne un gremio secreto. La mujer dijo que sonaba como ceniza o assa..."
		},
		Summary = "Encuentra un edificio en la parte sureste de Marruecos."
	},
	[11153] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Parece el mismo estilo de escritura que encontré en el recibo. De repente Karian dice que deberíamos ir a la Torre del Reloj en Aldebarán."
		},
		Summary = "Ve a la entrada de la Torre del Reloj en Aldebarán."
	},
	[11154] = {
		Title = "Buscando canción del maestro",
		Description = {
			"Escuchaste a Karian recordar una canción que su amigo cantó con él frente a la Torre del Reloj."
		},
		Summary = "Vuelve a la puerta sur de Prontera."
	},
	[11155] = {
		Title = "Cambio de trabajo a Sura",
		Description = {
			"Inicio: NPC: King Crab en Ubicacion: ve_in (237, 125). Acabas de presenciar a una mujer mostrar un poder asombroso. Ve a la posada y descubre más sobre ella."
		},
		Summary = ""
	},
	[11156] = {
		Title = "Cambio de trabajo a Sura",
		Description = {
			"Demuestra que tienes lo necesario para ser Sura y caza 100 lobos del desierto."
		},
		Summary = ""
	},
	[11157] = {
		Title = "Cambio de trabajo a Sura",
		Description = {
			"Ve a El Mes Gorge, al sureste de Juno, y encuentra a \"Buddy\", que debería estar cerca del centro. Dile que \"Bruno\" te envió allí."
		},
		Summary = ""
	},
	[11158] = {
		Title = "Cambio de trabajo a Sura",
		Description = {
			"El Maestro está meditando por lo que debes esperar en la sala."
		},
		Summary = "Espera al Maestro y sobrevive."
	},
	[11159] = {
		Title = "historia de brian",
		Description = {
			"Inicio: NPC: Brian en Ubicacion: dic_dun01 (205, 43). Ah... ¿Cuántos días han pasado desde que vine aquí...? ¿Sabes qué día es hoy?"
		},
		Summary = "Escuche la historia de Brian"
	},
	[11160] = {
		Title = "historia de juan",
		Description = {
			"Inicio: NPC: John en Ubicacion: dic_dun01 (235, 243). Bueno... No hay nada... malo... no te preocupes..."
		},
		Summary = "Continúa tu conversación con John."
	},
	[11161] = {
		Title = "historia de tyler",
		Description = {
			"Inicio: NPC: Tyler en Ubicacion: dic_dun01 (153, 107). Si estás ocupado, ¿podrías arreglarme la espalda? Me pica tanto que siento como si me hubiera picado un insecto. Dudo que haya un bicho lo suficientemente grande como para morderme la espalda."
		},
		Summary = "Continúa tu conversación con Tyler."
	},
	[11162] = {
		Title = "historia de rosa",
		Description = {
			"Inicio: NPC: Rose en Ubicacion: dic_dun02 (110, 127). Dígale que no hay ningún problema excepto que soy demasiado bueno en mi trabajo."
		},
		Summary = "Continúa tu conversación con Rose."
	},
	[11163] = {
		Title = "Historia de Bain",
		Description = {
			"Inicio: NPC: Bain en Ubicacion: dic_dun01 (64, 107). ¿Frede te pidió que vinieras? Sólo dile que estoy bien. Sencillo, ¿no?"
		},
		Summary = "Continúe su conversación con Bain"
	},
	[11164] = {
		Title = "Historia de Lash",
		Description = {
			"Inicio: NPC: Lash en Ubicacion: dic_dun01 (58, 225). Bueno, si quieres saber sobre mi situación actual, ¿no puedes notar que estoy sano con mis brazos que parecen firmes como una piedra? ¡Cuéntales lo que viste! ¡Jajajajajajaja!"
		},
		Summary = "Continúa tu conversación con Lash"
	},
	[11165] = {
		Title = "Entrega a Brian",
		Description = {
			"Inicio: NPC: Brian en Ubicacion: dic_dun01 (205, 43). Después de regañar a Frede, me di cuenta de que debía mirarme a mí mismo. Jajaja. Dile a Frede que volveré al pueblo tan pronto como me recupere."
		},
		Summary = "Entrega completada a Brian"
	},
	[11166] = {
		Title = "Entrega a Juan",
		Description = {
			"Inicio: NPC: John en Ubicacion: dic_dun01 (235, 243). ...... Gracias, amigo..."
		},
		Summary = "Entrega completada Juan"
	},
	[11167] = {
		Title = "Entrega a Tyler",
		Description = {
			"Inicio: NPC: Tyler en Ubicacion: dic_dun01 (153, 107). ¡¡¡Dios!!! ¡Casi me estaba quedando sin Bradium! ¡Muchas gracias!"
		},
		Summary = "Entrega completada a Tyler"
	},
	[11168] = {
		Title = "Entrega a rosa",
		Description = {
			"Inicio: NPC: Rose en Ubicacion: dic_dun02 (110, 127). Pronto volveré al pueblo. Podemos reunirnos y pasar el rato entonces~"
		},
		Summary = "Entrega completada a Rose"
	},
	[11169] = {
		Title = "Entrega a Bain",
		Description = {
			"Inicio: NPC: Bain en Ubicacion: dic_dun01 (64, 107). Muchas gracias~ Nos vemos la próxima vez~"
		},
		Summary = "Entrega completada a Bain"
	},
	[11170] = {
		Title = "Entrega a pestañas",
		Description = {
			"Inicio: NPC: Lash en Ubicacion: dic_dun01 (58, 225). Ohhhh!!!! ¡Qué gran favor de tu parte! ¡Podría haber terminado mi preciosa vida aquí si no me hubieras ayudado!"
		},
		Summary = "Entrega completada a Lash"
	},
	[11171] = {
		Title = "Solicitud de Frede",
		Description = {
			"Inicio: NPC: Frede en Ubicacion: dic_in01 (165, 104). Ven aquí a sentarte y descansar, come esto también."
		},
		Summary = "habla con el otra vez"
	},
	[11172] = {
		Title = "Solicitud de Frede",
		Description = {
			"Todos mis amigos deben estar en la cueva ya que los vi venir a reponer Bradium. Espero que se mantengan sanos. ¿Los visitarías para comprobar si están bien?"
		},
		Summary = "Conoce a los amigos de Frede, Brian, John, Tyler, Rose, Bain y Lash"
	},
	[11173] = {
		Title = "Solicitud de Frede",
		Description = {
			"Lamento mucho estar pidiendo tu favor continuamente, pero ¿le entregarías Bradium a mis amigos? Si le preguntas a Bouy en el edificio ubicado al noroeste del pueblo, te dará un poco de Bradium refinado. Por favor consíguelo."
		},
		Summary = "Conoce a Bouy y consigue Bradium refinado"
	},
	[11174] = {
		Title = "Escasez de suministro",
		Description = {
			"Se necesita mucho tiempo para refinar un mineral de bradio grande, pero los trozos pequeños de bradio serán rápidos. Puedes recolectar fácilmente piezas de Bradium de los monstruos cercanos. Unas 30 piezas de Bradium serán suficientes para compartir con 6 personas."
		},
		Summary = "No hay suficiente bradio. Recoge 30 pequeños trozos de Bradium."
	},
	[11175] = {
		Title = "Escasez de suministro",
		Description = {
			"El trabajo manual es mucho más rápido para refinar piezas de Bradium en lugar de utilizar una máquina. Sólo necesitaré una hora para terminar. Por favor, descansa mientras me pongo a trabajar."
		},
		Summary = "El trabajo parece necesitar 2 horas para realizarse."
	},
	[11176] = {
		Title = "para mis amigos",
		Description = {
			"¡Trabajo completado! Bouy estaba un poco nervioso porque hacía mucho tiempo que no hacía trabajos manuales pero lo hizo bien. Por favor, llévaselos a tus amigos."
		},
		Summary = "Dale el Bradium refinado a tus amigos y regresa con Frede para contar la historia."
	},
