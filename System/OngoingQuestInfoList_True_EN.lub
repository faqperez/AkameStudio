		Summary = ""
	},
	[7770] = {
		Title = "Noche de insomnio, Gritos del Espíritu más allá del mar",
		Description = {
			"Akarin sufre noches de insomnio todos los días debido a gritos desconocidos. Creo que es por Banshee."
		},
		Summary = "Derrota al alma en pena"
	},
	[7771] = {
		Title = "¡Por favor purifica el Santuario!",
		Description = {
			"Eridanus, cuyo trabajo en el templo dijo que había ruidos extraños provenientes del subsuelo del templo. Deben ser criaturas malvadas ^4d4dffHodremlin, Vanberk e Isilla^000000, por favor derrótalos."
		},
		Summary = "Derrota a todos los monstruos en Santuario."
	},
	[7772] = {
		Title = "¡Obviamente es un fantasma!",
		Description = {
			"Rigel en la academia Kiel Hyre escuchó ruidos extraños provenientes de la catedral abandonada y solicitó una investigación. Revisemos la catedral."
		},
		Summary = "Entrada a la Catedral de Residuos"
	},
	[7773] = {
		Title = "Investigación en profundidad",
		Description = {
			"El interior de la catedral residual estaba formado por instalaciones complejas. Ingrese al segundo piso y derrote a Elliot, luego recupere ^4d4dff1 pieza de la parte quemada^000000."
		},
		Summary = "1 trozo de parte quemada"
	},
	[7774] = {
		Title = "Túnel sospechoso",
		Description = {
			"Ayla encontró una manera de entrar a las instalaciones a través de un túnel subterráneo."
		},
		Summary = ""
	},
	[7775] = {
		Title = "Á¦³×¸¯ ÀüÁ÷ Äù½ºÆ®",
		Description = {
			"µ¥¹Ì Ä¶¹ö¸°Àº Ä\"Æ®¸¦ ±ae?éÀÌ´Â?¥¿¡´Â ¹\"¾ð°¡¿¡ Ä\"Æ®¸¦ ÈÖ?Î¸£´Â°Ô ÃÖ°í¶ó°í Çß´Ù. ¿ì¸® ¾È¿¡ Æ÷ÀÌÁð ½ºÆ÷¾Æ°¡ ÀÜ¶à ÀÖ´øµ¥..."
		},
		Summary = "¿ì¸® ¾ÈÀÇ Æ÷ÀÌÁð ½ºÆ÷¾Æ 100¸¶¸®"
	},
	[7776] = {
		Title = "Señal sospechosa",
		Description = {
			"Inicio: NPC: Elder Sanyul en Ubicacion: payon (164, 229). Los Ancianos de Payon están preocupados por el aprendiz de Soul Linker, Muyeon, quien desapareció durante un ritual. Debería hablar con el joven erudito a la entrada de la Cueva Payon."
		},
		Summary = "Habla con un joven académico"
	},
	[7777] = {
		Title = "¿Qué pasó?",
		Description = {
			"Inicio: NPC: Young Scholar en Ubicacion: pay_arche (48, 137). Muyeon partió hacia el palacio independiente. El joven erudito quiere preguntarle qué pasó."
		},
		Summary = "Habla con Muyeon"
	},
	[7778] = {
		Title = "Lo que vio Muyeon",
		Description = {
			"Inicio: NPC: Muyeon en Ubicacion: payon_in03 (33, 95). Muyeon está agitada por algo que vio durante el ritual de purga. Ella dijo que debería verlo por mí mismo."
		},
		Summary = "Habla con Muyeon"
	},
	[7779] = {
		Title = "Ritual angustioso",
		Description = {
			"Inicio: NPC: Muyeon en Ubicacion: payon_in03 (33, 95). Muyeon dice que podría dejarme tener una experiencia de primera mano sobre el ritual de purga. Será mejor que me prepare y hable con ella."
		},
		Summary = "Habla con Muyeon"
	},
	[7780] = {
		Title = "Pesadilla en el pueblo en ruinas",
		Description = {
			"Inicio: NPC: Muyeon en Ubicacion: payon_in03 (33, 95). Me desmayé durante el ritual y llegué a la aldea en ruinas dentro de la Cueva Payon. ¿Este portal brillante frente a mí está conectado con la pesadilla de la que me habló Muyeon?"
		},
		Summary = "Investiga el portal reluciente"
	},
	[7781] = {
		Title = "Pesadilla en el pueblo en ruinas",
		Description = {
			"Inicio: NPC: Shimmering Portal en Ubicacion: pay_dun03 (140, 46). El joven erudito fue absorbido por el portal reluciente de la aldea en ruinas dentro de la Cueva Payon."
		},
		Summary = "Habla con Chunghae al otro lado del portal."
	},
	[7782] = {
		Title = "¡Detén al mago!",
		Description = {
			"Inicio: NPC: Scholar Chunghae en Ubicacion: pay_d03_i (149, 45). El erudito Chunghae en la mazmorra Nightmare of the Moonlight Flower cree que el ^4d4dffWizard of the Truth^000000 es responsable de este incidente. Me pidió que lo cuidara."
		},
		Summary = "Derrota a 1 mago de la verdad."
	},
	[7783] = {
		Title = "¡Detén al mago! - Pendiente",
		Description = {
			"Inicio: NPC: Scholar Chunghae en Ubicacion: pay_d03_i (149, 45). Puedes volver a recibir esta misión diaria del erudito Chunghae en la mazmorra Nightmare of the Moonlight Flower después de que se enfríe."
		},
		Summary = "Reiniciar a las 4:00 a.m."
	},
	[7784] = {
		Title = "Sin piedad para las ilusiones",
		Description = {
			"Inicio: NPC: Soldier Junghee en Ubicacion: pay_d03_i (152, 45). El soldado Junghee en la mazmorra Nightmare of the Moonlight Flower me pidió que limpiara el área a su alrededor de ^4d4dffAngry Nine Tails^000000."
		},
		Summary = "Derrota al enojado nueve colas"
	},
	[7785] = {
		Title = "Sin piedad para las ilusiones - Pendiente",
		Description = {
			"Inicio: NPC: Soldier Junghee en Ubicacion: pay_d03_i (152, 45). Puedes volver a recibir esta misión diaria del soldado Junghee en la mazmorra Nightmare of the Moonlight Flower después de que se enfríe."
		},
		Summary = "Reiniciar a las 4:00 a.m."
	},
	[7786] = {
		Title = "Recordando a mis antepasados",
		Description = {
			"Inicio: NPC: Soldier Junghee en Ubicacion: pay_d03_i (152, 45). El soldado Junghee en la mazmorra Nightmare of the Moonlight Flower me pidió que enviara ^4d4dffResentful Soldiers^000000 al cielo."
		},
		Summary = "Derrota a los soldados resentidos"
	},
	[7787] = {
		Title = "Recordando a Mis Ancestros - Pendiente",
		Description = {
			"Inicio: NPC: Soldier Junghee en Ubicacion: pay_d03_i (152, 45). Puedes volver a recibir esta misión diaria del soldado Junghee en la mazmorra Nightmare of the Moonlight Flower después de que se enfríe."
		},
		Summary = "Reiniciar a las 4:00 a.m."
	},
	[7788] = {
		Title = "Volver a Muyeon",
		Description = {
			"Inicio: NPC: Scholar Chunghae en Ubicacion: pay_d03_i (149, 45). Transmite los resultados de la investigación de Chunghae a ^4d4dffMuyeon^000000 en el ^4d4dffPalacio Payon independiente^000000."
		},
		Summary = "Habla con Muyeon en el Palacio Independiente."
	},
	[7790] = {
		Title = "Rock Ridge, tierra de oportunidades",
		Description = {
			"Requisitos: Nivel Base: 100+. Inicio: NPC: Karam Pucci en Ubicacion: alberta (240, 103). Karam Pucci ha renunciado a la tarifa del barco a Rock Ridge como servicio gratuito."
		},
		Summary = ""
	},
	[7791] = {
		Title = "Problemas en Rock Ridge",
		Description = {
			"Inicio: NPC: Karam Pucci en Ubicacion: alberta (240, 103). Karam Pucci dijo que Rock Ridge necesita ayuda. Debería ir a Rock Ridge y hablar con el alcalde Costello en el muelle."
		},
		Summary = "Habla con Costello"
	},
	[7792] = {
		Title = "Problemas en Rock Ridge 2",
		Description = {
			"Inicio: NPC: Costello en Ubicacion: harboro1 (80, 218). El alcalde Costello dijo que Rock Ridge está en problemas debido a los Buffalo Bandits y que quiere que yo resuelva el problema junto con el sheriff. ^4d4dffDebería ir a la oficina del sheriff y encontrarme con Wyatt Warp^000000."
		},
		Summary = "Habla con Wyatt Warp"
	},
	[7793] = {
		Title = "Buenas noticias",
		Description = {
			"Inicio: NPC: Wyatt Warp en Ubicacion: har_in01 (20, 30). Johnny James, el líder de los Buffalo Bandits, sólo quiere negociar con el alcalde Costello. Debería entregarle esta emocionante noticia a ^4d4dffCostello en el muelle^000000."
		},
		Summary = "Habla con Costello"
	},
	[7794] = {
		Title = "Respuesta esperada",
		Description = {
			"Inicio: NPC: Costello en Ubicacion: harboro1 (80, 218). Costello, que tenía demasiado miedo de los bandidos como para ir a negociar con ellos, me pidió que fuera en su nombre. Debería ir a decirle al Sheriff Warp."
		},
		Summary = "Habla con Wyatt Warp"
	},
	[7795] = {
		Title = "Negociación sobre el ferrocarril",
		Description = {
			"Inicio: NPC: Wyatt Warp en Ubicacion: har_in01 (20, 30). La reunión de negociación se llevará a cabo en el tren de carga ^4d4dffunmoving^000000. Puedo encontrarlo si salgo del pueblo por la puerta este y sigo el ferrocarril."
		},
		Summary = "Encuentra un tren de carga inmóvil"
	},
	[7796] = {
		Title = "Arresto inesperado",
		Description = {
			"Inicio: NPC: Ivoka Skudi en Ubicacion: har_in01 (88, 22). Los vigilantes de cactus nos han ayudado a capturar al líder de los Buffalo Bandits, Johnny James. Debería regresar a la oficina del sheriff ^4d4dff y hablar con los sheriffs sobre nuestro próximo paso^000000."
		},
		Summary = "Habla con Wyatt e Ivoka"
	},
	[7797] = {
		Title = "Escúchame 1",
		Description = {
			"Inicio: NPC: Ivoka Skudi en Ubicacion: har_in01 (14, 24). Como sugirió Ivoka, debería hablar con Johnny James y plantar en su mente una semilla de duda sobre Albert Ford."
		},
		Summary = "Habla con Johnny James"
	},
	[7798] = {
		Title = "Perfectamente preparado",
		Description = {
			"Inicio: NPC: Johnny James en Ubicacion: har_in01 (89, 26). Johnny James está convencido de que Albert Ford lo traicionó. Me pidió que me deshiciera de Albert y le trajera su melena como prueba. Debería informar al Sheriff por ahora."
		},
		Summary = "Habla con Wyatt Warp"
	},
	[7799] = {
		Title = "Arma 1 de Shawn McCurdy",
		Description = {
			"Inicio: NPC: Wyatt Warp en Ubicacion: har_in01 (20, 30). El sheriff Warp dijo que ^4d4dffForeman McCurdy^000000 tiene una buena moneda de cambio. Está en la plaza."
		},
		Summary = "Habla con Shawn McCurdy"
	},
	[7800] = {
		Title = "El arma de Shawn McCurdy 2",
		Description = {
			"Inicio: NPC: Shawn McCurdy en Ubicacion: harboro1 (288, 193). Pude conseguir algunos minerales de color púrpura, que pensé que ya no podrían extraerse debido a los Buffalo Bandits. Debería encontrar a Shawn McCurdy ^4d4dffsouth desde la entrada de la mina^000000."
		},
		Summary = "Habla con Shawn McCurdy"
	},
	[7801] = {
		Title = "El arma de Shawn McCurdy 3",
		Description = {
			"Inicio: NPC: Shawn McCurdy en Ubicacion: rockmi2 (10, 86). Pudimos colarnos en el segundo piso de la mina. Debería obtener ^4d4dff1 Purple Ore^000000 y luego hablar con Shawn."
		},
		Summary = "1 mineral morado"
	},
	[7802] = {
		Title = "Escúchame 2",
		Description = {
			"Inicio: NPC: Shawn McCurdy en Ubicacion: rockrdg2 (347, 216). Debería ^4d4dff golpear la roca de señalización 3 veces^000000 y luego hablar con Albert Ford sobre el futuro de su pandilla."
		},
		Summary = "Habla con Albert Ford"
	},
	[7803] = {
		Title = "Feliz por la confianza rota",
		Description = {
			"Inicio: NPC: Albert Ford en Ubicacion: rockrdg2 (295, 309). Albert Ford, convencido de que Johnny James traicionó a su pandilla, acordó hacer un trato. Debería entregarle Albert's Mane a Johnny James como prueba."
		},
		Summary = "Habla con Johnny James"
	},
	[7804] = {
		Title = "Ubicación de los minerales",
		Description = {
			"Inicio: NPC: Johnny James en Ubicacion: har_in01 (89, 26). Johnny me dijo dónde escondió los minerales: ^4d4dffdebajo del ascensor en el segundo piso de la mina^000000. Debería informarle al Sheriff Warp con esta información."
		},
		Summary = "Habla con Wyatt Warp"
	},
	[7805] = {
		Title = "Ubicación de los minerales 2",
		Description = {
			"Inicio: NPC: Wyatt Warp en Ubicacion: har_in01 (20, 30). ^4d4dffShawn McCurdy^000000 está en la ^4d4dffentrada temporal al segundo piso de la mina^000000. Debería decirle dónde están los minerales y seguirlo hasta el interior de la mina."
		},
		Summary = "Habla con Shawn McCurdy"
	},
	[7806] = {
		Title = "Ubicación de los minerales 3",
		Description = {
			"Inicio: NPC: Shawn McCurdy en Ubicacion: rockmi2 (10, 86). El ascensor averiado está al norte desde el centro del segundo piso. Debería encontrar una ^4d4dffOre Box^000000 debajo del ascensor y llevársela a Shawn McCurdy."
		},
		Summary = "1 caja de mineral"
	},
	[7807] = {
		Title = "As bajo la manga",
		Description = {
			"Inicio: NPC: Shawn McCurdy en Ubicacion: rockmi2 (10, 86). Debería deshacerme de algunos Buffalo Bandits y recolectar ^4d4dff5 bufandas marrones y 5 bufandas de bandidos^000000 para mostrárselas a Albert Ford. Golpeará el techo."
		},
		Summary = "5 bufandas marrones y 5 bufandas bandidas."
	},
	[7808] = {
		Title = "Caso resuelto",
		Description = {
			"Inicio: NPC: Albert Ford en Ubicacion: rockrdg2 (295, 309). Podría haber quemado mis puentes con Albert Ford, pero no me importa. Ya no tengo que verlo. Debería informar al Sheriff Warp."
		},
		Summary = "Habla con Wyatt Warp"
	},
	[7809] = {
		Title = "Recogiendo minerales",
		Description = {
			"Inicio: NPC: Wyatt Warp en Ubicacion: har_in01 (20, 30). Recogiste los minerales."
		},
		Summary = ""
	},
