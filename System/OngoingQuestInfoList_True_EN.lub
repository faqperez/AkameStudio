	[16168] = {
		Title = "Alquiler de gafas 3D para disfraces (uso único)",
		Description = {
			"Esta es una búsqueda diaria; Durante el período del evento, puedes recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Heungbu Kite en Comodo."
		},
		Summary = "Se reinicia a las 04:00"
