		},
		Summary = ""
	},
	[4359] = {
		Title = "Cazar a Santa Orco",
		Description = {
			"Derrota a 3 Santa Orcos que se encuentran en el sur de Geffen/Orc Field."
		},
		Summary = ""
	},
	[4360] = {
		Title = "Cazar a Santa Jackk",
		Description = {
			"Derrota a 3 Santa Jackk de la torre Geffen del segundo piso."
		},
		Summary = ""
	},
	[4361] = {
		Title = "Espera a Santa Lunático",
		Description = {
