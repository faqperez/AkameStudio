		},
		Summary = ""
	},
	[60061] = {
		Title = "Un disolvente mágico",
		Description = {
			"Jacob buscará la corona en su última ubicación rumoreada mientras yo cazaré algunos Poporings y Dustiness para conseguir ingredientes para un solvente mágico que elimine el antiguo poder de la Corona."
		},
		Summary = "Caza 30 Dustiness y 30 Poporing"
	},
	[60062] = {
		Title = "Dejando la corona inerte",
		Description = {
			"¡Jacob ha encontrado la Corona y yo tengo el disolvente! Debería llevar ambos al mazo de Payon para combinarlos. Una vez que la Corona haya quedado inerte puedo ir a contarle mi aventura a Derik en Prontera."
		},
		Summary = ""
	},
