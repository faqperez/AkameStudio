	[11000] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Inicio: NPC: Alex en Ubicacion: hu_in01 (19, 161). De todos modos, si quieres ayudarnos, echa un vistazo al santuario y comprueba si quieres trabajar para nosotros. Por favor habla con el barquero para viajar al santuario, ¿vale?"
		},
		Summary = "Habla con Alex nuevamente después de investigar el Santuario."
	},
	[11001] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Tu primera tarea es traerme ^3355FF5 Runas de la Oscuridad^000000 del santuario. No te preocupes, me aseguraré de que seas recompensado por tus esfuerzos."
		},
		Summary = "Llévale 5 runas de la oscuridad a Alex."
	},
	[11002] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Alex murmura sobre la mujer de cabello gris mientras recibe las Runas de la Oscuridad."
		},
		Summary = "¿Debería hablar con ella?"
	},
	[11003] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Inicio: NPC: Laura en Ubicacion: hu_in01 (14, 11). Ahora, primero debes ir al santuario y inspeccionar el área para tu propio beneficio. Habla con el barquero y él te llevará allí, ¿vale?"
		},
		Summary = "Habla con Laura después de investigar."
	},
	[11004] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Muy bien, por favor tráeme ^3355FF5 Runas de la Oscuridad^000000 del Santuario de Odin."
		},
		Summary = "Llévale 5 runas de la oscuridad a Laura."
	},
	[11005] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Tu primera misión está completa. ¿Habría algo más para ayudar?"
		},
		Summary = ""
	},
	[11006] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Inicio: NPC: Laura en Ubicacion: hu_in01 (14, 11). Laura se pregunta qué estarán haciendo esos tipos en la otra habitación."
		},
		Summary = "Escabullirse para escuchar la conversación de Alex y volver con Laura."
	},
	[11007] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Quiero que revises la isla interior y veas qué puedes encontrar."
		},
		Summary = "Investiga la isla interior del Santuario de Odin, que está construida sobre dos islas conectadas."
	},
	[11008] = {
		Title = "Inspección del Santuario de Odín",
		Description = {
			"Tengo un favor que pedirte. ¿Podrías llevar este archivo a Marruecos?"
		},
		Summary = "Lleva el archivo al camarada de Ashe en la Puerta Sur de Marruecos."
	},
	[11009] = {
		Title = "La petición de Morriphen",
		Description = {
			"Inicio: NPC: Morriphen en Ubicacion: ein_in01 (16, 36). Morriphen está vomitando sangre. Está en estado muy grave. Ve a su casa ubicada en Hugel y consigue algunas medicinas de su esposa, Siria."
		},
		Summary = "Siria en Hugel"
	},
	[11010] = {
		Title = "ir a buscar la medicina",
		Description = {
			"Simplemente nos quedamos sin medicina. Ve a Lighthalzen y consigue la medicina del amigo de Morriphen, Dono."
		},
		Summary = "Dono en Lighthalzen"
	},
	[11011] = {
		Title = "Medicina para dos",
		Description = {
			"Debes encontrar ^3355FF5 Carbón, 5 Brigan, 5 Cyfar, 1 manzana verde, 3 Detrimindexta, 20 conchas, 1 de cada hierba roja, azul, verde, blanca y amarilla.^000000"
		},
		Summary = "Llévale esto a Dono."
	},
	[11012] = {
		Title = "Encuentra a Makkie",
		Description = {
			"Falta algo. El medicamento no se puede fabricar. Encuentra a Makkie dentro del pub al otro lado de la calle y consigue ^ff0000Polvo de tallo de planta roja^000000."
		},
		Summary = "Makkie"
	},
	[11013] = {
		Title = "Polvo de tallo de planta roja",
		Description = {
			"Descubriste que Morriphen y Dono solían trabajar en Rekenber antes. Primero, llévale el polvo de tallo de planta roja a Dono."
		},
		Summary = "dono"
	},
	[11014] = {
		Title = "La medicina del investigador.",
		Description = {
			"¡La Medicina finalmente está lista! ¡Llévaselo a Morriphen de inmediato!"
		},
		Summary = "Morriphen en Einbroch"
	},
	[11015] = {
		Title = "La cura de Siria",
		Description = {
			"Siria también se debilita sin medicamentos. Vuelve con Hugel lo antes posible y entrégale el resto del medicamento."
		},
		Summary = "Siria en Hugel"
	},
	[11016] = {
		Title = "La historia de Morriphen.",
		Description = {
			"Por suerte, Siria se ha recuperado. Vuelve con Morriphen y dile que Siria está bien."
		},
		Summary = "Morriphen en Einbroch"
	},
	[11017] = {
		Title = "Explorando Júperos",
		Description = {
			"Inicio: NPC: Scholar en Ubicacion: yuno_in04 (190, 125). Si viajas por Juperos y encuentras algún documento antiguo, ¿me lo traerías?"
		},
		Summary = "Traiga algo de Juperos que podría ser útil para su investigación."
	},
	[11018] = {
		Title = "Explorando Júperos",
		Description = {
			"Hay un grabado peculiar en la varilla de la Estatua de Bronce."
		},
		Summary = "Ve a ver a Feyruz en la Biblioteca Juno y cuéntale sobre la inscripción."
	},
	[11019] = {
		Title = "Explorando Júperos",
		Description = {
			"Ah, por lo general, las descripciones del \"vano y extravagante\" se refieren al científico loco que se rumorea que vivió en esa época antigua. Pero si esto es cierto, puede que tenga que reelaborar mi tesis..."
		},
		Summary = "Traiga algo de Juperos que podría ser útil para su investigación."
	},
	[11020] = {
		Title = "Explorando Júperos",
		Description = {
			"Fayruz tomó el plato transparente que te dio Juperos y empezó a contarte algunas historias sobre Juperos."
		},
		Summary = "Encuentra si hay otro plato transparente."
	},
	[11021] = {
		Title = "Explorando Júperos",
		Description = {
			"Fayruz tomó el segundo plato transparente que encontraste en Juperos y comenzó a contarte algunas historias sobre Juperos."
		},
		Summary = "Encuentra si hay otro plato transparente."
	},
	[11022] = {
		Title = "Explorando Júperos",
		Description = {
			"Fayruz tomó el tercer plato transparente que encontraste en Juperos y comenzó a contarte algunas historias sobre Juperos."
		},
		Summary = "Encuentra si hay otro plato transparente."
	},
	[11023] = {
		Title = "Ayuda al Sr. Zabaroo - 1",
		Description = {
			"¿Asbar? Está dentro del taller de herramientas. No te lo puedes perder... ¡Solo busca al hombre de los ojos locos!"
		},
		Summary = "encontrar asbar"
	},
	[11024] = {
		Title = "Ayuda al Sr. Zabaroo - 2",
		Description = {
			"Trae 5 raíces de Maneater, 2 corazones glaciales y 5 de acero. Si no vuelves pronto, no te ayudaré."
		},
		Summary = "Lleva a Absar los materiales que necesita."
	},
	[11025] = {
		Title = "Ayuda al Sr. Zabaroo - 3",
		Description = {
			"Asbar le ha regalado un reloj con mecanismo de liberación de abrazadera extensible táctil. Llévaselo al Viejo Zabaroo."
		},
		Summary = "Vuelve a Zabaroo"
	},
	[11026] = {
		Title = "Ayuda al Sr. Zabaroo - 4",
		Description = {
			"¿Podrías simplemente entregar las piedras que recogí a la fábrica de la ciudad? Está cerca del aeropuerto o del dirigible o algo así. No pasará mucho tiempo."
		},
		Summary = "Entrega las piedras a la fábrica de la ciudad."
	},
	[11027] = {
		Title = "Ayuda al Sr. Zabaroo - 5",
		Description = {
			"Lleva esas piedras a Bahed, que está allí. Él se hará cargo de ellos."
		},
		Summary = "Lleva las rocas a Bahed"
	},
	[11028] = {
		Title = "Ayuda al Sr. Zabaroo - 6",
		Description = {
			"Esas rocas se llamaron \"Hetarium\" y se venden a Rekenber. Ah, y por favor dale mis saludos a Zabaroo y agradécele por su arduo trabajo."
		},
		Summary = "Vuelve a Zabaroo"
	},
	[11029] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"Inicio: NPC: Grandpa Turtle en Ubicacion: alberta_in (23, 104). Dios mío, ese lugar es difícil de encontrar y aún más difícil viajar. ¿Estás seguro de que quieres ir?"
		},
		Summary = "Encuentra un viejo barquero en el lado este del puerto de Alberta para descubrir cómo llegar a la Isla Tortuga."
	},
	[11030] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"La pista del lugar es ^FF3355-tur_dun01 X : 160 . Y: 81-^000000"
		},
		Summary = "Has cogido la llave Calavera, ya que puede ser de alguna utilidad más adelante. vamos siguiendo la pista"
	},
	[11031] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"La pista del lugar es ^3355FF-tur_dun02 X : 132 . Y : 251 -^000000, debajo de las raíces."
		},
		Summary = "Has obtenido la clave Roots. vamos siguiendo la pista"
	},
	[11032] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"Aquí... ^3355FF-tur_dun01 X: 203. Y : 155 -^000000, debajo de la piedra tortuga."
		},
		Summary = "Encuentras tres pequeños agujeros debajo de la piedra de la tortuga. Obtuviste la clave de seguridad. vamos siguiendo la pista"
	},
	[11033] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"Ir... ^FF3355-tur_dun02 X: 46. Y : 125 -^000000, dentro del montón de tortugas."
		},
		Summary = "Dentro de la pila de cristales de tortuga, se esconde un pergamino. Has ganado una llave de Turtle Crystal. vamos siguiendo la pista"
	},
	[11034] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"Vaya 5 pasos hacia el este, 30 pasos hacia el sur y 5 pasos alrededor... el pilar de la tortuga..."
		},
		Summary = "En el borde de la placa de cristal hay una llave larga. Has obtenido la llave del Pilar Tortuga. vamos siguiendo la pista"
	},
	[11035] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"- Luz de la segunda etapa -^FF3355B2. X: 75. Y: 249^000000"
		},
		Summary = "Colocas la cuenta roja en la llave de seguridad, encajándola dentro de uno de los tres pequeños agujeros. Encuentra la luz de la segunda etapa."
	},
	[11036] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"- Luz de la tercera etapa -^FF3355B2. X: 118. Y: 233^000000"
		},
		Summary = "Colocas la cuenta amarilla en la llave de seguridad, encajándola dentro de uno de los tres pequeños agujeros. Encuentra la luz de la tercera etapa."
	},
	[11037] = {
		Title = "Yendo a la Isla Tortuga..",
		Description = {
			"- Estrella de la Serenidad -^FF3355B4. X: 113. Y: 178^000000"
		},
		Summary = "Coloca la cuenta azul en la llave de seguridad, encajándola dentro de uno de los tres pequeños agujeros. Encuentra la estrella de la serenidad"
	},
	[11038] = {
		Title = "Conoce a los muertos",
		Description = {
			"Inicio: NPC: Erious en Ubicacion: prt_in (161, 20). Por favor, hazle saber a Elly que lo que pasó hace un mes fue todo culpa mía."
		},
		Summary = "Ve a la ciudad de los muertos y entrega el mensaje de Erious a Elly."
	},
	[11039] = {
		Title = "Conoce a los muertos",
		Description = {
			"Alguien con quien tienes que encontrarte allí... Supongo que deseas contactar a los muertos... El pueblo de los muertos está ubicado al norte de este lugar."
		},
		Summary = "debes encontrar a un hombre llamado \"Feylin\". Es muy importante hacerle saber que Billik te lo presentó. Trae una rosa para el"
	},
	[11040] = {
		Title = "Conoce a los muertos",
		Description = {
			"Si viniste aquí para encontrarte con un amigo tuyo fallecido, has venido con la persona equivocada. Volver."
		},
		Summary = "No puedo rendirme ahora. Habla con Feylin continuamente."
	},
	[11041] = {
		Title = "Conoce a los muertos",
		Description = {
			"No estoy seguro de quién le dijo que podría ser posible contactar a los muertos... Pero seguramente no se lo habría dicho. Además, hablar de esas cosas es tabú."
		},
		Summary = "No puedo rendirme ahora. Habla con Feylin continuamente."
	},
	[11042] = {
		Title = "Conoce a los muertos",
		Description = {
			"La invocación de Elly falló."
		},
		Summary = "Vuelve a Erious de todos modos."
	},
	[11043] = {
		Title = "Conoce a los muertos",
		Description = {
			"Por favor, dale esta caja y dile que se olvide de mí. Debería vivir felizmente el resto de su vida con otra persona."
		},
		Summary = "Vuelve con Erious y entrega su mensaje y la caja."
	},
	[11044] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Inicio: NPC: Doctor en Ubicacion: lou_in02 (265, 69). Por favor visita el taller de herramientas de la ciudad y tráeme el medicamento que necesito. El Maestro entenderá si le dices que fui enviado por mí."
		},
		Summary = "Consigue el medicamento en la tienda de herramientas."
	},
	[11045] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"¿Un recado para el médico? Debe haberse quedado sin medicamentos otra vez. Continúe y verifique el almacenamiento. Puede encontrar el almacenamiento en el lado opuesto de este edificio."
		},
		Summary = "Ve y consigue las cosas que necesitas de Jiang Xiayou en el almacén."
	},
	[11046] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Tengo que ir a buscar algunos documentos oficiales al Ayuntamiento, pero no puedo salir de este área de almacenamiento ya que nadie puede hacerse cargo de mi turno. Simplemente dirígete hacia el este desde aquí y verás el Ayuntamiento. Obtenga el documento denominado ^ff0000Solicitud de transferencia de residencia^000000."
		},
		Summary = "Obtenga el documento para Jiang Xiayou"
	},
	[11047] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Tengo que ir a buscar algunos documentos oficiales al Ayuntamiento, pero no puedo salir de este área de almacenamiento ya que nadie puede hacerse cargo de mi turno. Simplemente dirígete hacia el este desde aquí y verás el Ayuntamiento. Obtenga el documento denominado ^ff0000Solicitud de clase SAT de verano^000000."
		},
		Summary = "Obtenga el documento para Jiang Xiayou"
	},
	[11048] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Tengo que ir a buscar algunos documentos oficiales al Ayuntamiento, pero no puedo salir de este área de almacenamiento ya que nadie puede hacerse cargo de mi turno. Simplemente dirígete hacia el este desde aquí y verás el Ayuntamiento. Obtenga el documento denominado ^ff0000Informe sobre el fenómeno del polvo de Sandy^000000."
		},
		Summary = "Obtenga el documento para Jiang Xiayou"
	},
	[11049] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Tengo que ir a buscar algunos documentos oficiales al Ayuntamiento, pero no puedo salir de este área de almacenamiento ya que nadie puede hacerse cargo de mi turno. Simplemente dirígete hacia el este desde aquí y verás el Ayuntamiento. Obtenga el documento denominado ^ff0000Propuesta de comunicación^000000."
		},
		Summary = "Obtenga el documento para Jiang Xiayou"
	},
	[11050] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Los medicamentos que estás buscando pueden estar por aquí, así que mira a tu alrededor."
		},
		Summary = "Mira a tu alrededor y encuentra la medicina."
	},
	[11051] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Cuando subas las escaleras, otro oficial te entregará el documento que deseas."
		},
		Summary = "Sube las escaleras y obtén la \"Solicitud de Transferencia de Residencia\""
	},
	[11052] = {
		Title = "Medicina herbaria: ser la asistencia de un médico",
		Description = {
			"Cuando subas las escaleras, otro oficial te entregará el documento que deseas."
		},
		Summary = "Sube las escaleras y obtén la \"Solicitud de clase SAT de verano\"."
