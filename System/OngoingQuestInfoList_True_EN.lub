	[5739] = {
		Title = "La misericordia del grabado",
		Description = {
			"Mostrar misericordia sólo es posible una vez al día."
		},
		Summary = ""
	},
	[5740] = {
		Title = "Una vez al día",
		Description = {
			"Ponte a prueba de nuevo mañana."
		},
		Summary = ""
	},
	[5846] = {
		Title = "Corredor de ilusiones",
		Description = {
			"Puedes recibir un Sello de ilusiones del Illusion Wraith, utilizable durante 1 hora, una vez al día."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[5847] = {
		Title = "Un mensaje para Ruanda",
		Description = {
			"Inicio: NPC: Defense Manager Luanda en Ubicacion: com_d02_i (241, 255). Cuéntale a Ruanda, el jefe de la defensa, lo que acabas de presenciar."
		},
		Summary = "\""
	},
	[5848] = {
		Title = "Prueba de repeler a la tribu megalítica",
		Description = {
			"Inicio: NPC: Request Board en Ubicacion: com_d02_i (238, 266). La aldea está teniendo problemas con los monstruos de la tribu Megalith. Si traes 3 pruebas de que las rechazaste, serás recompensado aproximadamente una vez al día."
		},
		Summary = "3 fichas de megalito"
	},
	[5849] = {
		Title = "[Enfriamiento] Prueba de repeler a la tribu Megalith",
		Description = {
			"Inicio: NPC: Defense Manager Luanda en Ubicacion: com_d02_i (241, 255). El Jefe de Defensa Ruanda te recompensará si traes pruebas de haber repelido a la Tribu Megalito nuevamente mañana."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[5850] = {
		Title = "Prueba de repulsión de la tribu Utan",
		Description = {
			"Inicio: NPC: Request Board en Ubicacion: com_d02_i (238, 266). El pueblo está teniendo problemas con los monstruos de la tribu Utan. Si traes 3 pruebas de que las rechazaste, serás recompensado aproximadamente una vez al día."
		},
		Summary = "3 fichas de Utan"
	},
	[5851] = {
		Title = "[Enfriamiento] Prueba de repeler a la tribu Utan",
		Description = {
			"Inicio: NPC: Defense Manager Luanda en Ubicacion: com_d02_i (241, 255). El jefe de defensa Ruanda te recompensará si traes pruebas de haber repelido a la tribu Utan nuevamente mañana."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[5852] = {
		Title = "Operación: Exterminio de la tribu megalítica",
		Description = {
			"Inicio: NPC: Request Board en Ubicacion: com_d02_i (238, 266). La aldea está planeando exterminar a la tribu Megalith. Mata a 5 de cada uno de los Ancient Trijoint, Ancient Stalactic Golem y Ancient Megalith, luego preséntate ante el jefe de defensa Ruanda."
		},
		Summary = ""
	},
	[5853] = {
		Title = "[Enfriamiento] Operación: Exterminio de la tribu megalítica",
		Description = {
			"Inicio: NPC: Defense Manager Luanda en Ubicacion: com_d02_i (241, 255). El jefe de defensa Ruanda espera que mañana te unas nuevamente a la lucha contra la tribu Megalith."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[5854] = {
		Title = "Operación: Exterminio de la tribu Utan",
		Description = {
			"Inicio: NPC: Request Board en Ubicacion: com_d02_i (238, 266). La aldea está planeando exterminar a la tribu Megalith. Mata a 5 de cada uno de los Ancient Stone Shooter, Ancient Utan Shooter y Ancient Utan Fighter, luego preséntate ante el jefe de defensa Ruanda."
		},
		Summary = ""
	},
	[5855] = {
		Title = "[Enfriamiento] Operación: Exterminio de la tribu Utan",
		Description = {
			"Inicio: NPC: Defense Manager Luanda en Ubicacion: com_d02_i (241, 255). El Jefe de Defensa Ruanda espera que mañana vuelvas a unirte a la lucha contra la tribu Utan."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[5856] = {
		Title = "Mi nombre es Achimi",
		Description = {
			"Inicio: NPC: Morning en Ubicacion: sp_rudus (130, 200). ¡Hola! Amigo que lee esta nota: Tuve que mudarme con prisa y terminé dejando al niño atrás. Ese niño es un sujeto de prueba abandonado de Ludus. Llámalo simplemente Achimi. No te lo estoy echando encima; Iré a verlo cuando tenga tiempo, así que asegúrate de que Achimi reciba su comida. Dale lo que te pida. No puedo permitirme el lujo de asimilarlo ahora. Por favor. -Olgu"
		},
		Summary = ""
	},
	[5857] = {
		Title = "Haciendo amigos para Achimi",
		Description = {
			"¡Hola! Amigo que lee esta nota, gracias por cuidar las comidas de Achimi. Quizás porque le hablé de Porings recientemente, le gusta tanto Porings. Si tuviera al menos una mascota Poring, no estaría tan solo. Entonces, ¿podrías conseguir un huevo de Poring y dárselo a Achimi? Por favor. Tu amigo. -Olgu"
		},
		Summary = "huevo"
	},
	[5858] = {
		Title = "Haciendo amigos para Achimi",
		Description = {
			"¡Hola! Amigo, ¿parece que Achimi ha comenzado a verte como su alimentador? Oh, eso es una tontería. Lo conté recientemente sobre Rocker, la cigarra cantante. Ahora parece que quiere ver a Rocker. ¿Podrías conseguir un huevo de Rocker esta vez? Por favor. Tu amigo. -Olgu"
		},
		Summary = "Huevo balancín"
	},
	[5859] = {
		Title = "Haciendo amigos para Achimi",
		Description = {
			"¡Hola! Amigo, le conté a Achimi sobre la aventura de Picky y ahora ¿sientes curiosidad por Picky? ¿Podrías conseguir un huevo Picky esta vez? No puedo cuidarlo a menudo, así que al menos debería tener muchos amigos. Por favor. Tu amigo. -Olgu"
		},
		Summary = "huevo quisquilloso"
	},
	[5860] = {
		Title = "Haciendo amigos para Achimi",
		Description = {
			"¡Hola! Amigo sigo pidiendo favores y soy un descarado. ¿Quizás porque lo conté sobre el conejo que vive en la Luna? Es curioso lo de Lunatic. ¿Puedes conseguir un huevo de lunático? Tengo un favor que pedirte, amigo. -Olgu"
		},
		Summary = "Huevo lunático"
	},
	[5861] = {
		Title = "[Enfriamiento] Cuidando a Achimi",
		Description = {
			"Inicio: NPC: Morning en Ubicacion: sp_rudus (130, 200). Te encargaste de las comidas de Achimi. Si tienes tiempo, ¿no sería buena idea volver a ocuparte de ello mañana?"
		},
		Summary = "Se reinicia a las 04:00"
	},
