	[6025] = {
		Title = "KVM Guillaume",
		Description = {
			"Inicio: NPC: KVM Waiting Room en Ubicacion: bat_room (169, 205). Has prometido tu lealtad al Guillaume. Sólo las coincidencias de KVM con Guillaume estarán disponibles durante los próximos 5 minutos."
