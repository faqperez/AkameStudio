	},
	[14648] = {
		Title = "El hielo aún no se ha derretido",
		Description = {
			"Todavía queda mucho hielo. Hace calor afuera, así que tómate un pequeño descanso antes de regresar."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14649] = {
		Title = "º°À\" °¡Á®´Ù ÁÖ¼¼¿ä",
		Description = {
			"Àß ¸¶¸¥ º°.Î ÃàÁ¦¿¡ Âü°¡ÇÑ \"ç¶÷µéÇÑÅ× ±â³äÇ°À\" ¸¸?é¾î ³ª´² ÁÖ°í ½Í±º¿ä. Àß ¸¶¸¥ º° 14°³ Á¤µµ ºÎÅ¹µå¸³´Ï´Ù. ÆÄ??ÆÄ?? ºÒ°¡\"ç¸®ÀÇ º° ¸\"ÀÔ´Ï´Ù."
