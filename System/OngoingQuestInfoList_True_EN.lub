	[14529] = {
		Title = "Por favor visite nuevamente mañana",
		Description = {
			"Necesito más muñecas para repartirlas a los niños de manera justa. ¿Podrías volver a visitarnos mañana?"
		},
		Summary = "Visita después de las 04:00"
	},
	[14530] = {
		Title = "Enfriamiento de trozos de huevo",
		Description = {
			"El tiempo de espera para adquirir el trozo de huevo misterioso se reinicia a las 04:00."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[14531] = {
		Title = "Todo sobre Con-Chliina",
		Description = {
			"Inicio: NPC: Eggling en Ubicacion: lasagna (205, 325). Si eres el primero en llegar a Con-Chliina, siempre es un placer conocer al sobrecargo y escuchar su historia."
		},
		Summary = "Conoce al sobrecargo"
	},
	[14532] = {
		Title = "Saludos al Capitán Gamberi",
		Description = {
			"Inicio: NPC: Purser en Ubicacion: conch_in (65, 58). Ahora que llegaste a Con-Chliina para explorar un nuevo continente, es hora de conocer a los miembros. Primera charla con el Capitán Gamberi."
		},
		Summary = "Habla con Gamberi"
	},
	[14533] = {
		Title = "Saluda a la grabadora",
		Description = {
			"Inicio: NPC: Captain Gamberi en Ubicacion: conch_in (26, 64). Si desea saber más sobre Lasaña y Con-Chliina, conozca al registrador."
		},
		Summary = "La grabadora lo sabe todo"
	},
	[14534] = {
		Title = "a la cocina",
		Description = {
			"Inicio: NPC: Recorder en Ubicacion: conch_in (96, 29). Todos deberían estar en la cocina ya. Ve a la cocina."
		},
		Summary = "a la cocina"
	},
	[14535] = {
		Title = "al sobrecargo",
		Description = {
			"Inicio: NPC: Boatswain en Ubicacion: conch_in (181, 61). Revisa todo el barco, pero no hay muchos con quienes hablar. Volvamos a Sobrecargo."
		},
		Summary = "al sobrecargo"
	},
	[14536] = {
		Title = "Entrega al chef",
		Description = {
			"Inicio: NPC: Purser en Ubicacion: conch_in (65, 58). ¿No te dije que le llevaras el Calunac al Chef? Los ingredientes de los alimentos deben ser frescos, ¡no me decepciones!"
		},
		Summary = "Entrega al chef"
	},
	[14537] = {
		Title = "¿Cuándo despegamos?",
		Description = {
			"Inicio: NPC: Sous Chef en Ubicacion: conch_in (186, 57). La señal de salida llega tarde, ¿podría preguntarle al sobrecargo por favor?"
		},
		Summary = "al sobrecargo"
	},
	[14538] = {
		Title = "¿Podemos despegar?",
		Description = {
			"Inicio: NPC: Purser en Ubicacion: conch_in (65, 58). Un gran banco de niebla ha aparecido en el mar, consulta con el Oficial Principal Stello si podemos zarpar hoy o no. Debe realizar cualquier tarea necesaria de inmediato."
		},
		Summary = "Informe al director Stello"
	},
	[14539] = {
		Title = "dragón loco",
		Description = {
			"Inicio: NPC: Stello en Ubicacion: conch_in (24, 62). Parece que el Dragón que vive dentro de la cueva está un poco enojado estos días. Un miembro de Vigilante verifica diariamente la condición de Dragon; verifique qué está mal. El miembro vigilante debería permanecer cerca del lado sur del puente."
		},
		Summary = "Consulte con Vigilante"
	},
	[14540] = {
		Title = "Un recado salido de la nada",
		Description = {
			"Inicio: NPC: Eggling en Ubicacion: lasagna (205, 325). ¿Realmente lo hiciste? El Sous Chef me regañó por tu culpa, así que esta vez me debes una. Consígueme 3 almejas Basilac. Puedes recolectarlos cazando Basiliscos. Esto es para ti, ¿sabes?"
		},
		Summary = "3 almejas albahaca"
	},
	[14541] = {
		Title = "No tener noticias no es una buena noticia.",
		Description = {
			"Inicio: NPC: Vigilante en Ubicacion: lasagna (298, 84). El tipo que fue a comprobar el estado de Dragon no ha regresado todavía. Algo debe haber pasado. Sígueme a la cueva."
		},
		Summary = "Aventura en la cueva"
	},
	[14542] = {
		Title = "¿Cómo es el dragón?",
		Description = {
			"Inicio: NPC: Vigilante en Ubicacion: lasa_dun01 (153, 103). Hoy encontré un gran enemigo aterrador, aún no he visto a Tartufi... ¿Está bien Tartufi? Compruébalo, por favor..."
		},
		Summary = "Comprueba la salud del Dragón."
	},
	[14543] = {
		Title = "Caza de Basilisco",
		Description = {
			"Inicio: NPC: Tartufi en Ubicacion: lasa_dun_q (162, 158). Ese Basilisco es extraño hoy. Que dolor. Cuídalo por Machie, ¿quieres?"
		},
		Summary = "Cazar Basilisco"
	},
	[14544] = {
		Title = "ahora puedo irme",
		Description = {
			"Inicio: NPC: Tartufi en Ubicacion: lasa_dun_q (162, 158). En este momento, Basilisk ya no se burlará de mí. Me iré a la cama ahora. Es hora de decir adiós. Adiós."
		},
		Summary = "Informe al primer oficial"
	},
	[14545] = {
		Title = "al sobrecargo",
		Description = {
			"Inicio: NPC: Boarding Attendant en Ubicacion: lasagna (211, 186). Si es la primera vez que sube al Con-Chliina, obtenga información del Sr.Purser."
		},
		Summary = "al sobrecargo"
	},
	[14546] = {
		Title = "Cuida al ladrón de hierba",
		Description = {
			"Requisitos: Nivel Base: 6+. Inicio: NPC: Shepherd en Ubicacion: lasa_fild01 (353, 370). Para ayudar a nuestras vacas a comer su pasto pacíficamente, caza 5 de Grass Fabre y Reef Lunatics de cada uno, e informa al Jefe o al Pastor."
		},
		Summary = "Cuida al ladrón de hierba"
	},
	[14547] = {
		Title = "¿Podemos emprender la navegación?",
		Description = {
			"Inicio: NPC: Purser en Ubicacion: conch_in (65, 58). Apenas sabemos si podremos empezar a navegar debido a la niebla del mar. Por favor pregúntele al Capitán los detalles. La cabina del capitán está justo enfrente."
		},
		Summary = "Al señor capitán"
	},
	[14548] = {
		Title = "dragón loco",
		Description = {
			"Inicio: NPC: Captain Gamberi en Ubicacion: conch_in (26, 64). Parece que el Dragón que vive dentro de la cueva está un poco enojado estos días. Un miembro de Vigilante verifica diariamente la condición de Dragon; verifique qué está mal."
		},
		Summary = "Consulte con Vigilante"
	},
	[14549] = {
		Title = "No tener noticias no es una buena noticia.",
		Description = {
			"Inicio: NPC: Vigilante en Ubicacion: lasagna (298, 84). El tipo fue a comprobar el estado de Dragon y aún no ha regresado. Algo debe haber pasado. Sígueme a la cueva."
		},
		Summary = "Aventura en la cueva"
	},
	[14550] = {
		Title = "¿Cómo es el dragón?",
		Description = {
			"Inicio: NPC: Vigilante en Ubicacion: lasa_dun01 (153, 103). Encontré un gran enemigo aterrador hoy, no pude comprobar Tartufi todavía... ¿Está bien Tartufi?... Compruébalo, por favor..."
		},
		Summary = "Comprueba la salud del Dragón."
	},
	[14551] = {
		Title = "Basilisco jefe",
		Description = {
			"Inicio: NPC: Tartufi en Ubicacion: lasa_dun03 (162, 158). Reúnete con Imoogi, el jefe de los Basiliscos y pídeles que los mantengan tranquilos. Hay un dispositivo con el que puedes conversar en algún lugar allá arriba."
		},
		Summary = "Habla con Imoogi"
	},
	[14552] = {
		Title = "El mensaje del Señor Imuk",
		Description = {
			"Inicio: NPC: Lord Imuk en Ubicacion: lasa_dun03 (161, 292). Basilisk continuará con su deber hasta que ese joven entregue el Yeouiju."
		},
		Summary = "A Tartufi"
	},
	[14553] = {
		Title = "Caza de Basilisco",
		Description = {
			"Inicio: NPC: Tartufi en Ubicacion: lasa_dun03 (162, 158). Por favor ocúpate de ellos mientras busco a Yeouiju. Eliminar 20 de ellos suele funcionar."
		},
		Summary = "Caza de Basilisco"
	},
	[14554] = {
		Title = "Podemos empezar a navegar ahora",
		Description = {
			"Inicio: NPC: Tartufi en Ubicacion: lasa_dun03 (162, 158). Se encargó de Basilisk, Tartufi ahora está tranquilo. Informe al primer oficial Stello."
		},
		Summary = "Informe al primer oficial Stello"
	},
	[14555] = {
		Title = "Un mundo de sabor completamente nuevo",
		Description = {
			"Inicio: NPC: Sous Chef en Ubicacion: conch_in (186, 57). Estoy intentando investigar los ingredientes alimentarios del nuevo continente. ¿Me conseguirías 4 frutas de Mastera? Y también necesito 1 galleta dura con forma de gato."
		},
		Summary = "4 Frutas de Mastera y 1 Galleta Dura con forma de Gato"
	},
	[14556] = {
		Title = "También hay algo aterrador para mí.",
		Description = {
			"Inicio: NPC: Boatswain en Ubicacion: conch_in (181, 61). Esos aparecen de noche y me asustan mucho. Dijeron que un nuevo héroe podría ayudarme. Reúnase con Shamanyang y escuche la solución a mi problema. Shamanyang vive en la entrada del pueblo."
		},
		Summary = "A Shamanyang"
	},
	[14557] = {
		Title = "La verdad siempre es dura",
		Description = {
			"Inicio: NPC: Shaman meow en Ubicacion: lasagna (85, 93). Cuéntale a Boatswain la historia que te acabo de contar."
		},
		Summary = "Al contramaestre"
	},
	[14558] = {
		Title = "Criaturas sucias",
		Description = {
			"Inicio: NPC: Boatswain en Ubicacion: conch_in (181, 61). Nunca saldría con Basilisk. Así que consígueme 20 albahacas y 5 albahacas. Por supuesto que habrá un regalo."
		},
		Summary = "Albahaca y albahaca"
	},
	[14559] = {
		Title = "Duración del efecto de encanto",
		Description = {
			"Inicio: NPC: Boatswain en Ubicacion: conch_in (181, 61). El efecto de encanto desaparecerá a las 4 en punto"
		},
		Summary = "Inicializar a las 4 en punto"
	},
	[14560] = {
		Title = "Nuevo ingrediente",
		Description = {
			"A medida que aumenta el contacto con la gente del nuevo continente, descubrimos que sus encantos también son efectivos. Hoy necesitamos 5 Basilrocks y 1 agua bendita. Consíguelos y preséntate ante el contramaestre."
		},
		Summary = "Basilrock y agua Holi"
	},
	[14561] = {
		Title = "Sucio y asqueroso",
		Description = {
			"Basilrock está muy sucio y asqueroso. 20 Basilrocks serían suficientes por hoy. Consíguelos y preséntate ante Boatswain de inmediato."
		},
		Summary = "albahaca"
	},
	[14562] = {
		Title = "Los básicos son los mejores.",
		Description = {
			"Cíñete a lo básico es la forma más efectiva. Recoge Basil 20 c/u y Basil lock 5 c/u. Tan pronto como los consigas, ve con Boatswain de inmediato."
		},
		Summary = "Albahaca y albahaca"
	},
	[14563] = {
		Title = "tiempo libre",
		Description = {
			"Inicio: NPC: Sous Chef en Ubicacion: conch_in (186, 57). El trabajo de hoy no ha terminado. No podemos investigar sin que nuestro trabajo esté hecho. Vuelve después del amanecer."
		},
		Summary = "Reiniciar a las 4 am"
	},
	[14564] = {
		Title = "A mí también me encantan los bollos",
		Description = {
			"Inicio: NPC: Sous Chef en Ubicacion: conch_in (186, 57). Se dice que hay bollo en el nuevo continente. Hay una comida similar en la lasaña, así que me gustaría compararlas. ¿Puedes traerme 20 de ellos?"
		},
		Summary = "bollo 20 c/u"
	},
	[14565] = {
		Title = "Suministros de alimentos de emergencia",
		Description = {
			"Inicio: NPC: Sous Chef en Ubicacion: conch_in (186, 57). Me pregunto si Nyas solía alimentar a todos esos marineros de Navi. Por favor consígueme 5 de cada uno de ellos."
		},
		Summary = "Cat Hardtack, comida enlatada de Malangdo"
	},
	[14566] = {
		Title = "idea brillante",
		Description = {
			"Inicio: NPC: Sous Chef en Ubicacion: conch_in (186, 57). ¡¡Hielo que se derrite!! Si existe, ¡será una revolución en la conservación de los ingredientes! ¡Eso estimula mi curiosidad! ¡Recoge 20 de ellos!"
		},
		Summary = "Trozo de hielo"
	},
	[14567] = {
		Title = "¡La leche Kaluna está en peligro!",
		Description = {
			"Requisitos: Nivel Base: 140+. Inicio: NPC: Kalu en Ubicacion: lasagna (226, 181). No he oído nada del señor Legalas, que se supone que me traerá a Kahlugna. Por favor, conozca al señor Legalas y vea qué está pasando. Vive en el sur."
		},
		Summary = "Al señor Legalas"
	},
	[14568] = {
		Title = "Es hora de persuadir",
		Description = {
			"Inicio: NPC: Legalas en Ubicacion: lasagna (248, 105). ¡Moriremos de hambre! ¡Haz algo! ¡¡Habla con ellos, evita que coman más Kahlugnag!!"
		},
		Summary = "Mr.Sea Otter y Mr.Galapago"
	},
	[14569] = {
		Title = "niñera",
		Description = {
			"Inicio: NPC: Gopara en Ubicacion: lasagna (246, 103). Busquemos un bebé que necesita cuidados."
		},
		Summary = "Para cuidar a un bebe"
	},
	[14570] = {
		Title = "Procesamiento de anchoa",
		Description = {
			"Inicio: NPC: Cute Baby en Ubicacion: lasagna (195, 235). Quieren hacer algo relacionado con la anchoa. Vamos al taller de anchoas."
		},
		Summary = "Taller de anchoa"
	},
	[14571] = {
		Title = "Barco pesquero de anchoa",
		Description = {
			"Inicio: NPC: Workshop Manager en Ubicacion: lasagna (225, 290). Quieren subir al barco para acostumbrarse al transporte de anchoas. Visitaremos el barco pesquero de anchoveta."
		},
		Summary = "Barco pesquero de anchoa"
	},
	[14572] = {
		Title = "Indefenso...",
		Description = {
			"Inicio: NPC: Captain of Anchovy Fish en Ubicacion: lasagna (139, 299). Estoy harto y cansado de andar con esos dos que no pueden hacer nada y tienen voluntad de hacerlo. Debería regresar con el señor Legalas sin alternativa."
		},
		Summary = "Al señor Legalas"
	},
	[14573] = {
		Title = "Necesito tiempo para mi cuenta",
		Description = {
			"Inicio: NPC: Legalas en Ubicacion: lasagna (248, 105). Podría trabajar un poco mientras ellos no estuvieran aquí. Debería terminar un poco, así que quédate con ellos un rato. Y por favor dígale al Sr. Kalu que le entregaré los productos muy pronto."
		},
		Summary = "Informe al Sr. Kalu"
	},
	[14574] = {
		Title = "Entrega de cajas de comida",
		Description = {
			"Inicio: NPC: Kalu en Ubicacion: lasagna (226, 181). Puedo hacer que se mantengan alejados del señor Legalas para dejarle hacer su trabajo. ¿Podrías entregarle esta lonchera al justiciero Panna en la cueva? Por supuesto, deberías traerlos contigo."
		},
		Summary = "Para vigilante en la cueva"
	},
	[14575] = {
		Title = "Informe completo de entrega",
		Description = {
			"Inicio: NPC: Panna en Ubicacion: lasa_dun02 (55, 153). Terminé de entregar la caja de comida al miembro de Vigilante. Volvamos a Kalu."
		},
		Summary = "A Kalu"
	},
	[14576] = {
		Title = "Tiempo de entrega de la caja de comida",
		Description = {
			"Inicio: NPC: Kalu en Ubicacion: lasagna (226, 181). El tiempo de entrega no es ahora. Espera hasta después del amanecer y regresa."
		},
		Summary = "Inicializar a las 04 en punto"
	},
	[14577] = {
		Title = "Entrega de cajas de comida",
		Description = {
			"Inicio: NPC: Kalu en Ubicacion: lasagna (226, 181). ¡Ayúdame con la entrega de cajas de comida al Vigilante Pana dentro de la cueva!"
		},
		Summary = "Entrega al miembro de Vigilante dentro de la cueva."
	},
	[14578] = {
		Title = "Informe completo de entrega",
		Description = {
			"Inicio: NPC: Panna en Ubicacion: lasa_dun02 (55, 153). Terminé de entregar la caja de comida al miembro de Vigilante. Volvamos a Kalu."
		},
		Summary = "A Kalu"
	},
	[14579] = {
		Title = "Entrevista con el capitán",
		Description = {
			"Inicio: NPC: Recorder en Ubicacion: conch_in (96, 29). Habla con el Capitán Gamberi, pregúntale esto y aquello. Y cuéntame lo que escuchaste."
		},
		Summary = "Al Capitán Gamberi"
	},
	[14580] = {
		Title = "A la grabadora",
		Description = {
			"Inicio: NPC: Captain Gamberi en Ubicacion: conch_in (26, 64). Entrevista terminada con el Capitán Gamberi. Volvamos a la Grabadora."
		},
		Summary = "Volver a la grabadora"
	},
	[14581] = {
		Title = "Entrevista con el jefe",
		Description = {
			"Inicio: NPC: Recorder en Ubicacion: conch_in (96, 29). Habla con Peperoncino, pregúntale sobre el Capitán Gamberi y otros. Vuelve y cuéntame lo que escuchaste. El jefe Peperoncino se hospeda en el restaurante del Adventurer Club."
		},
		Summary = "Al jefe Peperoncino"
	},
	[14582] = {
		Title = "A la grabadora",
		Description = {
			"Inicio: NPC: Chief Peperoncino en Ubicacion: lasa_in01 (179, 60). Entrevista terminada con Peperoncino. Volvamos a la Grabadora."
		},
		Summary = "Volver a la grabadora"
	},
	[14583] = {
		Title = "A la abuela",
		Description = {
			"Inicio: NPC: Recorder en Ubicacion: conch_in (96, 29). Encuentra a Granma atrapada en el tiempo, pregunta por el Capitán y el Jefe. Vuelve y cuéntame qué dijo. La abuela vive cerca del Pub-Oven."
		},
		Summary = "A la abuela"
	},
	[14584] = {
		Title = "Volver a la grabadora",
		Description = {
			"Inicio: NPC: Grandma en Ubicacion: lasagna (263, 156). Terminada toda la entrevista ahora, volvamos a Recorder."
		},
		Summary = "Volver a la grabadora"
	},
	[14585] = {
		Title = "Encontrar la causa",
		Description = {
			"Inicio: NPC: Dream en Ubicacion: rachel (176, 145). Es necesario descubrir por qué las horas de sueño del Papa se han alargado últimamente. Entra en el sueño del Papa, encuentra la causa y resuélvela si hay algún problema."
		},
		Summary = "dentro del sueño"
	},
	[14586] = {
		Title = "hora de dormir",
		Description = {
			"Inicio: NPC: Dream en Ubicacion: rachel (176, 145). El Papa aún no se ha dormido. Por favor regrese después de que hayan pasado las primeras horas de la mañana."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[14587] = {
		Title = "Encontrar la causa",
		Description = {
			"Inicio: NPC: Dream en Ubicacion: rachel (176, 145). Es necesario descubrir por qué las horas de sueño del Papa se han alargado últimamente. Entra en el sueño del Papa, encuentra la causa y resuélvela si hay algún problema."
		},
		Summary = "dentro del sueño"
	},
	[14588] = {
		Title = "La competencia",
		Description = {
			"Requisitos: Nivel Base: 10+. Inicio: NPC: Florin en Ubicacion: lasa_fild02 (102, 372). Encárgate de 10 avispones salvajes para la competencia de cosecha de miel e informa al jefe o a Florin."
		},
		Summary = "Avispón salvaje"
	},
	[14589] = {
		Title = "ingrediente pegajoso",
		Description = {
			"Inicio: NPC: Prok en Ubicacion: lasa_fild02 (177, 241). Nos falta Webfoot para hacer budines. Caza 10 ranas dulces de Roda y recoge 5 patas web pegajosas, informa al jefe o al pastor."
		},
		Summary = "Derrota a Sweet Roda Frog y recoge 5 Sticky Webfoots."
	},
	[14590] = {
		Title = "El destino del cazador.",
		Description = {
			"Requisitos: Nivel Base: 16+. Inicio: NPC: Fisher en Ubicacion: lasa_fild02 (326, 170). Dicen que los lobos cazadores del desierto roban pescado seco. Caza a 10 de ellos e informa al Jefe o al Pastor."
		},
		Summary = "cazador lobo del desierto"
	},
	[14591] = {
		Title = "Ingrediente secreto",
		Description = {
			"Inicio: NPC: Sleepy meow en Ubicacion: lasa_fild02 (331, 251). La espora Mashroom de Trance Spore es el ingrediente secreto del pastel de pescado. Caza 10 rastros de esporas y lleva 5 esporas de hongo al jefe o al pastor."
		},
		Summary = "Espora de trance"
	},
	[14592] = {
		Title = "Tiempo de descanso",
		Description = {
			"Requisitos: Nivel Base: 6+. Inicio: NPC: Shepherd en Ubicacion: lasa_fild01 (353, 370). Descanse un poco para trabajar duro mañana."
		},
		Summary = "Inicializado a las 04 en punto"
	},
	[14593] = {
		Title = "¸ÞÀÏ ¹ß¼Û",
		Description = {
			"¸ÞÀÏ ¹ß¼Û"
		},
		Summary = ""
	},
	[14594] = {
		Title = "Listo para recorrer el camino de los sueños",
		Description = {
			"Inicio: NPC: High Priestess Niren en Ubicacion: rachel (174, 138). Si estás listo para recorrer el camino de los sueños, ven a buscarme de nuevo."
		},
		Summary = "A Niruen"
	},
	[14595] = {
		Title = "A la estación de tren de Einbech",
		Description = {
			"Inicio: NPC: Unusual person en Ubicacion: einbroch (239, 269). Tenemos que ir a la estación de tren de Einbech, así que observa atentamente mi rastro y sígueme. Si se pierde el rastro, nos encontraremos en la estación de tren de Einbech."
		},
		Summary = "A la estación de tren de Einbech"
	},
	[14596] = {
		Title = "Siguiendo el rastro",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: einbech (46, 208). El camino se complica a partir de aquí. Dejaré rastros, así que observa atentamente y sígueme. También lo he marcado en el mapa. Si pierdes el rastro, sigue recto hacia abajo por ahora."
		},
		Summary = "Sigue el camino hacia abajo"
	},
	[14597] = {
		Title = "Un rincón de Einbech",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: einbech (76, 131). Tenemos que dirigirnos a un lugar apartado en el sureste de Einbech. Observa atentamente el rastro y sígueme. También lo he marcado en el mapa."
		},
		Summary = "Al lugar apartado"
	},
	[14598] = {
		Title = "La entrada invisible",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: einbech (217, 82). La rabia parece tener algo que hacer aquí. Entremos rápido."
		},
		Summary = "A la puerta invisible"
	},
	[14599] = {
		Title = "Una taza de té a cambio",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: rebel_in (21, 45). Vinimos hasta aquí, así que al menos deberíamos tomar una taza de té. Si hablas con Nemi o Eri, te dejarán entrar."
		},
		Summary = "Dentro"
	},
	[14600] = {
		Title = "El caballero del segundo piso",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: rebel_in (86, 61). Primero, ve a hablar con el caballero del segundo piso, Rupert. Persuadir no será fácil, pero cuando las cosas se pongan difíciles, ve a ver a las damas. ."
		},
		Summary = "Primero, al caballero del segundo piso."
	},
	[14601] = {
		Title = "Las damas del segundo piso",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: rebel_in (86, 61). Ve a hablar con las damas del segundo piso. Debes ser lo más educado posible. Lo sabes, ¿verdad?"
		},
		Summary = "A las damas del segundo piso."
	},
	[14602] = {
		Title = "El perro de caza en el segundo piso.",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Ve a hablar con Elena en el segundo piso. Si pasas por aquí en algún momento como un aventurero que parece fuerte, serás bienvenido. Probablemente..."
		},
		Summary = "A Elena en el segundo piso."
	},
	[14603] = {
		Title = "Materiales para la reparación de tuberías",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). Para reparar la tubería, necesita 5 placas de acero y 15 placas desgastadas. También me gustaría que mataras unos 10 Scrap Stoves."
		},
		Summary = "Materiales para la reparación."
	},
	[14604] = {
		Title = "Combustible Nacional, Combustible Solar",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). Necesitamos 10 madera quemada y 3 carbón. Tendrás que matar unos 10 Scrap Stoves, tal vez incluso más. Hace demasiado frío. ¡Date prisa antes de que me muera congelado!"
		},
		Summary = "Recoger combustible nacional"
	},
	[14605] = {
		Title = "Cosas que brillan",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). Necesitas 10 de cada uno de los fragmentos de cristal brillante y 10 del fragmento de cristal negro. Puedes obtener otros más brillantes eliminando Obsidiana y Mineral con técnica, entonces, ¿no sería suficiente matar a 5 de cada uno?"
		},
		Summary = "Recoge fragmentos de cristal"
	},
	[14606] = {
		Title = "Materiales para la reparación de tuberías",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). Para reparar la tubería, necesita 5 placas de acero y 15 placas desgastadas. También me gustaría que mataras unos 10 Scrap Stoves."
		},
		Summary = "Materiales para la reparación."
	},
	[14607] = {
		Title = "Combustible Nacional, Combustible Solar",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). Necesitamos 10 madera quemada y 3 carbón. Tendrás que matar unos 10 Scrap Stoves, tal vez incluso más. Hace demasiado frío. ¡Date prisa antes de que me muera congelado!"
		},
		Summary = "Recoger combustible nacional"
	},
	[14608] = {
		Title = "Cosas que brillan",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). Necesitas 10 de cada uno de los fragmentos de cristal brillante y 10 del fragmento de cristal negro. Puedes obtener otros más brillantes eliminando Obsidiana y Mineral con técnica, entonces, ¿no sería suficiente matar a 5 de cada uno?"
		},
		Summary = "Recoge fragmentos de cristal"
	},
	[14609] = {
		Title = "tiempo tranquilo",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: rebel_in (88, 61). No necesito tu ayuda ahora, aventurero, así que descansa un rato."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14610] = {
		Title = "Recuperar armas de fuego",
		Description = {
			"Inicio: NPC: Master en Ubicacion: rebel_in (108, 36). Si bajas desde Einbech, encontrarás montículos de tierra de aspecto sospechoso por todas partes. Extráelos y encontrarás restos de armas rotas; tráemelos. Aproximadamente 3. Tenga cuidado al tocar montículos de tierra sospechosos. Los rencores pueden surgir."
		},
		Summary = "recuperar las armas de fuego"
	},
	[14611] = {
		Title = "Recuperar armas de fuego",
		Description = {
			"Inicio: NPC: Master en Ubicacion: rebel_in (108, 36). Si bajas desde Einbech, encontrarás montículos de tierra de aspecto sospechoso por todas partes. Extráelos y encontrarás restos de armas rotas; tráemelos. Aproximadamente 3. Tenga cuidado al tocar montículos de tierra sospechosos. Los rencores pueden surgir."
		},
		Summary = "recuperar las armas de fuego"
	},
	[14612] = {
		Title = "Tiempo de reparaciones",
		Description = {
			"Inicio: NPC: Master en Ubicacion: rebel_in (108, 36). Estoy reparando lo que trajiste ahora mismo. Te agradecería que volvieras después de que hayan pasado las primeras horas de la mañana."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14613] = {
		Title = "Est en el segundo piso",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: rebel_in (86, 61). Ve a hablar con Est en el segundo piso. Si convences a Est, el resto será fácil."
		},
		Summary = "Para Est en el 2do piso."
	},
	[14614] = {
		Title = "Persuadir a los agentes del poder",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: rebel_in (86, 61). Ve a reunirte y persuadir a los agentes de poder en el segundo piso. No debes tomar otro camino: ¡tienes que venir directamente hacia mí! ¡Haz lo mejor que puedas, nuestro aventurero!"
		},
		Summary = "Informe después de persuadir a los agentes del poder"
	},
	[14615] = {
		Title = "Entre la negociación y el engaño",
		Description = {
			"Inicio: NPC: Rebellion Squadder en Ubicacion: rebel_in (65, 46). Dicen que tenemos a alguien dispuesto a cooperar de nuestra parte. Ve a encontrarte con el miembro de Rebellion en el pasillo junto a la tienda."
		},
		Summary = "Al miembro de Rebelión"
	},
