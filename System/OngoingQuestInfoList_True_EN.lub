	[7842] = {
		Title = "Castigar a Sweet Drops vuelve a estar disponible hoy - Enfriamiento",
		Description = {
			"Una vez finalizado el período de espera, esta misión de evento se puede repetir a través de Chocola en Prontera."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[7850] = {
		Title = "Gato a prueba de balas",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: einbech (219, 80). El miembro de Rebellion que conociste en Einbech te dijo que recientemente han estado usando una tienda en Einbroch como escondite para cubrir su área de operaciones ampliada. Encuentra el gato antibalas en Einbroch."
		},
		Summary = "Habla con Tess en Bulletproof Cat"
	},
	[7851] = {
		Title = "La nueva base de operaciones",
		Description = {
			"Inicio: NPC: Philofontes en Ubicacion: pub_cat (93, 105). Obtuviste información sobre la nueva base de operaciones, Ludus, de Tess. Dirigámonos a la base y unámonos a la Rebelión."
		},
		Summary = "Habla con Elena Volkova"
	},
	[7852] = {
		Title = "Más allá del muro barrera",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: sp_rudus (184, 360). Elena Volkova, esperando en la nueva base de operaciones Ludus, te pide que hables con Rookie, que está investigando la barrera, y luego investiga más allá."
		},
		Summary = "hablar con novato"
	},
	[7853] = {
		Title = "Investigando alrededor de la barrera",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: sp_rudus (193, 284). El novato dentro de Ludus te pide que investigues el área alrededor de la barrera. Si encuentra algo inusual, recójalo e infórmelo."
		},
		Summary = "Investiga alrededor del muro barrera."
	},
	[7854] = {
		Title = "El muro en la línea del ferrocarril",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: sp_rudus (304, 266). El muro de barrera se construye sobre la línea del ferrocarril. Parece haber sido construido algún tiempo después del abandono de la mina."
		},
		Summary = ""
	},
	[7855] = {
		Title = "La Atalaya",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: sp_rudus (122, 286). Una torre de vigilancia lo suficientemente alta como para inspeccionar todo lo que hay más allá de la barrera de un vistazo. Una torre de vigilancia así no sería necesaria para la fundición de minerales..."
		},
		Summary = ""
	},
	[7856] = {
		Title = "un agujero",
		Description = {
			"Inicio: NPC: Small Hole en Ubicacion: sp_rudus (27, 300). Donde el extremo de la pared de barrera se encuentra con la roca, hay un pequeño agujero lo suficientemente grande como para que un niño pequeño pueda pasar por él."
		},
		Summary = ""
	},
	[7857] = {
		Title = "Informar al novato",
		Description = {
			"Inicio: NPC: Rookie en Ubicacion: sp_rudus (193, 284). Prácticamente has mirado alrededor de la barrera. Pasemos la información que recopilaste a Rookie."
		},
		Summary = "hablar con novato"
	},
	[7858] = {
		Title = "Investigando los sonidos sospechosos",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: sp_rudus (184, 360). Algunos miembros de Rebellion ya se han movido para encontrar la fuente de los sonidos que provienen de más allá del muro de la barrera. Rookie te pidió que lo terminaras con estilo si la fuente resulta ser un monstruo."
		},
		Summary = "cazar al monstruo"
	},
	[7859] = {
		Title = "Informe a Tess",
		Description = {
			"Inicio: NPC: Philofontes en Ubicacion: pub_cat (93, 105). Elena Volkova te dijo que regresaras con Bulletproof Cat y le informaras a Tess que la situación más allá de la barrera no es normal. Aunque Elena lo llamó un depósito de chatarra..."
		},
		Summary = "Informe a Tess"
	},
	[7860] = {
		Title = "Un invitado inesperado",
		Description = {
			"Inicio: NPC: Philofontes en Ubicacion: pub_cat (93, 105). Tess, a quien conociste en Bulletproof Cat, dijo que tenía un asunto urgente y te llevó a una habitación secreta adentro."
		},
		Summary = "Habla con Tess en la habitación secreta."
	},
	[7861] = {
		Title = "La crisis de la empresa",
		Description = {
			"Inicio: NPC: Republic Guard en Ubicacion: lighthalzen (56, 270). Has decidido unirte al grupo de Est para recuperar el laboratorio Regenschirm, que ha sido capturado por un traidor interno. Reunámonos con la guardia de la República que está preparada para la operación en Lihitarzen."
		},
		Summary = "Habla con la Guardia de la República"
	},
	[7862] = {
		Title = "Operación: Retomar Regenschirm",
		Description = {
			"Inicio: NPC: Republic Guard en Ubicacion: lighthalzen (56, 270). Has decidido infiltrarte en el laboratorio y limpiar la casa por dentro. Puedes ingresar al laboratorio a través de Oscar, que está en espera."
		},
		Summary = "retomar el laboratorio"
	},
	[7863] = {
		Title = "Datos obtenidos del laboratorio",
		Description = {
			"Inicio: NPC: Philofontes en Ubicacion: pub_cat (93, 105). Estos son datos relacionados con el equipo de seguridad del laboratorio 1."
		},
		Summary = "Informe a Tess\""
	},
	[7864] = {
		Title = "Tomando un respiro",
		Description = {
			"Inicio: NPC: Philofontes en Ubicacion: pub_cat (93, 105). Mientras Tess analiza los datos, has decidido ayudar a Rage. Busquemos a Rage, que debería estar en algún lugar de la taberna."
		},
		Summary = "Habla con la rabia"
	},
	[7865] = {
		Title = "La segunda operación",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: ein_fild03 (278, 269). Se llevará a cabo una nueva operación en la mina abandonada del yacimiento noroeste de Einbroch. Conozca al miembro de Rebellion que está en espera y únase a la operación."
		},
		Summary = "Habla con Rebelion Crew"
	},
	[7866] = {
		Title = "De vuelta al gato a prueba de balas",
		Description = {
			"Debes regresar con Bulletproof Cat e informarle toda la historia del laboratorio a Tess."
		},
		Summary = "Habla con Tess"
	},
	[7867] = {
		Title = "Mercenario contra mercenario",
		Description = {
			"Inicio: NPC: Juslan en Ubicacion: sp_cor (155, 94). Yuslan, del distrito de guardia especial Kor, te ha pedido que elimines a Belare y Sanare, los cazadores de corazones que aparecen dentro de Os."
		},
		Summary = "Elimina a los cazadores de corazones\""
	},
	[7868] = {
		Title = "Mercenario contra Mercenario - Enfriamiento",
		Description = {
			"Inicio: NPC: Juslan en Ubicacion: sp_cor (155, 94). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Yuslan del Distrito de Guardia Especial Kor."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[7997] = {
		Title = "El verdadero sabor de la comida para gatos",
		Description = {
			"Has visto el efecto de la comida para gatos. Después del reinicio, es posible que vuelvas a probar la comida para gatos."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[7998] = {
		Title = "±×´ë¿¡°Ô ¸¶Áö¸. Æò¿ÂÀ\"",
		Description = {
			"È¦.Î ¹öÆ¾ ±â\"ç°¡ ¸¶Áö¸. ¿µ±¤ÀÇ ±æÀ\" °¥ ¼ö ÀÖ?µ.Ï."
		},
		Summary = "±â??"
	},
	[7999] = {
		Title = "La 'regresión' de la sala central",
		Description = {
			"Es posible que tengas que investigar nuevamente el núcleo de la sala central, que tiene un sistema de \"regresión\" parcial."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[8000] = {
		Title = "Renunciar al cambio de trabajo",
		Description = {
			"Deja de cambiar tu trabajo a Asesino y regresa a la ciudad."
		},
		Summary = "Dejar de trabajar Cambiar a Asesino"
	},
	[8001] = {
		Title = "Cambio de trabajo a asesino",
		Description = {
			"Inicio: NPC: Guildsman en Ubicacion: in_moc_16 (19, 33). Complete el formulario para postularse para el trabajo de Asesino y realizar la prueba."
		},
		Summary = "Solicitar cambio de trabajo a Asesino"
	},
	[8002] = {
		Title = "Cambio de trabajo a asesino",
		Description = {
			"Debes obtener al menos 9 de 10 preguntas para aprobar el examen."
		},
		Summary = "Prueba escrita para cambio de trabajo a Asesino"
	},
	[8003] = {
		Title = "Cambio de trabajo a asesino",
		Description = {
			"Debes capturar 6 \"objetivos de cambio de trabajo\" para pasar la prueba."
		},
		Summary = "¡Atrapa los 6 objetivos de cambio de trabajo!"
	},
	[8004] = {
		Title = "Cambio de trabajo a asesino",
		Description = {
			"Tu habilidad para esconderte debe ser puesta a prueba. Deberás usar tus habilidades para esconderte con poción hasta llegar al otro lado de la habitación sin derrotar a ningún monstruo."
		},
		Summary = "Ningún monstruo debe ser derrotado."
	},
	[8005] = {
		Title = "Cambio de trabajo a asesino",
		Description = {
			"Ve a la sala de pruebas finales."
		},
		Summary = ""
	},
	[8006] = {
		Title = "¡Encuentra al maestro del gremio!",
		Description = {
			"Debes atravesar el laberinto y encontrar al Guild Master."
		},
		Summary = "¡Encuentra al maestro del gremio!"
	},
	[8007] = {
		Title = "Aceptación del maestro del gremio",
		Description = {
			"Trae el collar del maestro del gremio y ve a encontrarte con el experto en asesinos \"Huey\"."
		},
		Summary = "Entrega del collar por parte del Guildmaster."
	},
	[8008] = {
		Title = "Cambio de trabajo a asesino",
		Description = {
			"¡¡Ahora te has convertido en un Asesino!!"
		},
		Summary = "Cambio de trabajo a asesino"
	},
	[8009] = {
		Title = "Solicitud de cambio de trabajo a sacerdote",
		Description = {
			"Inicio: NPC: High Bishop en Ubicacion: prt_church (16, 41). Acepta las Tres Pruebas del Sacerdocio para cambiar de trabajo."
		},
		Summary = "Solicitud de cambio de trabajo a sacerdote"
	},
	[8010] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"Debes hacer una peregrinación. Primero, visite Rubalkabara, que se encuentra en el noreste de las ruinas de Prontera. En segundo lugar, visite a la hermana Mathilda, que está cerca de Marruecos, al suroeste de Prontera. Finalmente, visite al padre Yosuke en un campo al noroeste de Prontera."
		},
		Summary = "1.ª prueba, una Romería"
	},
	[8011] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"Trasladarse al lugar donde se realiza el Entrenamiento Espiritual. Habla con Pedro S. Alberto."
		},
		Summary = "2da prueba, el Entrenamiento Espiritual"
	},
	[8012] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"Empieza a entrenar. ¡Derrota a todos los monstruos! ¡No tengas piedad de las criaturas de la oscuridad!"
		},
		Summary = "2da prueba, el Entrenamiento Espiritual"
	},
	[8013] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"¡Has completado el Entrenamiento Espiritual! Ve a ver a la hermana Cecilia."
		},
		Summary = "Prueba de cambio de trabajo a Sacerdote"
	},
	[8014] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"Haz una promesa de dedicarte a Dios."
		},
		Summary = "3ra prueba, tu Devoción a Dios"
	},
	[8015] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"Has completado las 3 misiones al hacer el juramento del Sacerdocio. Vuelve con el obispo Paul."
		},
		Summary = "Solicitud de cambio de trabajo a sacerdote"
	},
	[8016] = {
		Title = "Cambio de trabajo a sacerdote",
		Description = {
			"¡¡Ahora te has convertido en Sacerdote!!"
		},
		Summary = ""
	},
	[8017] = {
		Title = "Inspección de fábrica",
		Description = {
			"Inicio: NPC: Zelmeto en Ubicacion: ein_in01 (67, 242). Zelmeto te ha pedido que le ayudes a inspeccionar una a una las máquinas de la fábrica para saber cuál necesita ser reparada. Encuentra el segundo panel de control e informa a Zelmeto."
		},
		Summary = ""
	},
	[8018] = {
		Title = "Inspección de fábrica",
		Description = {
			"Encontraste el segundo panel de control y está completamente roto. Informe esto a Zelmeto."
		},
		Summary = ""
	},
	[8019] = {
		Title = "Inspección de fábrica",
		Description = {
			"Zelmeto le pidió que inspeccionara los reguladores automáticos de presión y reportara cualquier problema por pequeño que parezca."
		},
		Summary = ""
	},
	[8020] = {
		Title = "Inspección de fábrica",
		Description = {
			"Encontró los reguladores de presión automáticos y, después de revisarlos más cuidadosamente, descubrió que hace ruidos extraños y que algunos de los tornillos de la superficie están flojos. Informe sus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8021] = {
		Title = "Inspección de fábrica",
		Description = {
			"Ahora Zelmeto te pidió que inspeccionaras otro panel de control. Es similar al primero pero más grande. Está ubicado en medio de la fábrica. Encuéntralo e informa a Zelmeto."
		},
		Summary = ""
	},
	[8022] = {
		Title = "Inspección de fábrica",
		Description = {
			"El panel de control principal no parece tener ningún problema. Pero después de golpear su superficie, se escucha un sonido hueco y desalentador. Parece que le faltan algunas piezas... Informe sus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8023] = {
		Title = "Inspección de fábrica",
		Description = {
			"Zelmeto te pidió que inspeccionaras una mano mecánica que transporta objetos pequeños. Encuéntralo e informa tus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8024] = {
		Title = "Inspección de fábrica",
		Description = {
			"Los movimientos del transportador parecen nerviosos y torpes. El brazo mecánico tampoco parece lo suficientemente potente para soportar las cargas que lleva... Informa de tus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8025] = {
		Title = "Inspección de fábrica",
		Description = {
			"Ahora debes inspeccionar una tubería ubicada cerca de los grandes calderos de metal fundido e informar tus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8026] = {
		Title = "Inspección de fábrica",
		Description = {
			"La tubería que encontró está hinchada y desgastada debido a largos periodos de sobrecarga de presión. Es un milagro que aún no haya explotado. Informe sus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8027] = {
		Title = "Inspección de fábrica",
		Description = {
			"Lo último que Zelmeto le ha pedido que inspeccione es un transportador más grande y potente. Encuéntralo e informa tus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8028] = {
		Title = "Inspección de fábrica",
		Description = {
			"Este último transportador parece tener problemas similares a los de su versión más pequeña. Sus movimientos son torpes, erráticos y débiles, y casi todos sus tornillos están oxidados. Informe sus hallazgos a Zelmeto."
		},
		Summary = ""
	},
	[8029] = {
		Title = "Inspección de fábrica",
		Description = {
			"Zelmeto le dice que necesita solicitar al superintendente un aumento en el presupuesto de reparación de fábrica para asegurarse de que tengan suficientes materiales para las reparaciones. Encuentra al superintendente."
		},
		Summary = ""
	},
	[8030] = {
		Title = "Inspección de fábrica",
		Description = {
			"El superintendente se negó a aprobar el aumento del presupuesto de Reparación de Fábrica. Será mejor que le informes las malas noticias a Zelmeto."
		},
		Summary = ""
	},
	[8031] = {
		Title = "Inspección de fábrica",
		Description = {
			"Zelmeto todavía quiere hacer las reparaciones, por lo que te ha pedido que traigas ^FF000020 Tubo flexible^000000, ^FF000010 Tornillo oxidado^000000 y ^FF000010 Placa de hierro usada^000000 para que puedan hacer las reparaciones necesarias."
		},
		Summary = ""
	},
	[8032] = {
		Title = "El favor de Tarlock",
		Description = {
			"Inicio: NPC: Airship Captain en Ubicacion: airplane_01 (238, 154). Tarlock dice que no le importaría contarte cómo funciona el dirigible si le haces el favor de entregarle una carta a su hermano Ferlock."
		},
		Summary = "Entrega la carta de Tarlock a su hermano."
	},
	[8033] = {
		Title = "El favor de Ferlock",
		Description = {
			"Ferlock te ha pedido que recuperes sus cosas robadas de los monstruos que atacan el dirigible de Tarlock. Llévale 2 Voluntad de la Oscuridad y 2 Frutas Espinosas a Ferlock."
		},
		Summary = "Recuperar objetos robados"
	},
	[8034] = {
		Title = "El favor de Ferlock",
		Description = {
			"Ferlock te pidió que le llevaras la respuesta a su hermano Tarlock."
		},
		Summary = "Entrega la carta de Ferlock a su hermano, Tarlock."
	},
	[8035] = {
		Title = "Cómo funciona el dirigible",
		Description = {
			"Has entregado la carta de Ferlock a Tarlock. Ahora puede ser un buen momento para preguntarle cómo funciona el dirigible."
		},
		Summary = "Continuar hablando con Tarlock"
	},
	[8036] = {
		Title = "El favor de Hallen",
		Description = {
			"Inicio: NPC: Hallen en Ubicacion: airplane (236, 63). Hallen te ha pedido que le entregues una carta a Kaci de alguien llamado Sr. Mawong que es algo así como su mentor."
		},
		Summary = "Entregar la carta a Kaci"
	},
	[8037] = {
		Title = "El rodillo de dados",
		Description = {
			"Le entregaste la carta de Hallen a Kaci. Probablemente deberías descubrir lo que ella sabe..."
		},
		Summary = ""
	},
	[8038] = {
		Title = "El rodillo de dados",
		Description = {
			"Resulta que Kaci es prima de Hallen. Después de responder a sus preguntas, volvió a ejecutar sus juegos. ¿Quién más sabría de su pasado?"
		},
		Summary = ""
	},
	[8039] = {
		Title = "El secreto de los dirigibles",
		Description = {
			"Hallen te dice que su proyecto es aprender más sobre cómo funcionan los dirigibles. Podría resultarle beneficioso preguntarle a alguien que tenga conocimientos sobre dirigibles e informar sus hallazgos a Hallen."
		},
		Summary = ""
	},
	[8040] = {
		Title = "El secreto de los dirigibles",
		Description = {
			"\"¿En serio...? ¿Hablas en serio? Una imitación del Heart Piece de Ymir. ¿Dónde he oído hablar de eso antes? Mm, déjame pensar...\""
		},
		Summary = "Continuar hablando con Hallen"
	},
	[8041] = {
		Title = "El secreto de los dirigibles",
		Description = {
			"¡Kaci me habló de un borracho que siempre menciona el Corazón de Ymir cuando juega al juego de dados para comprar manzanas!"
		},
		Summary = ""
	},
	[8042] = {
		Title = "El secreto de los dirigibles",
		Description = {
			"Descubres que el director del Laboratorio Einbroch tiene un trozo del Corazón de Ymir. Vale la pena investigar..."
		},
		Summary = ""
	},
	[8043] = {
		Title = "El secreto de los dirigibles",
		Description = {
			"Será mejor que salgas de aquí. Los guardias patrullan este lugar con regularidad, por lo que es casi seguro que te atraparán. Hmm, ven a verme más tarde al Airship, ¿de acuerdo? ¡Ahora date prisa!"
		},
		Summary = "Debes ir a ver a Ferlock."
	},
	[8044] = {
		Title = "La prometida de Euslán",
		Description = {
			"Inicio: NPC: Euslan en Ubicacion: yuno (111, 156). \"...¿Estás realmente dispuesto a salir a buscar a Thierry por mí? ¡Oh, muchas gracias! No sabes cuánto significa para mí tu amable oferta. Thierry se fue de viaje, viajando en uno de los dirigibles, para encontrar algún medicamento que los médicos dicen que necesito para mi enfermedad\"."
		},
		Summary = ""
	},
	[8045] = {
		Title = "Consejos de Kaci",
		Description = {
			"\"¡Ah, ya lo sé! Le pediré ayuda al Capitán del dirigible: él tiene la lista de pasajeros y sus destinos\"."
		},
		Summary = "Consulta la lista de pasajeros del capitán."
	},
	[8046] = {
		Title = "Lista de pasajeros de Ferlock",
		Description = {
			"Según esto, la última vez que tomó un dirigible fue a Hugel. Eso es todo lo que esto dice."
		},
		Summary = ""
	},
	[8047] = {
		Title = "El favor de Euslán",
		Description = {
			"\"Si tienes la oportunidad, visita a mi hermano Eukran en Hugel y pregúntale dónde podría estar mi Thierry\"."
		},
		Summary = ""
	},
	[8048] = {
		Title = "El testimonio de Eukran",
		Description = {
			"\"Verás, Thierry pasó por aquí hace aproximadamente un mes y me dijo que tenía que visitar el Santuario de Odín. No estaba seguro entonces, pero ahora creo que está tratando de ayudar a mi hermana\"."
		},
		Summary = ""
	},
	[8049] = {
		Title = "El favor de Thierry",
		Description = {
			"\"Realmente no puedo entrar en detalles, pero estoy haciendo este trabajo para encontrar una cura para la enfermedad de Euslan. No es curable con la medicina moderna...\""
		},
		Summary = ""
	},
	[8050] = {
		Title = "El peligro se acerca a Thierry",
		Description = {
			"\"Thierry parece haberse dado cuenta de lo que realmente estamos haciendo. Creo que es por eso que está desacelerando su investigación. Será mejor que nos deshagamos de él antes de que sea demasiado tarde\"."
		},
		Summary = ""
	},
	[8051] = {
		Title = "La medicina de Euslán",
		Description = {
			"\"No importa lo que me pase, pero debo salvar a Euslan. Sólo necesito 5 Runas de la Oscuridad para terminar esa medicina. Por favor ayúdame a conseguirlas, aventurero...\""
		},
		Summary = "Reúne 5 runas de la oscuridad."
	},
	[8052] = {
		Title = "El favor de Thierry",
		Description = {
			"\"Por favor, comprenda que quiero verla tan pronto como pueda, pero tengo que esperar hasta que esos agentes de Rekenber dejen de buscarme. Por favor, dele esa medicina a Euslan tan pronto como pueda: su vida depende de ello\"."
		},
		Summary = "Entregar la medicina a Euslan."
	},
	[8053] = {
		Title = "Encuentra Postell",
		Description = {
			"Inicio: NPC: Allen Schuwell en Ubicacion: hu_in01 (387, 245). \"¡Encuentra al hijo de Allen, Postell, y dile que traiga su medicina! Dirígete hacia el este, sal de la ciudad y deberías poder encontrar a Postell\"."
		},
		Summary = ""
	},
	[8054] = {
		Title = "Mensaje de Postell",
		Description = {
			"Postell te ha pedido que le hagas un favor y te asegures de que su padre no se meta en más problemas."
		},
		Summary = "volver a allen"
	},
	[8055] = {
		Title = "Enfermería Allen",
		Description = {
			"\"¡¿Q-qué pasa si tengo otro ataque de úlcera antes de que Postell pueda traer mis medicamentos?! ¡Quizás no sobreviva! A-aventurero, ¿podrías quedarte a mi lado hasta que llegue mi hijo?\""
		},
		Summary = "cuida a allen"
	},
	[8056] = {
		Title = "Algo a cambio",
		Description = {
			"\"Por favor, echa un vistazo dentro del cajón de las medicinas y sírvete lo que quieras\" ~Allen"
		},
		Summary = "Mira dentro del cajón de las medicinas."
	},
	[8057] = {
		Title = "Manainne quejosa",
		Description = {
			"Inicio: NPC: Pub Granny en Ubicacion: hu_in01 (377, 106). Habla con Manainne sobre el árbol reconfortante."
		},
		Summary = ""
	},
	[8058] = {
		Title = "Habla con El Schatt",
		Description = {
			"\"Este árbol significa mucho para todos en esta ciudad, y todos tenemos recuerdos especiales de este lugar. Pero ese tipo de El Schatt planea talarlo para su tienda...\" -Manainne"
		},
		Summary = ""
	},
	[8059] = {
		Title = "Habla con Perfitz",
		Description = {
			"El Schatt dice que su padre llevaba mucho tiempo queriendo construir una tienda aquí. Habla con su padre Perfitz y conoce su versión de los hechos."
		},
		Summary = ""
	},
	[8060] = {
		Title = "El testarudo El Schatt",
		Description = {
			"\"Aunque estoy contento, tengo el presentimiento de que algo no está bien, como si estuviera demasiado emocionado por talar ese árbol. Tal vez este viejo simplemente sospecha demasiado~\" -Perfitz"
		},
		Summary = ""
	},
	[8061] = {
		Title = "Historias del pasado",
		Description = {
			"El Schatt dice que hubo un tiempo en el que habría protegido el árbol con su vida pero que debería ser enterrado en el pasado. Deberías encontrar a alguien que pueda conocer su pasado."
		},
		Summary = ""
	},
	[8062] = {
		Title = "cananea",
		Description = {
			"\"¡Ahora El Schatt es simplemente un desalmado y codicioso de dinero...! Ha cambiado completamente. Mi hermana estaría revolcándose en su tumba al verlo ahora...\" -Manainne"
		},
		Summary = ""
	},
	[8063] = {
		Title = "El espíritu de Kanainne",
		Description = {
			"\"Yo... ¿Puedo tomar prestado el cuerpo de mi hermana? Sí, si ella coopera, tal vez... Tal vez funcione. Debo... debo hacer algo antes de que él... él... se lastime aún más...\""
		},
		Summary = ""
	},
	[8064] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"Inicio: NPC: Cellette Lavit en Ubicacion: hu_in01 (15, 372). Por favor, llévale este pedido de sopa de pastel de pescado a mi amiga Neha. Agradezco que sea una clienta habitual."
		},
		Summary = "Entregar el pedido a Neha"
	},
	[8065] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"Inicio: NPC: Cellette Lavit en Ubicacion: hu_in01 (15, 372). Lleva este próximo pedido de sopa de pastel de pescado a Maewan, otro de mis clientes habituales."
		},
		Summary = "Entregar el pedido a Maewan"
	},
	[8066] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"Inicio: NPC: Cellette Lavit en Ubicacion: hu_in01 (15, 372). Por favor, llévaselo a mi compañero de cuarto Layoma. Pero... Ten cuidado. Le encanta la puntualidad. Sólo trata de no llegar tarde..."
		},
		Summary = "Entregar el pedido a Layoma"
	},
	[8067] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"Inicio: NPC: Cellette Lavit en Ubicacion: hu_in01 (15, 372). Rápido, llévale esta sopa de pasta de pescado a Erjan. Um, pero ten cuidado, es muy quisquilloso..."
		},
		Summary = "Entregar el pedido a Erjan"
	},
	[8068] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"Inicio: NPC: Neha en Ubicacion: hugel (76, 134). ¡Llegas tarde! ¿No sabes que esta sopa no es buena si no está muy caliente? Pero... te perdonaré... Con una condición. Tráeme ^FF00001 Látigo^000000 con el que azotarte. Será mejor que te des prisa o no te dejaré ir tan fácilmente."
		},
		Summary = "Llévale 1 látigo a Neha."
	},
	[8069] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"¡Argh, pero llegas tarde! Esto es tu culpa, lo sabes, ¿verdad? Puedo perdonarte si me ayudas con mi colección. Solo tráeme 1 clip en la memoria, ¿de acuerdo?\""
		},
		Summary = "Llevar 1 clip de libro en la memoria a Maewan"
	},
	[8070] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"No puedo permitir que sigas entregando a Cellette a menos que demuestres que eres confiable conmigo. Erm, tráeme ^ff00001 Mushroom Spore^000000, y olvidaré todo este asunto\"."
		},
		Summary = "Llévale 1 espora de hongo a Layoma."
	},
	[8071] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"Hm, pero como primer hijo de la familia Franchesfeschu, no puedo comer esta sopa a menos que esté adecuadamente preparada. ¡Ve! ¡Te ordeno que me traigas la ^ff0000China^000000 del plebeyo!\""
		},
		Summary = "Trae a Erjan 1 China"
	},
	[8072] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"Ooh, ¿te azoté accidentalmente dos veces? Je, je... Bueno, estoy satisfecho. Seguiré adelante y le diré a Cellette que hiciste un buen trabajo... Espero que vengas a traerme mi sopa otra vez~\""
		},
		Summary = "Volver a Cellette"
	},
	[8073] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"¡Genial, realmente me trajiste un Bookclip in Memory! Sí, esto será una excelente adición a mi colección ~ Ah, y dame mi sopa. Gracias de nuevo por entregarme ~\""
		},
		Summary = "Volver a Cellette"
	},
	[8074] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"Muy bien, tal vez pueda contar contigo para trabajar para mi compañera de cuarto Cellette un poco más. Ah, y por favor dile que no vuelva a casa tan tarde todo el tiempo, ¿de acuerdo?\""
		},
		Summary = "Volver a Cellette"
	},
	[8075] = {
		Title = "Sopa de pastel de pescado de Cellette",
		Description = {
			"\"Puedes despedirte. Por favor, despídete y regresa con Cellette con mi noble agradecimiento\"."
		},
		Summary = "Volver a Cellette"
	},
	[8076] = {
		Title = "Klitzer y Cala",
		Description = {
			"Inicio: NPC: Klitzer en Ubicacion: ein_in01 (200, 101). Sé que estoy actuando como un completo idiota. Pero daría cualquier cosa por ver a Calla... Simplemente no escuches nada de lo que digo. Sólo soy un pobre tonto enamorado de la persona equivocada. Tiene que ser eso...."
		},
		Summary = ""
	},
	[8077] = {
		Title = "Klitzer y Cala",
		Description = {
			"Bueno, tal vez no pueda verlo, pero ¿le darías mi violín a Klitzer de mi parte? Solía tocar esto para él todo el tiempo..."
		},
		Summary = "Lleva el violín de Calla a Klitzer"
	},
	[8078] = {
		Title = "Klitzer y Cala",
		Description = {
			"Ese es el violín de mi hija. Se lo regalé cuando cumplió dieciséis años... ¡Has cruzado la línea, punk! ¡Guardias! ¡Ven aquí!"
		},
		Summary = "Le quitan el violín a Calla"
	},
	[8079] = {
		Title = "Klitzer y Cala",
		Description = {
			"Todo lo que necesitas hacer es darle ^FF00001 Flor^000000. No tengo el zeny y no creo que sea bienvenido en Kapellthaine Manor."
		},
		Summary = "Llevar 1 flor a Calla"
	},
	[8080] = {
		Title = "Klitzer y Cala",
		Description = {
			"Oh, si pasas por Einbroch, ¿podrías agradecerle a Klitzer por la flor, por favor? Y-y... Y... Por favor, dile que realmente lo extraño mucho."
		},
		Summary = "Entrega el mensaje de Calla a Klitzer."
	},
	[8081] = {
		Title = "Klitzer y Cala",
		Description = {
			"Me siento mucho mejor ahora. ¡Oh! Cuando tengas tiempo, ¿por qué no hablas con mi madre? A ella siempre le gusta conocer a mis amigos."
		},
		Summary = "Conoce a la madre de Klitzer"
	},
	[8082] = {
		Title = "Klitzer y Cala",
		Description = {
			"No puedo soportar ver que el odio mezquino entre nuestros dos pueblos impide que mi hijo vea a la mujer que ama... Encuentra a alguien que pueda conocer la historia de Einbroch y Einbech."
		},
		Summary = ""
	},
	[8083] = {
		Title = "Klitzer y Cala",
		Description = {
			"¿Por qué no me traes ^990000carbones^000000? No es imposible para alguien como tú, pero este tipo de tarea requerirá algo de esfuerzo de tu parte."
		},
		Summary = "Llevar carbones a Satra"
	},
	[8084] = {
		Title = "Klitzer y Cala",
		Description = {
			"Bueno, intentaré encontrarles algún uso. Me temo que el regalo que te he pedido no es muy práctico. ¿Cómo se suele utilizar el carbón? ¡Ah, tengo una idea novedosa! Parece que traer Coals hará que Satra hable."
		},
		Summary = "Trae más carbones a Satra"
	},
	[8085] = {
		Title = "Klitzer y Cala",
		Description = {
			"De todos modos, la próxima vez que te encuentres con Klitzer, por favor dile que me visite pronto. Ah, y recuérdale que se vista apropiadamente para esta ocasión especial. ¡Ho ho ho ho ho ~!"
		},
		Summary = "Entregar el mensaje a Klitzer"
	},
	[8086] = {
		Title = "Klitzer y Cala",
		Description = {
			"¿Eh...? ¿Qué acabas de decir? ¿Acabas de decir que la madre de Calla quiere que tome el té con ella? ¡¡Santo cielo...!!"
		},
		Summary = ""
	},
	[8087] = {
		Title = "Klitzer y Cala",
		Description = {
			"Gracias por ayudar a mi hijo Klitzer. Lamentablemente, el pequeño tonto no tiene ni idea de ciertas cosas como elegir la ropa. Un hombre debe usar ropa bonita, como un traje formal o un esmoquin, para reuniones importantes y ocasiones especiales."
		},
		Summary = "Consíguele a Klitzer un bonito atuendo."
	},
	[8088] = {
		Title = "Klitzer y Cala",
		Description = {
			"Realmente me has abierto los ojos. De ahora en adelante, haré todo lo posible para ganarme la aprobación de los padres de Calla y ser digno del amor de Calla."
		},
		Summary = ""
	},
	[8089] = {
		Title = "Piedra preciosa robada",
		Description = {
			"Inicio: NPC: Vincent en Ubicacion: ra_in01 (384, 246). No tengo ninguna prueba, pero sospecho que fue robada por Phobe, un sirviente que desapareció casi al mismo tiempo que desapareció la gema. Quizás quieras preguntar a los otros sirvientes sobre su paradero."
		},
		Summary = "Obtén información sobre el paradero de Phobe."
	},
	[8090] = {
		Title = "señor manson",
		Description = {
			"La verdad es que no sé mucho desde que comencé a trabajar aquí. ¿Por qué no les preguntas a los empleados superiores? Podrías preguntarle al Sr. Manson dentro de la mansión."
		},
		Summary = "Encuentra al Sr. Manson"
	},
	[8091] = {
		Title = "jenny la jardinera",
		Description = {
			"Ah, nuestra jardinera Jenny fue quien me lo presentó. Ha trabajado para Sir Zhed durante mucho tiempo y le encantan los niños. Sabes, si quieres saber más sobre ese niño, deberías hablar con Jenny."
		},
		Summary = "encontrar a jenny"
	},
	[8092] = {
		Title = "Buscando en el mercado",
		Description = {
			"Muy bien, supongo que puedo ir al mercado y preguntar por ahí."
		},
		Summary = "ir al mercado"
	},
	[8093] = {
		Title = "Mensaje misterioso",
		Description = {
			"Así que sí, anoche un tipo me pidió que le dijera a cualquiera que estuviera buscando a este tipo llamado Phobe que les diera un mensaje. Básicamente, quiere que vengas a la \"cueva de hielo\". A ver, se llamaba... ¿Nogan? ¿Rogan? Algo así."
		},
		Summary = "Ir a la cueva de hielo"
	},
	[8094] = {
		Title = "¿Traicionado?",
		Description = {
			"Las instrucciones de Vincent eran derrotar a cualquiera que preguntara sobre Rogan, algún nombre que él inventó. Parece que nos tendió una trampa, amigo. Lo siento, si lo hubiera sabido no lo habría hecho."
		},
		Summary = "Volver a Vicente"
	},
	[8095] = {
		Title = "encontrar fobia",
		Description = {
			"No te meterás en problemas si puedo encontrar la joya y Phobe antes de que Sir Zhed regrese, así que intentaré encontrarlos tan pronto como pueda. Phobe es sólo un niño, así que probablemente esté escondido en algún lugar de la ciudad..."
		},
		Summary = "Intenta encontrar a Phobe."
	},
	[8096] = {
		Title = "Piedra preciosa robada encontrada",
		Description = {
			"Para que lo sepas, ¡no planeo volver a casa! Bueno, al menos no en este segundo. Pero hazle saber a mi mamá que estoy bien y que no se preocupe."
		},
		Summary = "Volver a Vicente"
	},
	[8097] = {
		Title = "Informar a Jenny",
		Description = {
			"Mientras devuelvo esta joya, ¿podrías decirle a mi esposa Jenny que nuestro hijo está bien? Ella ha estado muy preocupada por él, así que..."
		},
		Summary = "jenny"
	},
	[8098] = {
		Title = "Guardando el secreto",
		Description = {
			"Gracias por toda tu ayuda, aventurero ~"
		},
		Summary = "Volver a Vicente"
	},
	[8099] = {
		Title = "La recomendación de Vicente",
		Description = {
			"Esta nota es una carta de recomendación que he escrito para usted. Entrégueselo a Sir Zhed lo antes posible. Adiós y gracias por todo."
		},
		Summary = "Ve a ver al señor Zhed"
	},
	[8100] = {
		Title = "Recomendación del Sumo Sacerdote Zhed",
		Description = {
			"Inicio: NPC: High Priest Zhed en Ubicacion: ra_temin (277, 159). Mientras termino de escribir esta recomendación, déjame decirte cómo llegar a la oficina del Papa donde debes ir una vez que juntes 40 Corazones Glaciales."
		},
		Summary = "Reúne 40 corazones glaciales y ve a ver al Papa."
	},
	[8101] = {
		Title = "Recomendación del Sumo Sacerdote Zhed",
		Description = {
			"Realmente quiero agradecerte por venir a hablar conmigo. Me lo pasé muy bien aprendiendo. Ahora me toca ir a oficiar los servicios, así que... Esto es un adiós por ahora..."
		},
		Summary = "Volver a Zhed"
	},
	[8102] = {
		Title = "Recomendación del Sumo Sacerdote Zhed",
		Description = {
			"Lo siento, pero aún no hemos terminado nuestra discusión. ¿Por qué no esperas y te relajas en la habitación de al lado mientras tanto?"
		},
		Summary = ""
	},
	[8103] = {
		Title = "Recomendación del Sumo Sacerdote Zhed",
		Description = {
			"Quiero darte un pequeño consejo. No te acerques demasiado al Sumo Sacerdote Zhed. Si lo haces, podrías terminar metiéndote en problemas..."
		},
		Summary = "Volver a Zhed"
	},
	[8104] = {
		Title = "Recomendación del Sumo Sacerdote Zhed",
		Description = {
			"Ah, pero antes de irte, déjame advertirte que no ^FF0000te acerques a Tierra Santa^000000. Repito, mantente alejado de la Tierra Santa."
		},
		Summary = ""
	},
	[8105] = {
		Title = "Recomendación del Sumo Sacerdote Zhed",
		Description = {
			"Le advertí a Bekento que podría causarte problemas, pero parece que tú le causaste problemas a él. Entiende esto: la mayoría de los intrusos son severamente castigados, pero debido a mi amistad con Bekento, te lo dejo en paz. Recuerda que..."
		},
		Summary = "Volver a Zhed"
	},
	[8106] = {
		Title = "La hija del Sr. Shendar",
		Description = {
			"Inicio: NPC: Mr. Shendar en Ubicacion: ra_in01 (250, 19). El señor Shendar dice que su hija ha estado saliendo con alguien. Ella fue a algún pueblo por ese chico y él no ha sabido nada de ella desde entonces. Encuentre a alguien que pueda saber lo que le pudo haber pasado."
		},
		Summary = ""
	},
	[8107] = {
		Title = "El testimonio de Lachellen",
		Description = {
			"¡Oh, tengo tantos celos de Bruspetti! Ha estado pasando mucho tiempo con su nuevo novio recientemente... Pero todavía se niega a decirme cómo se llama. Veamos... ¿Creció en Lighthalzen? Eso es todo lo que ella sabe."
		},
		Summary = "Encuentra un extranjero en la ciudad."
	},
	[8108] = {
		Title = "Un extranjero, Katinshuell",
		Description = {
			"Katinshuell te dijo que la relación entre él y su novia terminó. Quizás esté hablando de la hija del señor Shendar. Deberías preguntarle al respecto."
		},
		Summary = "Habla con el Sr. Shendar"
	},
	[8109] = {
		Title = "El aroma de Bruspetti",
		Description = {
			"El Sr. Shendar dice que su hija Bruspetti tiene un olor distintivo y agradable, como el de su madre. Deberías buscar a alguien con un olor agradable y distintivo en Lighthalzen."
		},
		Summary = "Busca el aroma de Bruspetti en Lighthalzen"
	},
	[8110] = {
		Title = "El aroma de Bruspetti",
		Description = {
			"Este... este olor... ¡Huele tan bien! Como pétalos de rosa flotando en una suave brisa... Espera, ¿podría ser este el aroma que el padre de Bruspetti mencionó antes?"
		},
		Summary = "Vuelve con Rachel y conoce a Lachellen."
	},
	[8111] = {
		Title = "El testimonio de Lachellen",
		Description = {
			"Si está en Lighthalzen, probablemente haya ido allí para saber más sobre su novio. Hmm, tal vez si revisas el lugar donde ella y su novio solían salir, podrías encontrar algo."
		},
		Summary = "Encuentra el manantial de Freya"
	},
	[8112] = {
		Title = "La primavera de Freya",
		Description = {
			"Lo siento si te asusté, pero el suelo sobre el que estás parado es muy resbaladizo, ¿sabes?"
		},
		Summary = "Vuelve con el Sr. Shendar"
	},
	[8113] = {
		Title = "El diario de Bruspetti",
		Description = {
			"Como padre amoroso, no puedo permitirme invadir la privacidad de mi preciosa hija. Incluso si descuidadamente dejó su diario encima de su cajón."
		},
		Summary = "Busca el diario encima del cajón."
	},
	[8114] = {
		Title = "El diario de Bruspetti",
		Description = {
			"¡Éste debe ser el diario de Bruspetti! Pero... leerlo te haría sentir como un verdadero canalla. Deberías preguntarle a Katinshuell si sabe por qué Bruspetti está en Lighthalzen."
		},
		Summary = "Ve a conocer a Katinshuell"
	},
	[8115] = {
		Title = "Katinshuell sospechoso",
		Description = {
			"Katinshuell insiste en que la dejen en paz. Tal vez alguien más sepa algo más sobre el interés de Bruspetti en Freya's Spring y Lighthalzen."
		},
		Summary = "Ve a conocer a Lachellen"
	},
	[8116] = {
		Title = "El testimonio de Lachellen",
		Description = {
			"¿La primavera de Freya? ¡Oh, me gusta ese lugar! Hablando de eso, conozco a alguien llamado Katinshuell que iba allí con bastante frecuencia. Normalmente los hombres no van solos..."
		},
		Summary = "Ir a la primavera de Freya"
	},
	[8117] = {
		Title = "La primavera de Freya",
		Description = {
			"¿Ves el borde del manantial? El mismo joven llega con frecuencia a ese lugar y mira fijamente el agua, chorreando tristeza. Alguien tan joven no debería sentirse así."
		},
		Summary = "Vuelve con el Sr. Shendar"
	},
	[8118] = {
		Title = "Habla con el Sr. Shendar",
		Description = {
			"Espera, espera... ¿Entonces alguien ha estado merodeando por aquí? Eso es raro. Espera, ese tipo, el que podría ser el novio de Bruspetti..."
		},
		Summary = "Recupera el diario de Bruspetti"
	},
	[8119] = {
		Title = "El diario de Bruspetti",
		Description = {
			"Ahora tienes permiso para llevarte el diario y así poder averiguar si Bruspetti y Katinshuell están conectados... Llévale el diario a Katinshuell."
		},
		Summary = "katinshuell"
	},
	[8120] = {
		Title = "Habla con Katinshuell",
		Description = {
			"¡Dime la verdad! En realidad, ¿sabes qué? ¿Por qué no miramos la verdad juntos? ¿Cómo es eso?"
		},
		Summary = "Sigue hablando con Katinshuell"
	},
	[8121] = {
		Title = "Habla con Katinshuell",
		Description = {
			"Él todavía se resiste... ¿Cómo puedo lograr que revele la verdad? Tal vez haya algo que pueda usar para hacerle confesar..."
		},
		Summary = "Sigue hablando con Katinshuell"
	},
	[8122] = {
		Title = "El lugar de descanso de Bruspetti",
		Description = {
			"... Por favor, déjame en paz. Perdí a la mujer que amo por algo estúpido que hice en el pasado. Si quieres denunciarme, adelante..."
		},
		Summary = "Ir a la primavera de Freya"
	},
	[8123] = {
		Title = "El mundialmente famoso plato de Ayotaya, Tom Yum Goong",
		Description = {
			"Inicio: NPC: Einon en Ubicacion: ayothaya (196, 265). Cualquiera puede preparar Tom Yum Goong, pero te recomiendo que visites ^3131FFMali the Spicy^000000. Ella es la mejor cocinera. ¿Por qué no le pides que te cocine?"
		},
		Summary = ""
	},
	[8124] = {
		Title = "El mundialmente famoso plato de Ayotaya, Tom Yum Goong",
		Description = {
			"Puedes comprarle los camarones más frescos al tipo llamado \"^3131FFThongpool^000000\". Consigue 20 camarones para cocinar Tom Yum Goong."
		},
		Summary = "Trae 20 camarones a Mali el Picante"
	},
	[8125] = {
		Title = "El mundialmente famoso plato de Ayotaya, Tom Yum Goong",
		Description = {
			"Mali el Picante ha encontrado un limonero muy bonito por ahí, sin embargo, esos limones no estaban a la venta. Debes conseguir un poco de limón del dueño del limonero."
		},
		Summary = "Llévale 10 limones a Mali el Picante"
	},
	[8126] = {
		Title = "El mundialmente famoso plato de Ayotaya, Tom Yum Goong",
		Description = {
			"Ahora debes conseguir \"^CE0000Chilli^000000\" y otros materiales del mercado. Pregúntale al comerciante en el mercado y sabrás qué materiales conseguir."
		},
		Summary = "Llévale 30 chiles y otros materiales a Mali el Picante."
	},
	[8127] = {
		Title = "Excursión a Momotaro",
		Description = {
			"Inicio: NPC: Grandma en Ubicacion: ama_test (50, 93). El Jefe dijo que Dokebi ganó 20 millones de zenys pirateando las cuentas de otros... Como nosotros, los habitantes de la ciudad, pasamos el tiempo sentados y charlando, no podemos derrotar a Dokebis porque tenemos un nivel bajo, así que... Por favor, hazlo por nosotros."
		},
		Summary = "Derrota a Dokebi"
	},
	[8128] = {
		Title = "Excursión a Momotaro",
		Description = {
			"Inicio: NPC: Coach en Ubicacion: ama_test (50, 100). Ahora la historia de Momotaro ha terminado. Puede obtener su recompensa cuando hable con la editora que vio primero."
		},
		Summary = ""
	},
	[8129] = {
		Title = "Excursión a Momotaro",
		Description = {
			"..En este punto se supone que debo enviarte de regreso...¡PERO! Te daré una oportunidad. Pero si fallas, ^3163FF no podrás aceptar este desafío.^000000 Además, esta misión será bastante difícil."
		},
		Summary = "Derrota al Dokkaebi"
	},
	[8130] = {
		Title = "Excursión a Momotaro",
		Description = {
			"Eres realmente algo. Tienes los movimientos, chico. Déjame mostrarte la salida. Me lo pasé muy bien... No olvides recibir tu recompensa."
		},
		Summary = ""
	},
	[8131] = {
		Title = "La madre del señor en Amatsu.",
		Description = {
			"Inicio: NPC: Gate Soldier en Ubicacion: amatsu (164, 174). La madre de nuestro señor está descansando aquí. Ha estado enferma durante meses. Por eso ella se queda aquí."
		},
		Summary = ""
	},
	[8132] = {
		Title = "La madre del señor en Amatsu.",
		Description = {
			"Inicio: NPC: Lord of Palace en Ubicacion: ama_in02 (200, 176). Tú, que eres de Rune-Midgard, quizás puedas curar la enfermedad de mi madre. Te recompensaré bien si lo logras. Mi madre vive en una casa fuera del palacio. Ven a verme cuando termines tu tratamiento."
		},
		Summary = "Encuentra el tratamiento para curar a la madre del señor."
	},
	[8133] = {
		Title = "Canción del zorro",
		Description = {
			"Sacerdote, sacerdote~ ¡Un zorro me sigue! ¡Si no se va cuando grito y grito! El Sacerdote del Santuario del Norte debería ayudarme ~ Ralralrah Ralralrah Ralralrahralralrah ~~"
		},
		Summary = ""
	},
	[8134] = {
		Title = "Niño en el Santuario del Norte",
		Description = {
			"Un espíritu más fuerte expulsará al zorro de un humano. ¡Vamos, grita y muéstrame tu espíritu!"
		},
		Summary = ""
	},
	[8135] = {
		Title = "zorro expulsado",
		Description = {
			"^FF6060¡Aullido! ¡Gañido! ¡Gañido! ¡Humano! ¡Para expulsarme así de este cuerpo! ¡Maldito seas! ¡¡Maldito seas!! Maldeciré a la familia Ishida, ¡y será mejor que tengas cuidado, humano!^000000"
		},
		Summary = "Vuelve con el señor de la cola de zorro."
	},
	[8136] = {
		Title = "La advertencia del lobo gris",
		Description = {
			"Inicio: NPC: Sage en Ubicacion: mosk_fild02 (198, 252). Te has encontrado con un Lobo Gris que te advierte sobre alguien llamado Koshei, el Inmortal y te dice que debes abandonar este lugar. ¿Pero quién es exactamente este Koshei? Quizás el Lobo Gris regrese y se explique más..."
		},
		Summary = ""
	},
	[8137] = {
		Title = "Encontrar al creador de llaves",
		Description = {
			"Koshei parece ser un ser maligno inmortal que fue sellado por una niña llamada María. María necesita ser liberada de su prisión de piedra encontrando al fabricante de llaves que haga la ^0000ffGolden Key^000000."
		},
		Summary = ""
	},
	[8138] = {
		Title = "Solicitud del herrero",
		Description = {
			"El herrero te ha pedido que le lleves 25 acero. Prometió que le explicará cómo hacer la \"Llave Dorada\" después de que le traiga el Acero."
		},
		Summary = ""
	},
	[8139] = {
		Title = "La llave de oro",
		Description = {
			"El herrero dice que necesitas ^0000ff2 rubí maldito, 3 de oro, 1 anillo rojo, 2 cabellos de Lusalka y 10 hilos dorados^000000 para hacer la llave dorada. Habla con el Herrero y él te dirá cómo conseguir los materiales. Y no olvides usar esas botas de acero fuertes."
		},
		Summary = ""
	},
	[8140] = {
		Title = "El anillo rojo",
		Description = {
			"El abuelo Vassili dice que tenía un Anillo Rojo pero que se lo regaló a su hija Mashenka, quien lamentablemente falleció. Pero tiene otra hija, llamada Ryubaba, que podría saber sobre el Anillo Rojo."
		},
		Summary = "Ryubaba"
	},
	[8141] = {
		Title = "El anillo rojo de Mashenka",
		Description = {
			"Ryubaba te dijo que su hermana Mashenka probablemente llevaba el Anillo Rojo cuando desapareció por el pantano."
		},
		Summary = ""
	},
	[8142] = {
		Title = "Buscando el pantano",
		Description = {
			"Hablaste con una pastora cerca del pantano que te pidió que le trajeras ^0000ff25 ramas puntiagudas^000000 mientras buscas a Mashenka y su anillo rojo."
		},
		Summary = ""
	},
	[8143] = {
		Title = "La voz de la flauta",
		Description = {
			"Inicio: NPC: Vassili Grandpapa en Ubicacion: moscovia (206, 81). La Pastora te hizo una flauta de madera con las ramas que le trajiste. Una voz extraña canta una canción triste cuando suena. Deberías preguntarle a Ryubaba sobre la voz que canta en la flauta."
		},
		Summary = ""
	},
	[8144] = {
		Title = "La confesión de Ryubaba",
		Description = {
			"No podrás vivir contigo mismo si no le cuentas a Vasilli la verdad sobre lo que pasó entre sus dos hijas. Cuéntale lo que Ryubaba le confesó sobre Mashenka y trae la flauta de madera como prueba."
		},
		Summary = ""
	},
	[8145] = {
		Title = "La petición de una madre preocupada",
		Description = {
			"Has conocido a una madre preocupada que te contó una historia sobre la ninfa del agua Lusalka, que puede ser o no su hija. Continúa tu conversación con la Madre preocupada."
		},
		Summary = ""
	},
	[8146] = {
		Title = "Buscando a Lusalka",
		Description = {
			"Para encontrar a la ninfa acuática Lusalka, debes encontrar un área de agua entre las 5 p. m. y las 6 a. m. PST y traer agua bendita para protegerte de su peligrosa mirada."
		},
		Summary = ""
	},
	[8147] = {
		Title = "La amada de Lusalka",
		Description = {
			"Lusalka te ha pedido que encuentres a su amado Igor en la capital del Reino Rune Midgarts y le entregues sus aretes dorados y le entregues su mensaje diciéndole que deje de sufrir."
		},
		Summary = ""
	},
	[8148] = {
		Title = "La amada de Lusalka",
		Description = {
			"Inicio: NPC: Worried Mother en Ubicacion: moscovia (166, 145). Encontraste a un vagabundo de Moscovia que viajó a Prontera con Igor pero desde entonces se separaron. Dijo que Igor se dirigía a un desierto... El desierto más cercano que conoces es..."
		},
		Summary = ""
	},
	[8149] = {
		Title = "Buscando a Ígor",
		Description = {
			"Un aldeano de Marruecos dice que pudo haber visto a Igor y que entró en la pirámide. Tal vez finalmente hayas localizadolo para poder entregarle los aretes dorados de Lusalka."
		},
		Summary = ""
	},
	[8150] = {
		Title = "El mensaje de Igor.",
		Description = {
			"Igor te pidió que fueras a Lusalka y le dijeras que todavía la ama. Quizás ahora ella acepte darte su cabello para que puedas hacer la Llave Dorada. Recuerda llevar \"Agua Bendita\" cuando hables con Lusalka para protegerte de su mirada."
		},
		Summary = ""
	},
	[8151] = {
		Title = "La cueva de Marozka",
		Description = {
			"Marozka dice que necesita poner a prueba tu valía para luchar contra Koshei. Llévale 100 galletas bien horneadas del horno de piedra y 100 manzanas del manzano de su cueva."
		},
		Summary = ""
	},
	[8152] = {
		Title = "El hilo dorado",
		Description = {
			"Le has traído las galletas y las manzanas a Marozka. Dice que le llevará un tiempo hacer el Hilo Dorado. Vuelve en una hora y seguro que lo tendrá listo."
		},
		Summary = ""
	},
	[8153] = {
		Title = "Prueba de mente y sabiduría.",
		Description = {
			"Debes pasar todas las pruebas de Marozka y él te dará el Hilo Dorado que acaba de hacer."
		},
		Summary = ""
	},
	[8154] = {
		Title = "El fabricante de llaves",
		Description = {
			"El fabricante de llaves está en una cabaña en lo profundo del bosque. Tenga cuidado con las palabras del fabricante de llaves y no olvide el hechizo de protección del herrero, \"^0000ffSpellshield Protection^000000\"."
		},
		Summary = ""
	},
	[8155] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Inicio: NPC: 1 en Ubicacion: mosk_dun01 (45, 250). Baba Yaga te ha pedido que le hagas el favor de encontrar a su vaca que se escapó y que debes encontrarla y lanzarle un hechizo de regreso. El hechizo es \"^ff0000El buen pienso tiene sabor a naranja^000000\"."
		},
		Summary = ""
	},
	[8156] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Has lanzado el hechizo de retorno a la vaca de Baba Yaga. Vuelve con ella y hazle saber que le has hecho el favor que te pidió."
		},
		Summary = ""
	},
	[8157] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Baba Yaga te ha pedido que le hagas un favor y encuentres una manera de silenciar un ruidoso ataúd detrás de su casa a cambio de que te haga la Llave Dorada."
		},
		Summary = ""
	},
	[8158] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Has conseguido silenciar el ruidoso ataúd detrás de la casa de Baba Yaga. Vuelve con ella y hazle saber que le has hecho el favor que te pidió."
		},
		Summary = ""
	},
	[8159] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Baba Yaga te ha pedido que le hagas un favor y le traigas su preciosa Cuchara de Plata que los piratas de un barco hundido le robaron a cambio de que ella te hiciera la Llave Dorada."
		},
		Summary = ""
	},
	[8160] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Has encontrado la cuchara de plata de Baba Yaga que le robaron los piratas. Vuelve con ella y hazle saber que le has hecho el favor que te pidió."
		},
		Summary = ""
	},
	[8161] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Baba Yaga te ha pedido que le hagas un favor comprándole un libro de magia de Momotaro en Amatsu. Está reservado a su nombre, así que todo lo que tienes que hacer es ir allí y comprárselo."
		},
		Summary = ""
	},
	[8162] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Compraste los libros de magia y se los diste a Baba Yaga. Habla con ella nuevamente para ver si ha terminado de hacer la Llave Dorada."
		},
		Summary = ""
	},
	[8163] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Baba Yaga te ha pedido que le hagas un favor y encuentres una manera de calmar al fantasma de la Casa que vive en un frasco al lado de su cabaña a cambio de que ella te haga la Llave Dorada."
		},
		Summary = ""
	},
	[8164] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Después de jugar un juego de cartas con el fantasma de la casa, promete que ahora todo estará tranquilo. Regresa con Baba Yaga y hazle saber que le has hecho el favor que ella te pidió."
		},
		Summary = ""
	},
	[8165] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Baba Yaga te ha pedido que le hagas un favor y vayas con Broom Grandmother en Payon y le compres una escoba a cambio de que te haga la llave dorada."
		},
		Summary = ""
	},
	[8166] = {
		Title = "El favor de Baba Yaga",
		Description = {
			"Después de jugar a los dados con el árbol fantasma, finalmente recibiste la escoba que Baba Yaga te pidió que consiguieras. Regresa con Baba Yaga y hazle saber que le has hecho el favor que ella te pidió."
		},
		Summary = ""
	},
	[8167] = {
		Title = "La llave de oro",
		Description = {
			"Finalmente recibiste la Llave Dorada de Baba Yaga. Ahora es el momento de liberar a María Morebna de su prisión dentro de ese muro."
		},
		Summary = ""
	},
	[8168] = {
		Title = "Koshei, el inmortal",
		Description = {
			"Grey Wolf se hará cargo de las heridas de María. Debes hacer lo que puedas para someter a Koshei."
		},
		Summary = ""
	},
	[8169] = {
		Title = "Agua viva y muerta",
		Description = {
			"Grey Wolf dice que puedes salvar a María si obtienes \"Agua de vida\" y \"Agua de muerte\" de Baba Yaga."
		},
		Summary = ""
	},
	[8170] = {
		Title = "Agua viva y muerta",
		Description = {
			"Para hacer el \"Agua Viva\" necesitas traer 1 Agua Bendita y 2 Hojas de Yggdrasil y para el \"Agua Muerta\" necesitas traer 1 Agua Maldita y 10 Folletos de Hinalle."
		},
		Summary = ""
	},
	[8171] = {
		Title = "Agua viva y muerta",
		Description = {
			"Baba Yaga os ha dado el \"Agua Viva\" y el \"Agua Muerta\". Ve con María rápidamente. Primero debes verter el \"Agua Muerta\" para eliminar la herida y las maldiciones y luego verter el \"Agua Viva\" para devolverle el espíritu."
		},
		Summary = ""
	},
