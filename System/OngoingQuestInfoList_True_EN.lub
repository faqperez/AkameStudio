	[7674] = {
		Title = "No fue un sueño..",
		Description = {
			"Cuesta creer que el caldo de pulpo seguido de una cobertura de chocolate haya sido un éxito, pero para Dansul, que tiene que preparar tres comidas al día, pasemos todos los días para ver si hacen falta más ingredientes."
		},
		Summary = "Se reinicia por la mañana"
	},
	[7675] = {
