		Summary = "Captura una extraña hidra"
	},
	[9029] = {
		Title = "Extraña Hidra: condiciones actuales",
		Description = {
			"Inicio: NPC: Lucia en Ubicacion: brasilis (192, 133). En ^8B4513Brasilis^000000, hay un mensaje de ^0000FFLucia^000000: ^404040Gracias por tu ayuda. Desafortunadamente, puedo proporcionarte una nueva ^006400Hydra Ball^404040 mañana.^000000"
		},
		Summary = "Si quieres otra Hydra Ball, regresa con Lucia después de que expire el tiempo."
	},
	[9030] = {
