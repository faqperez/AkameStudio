	},
	[2139] = {
		Title = "Para Arunafeltz",
		Description = {
			"Tienes un documento que incluye un documento falso de vacaciones de Ismael."
		},
		Summary = "Volver a Niren"
	},
	[2140] = {
		Title = "Para Arunafeltz",
		Description = {
			"Niren dijo que todo está listo y llegas a un jardín en el cielo donde el Papa está con Zhed."
		},
		Summary = "Ve al jardín del cielo después de hablar con Zhed."
	},
	[2141] = {
		Title = "Para Arunafeltz",
		Description = {
			"El Papa muestra un aspecto de Papa maduro de una nación religiosa al montar una máscara de un joven monarca."
		},
		Summary = "Habla con niren"
	},
	[2142] = {
		Title = "Para Arunafeltz",
		Description = {
			"Niren promete reflexionar sobre su silencio respecto al Papa con Zhed."
		},
		Summary = "Habla con Zhed"
	},
	[2143] = {
