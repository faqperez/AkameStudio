	[3000] = {
		Title = "Cambio de trabajo a bardo",
		Description = {
			"Inicio: NPC: Wandering Bard en Ubicacion: comodo (226, 123). Hermosa canción: conocí a una hermosa cantante, Bard. Quiero ser Bardo... ¿Debería preguntarle sobre cómo convertirme en Bardo?"
		},
		Summary = ""
	},
	[3001] = {
		Title = "Cambio de trabajo a bardo",
		Description = {
			"¿Pago por flor? - Bardo Lalo pide traer flores para pagar por aprender una canción. Pero él quiere una flor especial."
		},
		Summary = "Trae flor especial para Lalo"
	},
	[3002] = {
		Title = "Cambio de trabajo a bardo",
		Description = {
			"El primer paso para convertirse en bardo: el bardo Lalo pide encontrar un muñeco de nieve que habla en Lutie y recibir un regalo de él."
		},
		Summary = ""
	},
	[3003] = {
		Title = "Cambio de trabajo a bardo",
		Description = {
			"Siguiendo una canción - El bardo Lalo me pide que siga una canción tras él. Si sigo cantando exactamente, podría ser un bardo..."
		},
		Summary = ""
	},
	[3004] = {
		Title = "Cambio de trabajo a bardo",
		Description = {
			"Prueba final: Bard Lalo pide recolectar 60 Trunks para la última prueba. Si los traigo me convertiré en bardo y recibiré un recuerdo de él."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3006] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"Calificación: \"Veré tu esfuerzo y decidiré si estás calificado o no. Deberás traer ^3355FF10 clavos cariados, 10 escamas apestosas, 10 uniformes de prisión desgastados y 10 Daenggie^000000\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3007] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"Calificación: \"Veré tu esfuerzo y decidiré si estás calificado o no. Deberás traer ^3355FF10 Skel-Bone, 10 Orc Claw, 10 Manacles y 10 Short Daenggie^000000\""
		},
		Summary = "Trae los materiales requeridos."
	},
	[3008] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"Calificación: \"Veré tu esfuerzo y decidiré si estás calificado o no. Deberás traer ^3355FF10 Boca Horrenda, 10 Vendas podridas, 10 Linternas y 10 Jack o'Pumpkin^000000\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3009] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"\"Puedo ver tu potencial como cruzado. Reúnete con ^0000FFMoorenak Miyol^000000. Está en la prisión subterránea del Castillo de Prontera. Habla con él primero\"."
		},
		Summary = "Habla con Moorenak Miyol"
	},
	[3010] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"Resistencia: \"Para un cruzado, la resistencia y la paciencia son lo más importante. Sólo tienes que caminar por el pasillo hasta llegar al final. Pero no derrotes a ningún monstruo, incluso si te atacan\"."
		},
		Summary = "Resistencia y paciencia"
	},
	[3011] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"\"Reúnete con Gabriel Valentine en el Santuario Prontera. Ella te hará la siguiente prueba... Ponte en marcha ahora\"."
		},
		Summary = "Habla con Gabriel Valentín"
	},
	[3012] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"\"Necesitas tener suficiente conocimiento para calificar para el trabajo. Lo siento, pero creo que tienes que estudiar más. Vuelve cuando estés listo\"."
		},
		Summary = ""
	},
	[3013] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"\"Muy bien. Ve a hacer la siguiente prueba de inmediato. Ve al Castillo de Prontera y conoce a Bliant Piyord. Le diré que prepare la próxima prueba\"."
		},
		Summary = "Habla con Bliant Piyord"
	},
	[3014] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"\"Esta es la última prueba que debes realizar. La última prueba es una prueba de combate. Sólo las personas con buenas habilidades de batalla son aptas para convertirse en cruzados. Trae 1 agua bendita antes de realizar la prueba de derrota\"."
		},
		Summary = "Trae 1 agua bendita"
	},
	[3015] = {
		Title = "Cambio de trabajo a cruzado",
		Description = {
			"\"Felicitaciones. Has terminado todas las pruebas. Habla con nuestro líder que está adentro. Ahora eres elegido para prepararte para la Guerra Santa\"."
		},
		Summary = "Habla con el cruzado mayor"
	},
	[3016] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"Inicio: NPC: Guarding Monk en Ubicacion: prt_monk (59, 247). \"¿Quieres ser un monje? Bueno, entonces entra y habla con ^0000FFSensei Moohae^000000. Él te guiará\"."
		},
		Summary = "Habla con el sensei Moohae"
	},
	[3017] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 5 mocos pegajosos, 10 peladuras de lombrices y 20 hierbas verdes\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3018] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 20 Yoyo Tail, 5 Iron Ore y 3 Blue Herb\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3019] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 30 tallos, 5 gelatinas y 10 peladuras de gusanos\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3020] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 5 Solid Shell, 20 Shell y 5 Zargon\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3021] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 5 Cyfar, 10 White Herb y 10 Yellow Herb\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3022] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 10 dientes de murciélago, 5 pieles de pies de oso y 20 esporas venenosas\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3023] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"La vida de un monje no es para todos, sólo aquellos lo suficientemente fuertes pueden convertirse en monje. Comencemos con una tarea simple. Trae 5 plumas de puercoespín, 20 telarañas y 10 patas de insecto\"."
		},
		Summary = "Trae los materiales requeridos."
	},
	[3024] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"Bueno, el próximo monje que tienes que conocer es... ¡OH! Ve con Touha. Ve hacia el norte desde aquí y lo encontrarás en el cementerio\"."
		},
		Summary = "Habla con Touha"
	},
	[3025] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"Te enseñaré el camino del monje: la actitud mental requerida y nuestro dogma. Sólo necesitas recordar lo que te diré y memorizarlo. ¿Estás listo?\""
		},
		Summary = ""
	},
	[3026] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"¡¡Genial!! ¡Perfecto! Has pasado mi prueba. Pero aún necesitas hacer otra prueba. Por favor, ve con Sir Boohae a continuación. ¡Buena suerte!\""
		},
		Summary = "Habla con Boohae"
	},
	[3027] = {
		Title = "Cambio de trabajo a monje",
		Description = {
			"\"Hmm... recolectando hongos. Entonces quieres probar tu tolerancia, ¿eh? Ve a prepararte y regresa más tarde cuando estés listo\"."
		},
		Summary = "Recoge setas en la abadía"
	},
	[3028] = {
		Title = "Cambio de trabajo a monje - Maratón",
		Description = {
			"\"La prueba del maratón consiste en superar tu limitación. En el centro de la abadía hay un edificio. Ve allí. Tienes que correr un par de vueltas\"."
		},
		Summary = "Corre vueltas para la prueba maratón"
	},
	[3029] = {
		Title = "Cambio de trabajo a Monje - Prueba final",
		Description = {
			"\"¡¡Felicitaciones!! Ahora, ve con el monje Tomoon. Él está en el lugar más profundo del edificio en el centro de la abadía\"."
		},
		Summary = "Habla con Tomoon"
	},
	[3031] = {
		Title = "Cambio de Trabajo a Monje - Entrenamiento Espiritual",
		Description = {
			"\"¡La última prueba es un entrenamiento espiritual! ¡Ataca y corta a todos los enemigos que se interpongan en tu camino! ¡Ahora! ¡Cierra el puño! ¡Levántate! ¡Es hora!\""
		},
		Summary = ""
	},
	[3032] = {
		Title = "Cambio de trabajo a monje: conviértete en monje",
		Description = {
			"\"¡¡Bien hecho!! Ahora... te daré una poción secreta. ¡Si la bebes, tendrás suficiente fuerza física para poder convertirte en monje! ¡Vuelve con el sensei Moohae!\""
		},
		Summary = "Habla con el sensei Moohae"
	},
	[3040] = {
		Title = "La maldición de Baphomet",
		Description = {
			"Inicio: NPC: Grave of Baphomet en Ubicacion: monk_test (306, 151). No puedes entrar porque la Maldición de Baphomet aún permanece. La maldición de Baphomet desaparece 12 horas después de haber entrado."
		},
		Summary = ""
	},
	[3041] = {
		Title = "La maldición de Baphomet",
		Description = {
			"Inicio: NPC: Rust Blackhand en Ubicacion: prt_monk (261, 91). Tu SP aún no se ha recuperado de la activación de otro sello. No podrás activar otro sello hasta que hayan pasado 5 minutos."
		},
		Summary = ""
	},
	[3042] = {
		Title = "El muñeco Baphomet maldito",
		Description = {
			"Inicio: NPC: Friar Patrick en Ubicacion: monk_test (309, 146). Fray Patrick sugiere encontrarse con Rust Blackhand, que está cerca del edificio principal del Monasterio. Dice que Rust Blackhand hará que el muñeco Baphomet Maldito sea muy útil."
		},
		Summary = ""
	},
	[3043] = {
		Title = "La gigantesca cabra mágica",
		Description = {
			"Inicio: NPC: Rust Blackhand en Ubicacion: prt_monk (261, 91). Rust Blackhand dice que puede hacer la cabra mágica gigantesca, que tiene el poder de Baphomet, si le traes todos los materiales que necesita: muñeco Baphomet maldito, cabra mágica, 30 cristales de oscuridad, 50 fragmentos de oscuridad y 990 000 zeny."
		},
		Summary = "Materiales gigantescos de cabra mágica"
	},
	[3044] = {
		Title = "La gigantesca cabra mágica",
		Description = {
			"Rust Blackhand dice que puede hacer la cabra mágica gigantesca, que tiene el poder de Baphomet, si le traes todos los materiales que necesita: muñeco Baphomet maldito, cabra mágica, 30 cristales de oscuridad, 50 fragmentos de oscuridad y 990 000 zeny."
		},
		Summary = "Materiales gigantescos de cabra mágica"
	},
	[3045] = {
		Title = "Santuario Sellado",
		Description = {
			"Tienes 2 horas para explorar la mazmorra del Santuario Sellado."
		},
		Summary = ""
	},
	[3046] = {
		Title = "Efecto secundario del Santuario Sellado",
		Description = {
			"Debido al efecto posterior de la mazmorra, solo podrás volver a ingresar al Santuario Sellado después de que hayan transcurrido 12 horas."
		},
		Summary = ""
	},
	[3050] = {
		Title = "Resurrección de Satanás Marruecos - 1",
		Description = {
			"Inicio: NPC: Continental Guard en Ubicacion: moc_fild20 (354, 183). \"Satan Morocc resucitó y escapó de Morocc Village, y ahora se ha mudado al desierto de Sograt. Si te consideras un valiente aventurero, busca al Jefe Balrog de la Guardia Continental en Morocc Village\"."
		},
		Summary = "Jefe Balrog"
	},
	[3051] = {
		Title = "Resurrección de Satanás Marruecos - 2",
		Description = {
			"\"Escuché que los monstruos en Lava Dungeon tienen llamas eternas que resolverían nuestros problemas de hoguera. Quiero que reúnas esas llamas para nosotros\". -Jefe Balrog"
		},
		Summary = "30 brasas"
	},
	[3052] = {
		Title = "Resurrección de Satanás Marruecos - 3",
		Description = {
			"\"Ahora, recuerdo haber oído que los monstruos en la Cueva de Hielo al norte tienen Corazones Glaciales. Esos corazones podrían aliviar a esos soldados del calor\". -Jefe Balrog"
		},
		Summary = "50 corazones glaciales"
	},
	[3053] = {
		Title = "Resurrección de Satanás Marruecos - 4",
		Description = {
			"\"Admito que estoy impresionado por tus habilidades y sentido común. Bienvenido a la Guardia Continental, amigo mío. ¿Estás listo para arriesgar tu vida por el bien de la paz en el mundo?\" -Jefe Balrog"
		},
		Summary = "Evite que Satan Morocc reviva completamente su verdadero poder."
	},
	[3054] = {
		Title = "Resurrección de Satanás Marruecos - 5",
		Description = {
			"Satan Morocc finalmente fue expulsado de Rune-Midgards y desapareció a través de la brecha dimensional. Puedes ver los fragmentos flotando en el hueco."
		},
		Summary = ""
	},
	[3055] = {
		Title = "Resurrección de Satanás Marruecos - 6",
		Description = {
			"Estiras la mano y recoges un fragmento sin brillo. Es un trozo de piel de Satán Morocc. Esta será la prueba decisiva de la derrota de Satan Morocc."
		},
		Summary = ""
	},
	[3056] = {
		Title = "Resurrección de Satanás Marruecos - 7",
		Description = {
			"\"Felicitaciones, soldado. Acabas de salvar a este mundo y a la gente de ser consumidos por la destrucción y el mal. Tengo tres artículos. ¿Cuál te gustaría recibir?\""
		},
		Summary = "Elige tu recompensa"
	},
	[3060] = {
		Title = "Kids in Veins - ¿Dónde está la hermanita?",
		Description = {
			"Inicio: NPC: Kid en Ubicacion: veins (327, 185). Un niño llamado Karyn perdió a su hermana pequeña cuando fueron al Volcán Thor en Veins. Debes ayudarlo a encontrar a su hermana Curdie."
		},
		Summary = ""
	},
	[3061] = {
		Title = "Kids in Veins: ¡encuentra una manera de desbloquear los grilletes!",
		Description = {
			"La hermana de Karyn ha sido sacudida. Debes regresar al pueblo de Veins para encontrar la manera de liberarla."
		},
		Summary = ""
	},
	[3062] = {
		Title = "Kids in Veins - ¡Encuentra al cerrajero!",
		Description = {
			"La hermana de Karyn ha sido sacudida. Debes regresar al pueblo de Veins para encontrar la manera de liberarla."
		},
		Summary = ""
	},
	[3063] = {
		Title = "Niños en venas: ¿Sr. Lockenlock?",
		Description = {
			"Encuentra al experto llamado Locksmith Lockenlock. Se supone que ese señor Lockenlock está sentado en la calle del mercado, borracho. Debes traer 1 poción amarilla contigo."
		},
		Summary = ""
	},
	[3064] = {
		Title = "Kids in Veins - Jabón Chamelepu Orgánico",
		Description = {
			"El señor Lockenlock dice que necesita un jabón de Chamelepu para hacer el molde de una llave. Puedes comprar el jabón a la jabonera, la Sra. Ivory, en el mercado."
		},
		Summary = ""
	},
	[3065] = {
		Title = "Kids in Veins - Ingredientes del jabón",
		Description = {
			"El Jabón Chamelepu está agotado en este momento. Sin embargo, ella puede hacer el jabón si le traes los ingredientes."
		},
		Summary = "10 leches, 100 hierbas verdes, 50 gelatinas, 5 botellas vacías"
	},
	[3066] = {
		Title = "Kids in Veins - Para hacer un Jabón de Chamelepu...",
		Description = {
			"Vaya a visitar al Sr. Saraman, el propietario de Camel Farm, con los ingredientes. Él te dirá qué hacer con los ingredientes. ¡Vamos!"
		},
		Summary = ""
	},
	[3067] = {
		Title = "Kids in Veins - Estimulantes del apetito del camello",
		Description = {
			"Para obtener los trozos de estiércol de camello, primero es necesario alimentar al camello con alimentos que estimulen su apetito. ¡Consigue la comida estimulante del apetito!"
		},
		Summary = "5 alimentos para monstruos, 1 manzana verde, 1 poción amarilla, 1 botella vacía"
	},
	[3068] = {
		Title = "Kids in Veins - Obteniendo el estiércol de camello",
		Description = {
			"Has reunido con éxito los estimulantes del apetito. Alimenta al camello con lo que has recogido y consigue 5 terrones de estiércol de camello."
		},
		Summary = ""
	},
	[3069] = {
		Title = "Kids in Veins: ¿Dónde está el camello de seda y arena?",
		Description = {
			"Qué raro... Los camellos no responden a los estimulantes. Volvamos con el Sr. Saraman y averigüemos qué está pasando."
		},
		Summary = ""
	},
	[3070] = {
		Title = "Kids in Veins - ¡Sea Sand Camel ya no existe!",
		Description = {
			"El Camello de Arena de Seda escapó de la granja y desapareció. Vayamos a buscar el camello de seda y arena para el Sr. Saraman y consigamos 5 trozos de estiércol de camello. El camello no debería haber llegado tan lejos."
		},
		Summary = ""
	},
	[3071] = {
		Title = "Kids in Veins - ¡Se encuentra el camello de arena de seda!",
		Description = {
			"Finalmente se encuentra Silk Sand Camel. Consigamos 5 trozos de estiércol de camello. Cada trozo de estiércol ocuparía algunos ingredientes."
		},
		Summary = "2 leches, 20 hierbas verdes, 10 gelatinas, 1 botella vacía"
	},
	[3072] = {
		Title = "Kids in Veins - 1 trozo de estiércol de camello obtenido",
		Description = {
			"Se obtiene 1 terrón de estiércol de Camello Arena de Seda. Necesitas 4 más de esto. Cada trozo de estiércol ocuparía algunos ingredientes."
		},
		Summary = "2 leches, 20 hierbas verdes, 10 gelatinas, 1 botella vacía"
	},
	[3073] = {
		Title = "Kids in Veins - 2 terrones de estiércol de camello obtenidos",
		Description = {
			"Se obtienen 2 terrones de estiércol de Camello Arena de Seda. Necesitas 3 más de estos. Cada trozo de estiércol ocuparía algunos ingredientes."
		},
		Summary = "2 leches, 20 hierbas verdes, 10 gelatinas, 1 botella vacía"
	},
	[3074] = {
		Title = "Kids in Veins - 3 terrones de estiércol de camello obtenidos",
		Description = {
			"Se obtienen 3 terrones de estiércol de Camello Arena de Seda. Necesitas 2 más de estos. Cada trozo de estiércol ocuparía algunos ingredientes."
		},
		Summary = "2 leches, 20 hierbas verdes, 10 gelatinas, 1 botella vacía"
	},
	[3075] = {
		Title = "Kids in Veins - Se obtienen 4 terrones de estiércol de camello.",
		Description = {
			"Se obtienen 4 terrones de estiércol de Camello Arena de Seda. Necesitas 1 más de estos. Cada trozo de estiércol ocuparía algunos ingredientes."
		},
		Summary = "2 leches, 20 hierbas verdes, 10 gelatinas, 1 botella vacía"
	},
	[3076] = {
		Title = "Kids in Veins - 5 terrones de estiércol de camello obtenidos",
		Description = {
			"Finalmente has terminado de recolectar trozos de estiércol de camello. Volvamos con el Sr. Saraman y le digamos dónde se encuentra el Camello."
		},
		Summary = ""
	},
	[3077] = {
		Title = "Kids in Veins - Vaya con la Sra. Ivory",
		Description = {
			"Le dijiste al Sr. Saraman dónde estaba su camello. Ahora, volvamos a la Sra. Ivory."
		},
		Summary = ""
	},
	[3078] = {
		Title = "Kids in Veins - ¡El Jabón Chamalepu está completo!",
		Description = {
			"Ve con el Sr. Lockenlock con Jabón Chamalepu."
		},
		Summary = ""
	},
	[3079] = {
		Title = "Kids in Veins - Haciendo el molde de la llave",
		Description = {
			"El Sr. Lockenlock te enseña cómo hacer el molde de la llave a partir de la cerradura. Viertes el jabón en el ojo de la cerradura y lo vuelves a verter en la botella. Podría hacer la llave con el molde. ¡Vamos!"
		},
		Summary = ""
	},
	[3080] = {
		Title = "Kids in Veins - Trayendo el molde clave",
		Description = {
			"La pequeña Curdie todavía está encadenada y perdiendo fuerzas. Debes regresar con el Sr. Lockenlock con el molde lo antes posible, para que pueda hacer la llave."
		},
		Summary = ""
	},
	[3081] = {
		Title = "Kids in Veins: ¡Todo lo que necesitas es acero!",
		Description = {
			"El Sr. Lockenlock te pide que le consigas 1 acero para hacer la llave."
		},
		Summary = "1 acero"
	},
	[3082] = {
		Title = "Kids in Veins: ¡la llave está hecha!",
		Description = {
			"Tienes la llave maestra después de escuchar la historia detrás de la cerradura. Debes rescatar a Curdie y luego tirar la llave."
		},
		Summary = ""
	},
	[3083] = {
		Title = "Kids in Veins - La llave del Sr. Lockenlock",
		Description = {
			"Curdie ya está sano y salvo en la ciudad. Sea lo que sea, este lugar esconde algo grande, algo relacionado con el Ejército Rachel. Volvamos a la ciudad y conozcamos a los niños."
		},
		Summary = ""
	},
	[3085] = {
		Title = "Llamada del comandante",
		Description = {
			"Inicio: NPC: Hibba Agip en Ubicacion: mid_campin (90, 121). Abidal, un oficial de Estado Mayor, tiene algo que contarte. El comandante de la expedición parece tener una misión importante para mí..."
		},
		Summary = ""
	},
	[3086] = {
		Title = "El deber del comandante",
		Description = {
			"Quiere que entregues el informe de la expedición a los 3 países de Rune Midgard. Debes confirmar la misión con el comandante."
		},
		Summary = ""
	},
	[3087] = {
		Title = "Informe a Runa Midgard",
		Description = {
			"Tomas la misión de entrega. Necesitas hablar con un mensajero en la brecha dimensional y preparar la entrega de los informes."
		},
		Summary = ""
	},
	[3088] = {
		Title = "Informe al continente - ¡Accidente!",
		Description = {
			"Eres asaltado alrededor de la brecha dimensional y pierdes el informe. Será mejor que regreses con el comandante y le expliques lo que pasó."
		},
		Summary = ""
	},
	[3089] = {
		Title = "Informe al continente - Cómo restaurar",
		Description = {
			"El comandante le ordena restaurar el informe junto con Abidal."
		},
		Summary = ""
	},
	[3090] = {
		Title = "Informe al continente - Ubicación de los informes",
		Description = {
			"Intente encontrar los informes dispersos por Ash Vacuum. Es posible que los monstruos de aquí se los hayan llevado. Obtén información de los exploradores que hay por aquí."
		},
		Summary = ""
	},
	[3091] = {
		Title = "Informe al continente - Ubicación de los informes",
		Description = {
			"Inicio: NPC: Expedition Scout en Ubicacion: man_fild01 (315, 95). Intente encontrar los informes dispersos por Ash Vacuum. Es posible que los monstruos de aquí se los hayan llevado. Obtén información de los exploradores que hay por aquí."
		},
		Summary = ""
	},
	[3092] = {
		Title = "Informe al continente - ¡Éxito para restaurar!",
		Description = {
			"Inicio: NPC: Staff Officer Abidal en Ubicacion: mid_campin (94, 118). Finalmente restauró el borrador del informe con Abidal. Deberías acudir al comandante para informar."
		},
		Summary = ""
	},
	[3093] = {
		Title = "Informe al continente, informe al continente",
		Description = {
			"Debes entregar 3 informes a 3 países. Los destinatarios son Laur en Prontera, Nuria en Rachel y Gerhart en Schwaltzval Republict."
		},
		Summary = ""
	},
	[3094] = {
		Title = "Informe al continente - Regreso a la expedición",
		Description = {
			"Terminaste de entregar los informes. Regrese con el comandante e informe."
		},
		Summary = ""
	},
	[3100] = {
		Title = "Consolidación de deuda pesada: vínculo de deuda perdido",
		Description = {
			"Inicio: NPC: Muff en Ubicacion: comodo (224, 187). Muff en Comodo busca ayuda para encontrar el vínculo de la deuda que perdió en el bosque Papuchicha cerca del río."
		},
		Summary = ""
	},
	[3101] = {
		Title = "Consolidación de deudas pesadas: extraño montón de tierra",
		Description = {
			"¡Has descubierto un extraño montón de tierra! Echemos un vistazo."
		},
		Summary = ""
	},
	[3102] = {
		Title = "Consolidación de deuda pesada: bono de deuda encontrado, pero...",
		Description = {
			"El vínculo de la deuda se encuentra, sin embargo, está mojado y hecho jirones. Parece completamente arruinado. Llévaselo a Muff de todos modos."
		},
		Summary = ""
	},
	[3103] = {
		Title = "Consolidación de deudas pesadas - Inventor Dorian",
		Description = {
			"El inventor Dorian en Izlude podría restaurar el vínculo de la deuda usando su Secador Mágico."
		},
		Summary = ""
	},
	[3104] = {
		Title = "Consolidación de deudas importantes: materiales de reparación del secador mágico",
		Description = {
			"Dorian dice que debes ayudarlo a arreglar la secadora si quieres usarla."
		},
		Summary = "20 tornillos oxidados, 10 minerales de hierro, 5 acero, 2 rubíes, 10 piedras preciosas rojas"
	},
	[3105] = {
		Title = "Consolidación de deudas importantes: reparación del secador mágico",
		Description = {
			"Dorian te dice cómo arreglar la secadora y te permite arreglarla tú mismo. Parece difícil..."
		},
		Summary = ""
	},
	[3106] = {
		Title = "Consolidación de deudas importantes: falló la reparación del secador mágico",
		Description = {
			"La reparación finalmente falló. Informe a Dorian que ha fallado."
		},
		Summary = ""
	},
	[3107] = {
		Title = "Consolidación de deudas importantes: reparación exitosa del secador mágico",
		Description = {
			"La reparación por fin ha tenido éxito. Informe a Dorian que lo ha logrado."
		},
		Summary = ""
	},
	[3108] = {
		Title = "Consolidación de deudas pesadas: hagamos funcionar el secador mágico",
		Description = {
			"Restaura el vínculo de la deuda utilizando el Secador Mágico."
		},
		Summary = ""
	},
	[3109] = {
		Title = "Consolidación de deudas pesadas: restauración del vínculo de la deuda",
		Description = {
			"El vínculo de la deuda ahora está completamente restablecido. Llévaselo a Muff."
		},
		Summary = ""
	},
	[3110] = {
		Title = "Diamante robado: seguimiento del diamante",
		Description = {
			"Inicio: NPC: Ibrahim en Ubicacion: moc_ruins (152, 147). Encuentra el diamante robado. Primero, debes encontrar a Jhonnita en Alberta, Kimeunbang en Payon y Leblo en Geffen. Quizás sepan su paradero."
		},
		Summary = ""
	},
	[3111] = {
		Title = "Diamante robado - El favor de Leblo",
		Description = {
			"Hagamos un trato. Te daré la información si consigues algún medicamento del doctor Wola en Payon."
		},
		Summary = ""
	},
	[3112] = {
		Title = "Diamante robado - Wola el Doctor",
		Description = {
			"Deberías ayudarme a arreglar esta olla. No puedo hacer ningún medicamento sin este bote."
		},
		Summary = "20 arenas finas, 10 brigans, 10 hojas blandas, 5 botellas vacías"
	},
	[3113] = {
		Title = "Diamante robado - Wola el Doctor",
		Description = {
			"Finalmente la olla está arreglada. Ahora, ¿qué dijiste que necesitabas?"
		},
		Summary = ""
	},
	[3114] = {
		Title = "Diamante robado - Wola el Doctor",
		Description = {
			"Leblo... Ah, ¿ese hombre de Geffen? Ya lo preparé. Se lo entregaré en breve."
		},
		Summary = ""
	},
	[3115] = {
		Title = "Diamante robado - Información de Leblo",
		Description = {
			"Probablemente sería la Banda Z la que robó el diamante. Obtén información sobre Z Gang en Rogue Guild."
		},
		Summary = ""
	},
	[3116] = {
		Title = "Diamante robado: información del investigador rebelde",
		Description = {
			"Sobornalo con algo de dinero y escucharás que el antiguo escondite de Z Gang es un gran almacén en Comodo. ¡Ve a verlo!"
		},
		Summary = ""
	},
	[3117] = {
		Title = "Diamante robado - Interruptores impares",
		Description = {
			"Mientras buscaba en el almacén de Comodo, encontró algunos interruptores extraños. Examinemos un poco más."
		},
		Summary = ""
	},
	[3118] = {
		Title = "Diamante robado - ¡Diamante encontrado!",
		Description = {
			"Has encontrado el Diamante de la Destrucción de Ibrahim activando esas extrañas máquinas en el almacén. Date prisa y llévale esto a Ibrahim."
		},
		Summary = ""
	},
	[3119] = {
		Title = "Se busca pandilla Z - Aviso de búsqueda",
		Description = {
			"Inicio: NPC: Wanted Notice en Ubicacion: prontera (150, 326). La Oficina de Seguridad Nacional del Reino Rune-Midgarts recompensará a cualquiera que capture a Z Gang. ¿Qué tal si lo intentamos? Recopilemos más información sobre esto."
		},
		Summary = ""
	},
	[3120] = {
		Title = "Se busca Z Gang - Acerca de Z Gang",
		Description = {
			"Hay tres miembros: Louis Von Silokens alias Louis, Martha Hertizan alias Martha y Catfoii alias Catfoii ¡deben ser capturados! Puedes obtener más información de un caballero llamado Valdés."
		},
		Summary = ""
	},
	[3121] = {
		Title = "Se busca pandilla Z - El favor de Valdés",
		Description = {
			"Encontraste a Valdés, pero está borracho. Te pide que traigas 5 botellas de Morocc Fruit Wine, de lo contrario no te dará ninguna información."
		},
		Summary = "5 botellas de Vino de Frutas Marruecos"
	},
	[3122] = {
		Title = "Se busca pandilla Z - Información de Valdés",
		Description = {
			"Se recomienda que se ponga en contacto con un agente de Rogue Guild para encontrar a Z Gang. Debes encontrar a Marybell, la agente Rogue, y obtener la información. La contraseña que debes darle es \"^3355FFEl amanecer está por llegar^000000\""
		},
		Summary = ""
	},
	[3123] = {
		Title = "Se busca pandilla Z - La prueba de Marybell",
		Description = {
			"Marybell quiere ponerte a prueba. Ella confiará en ti si recibes una carta de recomendación del legendario jugador llamado Moonho Ahn en Payon."
		},
		Summary = ""
	},
	[3124] = {
		Title = "Se busca pandilla Z - Desafiando a Moonho Ahn",
		Description = {
			"Moonho Ahn te dice que regreses cuando estés listo para jugar con él. Debes vencerlo para obtener la carta de recomendación."
		},
		Summary = ""
	},
	[3125] = {
		Title = "Se busca pandilla Z - Desafiando a Moonho Ahn",
		Description = {
			"Has vencido a Moonho Ahn. Vuelve a Marybell con la recomendación."
		},
		Summary = ""
	},
	[3126] = {
		Title = "Se busca pandilla Z - Información de Marybell",
		Description = {
			"Z Gang está relacionado con la mayoría de los problemas en todo el continente. Debes encontrar al informante de la Banda Z. Z Gang está reclutando informantes en secreto en Marruecos."
		},
		Summary = ""
	},
	[3127] = {
		Title = "Se busca Z Gang - El ataque de Z Gang",
		Description = {
			"Fuiste atacado por un hombre sospechoso mientras reunías información en Marruecos. ¿A dónde se escapó?... Parece que este hombre sospechoso está relacionado con Z Gang. ¡Siguelo!"
		},
		Summary = ""
	},
	[3128] = {
		Title = "Se busca Z Gang - El ataque de Z Gang",
		Description = {
			"Encontraste al informante de la Banda Z. La agitación de Z Gang parece estar en algún lugar alrededor del desierto de Marruecos... Vuelve con Marybell."
		},
		Summary = ""
	},
	[3129] = {
		Title = "Se busca pandilla Z - Carta extraña",
		Description = {
			"Marybell recibe una carta en blanco sellada con cifrado del informante de Z Gang y le pide al descifrador de códigos, Gooho Ahn, en Payon, que rompa el cifrado."
		},
		Summary = ""
	},
	[3130] = {
		Title = "Se busca pandilla Z - Descifrando la carta...",
		Description = {
			"Parece un trozo de papel en blanco, pero si le añades la cantidad adecuada de calor y luz, podrás leer su contenido. Necesitas conseguir algunos materiales para esto. Consigue ^0000ff20 brasas, 1 cerilla, 2 alcohol, 10 corazones ardientes^000000."
		},
		Summary = ""
	},
	[3131] = {
		Title = "Se busca pandilla Z: ¡el código está roto!",
		Description = {
			"Según Gooho Ahn, el idioma Aegye está escrito en el papel. La contraseña es ^0000ffWeii arr prowd Z G gna ^0000FFAynoen hwo sspotp uys ^0000FFwlil eb kckide on htier ssa!^000000"
		},
		Summary = ""
	},
	[3132] = {
		Title = "Se busca pandilla Z: encuentra el agitado de la pandilla Z",
		Description = {
			"Descubriste que existe la entrada a los escondites de Z Gang en el desierto del sur de Marruecos. Quizás la contraseña de Gooho Ahn te resulte útil. ^0000ffWeii arr prowd Z G gna ^0000FFAynoen hwo sspotp uys ^0000FFwlil eb kckide on htier ssa!^000000"
		},
		Summary = ""
	},
	[3133] = {
		Title = "Se busca Z Gang - ¡Agit encontrado!",
		Description = {
			"¿Entonces este es el Agit? ¡Busquemos miembros de Z Gang y derrotémoslos!"
		},
		Summary = ""
	},
	[3134] = {
		Title = "Se busca Z Gang - Barrido limpio de Z Gang",
		Description = {
			"Captaste a Z Gang y obtuviste el Libro del Misterio Prohibido. Vuelve con el soldado retirado en Prontera."
		},
		Summary = ""
	},
	[3135] = {
		Title = "Nido de Nidhoggur",
		Description = {
			"Inicio: NPC: Yggdrasil Gatekeeper en Ubicacion: nyd_dun02 (100, 201). El suelo tiembla por el despertar de Nidhoggur. Espere hasta que expire el cronómetro antes de poder recuperar el acceso a la mazmorra."
		},
		Summary = ""
	},
	[3136] = {
		Title = "Límite de tiempo del Nido de Nidhoggur",
		Description = {
			"Inicio: NPC: Yggdrasil Gatekeeper en Ubicacion: nyd_dun02 (100, 201). Tienes 4 horas para derrotar a la Sombra de Nidhoggur. Si el Memorial Dungeon es destruido no podrás volver a entrar."
		},
		Summary = ""
	},
	[3137] = {
		Title = "La sombra de Nidhoggur",
		Description = {
			"Caza la sombra de Nidhoggur"
		},
		Summary = ""
	},
	[3138] = {
		Title = "Dragón Púrpura Errante",
		Description = {
			"Caza al Dragón Púrpura Errante en el Bosque Brumoso"
		},
		Summary = ""
	},
	[3200] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Inicio: NPC: Splendid-Looking Knight en Ubicacion: prt_in (162, 24). Ve a la esquina noroeste de Glast Heim y encuentra un Rune Knight que te guiará hasta la entrada de la Torre Glast Heim."
		},
		Summary = ""
	},
	[3201] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Busca en el segundo piso de Glast Heim Chivalry el área de reunión secreta de Rune Knight. Encuentra allí a un miembro del personal de Rune Knight que te guiará al área de reunión."
		},
		Summary = ""
	},
	[3202] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"El Capitán Tigris de Rune Knight dice que vaya a Rune Knight Lunarea para comenzar la primera prueba para convertirse en Rune Knight."
		},
		Summary = ""
	},
	[3203] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Lunarea te dirige a la primera sala de pruebas. Derrota a todos los monstruos convocados para pasar la primera prueba."
		},
		Summary = ""
	},
	[3204] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Continúa tu prueba hablando con el Capitán Tigris."
		},
		Summary = ""
	},
	[3205] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"La siguiente parte de la prueba es hablar con Rune Knight Renoa en la biblioteca."
		},
		Summary = ""
	},
	[3206] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Renoa dice que estudiar es parte de ser un Caballero Rúnico. Lea detenidamente los 3 libros de la biblioteca y hable con Renoa una vez que haya terminado."
		},
		Summary = ""
	},
	[3207] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Habla con Lapine Sage Serpeone que se encuentra actualmente en el campamento de Rune Midgard en Ash Vacuum."
		},
		Summary = ""
	},
	[3208] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Un sabio sabio Serpeone lanza un hechizo sobre tu cuerpo para que puedas acumular energía mágica de otros seres vivos."
		},
		Summary = ""
	},
	[3209] = {
		Title = "Caza Dullahan",
		Description = {
			"Inicio: NPC: Sage Serpeone en Ubicacion: mid_camp (235, 250). Acumula energía mágica cazando a Dullahan. Puedes encontrar estos monstruos en Skellington Village en Nifflheim."
		},
		Summary = "Caza 10 Dullahan"
	},
	[3210] = {
		Title = "Caza disfrazada",
		Description = {
			"Inicio: NPC: Sage Serpeone en Ubicacion: mid_camp (235, 250). Acumula energía mágica cazando Disfraz. Puedes encontrar estos monstruos en Skellington Village en Nifflheim."
		},
		Summary = "Caza 10 disfraz"
	},
	[3211] = {
		Title = "Caza de Quve",
		Description = {
			"Inicio: NPC: Sage Serpeone en Ubicacion: mid_camp (235, 250). Acumula energía mágica cazando a Quve. Puedes encontrar estos monstruos en Skellington Village en Nifflheim."
		},
		Summary = "Caza 10 Quve"
	},
	[3212] = {
		Title = "Caza jerozoísta",
		Description = {
			"Inicio: NPC: Sage Serpeone en Ubicacion: mid_camp (235, 250). Acumula energía mágica cazando a Heirozoist. Puedes encontrar estos monstruos en Skellington Village en Nifflheim."
		},
		Summary = "Caza 10 Heirozoístas"
	},
	[3213] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Has acumulado suficiente energía mágica en tu cuerpo para convertirte en un Caballero Rúnico. Habla con Sage Serpeone y ella te enviará al área de Rune Knight Gathering."
		},
		Summary = ""
	},
	[3214] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Haz 20 piedras rúnicas con el horno de runas detrás de Renoa. Los libros de la biblioteca contienen todo el conocimiento acumulado sobre Rune Stones. Avisa a Renoa cuando tengas 20."
		},
		Summary = ""
	},
	[3215] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Pasaste la prueba de Renoa. Vuelve con el capitán Tigris para la siguiente parte de la prueba."
		},
		Summary = ""
	},
	[3216] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Tienes que realizar una prueba de Velpino en el lado derecho del área de Rune Knight Gathering."
		},
		Summary = ""
	},
	[3217] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Antes de realizar la última prueba, debes quitarte todo el equipo excepto un arma de una mano, un escudo o un arma de dos manos y no puedes pesar más de 400."
		},
		Summary = ""
	},
	[3218] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Has superado la prueba final para convertirte en Rune Knight. Habla con Rune Knight Velpino."
		},
		Summary = ""
	},
	[3219] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Has completado todas las pruebas para convertirte en Rune Knight. Habla con Rune Captain Tigris y renace como un noble Rune Knight."
		},
		Summary = ""
	},
	[3220] = {
		Title = "Cambio de trabajo a Rune Knight",
		Description = {
			"Inicio: NPC: Rune Knight Lunarea en Ubicacion: job3_rune01 (90, 50). Si no pasas la prueba, tendrás que esperar 10 minutos antes de volver a intentarlo. Espere a que expire el límite de tiempo antes de volver a intentarlo."
		},
		Summary = ""
	},
	[3250] = {
		Title = "¿Qué es este vendaje?",
		Description = {
			"Caza ^0000FF30 Momia^000000 y recoge ^0000FF20 Vendaje podrido^000000. Informe a Sparkle en Eden Group una vez realizada la solicitud."
		},
		Summary = ""
