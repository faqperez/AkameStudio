	[11596] = {
		Title = "viejos recuerdos",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: ein_fild03 (278, 269). Parece que has encontrado el escondite de los enemigos cerca de Einbroch, disfrazado de mina abandonada. Comprobemos si hay otros enemigos alrededor."
		},
		Summary = "inspeccionar los alrededores"
	},
	[11597] = {
		Title = "viejos recuerdos",
		Description = {
			"Nada parece extraordinario. Miremos hacia otro lado."
		},
		Summary = "inspeccionar los alrededores"
	},
	[11598] = {
		Title = "viejos recuerdos",
		Description = {
			"Nada parece extraordinario. Miremos hacia otro lado."
		},
		Summary = "inspeccionar los alrededores"
	},
	[11599] = {
		Title = "viejos recuerdos",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: ein_fild03 (278, 269). Nada parece extraordinario. Volvamos a Rebellion Crew."
		},
		Summary = "Habla con Rebelion Crew"
	},
	[11600] = {
		Title = "viejos recuerdos",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: ein_fild03 (278, 269). Miremos el interior de la mina abandonada."
		},
		Summary = "entra"
	},
	[11601] = {
		Title = "viejos recuerdos",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: rebel_in (68, 41). Se ha abierto el camino a la siguiente zona. Regresemos a Klana Nemieli para transmitirle la noticia y luego traigamos el objeto que Dien está buscando en la habitación de Dien."
		},
		Summary = "Al Klana Nemieli"
	},
	[11602] = {
		Title = "viejos recuerdos",
		Description = {
			"Inicio: NPC: Rebellion Crew en Ubicacion: rebel_in (68, 41). Traigamos el objeto que Dien está buscando en la habitación de Dien."
		},
		Summary = "Amuleto de Dien"
	},
	[11603] = {
		Title = "viejos recuerdos",
		Description = {
			"Inicio: NPC: Ornament Box en Ubicacion: rebel_in (161, 91). Encontraste el amuleto de Dien. Volvamos a Dien."
		},
		Summary = "Volver a Dien"
	},
	[11604] = {
		Title = "Àè ´õ ÀÚÀÌ¾ðÆ® ÆßÇÁÅ²",
