		},
		Summary = ""
	},
	[4362] = {
		Title = "Espera a Santa Duende",
		Description = {
			"Espere 24 horas para la misión."
		},
		Summary = ""
	},
	[4363] = {
		Title = "Espera a Santa Orco",
		Description = {
			"Espere 24 horas para la misión."
		},
		Summary = ""
	},
	[4364] = {
		Title = "Espera a Santa Jakk",
		Description = {
			"Espere 24 horas para la misión."
		},
		Summary = ""
	},
	[4999] = {
		Title = "Crisis de exterminio",
		Description = {
			"Nuestra gran carrera de ranas ahora está en peligro porque muchos viajeros vienen aquí y se llevan nuestros huevos como una especie de recuerdo. Incluso escuché que quedan muchos en el terreno aquí y allá, así que necesito tu ayuda. Por favor, traiga ^FF0000100 Spawn^000000."
		},
		Summary = "Lleva 100 engendros a King Froggie Vll"
	},
	[5000] = {
		Title = "Crisis de exterminio",
		Description = {
			"Inicio: NPC: Roda Frog en Ubicacion: gef_fild07 (108, 161). Nuestra gran carrera de ranas ahora está en peligro porque muchos viajeros vinieron aquí y se llevaron nuestros huevos como una especie de recuerdo. Incluso escuché que quedan muchos en el terreno aquí y allá, así que necesito tu ayuda. Por favor trae de vuelta ^FF0000100 Spawn^000000"
		},
		Summary = "Lleva 100 engendros a King Froggie Vll"
	},
	[5001] = {
		Title = "La venganza del Rey Froggie VII",
		Description = {
			"El Rey Froggie VII te pidió que te vengaras de los Side Winders que siguen derrotando a sus hermanos rana. Derrota a 50 Side Winders y regresa con él."
		},
		Summary = ""
	},
	[5002] = {
		Title = "El héroe de las ranas.",
		Description = {
			"King Froggie VII quiere agregar tus hazañas a sus libros de historia. Llévale 100 Venom Canine como prueba adicional de que eres digno de estar en los libros de historia."
		},
		Summary = "Consigue 100 caninos venenosos"
	},
	[5003] = {
		Title = "Habilidad para esconder ranas",
		Description = {
			"En los viejos tiempos, el gran rey Froggie III creó una medicina secreta que permitía a las ranas utilizar una habilidad para esconderse de las serpientes. Llévale 50 proyectiles de escamas al Rey Froggie VII."
		},
		Summary = ""
	},
	[5004] = {
		Title = "Escasez de alimentos",
		Description = {
			"Las ranas tienen escasez de alimento. Si derrotas a 50 Argiopes, será suficiente para alimentar a las masas de ranas hambrientas."
		},
		Summary = "Derrota a 50 Argiopes."
	},
	[5005] = {
		Title = "Holgren",
		Description = {
			"Yo soy algo especial, pero ^FF0000Bundle of Love^000000 no es algo que aparezca a menudo."
		},
		Summary = "Puedes volver a recibir un Bundle of Love de Holgren después de 24 horas"
	},
	[5006] = {
		Title = "Guía de Prontera",
		Description = {
			"El ^FF0000Bundle of Love^000000 es raro. ¿Por qué no intentar conseguir uno de otra persona?"
		},
		Summary = "Puedes volver a recibir un Bundle of Love de la guía después de 24 horas."
	},
	[5007] = {
		Title = "Guía de pago",
		Description = {
			"^FF0000Paquete de amor^000000? Incluso yo sólo recibo uno una vez en cada luna azul. ¿Por qué no intentas preguntarle a otros amigos además de mí?"
		},
		Summary = "Puedes volver a recibir un Bundle of Love de la guía después de 24 horas."
	},
	[5008] = {
		Title = "Guía Geffen",
		Description = {
			"¿Dijiste el ^FF0000Paquete de amor^000000? Lamento decirlo, pero no puedo darte uno ahora."
		},
		Summary = "Puedes volver a recibir un Bundle of Love de la guía después de 24 horas."
	},
	[5009] = {
		Title = "Guía de Marruecos",
		Description = {
			"Puedo volver a jugar piedra, papel y tijera, pero entregar otro ^FF0000Bundle of Love^000000 sería difícil. Es un objeto raro... No intentarás conseguirlo a cambio de nada, ¿verdad? No, a menos que ganes unos diez mil juegos..."
		},
		Summary = "Puedes volver a recibir un Bundle of Love de la guía después de 24 horas."
	},
	[5010] = {
		Title = "Sukrim",
		Description = {
			"Jeje, ¿el ^FF0000Paquete de Amor^000000 que te di como regalo de agradecimiento? Ya no lo tengo."
		},
		Summary = "Puedes volver a recibir un Paquete de Amor de Sukrim después de 24 horas"
	},
	[5011] = {
		Title = "Lee Jinha",
		Description = {
			"¿No te dije que estoy ocupado leyendo la colección completa de Ragnarok OX Quiz? Vuelve mañana, mañana"
		},
		Summary = "Puedes volver a recibir un Bundle of Love de la guía después de 24 horas."
	},
	[5012] = {
		Title = "Personal de la Agencia Jonda",
		Description = {
			"El ^FF0000Bundle of Love^000000 proviene de la oficina central, así que yo tampoco tengo uno. La oficina central debería recibir más información mañana aproximadamente."
		},
		Summary = "Podrás volver a recibir un Bundle of Love de Jonda después de 24 horas"
	},
	[5013] = {
		Title = "Arlés Orleáns",
		Description = {
			"¿Quieres volver a resolver problemas matemáticos? Me dará un calambre en la cabeza. Vuelve mañana."
		},
		Summary = "Podrás volver a recibir un Bundle of Love de Arles después de 24 horas"
	},
	[5014] = {
		Title = "Iseryu",
		Description = {
			"Respondas correctamente o no, sólo podrás resolver un problema al día."
		},
		Summary = "Por favor habla con Iseryu nuevamente después de 24 horas."
	},
	[5015] = {
		Title = "Guía de Marruecos",
		Description = {
			"Piedra, papel y tijera me genera bastante estrés mental, por lo que no puedo jugar de inmediato."
		},
		Summary = "Por favor regresa después de 3 horas."
	},
	[5016] = {
		Title = "Tráeme herramientas de investigación",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). El investigador de Raffle dice que estaba siendo atacado por una criatura no identificada y que le robaron sus herramientas de investigación. Ve y recupera las herramientas de investigación de la misteriosa criatura y devuélvelas al investigador."
		},
		Summary = "Recuperar herramientas de investigación"
	},
	[5017] = {
		Title = "La venganza del investigador",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). El investigador de la rifa dice que debes ayudarlo a estar en un estado mental relajado porque esa es la única forma en que puede hacer su investigación. Vamos a acosar a la criatura no identificada solo 3 veces."
		},
		Summary = "Acosar a una criatura no identificada 3 veces."
	},
	[5018] = {
		Title = "La venganza del investigador",
		Description = {
			"Acosar la vida no identificada de Bathtub está completo. Regrese a The Raffle Researcher."
		},
		Summary = "Volver a El Investigador de la Rifa"
	},
	[5019] = {
		Title = "Muestreo de investigación de baños",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). Se ha iniciado una investigación a gran escala. ¡Para comenzar la investigación, necesitan un sujeto de prueba! ¡Vayamos a la bañera y consigamos 10 sujetos de prueba en nombre de la investigación!"
		},
		Summary = "Obtenga sujetos de prueba de la bañera"
	},
	[5020] = {
		Title = "Escaneando la muestra",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). Los investigadores ahora están realizando pruebas básicas con el sujeto de prueba. Dijeron que tardarán unas 24 horas en completarlo. Como no hay nada que hacer en este momento, ¿por qué no tomar un descanso?"
		},
		Summary = "Volvamos con los investigadores después de 24 horas."
	},
	[5021] = {
		Title = "Muestras recolectadas",
		Description = {
			"La investigación de Bathtub encontró que el sujeto de prueba tiene un ADN interesante. Para comparar el ADN no identificado, vaya a la bañera para recolectar muestras de dientes."
		},
		Summary = "Se pueden obtener muestras de la bañera."
	},
	[5022] = {
		Title = "Muestras recolectadas",
		Description = {
			"La investigación de Bathtub encontró que el sujeto de prueba tiene un ADN interesante. Para comparar el ADN no identificado, vaya a la bañera para recolectar muestras de escamas."
		},
		Summary = "Se pueden obtener muestras de la bañera."
	},
	[5023] = {
		Title = "Muestra durante la prueba.",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). Actualmente, los investigadores están analizando las muestras que usted ha traído en busca de ADN interesante."
		},
		Summary = "Vuelve con los investigadores después de 6 horas."
	},
	[5024] = {
		Title = "Encuesta de la cuenca oriental",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). Los investigadores dicen que hay aún más curiosidad después de encontrar el interesante ADN. Para satisfacer su curiosidad, te piden que vayas al East Pool y recolectes más muestras para ellos."
		},
		Summary = "Ve al East Pool, recoge muestras y tráelas a los investigadores."
	},
	[5025] = {
		Title = "Estudio de la cuenca occidental",
		Description = {
			"Los investigadores dicen que hay aún más curiosidad después de encontrar el interesante ADN. Para satisfacer su curiosidad, te piden que vayas al West Pool y recolectes más muestras para ellos."
		},
		Summary = "Ve a West Pool, recoge muestras y tráelas a los investigadores."
	},
	[5026] = {
		Title = "Encuesta de la cuenca sur",
		Description = {
			"Los investigadores dicen que hay aún más curiosidad después de encontrar el interesante ADN. Para satisfacer su curiosidad, te piden que vayas al estanque sur y recolectes más muestras para ellos."
		},
		Summary = "Ve a South Pool, recoge muestras y tráelas a los investigadores."
	},
	[5027] = {
		Title = "Encuesta de la cuenca norte",
		Description = {
			"Los investigadores dicen que hay aún más curiosidad después de encontrar el interesante ADN. Para satisfacer su curiosidad, te piden que vayas al estanque norte y recolectes más muestras para ellos."
		},
		Summary = "Ve al estanque norte, recoge muestras y tráelas a los investigadores."
	},
	[5028] = {
		Title = "Muestra durante la prueba.",
		Description = {
			"Inicio: NPC: Raffle Researcher en Ubicacion: mora (31, 138). La investigación está entrando en su etapa final. Los investigadores están revisando las muestras de los 4 grupos."
		},
		Summary = "Vuelva con los investigadores después de 12 horas."
	},
	[5029] = {
		Title = "Criatura no identificada",
		Description = {
			"Inicio: NPC: Black Shadow en Ubicacion: mora (114, 79). Ha ocurrido una batalla con la vida no identificada. Sanemos la mente y el cuerpo desgastados."
		},
		Summary = "Por favor descansa 1 hora"
	},
	[5030] = {
		Title = "La familia de la criatura.",
		Description = {
			"Fishee no ha podido ver a su familia por un tiempo y se pregunta cómo les va. Ve a la piscina en las afueras del pueblo y encuentra a la familia de Fishee."
		},
		Summary = "Encuentra a la familia de Fishee"
	},
	[5031] = {
		Title = "La familia de la criatura.",
		Description = {
			"Fishee no ha podido ver a su familia por un tiempo y se pregunta cómo les va. Ve a la piscina en las afueras del pueblo y encuentra a la familia de Fishee."
		},
		Summary = "Encuentra a la familia de Fishee"
	},
	[5032] = {
		Title = "La familia de la criatura.",
		Description = {
			"Fishee no ha podido ver a su familia por un tiempo y se pregunta cómo les va. Ve a la piscina en las afueras del pueblo y encuentra a la familia de Fishee."
		},
		Summary = "Encuentra a la familia de Fishee"
	},
	[5033] = {
		Title = "La familia de la criatura.",
		Description = {
			"Fishee no ha podido ver a su familia por un tiempo y se pregunta cómo les va. Ve a la piscina en las afueras del pueblo y encuentra a la familia de Fishee."
		},
		Summary = "Encuentra a la familia de Fishee"
	},
	[5034] = {
		Title = "noticias de la familia",
		Description = {
			"Encontraste a la familia de Fishee. Vamos a decirle a Fishee."
		},
		Summary = "Ve a Fishee de la Bañera y cuéntale tus novedades."
	},
	[5035] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Inicio: NPC: Memo en Ubicacion: dewata (109, 262). El señor Memo de la isla Dewata está en problemas. Ve y descubre qué está pasando en la tribu Jaty como un favor para él."
		},
		Summary = "La tribu Jaty está ubicada a las 10 en punto en dirección a la isla Dewata."
	},
	[5036] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Para elaborar aceite de palma, se requiere el fruto del aceite de palma. Poby que fue a recoger esas frutas aún no ha sido devuelto. Ve al bosque de palmeras y busca a Poby."
		},
		Summary = "Puedes encontrar a Poby en la zona sur del bosque de palmeras."
	},
	[5037] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Poby, que trepó al árbol, sin ningún dispositivo de seguridad, se cayó del árbol y se lastimó la espalda por lo que no puede moverse en absoluto."
		},
		Summary = "Por favor, cuéntale la situación de Poby a Lero en la tribu Jaty."
	},
	[5038] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Has decidido ayudar a Lero a recoger la fruta en lugar de hacer que Poby, herido, termine el trabajo."
		},
		Summary = "Pregúntale a Poby cómo recoger fruta de las palmeras."
	},
	[5039] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"En lugar de trepar a la palmera, tienes la opción de sacudirla o patearla. Por su propia seguridad, trate de usar un casco de seguridad mientras realiza esta tarea."
		},
		Summary = "Obtén 60 frutos de aceite de palma de las palmeras y llévaselos a Lero."
	},
	[5040] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Lero quiere que le transmitas la situación actualizada a Memo mientras presiona Aceite de frutos de aceite de palma."
		},
		Summary = "Entrega el mensaje de Lero al Sr. Memo en la isla Dewata."
	},
	[5041] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Memo dice que los aceites de palma ya deberían estar listos."
		},
		Summary = "Consigue aceites de Lero en la tribu Jaty."
	},
	[5042] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Lleva 30 aceites frescos a Memo."
		},
		Summary = "Lero dice que tengan cuidado porque los aceites son muy pesados"
	},
	[5043] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Con los aceites que has traído, Memo se ocupará primero de los asuntos urgentes."
		},
		Summary = "Espere a Memo durante 5 minutos mientras se ocupa de problemas urgentes."
	},
	[5044] = {
		Title = "¡Ayuda al viejo!",
		Description = {
			"Inicio: NPC: Memo en Ubicacion: dewata (109, 262). Memo, un anciano de la isla Dewata, realmente gracias a ti. Memo espera que puedas ayudarlo mañana también."
