	[7671] = {
		Title = "Encuentra mi cordero perdido",
		Description = {
			"Usa la ^4d4dffCuerda de caza^000000 para ^4d4dffLost Lambs^000000 Runa errante Midgard."
		},
		Summary = "Recupera 5 corderos perdidos"
	},
	[7672] = {
		Title = "Los corderos siguen huyendo",
		Description = {
			"El perro guardián parece estar ahuyentando a los corderos con regularidad. Vuelva después de unas horas y es probable que Bori haya perdido más corderos."
		},
		Summary = "Regresa con Bori después de que el cronómetro haya expirado."
	},
	[7673] = {
