	[12490] = {
		Title = "Misiones recibidas hoy",
		Description = {
			"Habla con los miembros del Gremio de Sacerdotes dentro del Laberinto. Has recibido todas las misiones diarias disponibles para ti como miembro invitado del Gremio de Sacerdotes de Prontera. Estas misiones se pueden recibir nuevamente después de ^ff00004 AM todos los días^000000 y no se pueden recibir dos veces."
