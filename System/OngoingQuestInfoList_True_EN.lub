	[11453] = {
		Title = "Consideración para los invitados",
		Description = {
			"¡El evento de buenos deseos de hoy ha terminado! Visitaremos de nuevo mañana."
		},
		Summary = "¡Mañana otra vez!"
	},
	[11454] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Rebellion leader en Ubicacion: rebel_in (122, 71). No lograste persuadir a Rupert, el líder de la Rebelión. Vamos a encontrarnos con los demás primero."
		},
		Summary = "Conozcamos a los demás primero."
	},
	[11455] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Lazy en Ubicacion: rebel_in (86, 61). Has entrado en la habitación de Dien. Hablemos con Dien."
		},
		Summary = "Habla con dien"
	},
	[11456] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Dien en Ubicacion: rebel_in (164, 88). Cuando le explicaste la situación, Dien pidió un poco de tiempo para pensar. Hablemos nuevamente con Dien en un momento."
		},
		Summary = "Habla con dien"
	},
	[11457] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Dien en Ubicacion: rebel_in (164, 88). Obtuviste el permiso de Dien. Conozcamos a Est, otro anciano y comandante del batallón de fuerzas especiales."
		},
		Summary = "Habla con Est"
	},
	[11458] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Special Force commander en Ubicacion: rebel_in (210, 89). También obtuviste el permiso de Est. Hablemos con Rupert otra vez."
		},
		Summary = "Habla con Ruperto"
	},
	[11459] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Rebellion leader en Ubicacion: rebel_in (122, 71). Rupert, que leyó la carta que envió Dien, no podía creer su contenido y le pidió a Rasis que la leyera de nuevo. Confirmemos el contenido con Rasis."
		},
		Summary = "Habla con Rasis"
	},
	[11460] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (119, 68). Verificaste el contenido y no tenía nada de malo. Hablemos con Rupert otra vez."
		},
		Summary = "Habla con Ruperto"
	},
	[11461] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Rebellion leader en Ubicacion: rebel_in (122, 71). Dien apareció mientras hablabas con Rupert. Hablemos con Dien."
		},
		Summary = "Habla con dien"
	},
	[11462] = {
		Title = "rencor",
		Description = {
			"Inicio: NPC: Dien en Ubicacion: rebel_in (121, 69). Dien y Rupert, que aparecieron de repente, empezaron a pelear. Escuchemos lo que Rupert tiene que decir."
		},
		Summary = "Habla con Ruperto"
	},
	[11463] = {
		Title = "Te dije que era para los preparativos de la fiesta, ¿no?",
		Description = {
			"Inicio: NPC: Rebellion guard en Ubicacion: rebel_in (125, 44). Escuchaste algo sospechoso frente a la habitación de Dien, pero parece que no deberías decir que lo sabes. Prometiste ayudar con el recado primero, así que entremos a la habitación y hablemos con Dien."
		},
		Summary = "Habla con dien"
	},
	[11464] = {
		Title = "Te dije que era para los preparativos de la fiesta, ¿no?",
		Description = {
			"Inicio: NPC: Dien en Ubicacion: rebel_in (164, 88). Ella dice que ya le contó a Rasis sobre el asunto. Hablemos con Rasis."
		},
		Summary = "Habla con Rasis"
	},
	[11465] = {
		Title = "El coche de lujo de Dien",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (162, 87). El élder Dien de la Rebelión te pide que Julian, en la esquina noreste del campo norte de Einbroch, te deje entrar, luego derrota al Evil Heart Hunter y recupera un auto de lujo."
		},
		Summary = "El recado de Dien"
	},
	[11466] = {
		Title = "El coche de lujo de Dien",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (162, 87). Has completado el recado de Dien. Volvamos mañana."
		},
		Summary = "¡Mañana otra vez!"
	},
	[11467] = {
		Title = "La vieja carta de Reedshi",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (162, 87). El élder Reedshi de la Rebelión te pide que Julian, en la esquina noreste del campo norte de Einbroch, te deje entrar, luego elimine al Cazador de corazones mejorado y recupere una carta antigua."
		},
		Summary = "El recado de Reedshi"
	},
	[11468] = {
		Title = "La vieja carta de Reedshi",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (162, 87). Has completado el recado de Reedshi. Volvamos mañana."
		},
		Summary = "¡Mañana otra vez!"
	},
	[11469] = {
		Title = "Los anillos brillantes de Kortnes",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (162, 87). El élder Kortnes de la Rebelión te pide que Julian, en la esquina noreste del campo norte de Einbroch, te deje entrar, luego elimina a 5 Heart Hunter Guards y recupera 4 anillos brillantes."
		},
		Summary = "La misión de Kortnes"
	},
	[11470] = {
		Title = "Los anillos brillantes de Kortnes",
		Description = {
			"Inicio: NPC: Rebellion Guard leader en Ubicacion: rebel_in (162, 87). Has completado el recado de Kortnes. Volvamos mañana."
		},
		Summary = "¡Mañana otra vez!"
	},
	[11484] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Es difícil de entender, pero parece que tienes que conseguir un tallo blanco seco y volver a Jakk."
		},
		Summary = "Obtuvo un tallo blanco seco"
	},
	[11485] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Parece que el gatito sorprendido se escapó cuando capturaron a Jakk. Pregúntale a Harorong, que estaba con Jakk."
		},
		Summary = "Habla con Harorong"
	},
	[11486] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Es posible que Nibble en la entrada haya visto al gatito. Habla con Nibble en la entrada occidental de Niflheim."
		},
		Summary = "Picar en el oeste de Niflheim"
	},
	[11487] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Un pequeño objeto blanco pasó rápidamente por la entrada no hace mucho. No están seguros de si era un gato. Preguntémosle al chico que está afuera de la entrada."
		},
		Summary = "Habla con el nervioso Jakk."
	},
	[11488] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Jakk dijo que el gatito de Jakk fue al lugar llamado \"allí\". Informemos a Jakk, que está intentando encontrar al gatito."
		},
		Summary = "Habla con Jakk"
	},
	[11489] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Parece que el gatito de Jakk llegó a Midgard a través del tallo de Yggdrasil. Probablemente pasó por Umbala. Investiguemos."
		},
		Summary = "Investigación en la entrada norte de Umbala"
	},
	[11490] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"El investigador dice que le dijo al pequeño y blanco cómo llegar a Marruecos. Investiguemos la cercana entrada norte de Moroc."
		},
		Summary = "Investigación sobre la entrada de Marruecos"
	},
	[11491] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"El comerciante dice que le dijo a alguien cómo llegar a Alberta. Investiguemos la cercana entrada norte de Alberta."
		},
		Summary = "Investigación sobre la entrada de Alberta"
	},
	[11492] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Si te acercas al puerto, puedes encontrar muchos gatos que quieren quitarte el pescado. Investiguemos cerca del puerto."
		},
		Summary = "Investigación sobre el puerto de Alberta"
	},
	[11493] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"Encontraste un gato blanco, pero no se parece al gatito de Jakk. El montón de arena detrás es sospechoso. Investiguemos."
		},
		Summary = "Investigación sobre el montón de arena"
	},
	[11494] = {
		Title = "Jakk y el gato de Jakk",
		Description = {
			"En la arena encontraste huesos que parecen provenir de un animal pequeño. También encontraste un collar rojo con una campana. Volvamos a Jakk."
		},
		Summary = "Habla con Jakk en Niflheim"
	},
