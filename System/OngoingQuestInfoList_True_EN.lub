	[15110] = {
		Title = "¡Hielo con fuego!",
		Description = {
			"Inicio: NPC: cine1 en Ubicacion: ice_d03_i (152, 43). Necesitas recolectar ramas secas para derretir con fuego a Jace y Breed, congelados en la Cueva de Hielo."
		},
		Summary = "Recoge 10 ramas secas"
	},
	[15111] = {
		Title = "Cazando titanes de hielo enojados",
		Description = {
			"Siguiendo la absurda sugerencia de Breed de romper el hielo con hielo, cacemos a 10 Angry Ice Titans."
		},
		Summary = "Caza 10 titanes de hielo enojados"
	},
	[15112] = {
		Title = "¡No más hablar!",
		Description = {
			"Inicio: NPC: cine1 en Ubicacion: ice_d03_i (152, 43). No hay necesidad de esto o aquello: ¡hemos decidido simplemente aplastarlo! Golpeemos el hielo en el que está atrapado Jace."
		},
		Summary = "Rompe el hielo atrapando a Jace."
	},
	[15113] = {
		Title = "¡No más hablar!",
		Description = {
			"Inicio: NPC: cine1 en Ubicacion: ice_d03_i (152, 43). No hay necesidad de esto o aquello: ¡hemos decidido simplemente aplastarlo! Golpeemos el hielo en el que está atrapado Breed."
		},
		Summary = "Rompe la raza que atrapa el hielo."
	},
	[15114] = {
		Title = "Derrotar al extraño lagarto",
		Description = {
			"Decides vengarte del extraño lagarto que los congeló a ambos. Derribemos a Ktullanux en el centro de la cueva."
		},
		Summary = "Derrota al Ktullanux despierto"
	},
	[15115] = {
		Title = "Raza y Jace",
		Description = {
			"Inicio: NPC: cine1 en Ubicacion: ice_d03_i (152, 43). Esta misión se puede recibir nuevamente después de las 4:00 a.m."
		},
		Summary = "Hora de reinicio 4:00"
	},
	[15116] = {
		Title = "Limpia la ilusión de los congelados",
		Description = {
			"Inicio: NPC: cine1 en Ubicacion: ice_d03_i (152, 43)."
		},
		Summary = ""
	},
	[15117] = {
		Title = "Cazando a Gazeti enojado",
		Description = {
			"Siguiendo la absurda sugerencia de Breed de romper el hielo con hielo, cacemos 10 Angry Gazeti."
		},
		Summary = "Caza 10 Gazeti enojados"
	},
	[15118] = {
		Title = "Cazando a Snowier enojado",
		Description = {
			"Siguiendo la absurda sugerencia de Breed de romper el hielo con hielo, cacemos a 10 Angry Snowier."
		},
		Summary = "Caza 10 muñecos de nieve enojados"
	},
	[15119] = {
		Title = "Cazando helados endurecidos",
		Description = {
			"Siguiendo la absurda sugerencia de Breed de romper el hielo con hielo, busquemos 10 Iceicles endurecidos."
		},
		Summary = "Caza 10 helados endurecidos"
	},
	[15125] = {
		Title = "Necesito CACAO EN GRANO",
		Description = {
			"Cuida de los monstruos de Sweets Drops de campos y mazmorras. Vuelve con Charles con 20 GRANOS DE CACAO robados."
		},
		Summary = "Recoge 20 GRANOS DE CACAO robados"
	},
	[15127] = {
		Title = "Entrega de chocolates",
		Description = {
			"Entrega chocolates en orden en las tiendas de dulces Geffen, Payon, Aldebarn y Prontera."
		},
		Summary = "Entrega de chocolate a las confiterías de las grandes ciudades."
	},
	[15128] = {
		Title = "Entrega de chocolate completa",
		Description = {
			"Entrega de chocolate terminada que Charles solicitó. Puedes repetir después de las 4 AM."
		},
		Summary = "Entregar nuevamente a partir de las 4 a.m."
	},
	[15129] = {
		Title = "Limitación de sorteo diario",
		Description = {
			"El sorteo de la Tienda de Dulces sólo es posible una vez al día. Hoy ya has sacado uno, así que intentémoslo después de mañana a las 4 a.m."
		},
		Summary = "Hora fría de Darwa hasta las 4 a. m."
	},
	[16000] = {
		Title = "Aviso de Metz Brayde",
		Description = {
			"Lees un aviso en un tablero pidiendo a los aventureros que emprendan una misión única en la vida de Metz Brayde."
		},
		Summary = "encontrar Metz Brayde"
	},
	[16001] = {
		Title = "Primer examen",
		Description = {
			"Descubres que tienes que pasar por una serie de pruebas por parte de los amigos de Metz. El primer amigo está en Marruecos llamado Arian. Deberías ir allí y verlo si quieres continuar."
		},
		Summary = "arian en Marruecos"
	},
	[16002] = {
		Title = "Obteniendo artículos para Arian -1",
		Description = {
			"Trae sólo lo que te digo que traigas. Si sabes que te pediré algo más tarde y lo tienes, lo aceptaré directamente. Dame ^FF0000100 Pelusa^000000."
		},
		Summary = "100 pelusa"
	},
	[16003] = {
		Title = "Obteniendo artículos para Arian -2",
		Description = {
			"Trae sólo lo que te digo que traigas. Si sabes que te pediré algo más tarde y lo tienes, lo aceptaré directamente. Dame ^FF000050 Esporas de veneno^000000."
		},
		Summary = "50 esporas de veneno"
	},
	[16004] = {
		Title = "Obteniendo artículos para Arian -3",
		Description = {
			"Trae sólo lo que te digo que traigas. Si sabes que te pediré algo más tarde y lo tienes, lo aceptaré directamente. Dame ^FF000030 Colas de escorpión^000000."
		},
		Summary = "30 colas de escorpión"
	},
	[16005] = {
		Title = "Obteniendo artículos para Arian -4",
		Description = {
			"Trae sólo lo que te digo que traigas. Si sabes que te pediré algo más tarde y lo tienes, lo aceptaré directamente. Dame ^FF000020 vendas podridas^000000."
		},
		Summary = "20 vendas podridas"
	},
	[16006] = {
		Title = "Obteniendo artículos para Arian -5",
		Description = {
			"Trae sólo lo que te digo que traigas. Si sabes que te pediré algo más tarde y lo tienes, lo aceptaré directamente. Dame ^FF000015 Cuerno pequeño y uniforme^000000."
		},
		Summary = "15 Cuerno pequeño e igual"
	},
	[16007] = {
		Title = "Obteniendo artículos para Arian -6",
		Description = {
			"Trae sólo lo que te digo que traigas. Si sabes que te pediré algo más tarde y lo tienes, lo aceptaré directamente. Dame ^FF000010 Arrecifes de coral^000000."
		},
		Summary = "10 arrecifes de coral"
	},
	[16008] = {
		Title = "¡Hora de las pruebas!",
		Description = {
			"Habla con Ganaan para pasar a la siguiente parte del examen."
		},
		Summary = "ganaan"
	},
	[16009] = {
		Title = "El lenguaje de un belicista es la batalla",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Una revancha con Elena Volkova, que parece estar llena de expectativas. Hablemos con Elena Volkova y entremos a la sala de espera."
		},
		Summary = "Derrota a Elena Volkova"
	},
	[16010] = {
		Title = "En óptimas condiciones para la batalla",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Elena Volkova en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16011] = {
		Title = "Entra en la arena de combate",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Después de prepararte, entremos a la arena a través de Ivan Ivanov en la sala de espera de la arena."
		},
		Summary = "Entra a la arena"
	},
	[16012] = {
		Title = "Los gemelos problemáticos",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Elena Volkova tiene dolor de cabeza por los gemelos de cabello plateado que quedaron debajo de ella. Vayamos con los gemelos en su lugar y escuchémoslos."
		},
		Summary = "Ir a los gemelos Lebedev"
	},
	[16013] = {
		Title = "Testimonio: La historia del cocinero",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Escuchemos sobre los gemelos Lebedev de Milo River, el cocinero de la Rebelión."
		},
		Summary = "Ir al río Milo"
	},
	[16014] = {
		Title = "Testimonio: La historia del francotirador",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Escuchemos sobre los gemelos Lebedev de la mano de Mason Bender, el francotirador del escuadrón USU de la Rebelión."
		},
		Summary = "Ir a Mason Bender"
	},
	[16015] = {
		Title = "Intento casual",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Hablaste demasiado apresuradamente y terminaste siendo completamente ignorado. Pidamos ayuda a Elena Volkova."
		},
		Summary = "Regreso a Elena Volkova"
	},
	[16016] = {
		Title = "Tomar prestada la sabiduría de un veterano",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Vayamos con Erickson Adler, nos presentó Elena Volkova, miembro de Rebellion, y pidámosle consejo sobre los gemelos."
		},
		Summary = "Ir a Erickson Adler"
	},
	[16017] = {
		Title = "La sincera confesión de los gemelos",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Ya has oído por qué los gemelos Lebedev sólo podían ser una carga para todos. Volvamos a Elena Volkova y contemos su historia."
		},
		Summary = "Regreso a Elena Volkova"
	},
	[16018] = {
		Title = "Estrellas por tu esfuerzo",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Elena Volkova te pidió que trajeras a los gemelos. Animemos a los dos niños abatidos y traigamoslos."
		},
		Summary = "Regreso a los gemelos Lebedev"
	},
	[16019] = {
		Title = "La solución de Elena Volkova",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). ¿Quedaron los dos niños satisfechos con la solución de Elena Volkova? Una cosa es segura: te espera un futuro en el que los niños te atormentarán, aventurero."
		},
		Summary = ""
	},
	[16020] = {
		Title = "Cuidando niños día tras día",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Yana Lebedeva en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16021] = {
		Title = "Servicio: Préstamo de libros",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Tomemos prestado '^0000CDDizzy from a Thousand Years of Swaying^000000' del joven bibliotecario adulto de la Biblioteca Prontera. El nuevo libro más candente del gran maestro Budeulbudeul, que se ha mecido en el viento del río durante mil años."
		},
		Summary = "Visita la Biblioteca Prontera"
	},
	[16022] = {
		Title = "Servicio: Préstamo de libros",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Tomemos prestado '^0000CDRebellion: Una historia de libertad^000000' del joven bibliotecario de la Biblioteca Prontera. ¡La historia de libertad y excesos de los rebeldes pícaros de mediana edad de Rebellion, transmitida a través de los siglos!"
		},
		Summary = "Visita la Biblioteca Prontera"
	},
	[16023] = {
		Title = "Servicio: Préstamo de libros",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Tomemos prestado '^0000CDNogrod Horizon^000000' del joven bibliotecario de la Biblioteca Prontera. Un conmovedor ensayo de no ficción que describe maravillosamente la ecología de las criaturas que viven en Nogrod."
		},
		Summary = "Visita la Biblioteca Prontera"
	},
	[16024] = {
		Title = "Servicio: Entrega del libro prestado",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Tomaste prestado el libro de la Biblioteca Prontera sin ningún problema. Llevémoslo con cuidado a los gemelos Lebedev de la Rebelión para que no se pierda. Lo devolverán ellos mismos, ¿verdad?"
		},
		Summary = "Regreso a los gemelos"
	},
	[16025] = {
		Title = "Servicio: Encuesta previa a Mine Dungeon",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Un estudio previo a la expedición minera de los gemelos Lebedev. Busquemos ^0000CD30 Pitman^000000 y llevemos ^0000CD1 Gunpowder^000000 a los gemelos."
		},
		Summary = "30 Pitman y 1 pólvora"
	},
	[16026] = {
		Title = "Servicio: Encuesta previa a Mine Dungeon",
		Description = {
			"Inicio: NPC: Jana Levedeva en Ubicacion: rebel_in (109, 54). Un estudio previo a la expedición minera de los gemelos Lebedev. Busquemos ^0000CD20 venenosos y 20 nocivos^000000 y llevemos ^0000CD1 polvo explosivo^000000 a los gemelos."
		},
		Summary = "20 polvos venenosos, 20 nocivos y 1 explosivo"
	},
	[16027] = {
		Title = "Servicio: Entrega de galletas",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Los gemelos Lebedev quieren repartir las galletas que hornearon con tanta torpeza a la gente de Rebellion. Llevemos galletas calientes al río Milo."
		},
		Summary = "Entregar galletas al río Milo"
	},
	[16028] = {
		Title = "Servicio: Entrega de galletas",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Los gemelos Lebedev quieren repartir las galletas que hornearon con tanta torpeza a la gente de Rebellion. Llevémosle galletas calientes a Mason Bender."
		},
		Summary = "Entregar galletas a Mason Bender"
	},
	[16029] = {
		Title = "Servicio: Entrega de galletas",
		Description = {
			"Inicio: NPC: Rachel Smith en Ubicacion: rebel_in (90, 51). Los gemelos Lebedev quieren repartir las galletas que hornearon con tanta torpeza a la gente de Rebellion. Llevémosle galletas calientes a Rachel Smith."
		},
		Summary = "Entregar galletas a Rachel Smith"
	},
	[16030] = {
		Title = "Servicio: Entrega de galletas",
		Description = {
			"Inicio: NPC: Ericsson Adler en Ubicacion: rebel_in (91, 67). Los gemelos Lebedev quieren repartir las galletas que hornearon con tanta torpeza a la gente de Rebellion. Llevémosle galletas calientes a Erickson Adler."
		},
		Summary = "Entregar galletas a Erickson Adler"
	},
	[16031] = {
		Title = "Servicio: Entrega de galletas",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Los gemelos Lebedev quieren repartir las galletas que hornearon con tanta torpeza a la gente de Rebellion. Llevémosle galletas calientes a Elena Volkova."
		},
		Summary = "Entregar galletas a Elena Volkova"
	},
	[16032] = {
		Title = "Refrescos para los mayores",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Milo River busca un postre dulce para servir a los Ancianos. Para ayudarlo, llevemos un artículo de ^0000CDTé de hierbas con jugo de uva, té negro de diez mil hojas, té de miel con hierbas, pastel de mousse de chocolate o mezcla de frutas^000000."
		},
		Summary = "Trae un plato al río Milo"
	},
	[16033] = {
		Title = "Sólo cosas dulces y un oído atento",
		Description = {
			"Inicio: NPC: Ericsson Adler en Ubicacion: rebel_in (91, 67). Erickson Adler preparó galletas que huelen bien para que las compartas con los gemelos Lebedev. Tome las galletas y esta vez escuchemos con la suficiente atención para consolar los corazones de los gemelos."
		},
		Summary = "Regreso a los gemelos Lebedev"
	},
	[16034] = {
		Title = "Galletas dulces una vez al día",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través del río Milo en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16035] = {
		Title = "Entrega: Revólver explosivo",
		Description = {
			"Inicio: NPC: Rachel Smith en Ubicacion: rebel_in (90, 51). Entreguemos rápidamente este revólver, que es como una bomba de tiempo que se estropea constantemente, al gremio de herreros de Einbroch."
		},
		Summary = "Consulta en el Gremio de Herreros de Einbroch"
	},
	[16036] = {
		Title = "Tomar prestado el ojo agudo de un veterano",
		Description = {
			"Inicio: NPC: Blacksmith Jack en Ubicacion: ein_in01 (38, 21). Transmitamos lo que aprendimos del Blacksmith Guild a Rachel Smith."
		},
		Summary = "Visita a Raquel Smith"
	},
	[16037] = {
		Title = "La adquisición de materiales se realiza una vez al día",
		Description = {
			"Inicio: NPC: Rachel Smith en Ubicacion: rebel_in (90, 51). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Rachel Smith en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16038] = {
		Title = "Adquirir 2 Oridecon",
		Description = {
			"Inicio: NPC: Rachel Smith en Ubicacion: rebel_in (90, 51). Prepare el ^0000CD2 Oridecon^000000 que solicitó Rachel Smith."
		},
		Summary = "Adquirir 2 Oridecon"
	},
	[16039] = {
		Title = "Consigue 2 elunium",
		Description = {
			"Inicio: NPC: Rachel Smith en Ubicacion: rebel_in (90, 51). Prepare el ^0000CD2 Elunium^000000 que solicitó Rachel Smith."
		},
		Summary = "Consigue 2 elunium"
	},
	[16040] = {
		Title = "Consigue 5 hierros.",
		Description = {
			"Inicio: NPC: Rachel Smith en Ubicacion: rebel_in (90, 51). Prepare el ^0000CD5 Iron^000000 que solicitó Rachel Smith."
		},
		Summary = "Consigue 5 hierros."
	},
	[16041] = {
		Title = "Investigación: Operación Atrapar al gato paseante",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Charity, la gata paseante de la base Rebellion, todavía no ha aparecido a pesar de que ya pasó la hora de comer. Paseemos por los ^0000CDEmpty Banks de Einbech^000000 y atráigamoslo con galletas de anchoa."
		},
		Summary = "Recuperar a Charity de Einbech"
	},
	[16042] = {
		Title = "La caridad se lo está tomando con calma",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través del río Milo en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16043] = {
		Title = "Investigación: Operación Atrapar el Objeto del Deseo",
		Description = {
			"Inicio: NPC: Milo River en Ubicacion: rebel_in (108, 27). Milo River parece tener tantas ganas de acariciar a Charity que no puede soportarlo. No parece probable que le haga nada malo al gato, así que vayamos por los ^0000CDEmpty Benches de Einbech^000000 como antes y vayamos a pescar gatos con galletas de anchoa."
		},
		Summary = "Recuperar a Charity de Einbech"
	},
	[16044] = {
		Title = "La caridad está en el lugar de la caridad",
		Description = {
			"Inicio: NPC: Empty bench en Ubicacion: einbech (34, 209). ¡Encontraste a Caridad! Recojamos rápidamente a Charity, que está demasiado ocupada devorando galletas de anchoas para darnos cuenta, y llevémosla al río Milo."
		},
		Summary = "Regreso a Milón"
	},
	[16045] = {
		Title = "Un pequeño monumento a los veteranos",
		Description = {
			"Inicio: NPC: Ericsson Adler en Ubicacion: rebel_in (91, 67). Erickson Adler te pidió que compraras flores al chico que vendía flores cerca y las pusieras debajo del pequeño cartel al sur del mirador de Einbroch. Vayamos a Einbroch para acceder a su petición."
		},
		Summary = "Coloque flores junto al cartel debajo del árbol en Einbroch."
	},
	[16046] = {
		Title = "Reunir materiales para ramos de bricolaje",
		Description = {
			"Inicio: NPC: Flower Girl en Ubicacion: einbroch (167, 160). La vendedora de flores de Einbech dice que se han acabado los materiales para el ramo y le pide que los recoja usted mismo. Reunamos ^0000CD3 hojas de papel liso^000000 y regresemos."
		},
		Summary = "Reúna 3 hojas de papel liso"
	},
	[16047] = {
		Title = "Un rito conmemorativo tranquilo",
		Description = {
			"Inicio: NPC: Flower Girl en Ubicacion: einbroch (167, 160). Recibiste un ramo del niño vendedor de flores. Coloquémoslo ^0000CDantes del pequeño cartel debajo del árbol^000000."
		},
		Summary = "Coloca el ramo debajo del árbol."
	},
	[16048] = {
		Title = "Rastros de una historia muy, muy antigua",
		Description = {
			"Inicio: NPC: Huge Tree en Ubicacion: einbroch (162, 153). Probablemente hayas escuchado una historia muy, muy larga. El recado ha terminado, así que informemos a Erickson Adler."
		},
		Summary = "Volver a Erickson Adler"
	},
	[16049] = {
		Title = "El amanecer tranquilo",
		Description = {
			"Inicio: NPC: Ericsson Adler en Ubicacion: rebel_in (91, 67). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Erickson Adler en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16050] = {
		Title = "Tiempo para recordar",
		Description = {
			"Inicio: NPC: Ericsson Adler en Ubicacion: rebel_in (91, 67). Erickson Adler le ha pedido una vez más que compre flores al chico que vende flores que hay cerca y que las coloque bajo el pequeño cartel al sur del mirador de Einbroch. Vayamos a Einbroch para acceder a su petición."
		},
		Summary = "Coloque flores junto al cartel debajo del árbol en Einbroch."
	},
	[16051] = {
		Title = "Reunir materiales para ramos de bricolaje",
		Description = {
			"Inicio: NPC: Flower Girl en Ubicacion: einbroch (167, 160). La vendedora de flores de Einbech dice que hoy se han acabado los materiales para el ramo y le pide que los recoja usted mismo. Reunamos ^0000CD3 hojas de papel liso^000000 y regresemos."
		},
		Summary = "Reúna 3 hojas de papel liso"
	},
	[16052] = {
		Title = "Un rito conmemorativo tranquilo",
		Description = {
			"Inicio: NPC: Flower Girl en Ubicacion: einbroch (167, 160). También hoy has decidido dejar un ramo ^0000CD delante del pequeño cartel debajo del árbol^000000 y volver. Que en paz descanse la joven que falleció tan temprano."
		},
		Summary = "Coloca el ramo debajo del árbol."
	},
	[16053] = {
		Title = "Una vieja historia que continuará",
		Description = {
			"Inicio: NPC: Huge Tree en Ubicacion: einbroch (162, 153). Has terminado el recado. Informemos a Erickson Adler."
		},
		Summary = "Volver a Erickson Adler"
	},
	[16054] = {
		Title = "Una estrategia publicitaria diferenciada",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Mason Bender te pide que repartas a la gente de Einbech el folleto de la tienda de armas que escribió con cada gramo de su habilidad literaria."
		},
		Summary = "Repartir los folletos en Einbech"
	},
	[16055] = {
		Title = "Anuncio: ¿Quieres una ciudad limpia?",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Le entregaste el volante, escrito con una caligrafía innecesariamente elegante, a ^0000CDel hombre de aspecto cansado^000000."
		},
		Summary = "Dáselo al hombre de aspecto cansado."
	},
	[16056] = {
		Title = "Anuncio: ¡Entonces sóplalo todo!",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Empujaste a la fuerza el folleto, impreso en papel innecesariamente caro, en las manos del ^0000CDel anciano de aspecto exhausto^000000."
		},
		Summary = "Dáselo al anciano de aspecto exhausto."
	},
	[16057] = {
		Title = "Anuncio: ¡Excelente también para vengarte de tu antiguo enemigo!",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Doblaste el volante, impreso con tinta innecesariamente colorida, formando un abanico y se lo ofreciste a ^0000CD, la anciana de aspecto somnoliento^000000."
		},
		Summary = "Dáselo a la anciana de aspecto somnoliento."
	},
	[16058] = {
		Title = "La publicidad lleva tiempo",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Mason Bender en Klana Nemieli."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[16059] = {
		Title = "Una estrategia publicitaria poco a poco diferenciada",
		Description = {
			"Inicio: NPC: Mason Bender en Ubicacion: rebel_in (19, 48). Mason Bender no se ha rendido y parece que está a punto de repartir folletos una vez más. Quizás sería mejor simplemente ahorrarse los costos de impresión de folletos..."
		},
		Summary = "Repartir los folletos en Einbech"
	},
	[16060] = {
		Title = "El lenguaje de un belicista es la batalla",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Elena lo está estudiando de cerca con una mirada de interés. Hablemos con Elena y entremos a la sala de espera."
		},
		Summary = "Derrota a Elena Volkova"
	},
	[16061] = {
		Title = "Una pelea justa y equitativa",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: rebel_in (70, 78). Luchas contra Elena uno a uno."
		},
		Summary = ""
	},
	[16062] = {
		Title = "Gen de Niflheim",
		Description = {
			"Crayu dice que necesitas hablar con alguien en Niflheim llamado ^FF0000Gen^000000."
		},
		Summary = "generación"
	},
	[16063] = {
		Title = "La ayuda de la bruja",
		Description = {
			"Gen sugiere que vayas a ver a la bruja y le pidas que te ayude. También añadió que hay que tener cuidado con Serin."
		},
		Summary = ""
	},
	[16064] = {
		Title = "Desgracia de Niflheim",
		Description = {
			"Serin dice que deberías hablar con algunas personas de Niflheim y ver si puedes serles de alguna ayuda."
		},
		Summary = ""
	},
	[16065] = {
		Title = "El símbolo de la reina",
		Description = {
			"Debes ganarte el favor de la reina para poder obtener el Símbolo de los Nueve Reinos. Descubra dónde ha sido sellada su madre perdida, Agrboda, preguntando a otros si saben algo sobre ella."
		},
		Summary = "Agrboda"
	},
	[16066] = {
		Title = "Conocimiento del símbolo",
		Description = {
			"Serin dijo que deberías ser alguien que haya vivido en Asgard y que pueda saber más sobre dónde está sellado Agrboda."
		},
		Summary = ""
	},
	[16067] = {
		Title = "Conocimiento de Asgard",
		Description = {
			"Valkyrie no pudo proporcionarle ninguna respuesta. Quizás alguien en Niflheim pueda ayudarte con tu búsqueda de Agrboda."
		},
		Summary = "Niflheim"
	},
	[16068] = {
		Title = "Encontrar las piezas del alma",
		Description = {
			"Laichin te ha dado instrucciones sobre cómo encontrar las 4 piezas de alma de Agrboda. Pero, ¿qué quiere decir con \"grande\" o \"pequeño\" y qué? Será mejor que le pidas una aclaración."
		},
		Summary = "Laichin"
	},
	[16069] = {
		Title = "Encontrar las piezas del alma",
		Description = {
			"En grande, mire cerca del borde del mapa. Para los pequeños, mire entre el borde y el centro. Para muy pequeños, busque cerca del centro. Echa un vistazo a la 1 grande, a las 5 grandes, a las 7 grandes y a las 6 pequeñas."
		},
		Summary = "Mazmorra de Glastheim - Sello de Agrboda"
	},
	[16070] = {
		Title = "Encontrar las piezas del alma",
		Description = {
			"En grande, mire cerca del borde del mapa. Para los pequeños, mire entre el borde y el centro. Para muy pequeños, busque cerca del centro. Echa un vistazo a las 4 grandes, a las 10 grandes, a las 6 pequeñas y a las 11 muy pequeñas."
		},
		Summary = "Mazmorra de Glastheim - Sello de Agrboda"
	},
	[16071] = {
		Title = "Encontrar las piezas del alma",
		Description = {
			"En grande, mire cerca del borde del mapa. Para los pequeños, mire entre el borde y el centro. Para muy pequeños, busque cerca del centro. Echa un vistazo a las 5 grandes, a las 11 pequeñas, a las 6 pequeñas y a las 11 muy pequeñas."
		},
		Summary = "Mazmorra de Glastheim - Sello de Agrboda"
	},
	[16072] = {
		Title = "Encontrar las piezas del alma",
		Description = {
			"En grande, mire cerca del borde del mapa. Para los pequeños, mire entre el borde y el centro. Para muy pequeños, busque cerca del centro. Echa un vistazo a las 4 grandes, las 5 grandes, las 10 grandes y las 11 pequeñas."
		},
		Summary = "Mazmorra de Glastheim - Sello de Agrboda"
	},
	[16073] = {
		Title = "El alma de Agrboda",
		Description = {
			"Has recuperado todas las piezas del alma de Agrboda. Escuchas una voz que te habla directamente: \"Estoy... dejando mi alma contigo. Por favor, guíame hasta la reina de los muertos...\""
		},
		Summary = ""
	},
	[16074] = {
		Title = "Símbolo de los Nueve Reinos",
		Description = {
			"Lady Hell te ha recompensado con el Símbolo de los Nueve Reinos. ¿A quién debo decirle primero...?"
		},
		Summary = ""
	},
	[16075] = {
		Title = "Las ambiciones de Serin",
		Description = {
			"Kirkena te ha dicho que Serin tiene la intención de hacer un trato con el Señor Oscuro para permanecer en el mundo de los vivos. Debes darle el tónico de bruja para que olvide sus retorcidas ambiciones."
		},
		Summary = ""
	},
	[16076] = {
		Title = "Tónico de bruja",
		Description = {
			"Kirkena te ha dado el tónico de bruja y te enviará a la ubicación de Serin para que puedas borrar sus recuerdos."
		},
		Summary = ""
	},
	[16077] = {
		Title = "La liberación de Serin",
		Description = {
			"Le has dado exitosamente el tónico de bruja a Serin y ella ya no intentará convocar al Señor Oscuro. Deberías contarle a Kirkena tu éxito."
		},
		Summary = ""
	},
	[16078] = {
		Title = "Visita con Lady Hell",
		Description = {
			"Inicio: NPC: Mrs. Cacturon en Ubicacion: rockrdg1 (341, 133). Kirkena dice que Lady Hell quiere verte por alguna razón..."
		},
		Summary = ""
	},
	[16079] = {
		Title = "El signo",
		Description = {
			"Inicio: NPC: Mrs. Cacturon en Ubicacion: rockrdg1 (341, 133). Has sido recompensado con \"La Señal\", que mostrará a todos los demás que eres un gran guerrero cuyo coraje fue puesto a prueba por los propios dioses. ¿A quién debería mostrarle esto primero?"
		},
		Summary = ""
	},
	[16080] = {
		Title = "El regreso del Señor Oscuro",
		Description = {
			"Inicio: NPC: Mrs. Cacturon en Ubicacion: rockrdg1 (341, 133). No has podido evitar que Serin convoque al Señor Oscuro. Será mejor que le digas a Kirkena que fallaste en tu misión."
		},
		Summary = ""
	},
	[16081] = {
		Title = "Las ambiciones de Serin",
		Description = {
			"Serin te dijo que Kirkena está intentando convocar al Señor Oscuro a Rune Midgard. Debes encontrar una manera de evitar que esto suceda."
		},
		Summary = ""
	},
	[16082] = {
		Title = "El regreso del Señor Oscuro",
		Description = {
			"Inicio: NPC: Suspicious Sand Mound en Ubicacion: rockrdg1 (182, 124). Probablemente deberías decirle a Metz que fallaste en tu misión."
		},
		Summary = "Metz en Prontera"
	},
	[16083] = {
		Title = "La realización de Serin",
		Description = {
			"Inicio: NPC: Wasteland Cactuten en Ubicacion: rockrdg1 (146, 164). Has detenido los ambiciosos planes de Serin. Deberías contarle a la bruja Kirkena lo que te pasó en Niflheim."
		},
		Summary = "kirkena"
	},
	[16084] = {
		Title = "El signo",
		Description = {
			"Metz dice que The Sign se puede usar para ingresar a Valhalla, pero que primero debes ver a Engel Howard, quien es la única persona en Rune Midgard que sabe cómo manejarlo."
		},
		Summary = "Engel Howard"
	},
	[16085] = {
		Title = "El signo",
		Description = {
			"Inicio: NPC: Curious Coyote en Ubicacion: rockrdg1 (195, 183). Engel Howard ha terminado de trabajar con The Sign. Le dice que es un honor que le hayan dado la oportunidad de trabajar con él. Enséñaselo a Metz para que sepa que tu trabajo está hecho."
		},
		Summary = "Metz"
	},
	[16086] = {
		Title = "El signo",
		Description = {
			"Espere a que Metz termine su examen de The Sign. Sólo debería llevar un par de horas."
		},
		Summary = "Regreso a Metz una vez transcurrido el tiempo"
	},
	[16087] = {
		Title = "El signo",
		Description = {
			"Inicio: NPC: Cactus Girl en Ubicacion: rockrdg1 (305, 200). Espere a que Engel complete su trabajo con The Sign y regrese después del tiempo asignado."
		},
		Summary = "Regresa a Engel después de que el cronómetro haya expirado."
	},
	[16088] = {
		Title = "Coyote descubierto",
		Description = {
			"Inicio: NPC: Absorbed Coyote en Ubicacion: rockrdg1 (266, 219)."
		},
		Summary = ""
	},
