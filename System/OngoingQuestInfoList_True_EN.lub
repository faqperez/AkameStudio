	[7349] = {
		Title = "Participación en el voto",
		Description = {
			"Inicio: NPC: Revoting Manager en Ubicacion: prt_gld (164, 98). Votaste en la elección adicional para elegir el escondite para la conexión Dimensional Rift. No puede volver a votar hasta que finalicen las elecciones."
