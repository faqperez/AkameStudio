	[11502] = {
		Title = "Los días divertidos de Jack y Jack",
		Description = {
			"Trajiste a Jack a Nifflheim. Según los fantasmas, si Jack permanece demasiado tiempo en la tierra de los vivos, le crecerán tallos, así que dejémosle descansar bien."
