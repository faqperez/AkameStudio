	[12225] = {
		Title = "Insectos portadores de frutas",
		Description = {
			"Inicio: NPC: Elephantine en Ubicacion: mora (133, 80). Me gustaría que los sacaras tal como los ves, antes de que intenten vender algo a los aventureros perdidos en el bosque."
		},
		Summary = "Caza 3 arañas pompones"
	},
	[12226] = {
		Title = "Cazadores floridos",
		Description = {
			"Inicio: NPC: Elephantine en Ubicacion: mora (133, 80). Aún no se han reportado víctimas, pero no estaría de más tomar precauciones. Por favor trátelos apropiadamente."
		},
		Summary = "Caza 4 mantis de Angra"
	},
	[12227] = {
		Title = "Pequeño pero feroz...",
		Description = {
			"Inicio: NPC: Elephantine en Ubicacion: mora (133, 80). No parecían tan feroces... pero el aventurero me ha pedido que me deshaga de ellos, así que tendrás que hacerlo tú."
		},
		Summary = "Caza 5 Parus"
	},
	[12228] = {
		Title = "Un rencor desconocido",
		Description = {
			"Inicio: NPC: Elephantine en Ubicacion: mora (133, 80). No sé qué rencor le guarda a las hadas, pero una petición es una petición."
		},
		Summary = "Caza 6 pequeños Fatum"
	},
	[12229] = {
		Title = "rubia ann",
		Description = {
			"Inicio: NPC: Elephantine en Ubicacion: mora (133, 80). No parecen tan peligrosos, pero se dice que roban libros y dulces a los aventureros. Por favor trátelos apropiadamente."
		},
		Summary = "Caza 7 mímica"
	},
	[12230] = {
		Title = "Solicitar temporizador",
		Description = {
			"Inicio: NPC: Elephantine en Ubicacion: mora (133, 80). Elephantine no tiene más tareas disponibles hoy."
		},
		Summary = "Espere a que expire el temporizador"
	},
	[12231] = {
		Title = "Material para el conservante",
		Description = {
			"Inicio: NPC: Bow-wow en Ubicacion: mora (119, 103). *sonrisa* Nada menos que... ¡Sentidores de insectos! El comerciante de artículos generales me pidió que le consiguiera cuatro. Yo personalmente no lo comería por nada del mundo..."
		},
		Summary = "Recoge 4 antenas de insectos"
	},
	[12232] = {
		Title = "Un símbolo de resistencia",
		Description = {
			"Inicio: NPC: Bow-wow en Ubicacion: mora (119, 103). Corazones Inmortales parece estar de moda últimamente. El comerciante de bienes generales me pidió que consiguiera cinco de ellos."
		},
		Summary = "Recoge 5 corazones inmortales"
	},
	[12233] = {
		Title = "Material para botiquines de primeros auxilios",
		Description = {
			"Inicio: NPC: Bow-wow en Ubicacion: mora (119, 103). Necesitan toneladas de vendajes podridos para hacer vendajes de primeros auxilios. Se deben haber quedado sin materiales nuevos. El cliente es el comerciante de bienes generales de allí. Tres manojos serán suficientes."
		},
		Summary = "Recoge 1 vendaje podrido"
	},
	[12234] = {
		Title = "Símbolos de coraje",
		Description = {
			"Inicio: NPC: Bow-wow en Ubicacion: mora (119, 103). El comerciante de bienes generales me pidió que consiguiera tres vales orcos, que se utilizarán para crear símbolos de valentía."
		},
		Summary = "Recoge 3 vales orcos"
	},
	[12235] = {
		Title = "Bueno para la resistencia...",
		Description = {
			"Inicio: NPC: Bow-wow en Ubicacion: mora (119, 103). El comerciante de bienes generales me pidió que consiguiera tres Skel-Bones, que se usarán para hacer tónico."
		},
		Summary = "Recoge 3 huesos de esqueleto"
	},
	[12236] = {
		Title = "La última tendencia en talismanes",
		Description = {
			"Inicio: NPC: Woof-grrr en Ubicacion: mora (124, 108). Los recuerdos sirven de inspiración para los diseñadores de esos casos. El comerciante de materias primas que estaba frente a mí me pidió que le comprara dos."
		},
		Summary = "Recoge 2 recuerdos"
	},
	[12237] = {
		Title = "Mantenga sus objetos de valor seguros",
		Description = {
			"Inicio: NPC: Woof-grrr en Ubicacion: mora (124, 108). El comerciante de materias primas que tengo enfrente parece fabricar fundas protectoras con conchas. Me pidieron que consiguiera tres de ellos."
		},
		Summary = "Recoge 3 conchas"
	},
	[12238] = {
		Title = "Material para espinilleras",
		Description = {
			"Inicio: NPC: Woof-grrr en Ubicacion: mora (124, 108). El comerciante de productos básicos frente a mí me pidió que consiguiera tres Scale Shells, que se usarán para hacer espinilleras."
		},
		Summary = "Recoge 3 conchas de escamas"
	},
	[12239] = {
		Title = "Veneno por veneno...",
		Description = {
			"Inicio: NPC: Woof-grrr en Ubicacion: mora (124, 108). El comerciante de productos básicos frente a mí me pidió que consiguiera dos Venom Canines, que se utilizarán en la investigación de la sustancia."
		},
		Summary = "Recoge 2 caninos venenosos."
	},
	[12240] = {
		Title = "No resbale ni caiga",
		Description = {
			"Inicio: NPC: Woof-grrr en Ubicacion: mora (124, 108). El comerciante de productos básicos frente a mí me encargó que consiguiera cinco gotas de Sticky Mucus."
		},
		Summary = "Recoge 5 mocos pegajosos"
	},
	[12241] = {
		Title = "Solicitar temporizador",
		Description = {
			"Inicio: NPC: Bow-wow en Ubicacion: mora (119, 103). No hay más tareas disponibles hoy en Bow-wow"
		},
		Summary = "Espere a que expire el temporizador"
	},
	[12242] = {
		Title = "Solicitar temporizador",
		Description = {
			"Inicio: NPC: Woof-grrr en Ubicacion: mora (124, 108). No hay más tareas disponibles hoy desde Woof-grrr"
		},
		Summary = "Espere a que expire el temporizador"
	},
	[12243] = {
		Title = "Información sobre la persona desaparecida Tazar",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). 32 años. Proviene de Midgard. Ha estado desaparecido durante 3 meses desde que fue al Laberinto del Bosque Brumoso para recolectar las plantas nativas. No es probable que sobreviva."
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor del 13, 10"
	},
	[12244] = {
		Title = "Información sobre la persona desaparecida Nigel",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). 19 años. Aventurero que llegó en barco desde un lugar lejano y desconocido. Ha estado desaparecido durante 2 meses desde que fue a explorar Maze vestido con medias finas a pesar de las protestas de todos los residentes de Mora."
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor del 10, 24"
	},
	[12245] = {
		Title = "Información sobre la persona desaparecida Messil",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). Edad desconocida. Tiene una pequeña enfermedad mental. Fue solo para purificar el Laberinto del Bosque Brumoso."
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor del 14, 24"
	},
	[12246] = {
		Title = "Información sobre la persona desaparecida Noirit",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). 51 años. Solía ser un gran ladrón que robaba espadas famosas de todo el mundo. Ha desaparecido en el Laberinto después de ser perseguido por administrar un casino ilegal que causó muchas víctimas en sus últimos años."
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor del 19, 27"
	},
	[12247] = {
		Title = "Información sobre la persona desaparecida Pyjama Sin",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). 22 años. Piloto cadete de dirigible. Ha desaparecido durante su permiso mientras bebía en el pueblo de Mora. Se rumorea que huyó después de firmar en alguna parte. Lleva 4 meses desaparecido. Pocas posibilidades de supervivencia."
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor de 30, 32"
	},
	[12248] = {
		Title = "Información sobre la persona desaparecida Mendel^",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). Edad desconocida. Una mujer de pelo largo vestida de negro. Realice una expedición al bosque de Maze en busca de la vida eterna. Lleva 3 meses desaparecido. Pocas posibilidades de supervivencia."
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor de 33, 28"
	},
	[12249] = {
		Title = "Información sobre la persona desaparecida Milebit",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). Edad alrededor de 50 años. Actual alcalde del pueblo de Mora. Se escapó al Bosque del Laberinto después de ser descubierto por embolsarse ganancias haciendo trampa en la residencia. Supervivencia incierta"
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor de 33, 17"
	},
	[12250] = {
		Title = "Información sobre la persona desaparecida Kunmoon",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). 29 años. Un joven de antecedentes desconocidos. Huyó al bosque del laberinto después de estafar 1200 monedas de Mora a los residentes de Mora mientras pretendía iniciar muchos negocios y adaptarse en Mora. Supervivencia incierta"
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor de 28, 8"
	},
	[12251] = {
		Title = "Información sobre la persona desaparecida Chaihokin",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). 34 años. Coqueteó con varias mujeres en Mora. Los aldeanos de Mora huyeron al bosque del laberinto. Supervivencia incierta"
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor del 17, 5"
	},
	[12252] = {
		Title = "Información sobre la persona desaparecida Tual",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). Edad desconocida. Desapareció con monedas que estaban controladas conjuntamente por los aldeanos. Pocas posibilidades de supervivencia"
		},
		Summary = "Busca en el bosque del laberinto de niebla alrededor del 11, 4"
	},
	[12253] = {
		Title = "Solicitar temporizador",
		Description = {
			"Inicio: NPC: Soul Guide en Ubicacion: mora (170, 101). No hay más tareas disponibles hoy en Soul Guide"
		},
		Summary = "Espere a que expire el temporizador"
	},
	[12254] = {
		Title = "ahora esta limpiando",
		Description = {
			"Inicio: NPC: Missing, the Cleaner en Ubicacion: mal_in01 (160, 34). Ahora es el momento de limpiar. Por favor concéntrate en un lugar antes de que termine el tiempo."
		},
		Summary = "Limpiar la alcantarilla en 1 hora."
	},
