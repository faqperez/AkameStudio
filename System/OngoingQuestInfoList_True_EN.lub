	[7090] = {
		Title = "Entrega de arroz: nuevamente la próxima vez",
		Description = {
			"Los clientes de la tienda de arroz reciben arroz regularmente todos los días, por lo que siempre tienen pocas manos. Después de que haya pasado un día, es posible que pueda recibir más trabajo."
		},
		Summary = ""
	},
	[7091] = {
		Title = "El consejo de Daora",
		Description = {
			"Inicio: NPC: Daora en Ubicacion: job3_guil01 (82, 95). Trovan es un Vigilante en Veins, Crave es un comerciante en la tienda de herramientas y Madelle es una camarera en el pub. Pregúntales sobre cualquier extraño en la ciudad."
		},
		Summary = ""
	},
	[7092] = {
		Title = "El consejo de Daora",
		Description = {
			"Inicio: NPC: Daora en Ubicacion: job3_guil01 (82, 95). Encuentra una chica cerca del centro de Veins que sepa cómo encontrar gente."
		},
		Summary = ""
	},
	[7093] = {
		Title = "El consejo de Daora",
		Description = {
			"Inicio: NPC: Daora en Ubicacion: job3_guil01 (82, 95). El callejón sin salida está en algún lugar de la parte noreste de Veins, donde la calle se vuelve estrecha."
		},
		Summary = ""
	},
	[7094] = {
		Title = "El consejo de Daora",
		Description = {
			"Inicio: NPC: Daora en Ubicacion: job3_guil01 (82, 95). Si quieres saber sobre la llave, ve con Rachel y encuentra al artesano de llaves llamado Oresa. Está en un edificio en la parte suroeste de Rachel."
		},
		Summary = ""
	},
	[7095] = {
		Title = "El consejo de Daora",
		Description = {
			"Inicio: NPC: Daora en Ubicacion: job3_guil01 (82, 95). Estoy seguro de que habrá una villa alrededor de Veins. que es un campo ubicado al noroeste de Venas y hay una quebrada dirigida al noreste. tal vez esa sea la forma que desees."
		},
		Summary = ""
	},
	[7096] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Un certificado de calificación para convertirse en Cruz de Guillotina reconocido por Mayshell. Completaste la tarea especial con un rango \"A\"."
		},
		Summary = "Mostrar el certificado a Bercasell"
	},
	[7097] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Un certificado de calificación para convertirse en Cruz de Guillotina reconocido por Mayshell. Completaste la tarea especial con un rango \"B\"."
		},
		Summary = "Mostrar el certificado a Bercasell"
	},
	[7098] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Un certificado de calificación para convertirse en Cruz de Guillotina reconocido por Mayshell. Completaste la tarea especial con un rango \"C\"."
		},
		Summary = "Mostrar el certificado a Bercasell"
	},
	[7099] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Un certificado de calificación para convertirse en Cruz de Guillotina reconocido por Mayshell. Completaste la tarea especial con un rango de \"S\"."
		},
		Summary = "Mostrar el certificado a Bercasell"
	},
	[7100] = {
		Title = "Un mensaje de Bercascell",
		Description = {
			"Es trivial pero ofreceremos que este equipo perteneció a un gremio. No olvides conseguirlo más tarde... pero no estoy seguro de cuándo estará listo... te lo daré. no lo olvides."
		},
		Summary = "A veces conocemos a Bercascell."
	},
	[7101] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Guild Member en Ubicacion: que_job01 (75, 96). Ahcart ha enviado un mensaje al gremio de asesinos de Veins de que irás allí. Encuentra el pub en Veins y habla con Daora."
		},
		Summary = "Encuentra la rama de Veins del Assassin Guild"
	},
	[7102] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Baja al sótano del pub Veins y habla con Mayshell. Ella te dará más detalles sobre la tarea especial."
		},
		Summary = "Habla con Mayshell"
	},
	[7103] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Tu primera tarea es encontrar un extranjero en Veins. Pregúntale a Daora en el pub si tiene información sobre el extraño."
		},
		Summary = ""
	},
	[7104] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: veins (223, 180). Melissa dice que la chica que busca se llama Estillda. Dijo que Estillda pasará por un callejón sin salida en el extremo noreste de Veins en una hora."
		},
		Summary = "Espera 15 minutos y encuentra a Estillda."
	},
	[7105] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: veins (223, 180). Estillda se escapó pero todavía está por aquí en alguna parte. Asegúrate de estar solo e intenta atraparla nuevamente en 5 minutos."
		},
		Summary = ""
	},
	[7106] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: veins (223, 180). Encontraste a Estillda. Después de calmarla, le dijiste cómo llegar al pub de Daora. Vuelve al pub y habla con Daora."
		},
		Summary = ""
	},
	[7107] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Estillda dijo que se supone que se reunirá con el hombre para el que trabaja en 30 minutos en un almacén cerca de la entrada sur de Veins."
		},
		Summary = ""
	},
	[7108] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Encontraste una llave de mansión del diente de león muerto. Descubra para qué sirve esa clave e infórmeselo a Mayshell."
		},
		Summary = ""
	},
	[7109] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: ve_fild02 (330, 384). Ve al sur de Rachel y encuentra a uno de los miembros de nuestro gremio allí. Ella está esperando para ayudarte a entrar a la mansión."
		},
		Summary = ""
	},
	[7110] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Girl en Ubicacion: ve_fild02 (330, 384). Sé puntual, entra sigilosamente en la mansión y completa tu tarea en 10 minutos. Reúnete con ella en la puerta trasera de la mansión cuando hayas terminado."
		},
		Summary = ""
	},
	[7111] = {
		Title = "Cambio de trabajo a cruz de guillotina",
		Description = {
			"Inicio: NPC: Renzak en Ubicacion: job3_guil03 (146, 70). Has completado tu tarea de eliminar el objetivo final del gremio Assassin. Vuelve a una sucursal e infórmaselo a Mayshell."
		},
		Summary = ""
	},
	[7112] = {
		Title = "Información de Madelle",
		Description = {
			"Inicio: NPC: Waitress en Ubicacion: ve_in (228, 108). Madelle vio a una persona que parecía un sacerdote de Rachel a altas horas de la noche."
		},
		Summary = ""
	},
	[7113] = {
		Title = "Información de Crave",
		Description = {
			"Inicio: NPC: Young Merchant en Ubicacion: ve_in (246, 303). Crave dijo que hay una chica que compra muchas cosas todas las mañanas y todas las noches. Nadie sabe su dirección. ¿Quién es ella?"
		},
		Summary = ""
	},
	[7114] = {
		Title = "Información de Trovan",
		Description = {
			"Inicio: NPC: Vigilante en Ubicacion: veins (291, 215). Trovan dijo que hay un tipo que se puede ver a menudo y que no es huésped de la posada, por lo que sospecha."
		},
		Summary = ""
	},
	[7115] = {
		Title = "Información de un vendedor ambulante",
		Description = {
			"Inicio: NPC: Peddler en Ubicacion: veins (187, 143). Un vendedor ambulante dijo que hay una chica que usa ropa raída pero que compra cosas nuevas y caras todos los días."
		},
		Summary = ""
	},
	[7116] = {
		Title = "Información de un anciano",
		Description = {
			"Inicio: NPC: Old Man en Ubicacion: veins (235, 126). El anciano del pueblo dijo que hay una chica que aparece en el mismo lugar a la misma hora todos los días, tal vez se mudó aquí recientemente."
		},
		Summary = ""
	},
	[7117] = {
		Title = "¡Tu primera misión!",
		Description = {
			"Cruza el puente a la derecha. Pasa por la entrada del castillo, entra al Centro de entrenamiento y habla con Sprakki dentro."
		},
		Summary = ""
	},
	[7118] = {
		Title = "Entrenamiento para principiantes",
		Description = {
			"Habla con el instructor Brade."
		},
		Summary = "Conversación"
	},
	[7119] = {
		Title = "Entrenamiento para principiantes",
		Description = {
			"Recibiste equipo de Brade."
		},
		Summary = "Ponte tu equipo"
	},
	[7120] = {
		Title = "Entrenamiento para principiantes",
		Description = {
			"Encuentra a Jinha y aprende una nueva habilidad."
		},
		Summary = "Aprenda la habilidad de primeros auxilios"
	},
	[7121] = {
		Title = "Entrenamiento para principiantes",
		Description = {
			"En las ciudades de este mundo, hay muchas personas con las que puedes interactuar. Habla con Kafra, Cool Event y guías de soldados."
		},
		Summary = "Conversaciones"
	},
	[7122] = {
		Title = "Primera batalla: caza de poring",
		Description = {
			"Encuentra el monstruo llamado Poring y derrota a 1."
		},
		Summary = "Cazando 1 Porin"
	},
	[7123] = {
		Title = "Conceptos básicos de batalla: espadachín",
		Description = {
			"Prueba la habilidad Swordman \"Bash\" en el Manual de habilidades para cazar monstruos Picky y regresa a la Guía Swordman."
		},
		Summary = "Caza 2 exigente"
	},
	[7124] = {
		Title = "Conceptos básicos de batalla: mago",
		Description = {
			"Practica el uso de las habilidades \"Bolt\" de un mago cazando lunáticos"
		},
		Summary = "Caza 5 lunáticos"
	},
	[7125] = {
		Title = "no usado",
		Description = {
			""
		},
		Summary = ""
	},
	[7126] = {
		Title = "Vender artículos",
		Description = {
			"Vende un artículo de tu inventario al comerciante de patatas y devuelve 300 zenys al guía del comerciante."
		},
		Summary = ""
	},
	[7127] = {
		Title = "Conceptos básicos de batalla: ladrón",
		Description = {
			"Prueba las habilidades \"Doble ataque\" y \"Mejorar esquiva\" equipando el manual de ladrón mientras cazas 5 sauces."
		},
		Summary = "Caza 5 sauces"
	},
	[7128] = {
		Title = "¡Conquista el Desierto!",
		Description = {
			"[Grupo Edén: Entrenamiento en el Desierto (Nv. 12-25) - Paso 1 de 5] Requisitos: Nivel Base: 12+. Siguiente mision: 7129 (¡Conquista el Desierto!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). Encuentra al Perro Parlante en el campo al sureste de Morocc, cerca de un Oasis. Dile que \"Boya es realmente genial\"."
		},
		Summary = "Encuentra al Perro Parlante en el Oasis"
	},
	[7129] = {
		Title = "¡Conquista el Desierto!",
		Description = {
			"[Grupo Edén: Entrenamiento en el Desierto (Nv. 12-25) - Paso 2 de 5] Requisitos: Nivel Base: 12+ | Mision previa: 7128 (¡Conquista el Desierto!). Siguiente mision: 7130 (¡Conquista el Desierto!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). Caza 10 Condors para despejar los alrededores del Oasis."
		},
		Summary = "Caza 10 Condor"
	},
	[7130] = {
		Title = "¡Conquista el Desierto!",
		Description = {
			"[Grupo Edén: Entrenamiento en el Desierto (Nv. 12-25) - Paso 3 de 5] Requisitos: Nivel Base: 12+ | Mision previa: 7129 (¡Conquista el Desierto!). Siguiente mision: 7131 (¡Conquista el Desierto!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). ¡Caza 10 ruidosos Baby Desert Wolves (Lobitos del Desierto)!"
		},
		Summary = "Caza 10 Baby Desert Wolf"
	},
	[7131] = {
		Title = "¡Conquista el Desierto!",
		Description = {
			"[Grupo Edén: Entrenamiento en el Desierto (Nv. 12-25) - Paso 4 de 5] Requisitos: Nivel Base: 12+ | Mision previa: 7130 (¡Conquista el Desierto!). Siguiente mision: 7132 (¡Conquista el Desierto!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). Los Scorpions emboscan y envenenan a los viajeros en el desierto. Caza al menos 5 para proteger el Oasis."
		},
		Summary = "Caza 5 Scorpion"
	},
	[7132] = {
		Title = "¡Conquista el Desierto!",
		Description = {
			"[Grupo Edén: Entrenamiento en el Desierto (Nv. 12-25) - Paso 5 de 5] Requisitos: Nivel Base: 12+ | Mision previa: 7131 (¡Conquista el Desierto!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). Has completado tu entrenamiento en el desierto. Reporta tus resultados al Instructor Boya en la Sede del Grupo del Paraíso."
		},
		Summary = "Informa al Instructor Boya"
	},
	[7133] = {
		Title = "¡Conquista las Alcantarillas!",
		Description = {
			"[Grupo Edén: Alcantarillas de Prontera (Nv. 26-39) - Paso 1 de 5] Requisitos: Nivel Base: 26+. Siguiente mision: 7134 (¡Conquista las Alcantarillas!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). Regístrate en el Gremio de Caballeros de Prontera para explorar las Alcantarillas (Culvert). Baja allí, encuentra al Gato De Pie y dile: \"La ayuda de Boya es como un atún gigante y hermoso\"."
		},
		Summary = "Encuentra al Gato De Pie en las Alcantarillas"
	},
	[7134] = {
		Title = "¡Conquista las Alcantarillas!",
		Description = {
			"[Grupo Edén: Alcantarillas de Prontera (Nv. 26-39) - Paso 2 de 5] Requisitos: Nivel Base: 26+ | Mision previa: 7133 (¡Conquista las Alcantarillas!). Siguiente mision: 7135 (¡Conquista las Alcantarillas!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). La primera parte del entrenamiento consiste en cazar 10 Thief Bugs."
		},
		Summary = "Caza 10 Thief Bug"
	},
	[7135] = {
		Title = "¡Conquista las Alcantarillas!",
		Description = {
			"[Grupo Edén: Alcantarillas de Prontera (Nv. 26-39) - Paso 3 de 5] Requisitos: Nivel Base: 26+ | Mision previa: 7134 (¡Conquista las Alcantarillas!). Siguiente mision: 7136 (¡Conquista las Alcantarillas!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). La siguiente parte del entrenamiento es deshacerse de 10 Tarous (ratas gigantes)."
		},
		Summary = "Caza 10 Tarou"
	},
	[7136] = {
		Title = "¡Conquista las Alcantarillas!",
		Description = {
			"[Grupo Edén: Alcantarillas de Prontera (Nv. 26-39) - Paso 4 de 5] Requisitos: Nivel Base: 26+ | Mision previa: 7135 (¡Conquista las Alcantarillas!). Siguiente mision: 7137 (¡Conquista las Alcantarillas!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). La última prueba en las alcantarillas es cazar 5 Familiars voladores."
		},
		Summary = "Caza 5 Familiar"
	},
	[7137] = {
		Title = "¡Conquista las Alcantarillas!",
		Description = {
			"[Grupo Edén: Alcantarillas de Prontera (Nv. 26-39) - Paso 5 de 5] Requisitos: Nivel Base: 26+ | Mision previa: 7136 (¡Conquista las Alcantarillas!). Inicio: NPC: Instructor Boya en Ubicacion: Sede del Grupo Edén (moc_para01). Has completado las tareas del Gato De Pie. Regresa y reporta tu progreso al Instructor Boya en la Sede del Grupo del Paraíso."
		},
