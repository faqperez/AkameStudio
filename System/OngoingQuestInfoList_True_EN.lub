	[40000] = {
		Title = "Carterista Lighthalzen",
		Description = {
			"Espere al menos 5 minutos antes de intentar hablar con el \"chico sospechoso\" nuevamente."
		},
		Summary = ""
	},
	[40001] = {
		Title = "Investigación criminal",
		Description = {
			"El agente York te ha pedido que encuentres a Vince Noir cerca de la fuente Geffen."
		},
		Summary = ""
	},
	[40002] = {
		Title = "Ling Mynmei",
		Description = {
			"Vince Noir te da una muñeca mapache y te dice que busques a Ling Mynmei en un bar en Geffen y le lleves la muñeca."
		},
		Summary = ""
	},
	[40003] = {
		Title = "Liberando a Mynmei",
		Description = {
			"Habla con la anciana Kroot y convéncela de liberar a Ling Mynmei de su contrato de servidumbre laboral."
		},
		Summary = ""
	},
	[40006] = {
		Title = "Lucha de brazo con una anciana",
		Description = {
			"Has desafiado a la anciana Kroot a un concurso de pulseadas a la antigua usanza. Págale 5.000 zenys y prueba suerte venciéndola."
		},
		Summary = ""
	},
	[40007] = {
		Title = "El mejor camino al corazón de una mujer...",
		Description = {
			"Llévale un filete de bombardero a la anciana Kroot y ella reducirá el pago del contrato de Ling Mynmei a 50.000 zenys."
		},
		Summary = ""
	},
	[40008] = {
		Title = "Pagar a la anciana",
		Description = {
			"Paga el contrato de Ling Mynmei dándole 100.000 zenys a la anciana Kroot."
		},
		Summary = ""
	},
	[40009] = {
		Title = "¡Ling Mynmei es libre!",
		Description = {
			"Dile a Ling Mynmei que has comprado con éxito su contrato a la anciana Kroot."
		},
		Summary = ""
	},
	[40010] = {
		Title = "Howard Luna",
		Description = {
			"Encuentra a Howard Moon, que está trabajando en algún lugar de Geffen."
		},
		Summary = ""
	},
	[40011] = {
		Title = "Inundar el trastero",
		Description = {
			"Howard Moon necesita tu ayuda para inundar el almacén de fuudmaart. Encuentra los 4 controles alrededor de la ciudad de Geffen y apágalos e inundará la sala de almacenamiento de fuudmaart."
		},
		Summary = "Habla con Howard Moon después de haber encontrado los 4 controles de inundaciones."
	},
	[40012] = {
		Title = "Control de inundaciones 1",
		Description = {
			"Ha cambiado el primer dispositivo de control de inundaciones."
		},
		Summary = ""
	},
	[40013] = {
		Title = "Control de inundaciones 2",
		Description = {
			"Ha activado el segundo dispositivo de control de inundaciones."
		},
		Summary = ""
	},
	[40014] = {
		Title = "Control de inundaciones 3",
		Description = {
			"Ha activado el tercer dispositivo de control de inundaciones."
		},
		Summary = ""
	},
	[40015] = {
		Title = "Control de inundaciones 4",
		Description = {
			"Ha activado el cuarto dispositivo de control de inundaciones."
		},
