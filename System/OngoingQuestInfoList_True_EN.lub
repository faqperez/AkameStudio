	},
	[2147] = {
		Title = "Actitud hacia el nuevo mundo",
		Description = {
			"Inicio: NPC: Monster Scholar en Ubicacion: mid_camp (188, 254). Rumis Block, un zoólogo, quiere abandonar el estudio porque tiene miedo de los monstruos del Ash Vacuum. Derrota a 1 Nepethenes y llévale 1 Strong Vine para demostrarle que no son tan intimidantes."
		},
		Summary = "1 vid fuerte"
	},
	[2148] = {
		Title = "Actitud hacia el nuevo mundo",
		Description = {
			"Rumis necesita que le ayudes a fabricar sus herramientas de muestra llevándole 1 botella vacía, 5 agua bendita y 30 moco pegajoso."
		},
		Summary = "Trae los materiales requeridos."
	},
	[2149] = {
		Title = "Actitud hacia el nuevo mundo",
		Description = {
			"Rumis te pide que lleves el espécimen de Nepenthes a su hermano, Terris, que se encuentra en el extremo este del campamento."
		},
