		},
		Summary = "Habla con Totoy"
	},
	[2280] = {
		Title = "Secreto en el bosque",
		Description = {
			"Inicio: NPC: Totoy en Ubicacion: ma_in01 (47, 101). Terminaste tu deber con Totoy. Ahora hablemos con el líder de la guardia sobre Buwaya."
		},
		Summary = "Habla con el líder de la guardia."
	},
	[2281] = {
		Title = "Deshazte de Buwaya",
		Description = {
			"Inicio: NPC: Guard Leader en Ubicacion: malaya (290, 340). Derrota a Buwaya en la cueva de Buwaya y luego regresa con el líder de la guardia."
		},
