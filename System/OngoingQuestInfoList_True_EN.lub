		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Entrega la Protección Espiritual terminada a la linda Talah."
		},
		Summary = ""
	},
	[7373] = {
		Title = "Entregar protección espiritual-Romel",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Entrega la Protección Espiritual terminada al padre de Talah, Romel."
		},
		Summary = ""
	},
	[7374] = {
		Title = "Amor y protección espiritual para todos",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Imelda te pide que entregues las Protecciones Espirituales terminadas a los asustados aldeanos. Total de 6 aldeanos."
		},
		Summary = ""
	},
	[7375] = {
		Title = "El amor y la protección espiritual continúan",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). El efecto de la Protección Espiritual no dura tanto. Ayudaré a Imelda a distribuir las Protecciones Espirituales después de un día."
		},
		Summary = ""
	},
	[7376] = {
		Title = "Viejo y caldero de hierro fundido-1",
		Description = {
			"Inicio: NPC: Old Man Nardo en Ubicacion: malaya (181, 353). Dicen que hay una pequeña tribu llamada Baryo Mahiwaga en las afueras de la ciudad de Port Malaya. Recibí una solicitud para obtener calderos de hierro fundido del monstruo llamado Bakonawa y distribuirlos a quienes los deseen."
		},
		Summary = "Entrega un caldero de hierro fundido a Kiko en Mumbaki"
	},
	[7377] = {
		Title = "Viejo y caldero de hierro fundido-2",
		Description = {
			"Inicio: NPC: Kiko in Mumbaki en Ubicacion: ma_fild01 (261, 208). Le entregaste un caldero de hierro fundido a Mumbaki Kiko en Baryo Mahiwaga y recibiste protección espiritual como recompensa. Informemos a Nardo para que esta entrega sea oficial."
		},
		Summary = "Entregar protección espiritual a Nardo"
	},
	[7378] = {
		Title = "El viejo y el caldero de hierro fundido-Oficios regulares",
		Description = {
			"Inicio: NPC: Old Man Nardo en Ubicacion: malaya (181, 353). El caldero de hierro fundido es un objeto que se golpea constantemente para que siempre se rompa. Por eso se adquieren calderos con regularidad. Reúnete con Nardo después de un día. Él te dará la fecha de entrega del Caldero de Hierro Fundido."
		},
		Summary = ""
	},
	[7379] = {
		Title = "Predicador de la paz",
		Description = {
			"Inicio: NPC: Old Man Nardo en Ubicacion: malaya (181, 353). Entregó las Protecciones Espirituales a los 6 aldeanos según las instrucciones de Imelda. Siento que acabo de participar en traer paz y estabilidad a este pueblo. Compartamos este gran éxito con Imelda."
		},
		Summary = ""
	},
	[7380] = {
		Title = "Para Smith una protección espiritual tradicional",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Prometió recolectar material para crear Protecciones Espirituales. La sal se puede recolectar en las costas noroeste, el bambú en Baryo y las cruces de plata en Pandoi."
		},
		Summary = "6 bolsas de sal, 6 bambúes afilados, 6 cruces de plata"
	},
	[7381] = {
		Title = "Alta demanda de material de protección espiritual",
		Description = {
			"Inicio: NPC: Imelda en Ubicacion: malaya (169, 350). Las protecciones espirituales siempre son necesarias, por lo que los materiales siempre se agotan. Visita a Imelda después de un día. Definitivamente pedirá más materiales."
		},
		Summary = ""
	},
	[7382] = {
		Title = "Entregar a Pedro",
		Description = {
			"Inicio: NPC: Pedro the Sailor en Ubicacion: malaya (326, 68). ¡Entregó la Protección Espiritual a Pedro!"
		},
		Summary = ""
	},
	[7383] = {
		Title = "Entregar en Nardo",
		Description = {
			"Inicio: NPC: Old Man Nardo en Ubicacion: malaya (181, 353). ¡Entregó la protección espiritual a Nardo!"
		},
		Summary = ""
	},
	[7384] = {
		Title = "Entregar en Pandoi",
		Description = {
			"Inicio: NPC: Blacksmith Pandoi en Ubicacion: malaya (119, 217). ¡Entregó la protección espiritual a Pandoi!"
		},
		Summary = ""
	},
	[7385] = {
		Title = "Entregar a Woeon",
		Description = {
			"Inicio: NPC: Collection Dealer Woeon en Ubicacion: malaya (295, 171). ¡Entregó la protección espiritual a Woeon!"
		},
		Summary = ""
	},
	[7386] = {
		Title = "Entregar a Talah",
		Description = {
			"Inicio: NPC: Talah en Ubicacion: malaya (223, 267). ¡Entregó la protección espiritual a Talah!"
		},
		Summary = ""
	},
	[7387] = {
		Title = "Entregar a Romel",
		Description = {
			"Inicio: NPC: Romel en Ubicacion: malaya (224, 267). ¡Entregó la protección espiritual a Romel!"
		},
		Summary = ""
	},
	[7388] = {
		Title = "El hijo de María",
		Description = {
			"Inicio: NPC: Maries en Ubicacion: ma_fild01 (200, 190). Busquemos la ^4d4dffCamiseta del revés^000000 para el hijo de Maries que está perdido en el bosque. La camiseta debe ser cogida por un animal o un monstruo."
		},
		Summary = ""
	},
	[7389] = {
		Title = "Regálale la camiseta al niño de Maries",
		Description = {
			"Inicio: NPC: Lost Child en Ubicacion: ma_fild01 (251, 93). Le regaló la camiseta al hijo de Maries. El niño se pondrá la camiseta y volverá a casa sano y salvo. Tendré que hacerle saber a Maries que todo está bien ahora."
		},
		Summary = ""
	},
	[7390] = {
		Title = "Preocupado por el hijo de Maries",
		Description = {
			"Inicio: NPC: Maries en Ubicacion: ma_fild01 (200, 190). Según la historia del niño, parece que hay un espíritu travieso que engaña a la gente para que se pierda. Esto significa que el niño podría perderse nuevamente. Si estás preocupado, pásate por su local de nuevo."
		},
		Summary = ""
	},
	[7391] = {
		Title = "Jejeling y Jejellopy",
		Description = {
			"Inicio: NPC: Collection Dealer Woeon en Ubicacion: malaya (295, 171). El distribuidor de colecciones, Woeon, colecciona Jejellopys y te pidió que le ayudaras a recolectarlas. Caza a los Jejelings cercanos y recoge los Jejellopys que sueltan. Entrega 30 Jejellopys a Woeon."
		},
		Summary = "Entrega 30 Jejellopys a Woeon."
	},
	[7392] = {
		Title = "Recoge Jejellopy regularmente",
		Description = {
			"Inicio: NPC: Collection Dealer Woeon en Ubicacion: malaya (295, 171). Jejellopy se fabrica para utilizarlo como material en diversos productos. Woeon necesitará tantos Jejellopys como pueda conseguir. Visitémoslo cuando tenga tiempo libre."
		},
		Summary = ""
	},
	[7393] = {
		Title = "Hoja plateada brillante",
		Description = {
			"Inicio: NPC: Blacksmith Pandoi en Ubicacion: malaya (119, 217). Cub Blacksmith, el sueño de Pandoi es hacer un arma Silver Blade. Recoge 10 pulseras de plata de los monstruos del hospital."
		},
		Summary = "10 pulseras de plata y derrota a Manananggal y Tiyanak."
	},
	[7394] = {
		Title = "mañana brillante",
		Description = {
			"Inicio: NPC: Blacksmith Pandoi en Ubicacion: malaya (119, 217). Regrese a Pandoi después de un día. Si no pudo crear una Silver Blade, necesitará tu ayuda para conseguir más pulseras de plata."
		},
		Summary = ""
	},
	[7395] = {
		Title = "Fantasma en el barco Perry",
		Description = {
			"Inicio: NPC: Pedro the Sailor en Ubicacion: malaya (326, 68). Decidí comprobar por ti mismo si la historia de Pedro de que el barco Perry está embrujado es cierta. Los fantasmas de por aquí parecen tenerme miedo así que no tengamos miedo de abordar el barco."
		},
		Summary = "Investigar el barco Perry"
	},
	[7396] = {
		Title = "Alma enojada en el barco Perry",
		Description = {
			"Inicio: NPC: Ghost Diwata en Ubicacion: ma_in01 (125, 107). Fue maltratada en el barco Perry por un espíritu femenino enojado. Busquemos una solución."
		},
		Summary = "Habla con Pedro y Mumbaki"
	},
	[7397] = {
		Title = "El consejo de Mumbaki Phong",
		Description = {
			"Inicio: NPC: Leader Phong in Mumbaki en Ubicacion: malaya (185, 358). Mumbaki Phong dijo que no hay que evitar al espíritu sino abrazarlo y calmarlo. Busquemos flores para ofrecer. Puedes conseguir flores de los animales y monstruos cercanos."
		},
		Summary = "3 flores elegantes, 3 flores misteriosas, 3 flores hermosas"
	},
	[7398] = {
		Title = "Ramo de Ofrenda Recomendado por Mumbaki",
		Description = {
			"Inicio: NPC: Leader Phong in Mumbaki en Ubicacion: malaya (185, 358). Mumbaki Phong bendijo las flores e hizo un ramo de ofrendas que le llevaste. Llevemos este ramo a Soul Diwata en el barco Perry."
		},
		Summary = "Ofrezca el ramo a Diwata"
	},
	[7399] = {
		Title = "La historia de Soul Diwata",
		Description = {
			"Inicio: NPC: Ghost Diwata en Ubicacion: ma_in01 (125, 107). Diwata dijo que los fantasmas nativos la intimidaban porque era de fuera de la aldea. Perry Ship está atrapado debido al alma poderosa de Diwata."
		},
		Summary = "Comparte esta información con Pedro"
	},
	[7400] = {
		Title = "Mumbaki de Puerto Malaya",
		Description = {
			""
		},
		Summary = ""
	},
	[7401] = {
		Title = "Todos a bordo para Perry Sailing",
		Description = {
			"Inicio: NPC: Pedro the Sailor en Ubicacion: malaya (326, 68). Parece que el barco Perry puede operar con regularidad por el momento. Pero revisemos el barco después de un día. Todavía existe la posibilidad de que los fantasmas nativos intimiden a Diwata."
		},
		Summary = ""
	},
	[7402] = {
		Title = "Ramo para Diwata",
		Description = {
			"Inicio: NPC: Pedro the Sailor en Ubicacion: malaya (326, 68). Decidió crear un ramo para calmar a Diwata de su pelea con los fantasmas nativos. Reúna flores para que Mumbaki Phong las bendiga."
		},
		Summary = "3 flores elegantes, 3 flores misteriosas, 3 flores hermosas"
	},
	[7403] = {
		Title = "Perry estabilizado",
		Description = {
			"Inicio: NPC: Ghost Diwata en Ubicacion: ma_in01 (125, 107). Diwata se calmó después de recibir el ramo. El barco Perry puede empezar a navegar de nuevo. Vamos a decirle a Pedro."
		},
		Summary = ""
	},
	[7404] = {
		Title = "Deshacerse de Jejeling",
		Description = {
			"Inicio: NPC: Rodel the Guard en Ubicacion: malaya (266, 76). Decidió ayudar a algunos vendedores ambulantes que viajaban hacia y desde Baryo para derrotar a los Jejelings. Intenta deshacerte de 20 Jejelings hoy."
		},
		Summary = "20 jejelings"
	},
	[7405] = {
		Title = "Deshazte de Jejeling: mañana a la misma hora",
		Description = {
			"Inicio: NPC: Rodel the Guard en Ubicacion: malaya (266, 76). Deshacerse de Jejelings es un proyecto en curso que necesita mucha ayuda. Para participar, reúnete con la Guardia después de un día."
		},
		Summary = ""
	},
	[7406] = {
		Title = "¡Acepta coleccionar huesos!",
		Description = {
			"Inicio: NPC: Dhong the Guard en Ubicacion: ma_fild01 (239, 253). Recoge huesos para el perro guardián Vantai. Los huesos recolectados deben purificarse. Lleva los huesos del espíritu maligno recolectados a Mumbaki Kiko para que los purifique."
		},
		Summary = "10 huesos de espíritu maligno, 10 agua bendita"
	},
	[7407] = {
		Title = "Hueso purificado",
		Description = {
			"Inicio: NPC: Kiko in Mumbaki en Ubicacion: ma_fild01 (261, 208). Recibiste huesos de espíritu purificados después del ritual de Mumbaki Kiko. Llevémoslos al Barrio."
		},
		Summary = "Entrega 10 huesos espirituales purificados al cuarto 10"
	},
	[7408] = {
		Title = "¿Estás de acuerdo en volver mañana?",
		Description = {
			"Inicio: NPC: Dhong the Guard en Ubicacion: ma_fild01 (239, 253). Al Cuartel de Guardia de Baryo Mahiwaga le gustaría tener más huesos para darle a Vantai mañana. Visitemos nuevamente después de un día."
		},
		Summary = ""
	},
	[7409] = {
		Title = "¡No puedo mirarlo a los ojos!",
		Description = {
			"Inicio: NPC: Good Capre Budidai en Ubicacion: ma_fild02 (241, 39). El autoproclamado Buen Capre Budidai no puede soportar ver a sus amigos siendo intimidados por los Bungisngis. Bungisngis era demasiado poderoso para que Budidai lo manejara y ahora te pregunta si puedes ayudarlo a cuidar del monstruo de un solo ojo."
		},
		Summary = "Deshazte de 10 Bungisngis"
	},
	[7410] = {
		Title = "¡Enseñe otra lección mañana!",
		Description = {
			"Inicio: NPC: Good Capre Budidai en Ubicacion: ma_fild02 (241, 39). Capre Budidai dijo que los Bongisungisu no se libran de un susto y pide seguir amenazándolos. Vuelve después de un día."
		},
		Summary = ""
	},
	[7411] = {
		Title = "El viajero, la historia de Fome",
		Description = {
			"Inicio: NPC: Traveler Fome en Ubicacion: ecl_in01 (32, 52). Escuché la historia sobre los Lapines y Eclage."
		},
		Summary = ""
	},
	[7412] = {
		Title = "El viajero, la historia de Litrip",
		Description = {
			"Inicio: NPC: Traveler Litrip en Ubicacion: ecl_in01 (32, 51). Escuché la historia sobre la Torre Bifrost."
		},
		Summary = ""
	},
	[7413] = {
		Title = "El viajero, la historia de Chiba",
		Description = {
			"Inicio: NPC: Traveler Chiba en Ubicacion: ecl_in01 (35, 51). Escuchó la organización y las funciones de los Lapines."
		},
		Summary = ""
	},
	[7414] = {
		Title = "Mensaje del guardia de Eclage",
		Description = {
			"Alguien de Eclage quería conocerle. Pide indicaciones al guardia cerca de la salida este de la plaza Eclage."
		},
		Summary = "Hablando con el guardia en la salida este de Eclage."
	},
	[7415] = {
		Title = "Jefe de Gabinete de Lapine",
		Description = {
			"Planeé encontrarme con alguien según las instrucciones del guardia de Eclage. Si se pierde, vuelva a pedir indicaciones al guardia."
		},
		Summary = "Hablando con el jefe de gabinete"
	},
	[7416] = {
		Title = "esperando encontrarnos",
		Description = {
			"Después de hablar con el jefe de personal, solicité reunirme con el alcalde Jun del Rey de Lapines. Una vez que termine la espera, pidamos nuevamente al guardia de Eclage más instrucciones."
		},
		Summary = "Pedir direcciones después de esperar"
	},
	[7417] = {
		Title = "La petición de Kardui",
		Description = {
			"El alcalde Jun no escuchó mis historias sinceras, sino que afirmó que las escucharía más si yo contribuyera a Eclage de manera más significativa. Cuidemos a los Lapines de Eclage que necesitan ayuda."
		},
		Summary = "Trabajando para Eclage"
	},
	[7418] = {
		Title = "Para Eclage 1",
		Description = {
			"Inicio: NPC: Eclage Guard en Ubicacion: ecl_in01 (82, 70). Obtén ingredientes para decorar Yai para el guardia de Eclage que está demasiado ocupado. Cuernos de león montañés, cuernos místicos y pezuñas de caballo, 5 de cada uno, serían suficientes."
		},
		Summary = "5 cuernos de león montañés, 5 cuernos místicos, 5 cascos de caballo"
	},
	[7419] = {
		Title = "Para Eclage 2",
		Description = {
			"Inicio: NPC: Eclage Messenger Roy en Ubicacion: ecl_fild01 (205, 86). Decidió entregar correos del Oficial de Contacto de Splendide como un favor para Roy, el mensajero que estaba teniendo problemas en el borde de Bifrost debido a que se cortaron las comunicaciones."
		},
		Summary = "Splendide Oficial de Contacto y Buzón"
	},
	[7420] = {
		Title = "Para Eclage 3",
		Description = {
			"Inicio: NPC: Eclage Guard Leo en Ubicacion: eclage (112, 40). Para Leo, que ama los dulces, consígale frutas encurtidas de Pinguicula, elaboradas con Splendide, y mermelada de miel de Luciola. Las frutas encurtidas y la mermelada de miel se pueden obtener usando monedas en la base avanzada."
		},
		Summary = "3 Frutas Encurtidas de Pinguicula, 3 Mermelada de Miel de Luciola"
	},
	[7421] = {
		Title = "eso es suficiente",
		Description = {
			"Mientras trabajaba en varios trabajos, me llegó la página de Kardui. Debo ir a encontrarme con Kardui. Su oficina estará en el último piso cuando siga el camino en espiral."
		},
		Summary = "Hablando con Kardui"
	},
	[7422] = {
		Title = "El regalo de Kardui.",
		Description = {
			"Kardui declaró que preparó un regalo que se puede recoger en la Jefa de Gabinete Shenime. ¿Qué podría ser?"
		},
		Summary = "Recibir el regalo a través de Shenime"
	},
	[7423] = {
		Title = "Un rumor sobre el Rey 1",
		Description = {
			"Inicio: NPC: Eclage Guard Leo en Ubicacion: eclage (112, 40). Durante la conversación con Leo se contaron cosas inquietantes sobre Kardui. No pareció entrar en detalles, pero era muy preocupante."
		},
		Summary = ""
	},
	[7424] = {
		Title = "Un rumor sobre el Rey 2",
		Description = {
			"Inicio: NPC: Traveler Fome en Ubicacion: ecl_in01 (32, 52). Fome compartió algo inesperado. Es que a Lapines le ha venido sutilmente antipatía por Kardui. Esto era similar a lo que Leo parecía guardarse para sí mismo antes."
		},
		Summary = ""
	},
	[7425] = {
		Title = "Un rumor sobre el Rey 3",
		Description = {
			"Inicio: NPC: Eclage Resident en Ubicacion: eclage (275, 294). La conexión entre el despotismo de Cenes y Kardui se estableció mediante conversaciones con los lapinos. No es demasiado grave, pero lo cierto es que al actual rey Kardui se le está considerando de forma similar a como lo era Cenes."
		},
		Summary = ""
	},
	[7426] = {
		Title = "Un rumor sobre el Rey 4",
		Description = {
			"Inicio: NPC: Resting Laphine en Ubicacion: ecl_in03 (244, 57). Más recientemente, Kardui parecía haberse convertido en alcalde Jun en medio de la calamidad que enfrenta toda la carrera lapina. No parecen estar completamente en desacuerdo con sus políticas, pero tampoco parecen estar de acuerdo con ellas."
		},
		Summary = ""
	},
	[7427] = {
		Title = "En momentos como este, ¡enfréntalo de frente!",
		Description = {
			"Inicio: NPC: Resting Laphine en Ubicacion: ecl_in03 (244, 57). La verdad detrás de la ansiedad y el miedo de Lapine hacia Kardui ya no podía dilucidarse. ¿No debería al menos comunicarse esto a la persona de interés? Quizás sea posible escuchar la razón detrás de todo esto."
		},
		Summary = "Habla con Kardui"
	},
	[7428] = {
		Title = "Yai de lo salvaje",
		Description = {
			"Inicio: NPC: Eclage Guard en Ubicacion: ecl_in01 (82, 70). Obtén artículos para el Yai para el guardia de Eclage, Minuel, que permanece en el puesto todos los días y todas las noches."
		},
		Summary = "10 cuernos de león montañés, 10 cuernos místicos, 10 cascos de caballo"
	},
	[7429] = {
		Title = "¡Tendencia salvaje reciente!",
		Description = {
			"Los objetos recogidos por Minuel parecían haber causado sensación entre las condecoraciones de Yai. Obtengamos los tiempos regularmente para mantener la tendencia."
		},
		Summary = "Consulta con Minuel después de un tiempo."
	},
	[7430] = {
		Title = "Repartidor que corre por el espacio",
		Description = {
			"Inicio: NPC: Eclage Messenger Roy en Ubicacion: ecl_fild01 (205, 86). Se entregaron correos de Splendide en lugar de Roy, que todavía tiene problemas en el borde de Bifrost."
		},
		Summary = "Splendide Oficina de Contacto, Buzón"
	},
	[7431] = {
		Title = "¡Un cartero nunca descansa!",
		Description = {
			"Los correos requieren entregas regulares. Comprobemos de nuevo más tarde."
		},
		Summary = "Consulta con Roy después de un tiempo."
	},
	[7432] = {
		Title = "Los alborotadores en la tierra de las flores",
		Description = {
			"Inicio: NPC: Eclage Guard Leo en Ubicacion: eclage (112, 40). Demostremos quién manda a Menblatt y Petals que molestan a los viajeros. Se informa como patrullaje, pero en realidad es eliminación."
		},
		Summary = "Eliminando Menblatt y Pétalos"
	},
	[7433] = {
		Title = "Necesita orientación constante",
		Description = {
			"Leo una vez más pide patrullar y subyugar a Menblatt y Petals. Comprobemos con él más tarde."
		},
		Summary = "Consulta con Leo después de un tiempo."
	},
	[7434] = {
		Title = "El hermano mayor de Kardui.",
		Description = {
			"Inicio: NPC: Mayor Jun Kardui en Ubicacion: ecl_in03 (41, 90). Kardui envía una carta a su hermano mayor. El hermano de Kardui vive en lo alto de la torre Biforst. Entreguémoselo."
		},
		Summary = "entregar la carta"
	},
	[7435] = {
		Title = "Hora de leer la carta.",
		Description = {
			"Hisie pidió algo de tiempo para leer la carta. Sólo lleva un par de minutos, así que esperemos un poco."
		},
		Summary = "Espere hasta que termine de leer la carta."
	},
	[7436] = {
		Title = "Avant el erudito de la magia",
		Description = {
			"En la carta de Kardui, no sólo había una introducción sino también una solicitud para buscar a su padre, Avant el Erudito en Magia. Ayuda a Hisie a descubrir más sobre el erudito desde Eclage."
		},
		Summary = ""
	},
	[7437] = {
		Title = "El favor de Shenime",
		Description = {
			"No se pudo obtener la información de Avant, pero recibí una solicitud extraña de Shenime. Se le pidió que reuniera ingredientes experimentales para el erudito en magia que patrocina. Son 10 bolas de polvo, 10 marcapáginas de hojas."
		},
		Summary = "10 bolas de polvo, 10 marcapáginas de hojas."
	},
	[7438] = {
		Title = "Patrocinio secreto",
		Description = {
			"Shenime no compartió ni un poco sobre el estudioso de la magia que patrocina y pide olvidarse incluso de enterarse de ello. ¿Hay alguien que lo sepa?"
		},
		Summary = "buscar información"
	},
	[7439] = {
		Title = "El estudioso de la magia patrocinado por Sheime",
		Description = {
			"Hisie afirmó que si localizas a Sheime, también se podría identificar la ubicación del erudito. Descubra los deberes de Sheime."
		},
		Summary = "buscar información"
	},
	[7440] = {
		Title = "El testigo de Minuel",
		Description = {
			"Inicio: NPC: Eclage Guard en Ubicacion: ecl_in01 (82, 70). Minuel, guardia de Eclage, afirmó que Shenime viaja a menudo hacia el este, en dirección opuesta a su Yai. Discuta con Hisie."
		},
		Summary = "hablar con hisie"
	},
	[7441] = {
		Title = "¡El correo está aquí!",
		Description = {
			"Planeé visitar al erudito en magia Yai como si Shenime estuviera enviando un correo. Hisie confirmará si esa persona es Avant. Hisie proporcionará la información en el cruce frente a Eclage."
		},
		Summary = "10 bolas de polvo, 10 marcapáginas de hojas"
	},
	[7442] = {
		Title = "La identidad del estudioso de la magia.",
		Description = {
			"El erudito en magia encontrado a través de la estrategia fue de hecho Avant. Debo decirle esto a Kardui."
		},
		Summary = "Habla con Kardui"
	},
	[7443] = {
		Title = "¡Interfiere con la investigación!",
		Description = {
			"Una pequeña venganza. Kardui e Hisie quieren saber qué está investigando Avant y quieren interferir en ello. ¿Será esto una pequeña venganza de los hermanos?"
		},
		Summary = "Interfiriendo la investigación de Avant"
	},
	[7444] = {
		Title = "Lo que Avant estaba investigando",
		Description = {
			"Avant estaba investigando los métodos para extraer el poder mágico del Orbe. Dado que se trata de información peligrosa, los materiales de investigación deben devolverse inmediatamente a Kardui."
		},
		Summary = "Entregar los materiales de investigación a Kardui."
	},
	[7445] = {
		Title = "La espalda de Avant",
		Description = {
			"Inicio: NPC: Hisie en Ubicacion: ecl_tdun04 (32, 35). Se investigó la fuerza detrás de la investigación de Avant sobre el Orbe. El culpable más probable es el patrocinador de Avant, el jefe de gabinete. Acércate al jefe de gabinete para revelarle la verdad."
		},
		Summary = "Habla con el jefe de gabinete."
	},
	[7446] = {
		Title = "Conversación infructuosa",
		Description = {
			"Habló con Sheime, el jefe de gabinete, pero no se obtuvo nada. Afirma que Avant también podría haberlo engañado. El jefe de personal estaba realmente molesto porque Kardui sólo aumentó las defensas que rodeaban el Orbe."
		},
		Summary = "Informe a Kardui"
	},
	[7447] = {
		Title = "Dilema que rodea al Orbe",
		Description = {
			"Sólo confirmó la desconfianza hacia Kardui en lugar de revelar más sobre las investigaciones de Avant. El jefe de Gabinete deseó que el juicio de Kardui no se haya debilitado y pidió que lo demuestre."
		},
		Summary = "Informe a Kardui"
	},
	[7448] = {
		Title = "algo no esta bien",
		Description = {
			"Inicio: NPC: Mayor Jun Kardui en Ubicacion: ecl_in03 (41, 90). Después de discutir con Kardui e Hisie, se decide que el jefe de gabinete es el más sospechoso. ¿Cuál es la razón detrás de su resistencia a las acciones de Kardui hacia el Orbe?"
		},
		Summary = "Vigilancia del jefe de gabinete"
	},
	[7449] = {
		Title = "Tentación hacia el Orbe",
		Description = {
			"El jefe de personal pidió ir a la sala de iluminación del Orbe para discutirlo. Decidí hacérselo saber a Kardui después de decirle que me diera algo de tiempo para pensar en ello."
		},
		Summary = "Informe a Kardui"
	},
	[7450] = {
		Title = "Sala de iluminación de Orb",
		Description = {
			"No estoy seguro de por qué el jefe de personal seguía intentando atraerme a la sala de iluminación del Orbe, pero decidió ir allí aunque fuera sólo para descubrir por qué. Sigamos con lo que quiere por ahora."
		},
		Summary = "Tomar de la mano al jefe de gabinete."
	},
	[7451] = {
		Title = "traición",
		Description = {
			"Todo es tan confuso. El monstruo que luchó en la sala de iluminación no era un subordinado del Rey de los Demonios. Me controlaron sin mi conocimiento. ¡Shenime, el jefe de personal, traicionó a todos!"
		},
		Summary = "Informe a Kardui"
	},
	[7452] = {
		Title = "¡Encuentra al jefe de personal!",
		Description = {
			"Shenimé, el jefe de gabinete, responsable de todos estos hechos, ha ocultado su paradero. Según las fuentes de Hisie, la fuerza mágica residual se sintió levemente en Bifrost."
		},
		Summary = "Encuesta Bifrost del Norte"
	},
	[7453] = {
		Title = "Lo último del jefe de gabinete",
		Description = {
			"El camino de norte a sur en Bifrost. Solía ser un camino abierto, pero actualmente está bloqueado por una enorme grieta en el sur. En el camino hacia la grieta, se encontró el cadáver del jefe de personal."
		},
		Summary = "Informe a Kardui"
	},
	[7454] = {
