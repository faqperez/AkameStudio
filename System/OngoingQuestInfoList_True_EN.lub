	[11446] = {
		Title = "Los días de Jakk y Jakk en Jakky",
		Description = {
			"Te despertaron las voces susurrantes de los fantasmas. Te encontraste en Niflheim, una ciudad de los muertos. Escuchemos lo que dicen los fantasmas."
		},
		Summary = "Habla con Hororong"
	},
	[11447] = {
		Title = "Los días de Jakk y Jakk en Jakky",
		Description = {
			"Dicen que el Jakk que está en la plaza quizás sepa algo. Preguntémosle a Jakk en la plaza."
		},
		Summary = "Habla con Jakk"
	},
	[11448] = {
		Title = "Los días de Jakk y Jakk en Jakky",
		Description = {
			"Oíste sobre el lugar donde solía quedarse Jakk. Volvamos a Hooroorong."
		},
		Summary = "Habla con Hooroorong"
	},
	[11449] = {
		Title = "Los días de Jakk y Jakk en Jakky",
		Description = {
			"En algún lugar del campo y de la mazmorra, captura a unos 10 Jakks que están huyendo. Lleva 10 decoraciones_de_calabaza y 20 tallos_blancos_secos a Hororong. Se sueltan cuando capturas a los Jakks."
		},
		Summary = "Enviar a Jakk a Niflheim"
	},
	[11450] = {
		Title = "Los días de Jakk y Jakk en Jakky",
		Description = {
			"Has traído a Jakk a Niflheim. Según los fantasmas, el tallo de Jakk puede crecer si permanece en la tierra de los vivos durante mucho tiempo. Que descanse bien."
		},
		Summary = "el descanso de jakk"
	},
	[11451] = {
		Title = "Los días de Jakk y Jakk en Jakky",
		Description = {
			"En algún lugar del campo y de la mazmorra, captura a unos 10 Jakks que están huyendo. Lleva 10 decoraciones_de_calabaza y 20 tallos_blancos_secos a Hororing. Se sueltan cuando capturas a los Jakks."
		},
		Summary = "Enviar a Jakk a Niflheim"
	},
