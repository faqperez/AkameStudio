	},
	[7161] = {
		Title = "Criptograma misterioso",
		Description = {
			"Inicio: NPC: Manager en Ubicacion: s_atelier (65, 123). Recibiste un nuevo criptograma de Graham. El criptograma es (5 15 24 8/9 12 21 8/18 17/23 24 21 23 15 8/12 22 15 4 17 7/23 11 12 21 7/9 15 18 18 21) (Clave: 3)"
		},
		Summary = ""
	},
	[7162] = {
		Title = "Criptograma misterioso",
		Description = {
			"Inicio: NPC: Manager en Ubicacion: s_atelier (65, 123). Recibiste un nuevo criptograma de Graham. El criptograma es (6 16 25 9/10 13 22 9/19 18/24 25 22 24 16 9/13 23 16 5 18 8/24 12 13 22 8/10 16 19 19 22) (Clave: 4)"
		},
		Summary = ""
	},
	[7163] = {
		Title = "Criptograma misterioso",
		Description = {
			"Inicio: NPC: Manager en Ubicacion: s_atelier (65, 123). Recibiste un nuevo criptograma de Graham. El criptograma es (7 17 26 10/11 14 23 10/20 19/25 26 23 25 17 10/14 24 17 6 19 9/25 13 14 23 9/11 17 20 20 23) (Clave: 5)"
		},
		Summary = ""
	},
	[7164] = {
		Title = "Caza la sombra del engaño",
		Description = {
			"Inicio: NPC: Blue Flame en Ubicacion: tur_dun03 (38, 209). La Llama Azul de la Isla Tortuga parece fuertemente relacionada con la Sombra del Engaño. Para cortar esta conexión, debes encontrar y matar a Shadow of Deception aquí en Good Turtles Village."
		},
		Summary = "Mata la sombra del engaño"
	},
	[7165] = {
		Title = "La clave del engaño",
		Description = {
			"Inicio: NPC: ???? en Ubicacion: job3_sha01 (22, 78). No fue un tesoro sino una pequeña llave que encontré en el lugar secreto de la Isla Tortuga. Primero, regresa con Graham en el Taller de sombras de Prontera e infórmale lo que encontraste."
		},
		Summary = ""
	},
	[7166] = {
		Title = "Taller de sombras de Rachel",
		Description = {
			"Ve al Taller de Sombras en Rachel y habla con el Gerente allí. Él te dará el siguiente cifrado para desbloquear la siguiente pista si le dices que Graham te envió."
		},
		Summary = ""
	},
	[7167] = {
		Title = "Criptograma misterioso",
		Description = {
			"¿Qué significa el criptograma que le mostró Paul, el gerente de la sucursal de Rachel? El criptograma es (R-E-N-N-N-D / L-N-N-W-W-N-D). Cuando lo averigües, habla con Paul."
		},
		Summary = ""
	},
	[7168] = {
		Title = "Criptograma misterioso - 3.º",
		Description = {
			"Recibiste el criptograma y la palabra clave que tenía Paul. (R-E-N-N-N-D / L-N-N-W-W-N-D) Estos criptogramas parecen indicar el nombre del lugar y la dirección. La palabra clave separada es (SEMILLA)"
		},
		Summary = "Encuentra el lugar donde indica el critograma."
	},
	[7169] = {
		Title = "Criptograma misterioso - 3.º",
		Description = {
			"Recibí el criptograma y la palabra clave que tenía Paul. (R-E-N-N-N-D / L-N-N-W-W-N-D) Estos criptogramas parecen indicar el nombre del lugar y la dirección. La palabra clave separada es (PIE)"
		},
		Summary = "Encuentra el lugar donde indica el critograma."
	},
	[7170] = {
		Title = "Criptograma misterioso - 3.º",
		Description = {
			"Recibiste el criptograma y la palabra clave que tenía Paul. (R-E-N-N-N-D / L-N-N-W-W-N-D) Estos criptogramas parecen indicar el nombre del lugar y la dirección. La palabra clave separada es (FRÍO)"
		},
		Summary = "Encuentra el lugar donde indica el critograma."
	},
	[7171] = {
		Title = "Caza la sombra de la ilusión",
		Description = {
			"Inicio: NPC: Red Flame en Ubicacion: ice_dun02 (206, 223). Al igual que la Sombra del Engaño, encontraste una llama fuertemente conectada a otra sombra. Para cortar esta conexión, debes matar a la Sombra de la Ilusión."
		},
		Summary = "Mata la sombra de la ilusión"
	},
	[7172] = {
		Title = "La clave de la ilusión",
		Description = {
			"Fue la Llave de la Ilusión que encontraste en lo profundo de la Cueva de Hielo. Pero el tesoro tampoco estaba escondido allí. Regrese e informe a Paul en Rachel."
		},
		Summary = ""
	},
	[7173] = {
		Title = "Mensaje de Paul a Haled",
		Description = {
			"Encuentra a Haled en el Juno Shadow Workshop. Si no coopera, dale este mensaje de Paul:^4d4dff¡Sé lo que hiciste el verano pasado!^000000"
		},
		Summary = ""
	},
	[7174] = {
		Title = "Criptograma misterioso",
		Description = {
			"La pista que tenía Haled era una canción corta. Necesito encontrar el lugar que indica esta canción. (^4d4dffRaíz delgada del árbol de la vida / Lágrimas de los vivos / Eran pero no éramos nosotros / Residentes de la noche olvidada"
		},
		Summary = ""
	},
	[7175] = {
		Title = "Caza la sombra del placer",
		Description = {
			"Inicio: NPC: Red Flame en Ubicacion: niflheim (230, 276). Una llama se apagó tras balancearse notablemente mostrando a una mujer joven. Necesito matar a la Sombra del Placer."
		},
		Summary = "Mata la sombra del placer"
	},
	[7176] = {
		Title = "La clave del placer",
		Description = {
			"Inicio: NPC: ???? en Ubicacion: job3_sha01 (73, 80). ¡Es una llave nuevamente, no un tesoro que encontré esta vez! ¿Dónde diablos está el tesoro? Primero, ve a Haled en Juno e infórmalo."
		},
		Summary = ""
	},
	[7177] = {
		Title = "El taller Lighthalzen",
		Description = {
			"Haled está molesto por el hecho de que su pista no reveló el lugar donde estaba enterrado el tesoro y me dijo que fuera a ver a Vicente, el gerente de la sucursal de Lighthalzen, quien tiene la última pista."
		},
		Summary = ""
	},
	[7178] = {
		Title = "Destino de las llaves",
		Description = {
			"Las 3 llaves de Engaño, Ilusión y Placer son para la estatua escondida en la torre de Thanatos. Ve al primer piso de la torre Thanatos donde aparece el poste de luz."
		},
		Summary = ""
	},
	[7179] = {
		Title = "¿Tesoro?",
		Description = {
			"Usaste tres llaves pero lo único que obtuviste fue una especie de cepillo. No volvió a ser un tesoro. ¡Necesito ver a Vicente ahora mismo!"
		},
		Summary = ""
	},
	[7180] = {
		Title = "Mensaje de Doomk",
		Description = {
			"Los suministros los entregará el gremio en un futuro próximo. Pero no sé cuándo. De todos modos, cuando me los den, me llevaré los tuyos también. Así que no olvides pasar por aquí alguna vez."
		},
		Summary = ""
	},
	[7181] = {
		Title = "El anillo de Karakas.",
		Description = {
			"Recibí el anillo de Karakass, que estuvo disponible por algún tiempo."
		},
		Summary = ""
	},
	[7182] = {
		Title = "La visita de Safa",
		Description = {
			"Inicio: NPC: Guard Aello en Ubicacion: mid_campin (93, 114). Hay rumores de que un Sapha de Manuk ha venido a visitar el campamento. Aello confía en mí así que me designó para hablar con él. El delegado está en la habitación de la derecha en el segundo piso."
		},
		Summary = "Conozca al delegado de Sapha arriba"
	},
	[7183] = {
		Title = "Invitación de Safa",
		Description = {
			"Obtén permiso de Avalanche, la guardia general de Manuk, para pasar por el túnel entre Manuk y la capital de Sapha, El Dicastes."
		},
		Summary = "Conoce a Avalanche en Manuk"
	},
	[7184] = {
		Title = "¡A El Dicastes!",
		Description = {
			"Avalanche te ha aprobado para utilizar el túnel entre Manuk y El Dicastes. ¡Finalmente puedo ir a la Capital de Sapha! Encuentre al administrador de entrada en la entrada del túnel en Manuk."
		},
		Summary = ""
	},
	[7185] = {
		Title = "inspector doha",
		Description = {
			"Inicio: NPC: Soldier en Ubicacion: mid_campin (111, 120). Antes de partir hacia la capital, el capitán Hibba Agip me dijo que me reuniera con el inspector Doha. No sé para qué sirve, pero tengo que encontrarme con esa persona de Doha antes de dirigirme a Manuk. Doha está en la habitación al lado de la de Vyhannus."
		},
		Summary = "Conozca al inspector Doha"
	},
	[7186] = {
		Title = "Orden secreta de Doha - Investigación",
		Description = {
			"Doha dice que está buscando al sospechoso del caso de denuncia de robo. Te ordena en secreto que recopiles información mientras estás en El Dicastes, explicando el atuendo del sospechoso. El sospechoso es un tipo con orejas de animal."
		},
		Summary = ""
	},
	[7187] = {
		Title = "Orden secreta de Doha - Shay",
		Description = {
			"Inicio: NPC: Shay en Ubicacion: dic_in01 (245, 119). Shay es el gerente de \"Burman Flone\", el Pub de El Dicastes. Sugirió obtener información sobre \"el tipo con orejas de animal\" de los Sapha que viven en la capital."
		},
		Summary = "Conversa con los Sapha en El Dicastes para recopilar información."
	},
	[7188] = {
		Title = "Reunión de información - en la Plaza",
		Description = {
			"Inicio: NPC: Walking Knit en Ubicacion: dicastes01 (207, 210). ¿Orejas de gato? ¿No son comerciantes de manos de gatos? No tengo ni idea. Por cierto, ¿ya conociste a Ahat? Es realmente hermoso y noble."
		},
		Summary = ""
	},
	[7189] = {
		Title = "Recopilación de información: en la fábrica",
		Description = {
			"Inicio: NPC: Resting Piom en Ubicacion: dicastes01 (112, 248). ¿Un hombre con orejas de gato? Nunca he oído hablar de eso. No intentes encontrar ese tipo de cosas poco confiables y simplemente ve a encontrarte con Ahat. ¡Él es realmente agradable! ¡Él es el modelo a seguir de Sapha!"
		},
		Summary = ""
	},
	[7190] = {
		Title = "Recopilación de información: en los guardias",
		Description = {
			"Inicio: NPC: Training Galten en Ubicacion: dicastes01 (249, 140). ¿Orejas de gato? ¿Seguro? ¿Son ustedes los humanos siempre así? ¿Por qué no vas a encontrarte con Ahat? Es un Sapha muy fuerte. ¡Puede que sea un Jarute trabajando entre montones de documentos, pero debe estar ocultando su poder!"
		},
		Summary = ""
	},
	[7191] = {
		Title = "Designación de Shay - BK",
		Description = {
			"Para facilitar la recopilación de información, Shay presentó a BK de Cat Hand Merchants. Debes decirle a BK que ^4d4dff'Se entregará la bebida especial de Shay'.^000000 si BK no ofrece ninguna ayuda..."
		},
		Summary = "Reúnete con BK en las afueras de la montaña Kamidal, en las afueras de El Dicastes."
	},
	[7192] = {
		Title = "Información de BK",
		Description = {
			"Según la información de BK, el hombre de las orejas de gato está estrechamente relacionado con Ahat, el hombre popular de El Dicastes. Pero dice que Ahat no es un Sapha y fue encontrado cerca de la Grieta. ¿Cuál es la relación?"
		},
		Summary = "Comenta tus hallazgos con Shay en Burman Flone"
	},
	[7193] = {
		Title = "Investigación de brechas dimensionales",
		Description = {
			"Después de hablar con Shay, investiga el área de la brecha dimensional hacia el sur para encontrar la verdad. Encuentre cualquier pista que pueda ser útil para la investigación."
		},
		Summary = "Investiga el área de la brecha dimensional hacia el sur."
	},
	[7194] = {
		Title = "¿Qué es esta mancha de sangre?",
		Description = {
			"Inicio: NPC: BK en Ubicacion: dic_fild01 (231, 174). Encontré sangre coagulada en la tierra cerca de la grieta. ¿Tiene esto algo que ver con Ahat?"
		},
		Summary = ""
	},
	[7195] = {
		Title = "¿Qué es este trozo de piel?",
		Description = {
			"Encontré un trozo de piel congelada de un ser vivo cerca de la grieta. ¿Tiene esto algo que ver con Ahat?"
		},
		Summary = ""
	},
	[7196] = {
		Title = "¿Qué es este poder mágico sospechoso?",
		Description = {
			"Encontraste un fragmento de piedra mágica sospechoso. Se siente como el poder mágico de la grieta. ¿Tiene esto algo que ver con Ahat?"
		},
		Summary = ""
	},
	[7197] = {
		Title = "¿Certificaciones Sapha?",
		Description = {
			"Inicio: NPC: Shay en Ubicacion: dic_in01 (245, 119). No es necesario traer certificaciones Sapha para tener una audiencia con Ahat. Realiza algunas misiones que puedes encontrar por toda la capital y recógelas."
		},
		Summary = "Recoge 3 certificaciones Sapha"
	},
	[7198] = {
		Title = "Audiencia con Ahat",
		Description = {
			"Puede tener una audiencia con Ahat después de pagar 3 certificaciones Sapha. Puedes encontrarte con Ahat después de subir a la Oficina Administrativa en Dicastes Diel."
		},
		Summary = ""
	},
	[7199] = {
		Title = "Orden secreta de Ahat",
		Description = {
			"Inicio: NPC: Secret Adjutant en Ubicacion: dic_in01 (294, 276). Ahat te ordenó eliminar varios rastros alrededor de la grieta. Recoge 10 objetos de cada uno: Mancha de sangre coagulada, Trozo de piel congelado y Piedras mágicas extrañas."
		},
		Summary = ""
	},
	[7200] = {
		Title = "La llamada de Cheshire",
		Description = {
			"Inicio: NPC: Secret Adjutant en Ubicacion: dic_in01 (294, 276). Realiza el trabajo de eliminación poco a poco para no levantar sospechas. Reúnase con Cheshire en la Oficina Administrativa cuando sea el momento adecuado."
		},
		Summary = "Espera el cronómetro y habla con Cheshire."
	},
	[7201] = {
		Title = "Eliminando rastros",
		Description = {
			"Inicio: NPC: Secret Adjutant en Ubicacion: dic_in01 (294, 276). Elimine los rastros de la brecha dimensional alrededor del área sureste de las afueras de la montaña Kamidal. Como de costumbre, recolecta 10 elementos de cada uno de Mancha de sangre coagulada, Trozo de piel congelado y Piedras mágicas extrañas."
		},
		Summary = ""
	},
	[7202] = {
		Title = "Orden secreta de Doha: recoger pruebas",
		Description = {
			"Inicio: NPC: BK en Ubicacion: dic_fild01 (231, 174). Sin que Cheshire y Ahat lo noten, oculte cada rastro de grieta para presentarlo a Doha como prueba y ponerlo en el informe. Recoge 1 mancha de sangre sólida, 1 trozo de piel congelada y 1 piedra mágica sospechosa."
		},
		Summary = ""
	},
	[7203] = {
		Title = "Orden secreta de Doha - Informe final",
		Description = {
			"Inicio: NPC: Jarute HesLanta en Ubicacion: dic_in01 (158, 188). Habló con Jarute, Heslanta sobre varios temas. Después de hablar con Heslanta, lleva tus hallazgos en un informe a Doha, en el campamento de expedición."
		},
		Summary = "Lleve su informe final al inspector Doha"
	},
	[7204] = {
		Title = "Primavera trayendo flores",
		Description = {
			"Conocí a \"Bomi\" en Lutie, que tenía curiosidad por saber que la primavera traería flores. Para ella, le prometí que le llevaría un ramo de flores de primavera. Puede ser suficiente con 5 (Enorme Spray De Flores).."
		},
		Summary = "Regala Bomi Spring"
	},
	[7206] = {
		Title = "Los nuevos días de Cheshire",
		Description = {
			"Inicio: NPC: Theore Set Guid en Ubicacion: sec_in02 (35, 175). Encontrarás un miembro de Cat Paw si miras en el medio del ^4d4dffKamidal Tunnel^000000. ^4d4dff En el lado oeste de la entrada de Skaraba Hall hay una caja marcada con productos.^000000. Por favor muévelo. La ubicación donde debes moverlo estará en la caja."
		},
		Summary = ""
	},
	[7207] = {
		Title = "La caja de Cheshire",
		Description = {
			"Inicio: NPC: Stacked Boxes of Goods en Ubicacion: dic_dun01 (274, 114). Encontraste la caja de que Cheshire hablaba sobre el túnel Kamidal. En la parte inferior de la caja, en letras minúsculas, dice ^4d4dff In Front of Bifrost's Crack^000000. Debe pasarle esto a Cheshire, que puede estar en cualquier lugar de Bifrost."
		},
		Summary = ""
	},
	[7208] = {
		Title = "¿Y mañana también, por favor?",
		Description = {
			"Inicio: NPC: Cheshire en Ubicacion: bif_fild01 (335, 168). Acordó ayudar a transportar la caja cargada a Cheshire una vez al día hasta el túnel Kamidal. Cuando llegue el momento, ve a buscar la caja."
		},
		Summary = ""
	},
	[7209] = {
		Title = "olvida la caja",
		Description = {
			"Inicio: NPC: Cheshire en Ubicacion: bif_fild01 (335, 168). La caja está perdida. En lugar de la caja, Cheshire te pide que consigas 20 bradio refinado en lugar de la caja."
		},
		Summary = "Bradio refinado: 20 cada uno"
	},
	[7210] = {
		Title = "Entrega diaria",
		Description = {
			"Inicio: NPC: Stacked Boxes of Goods en Ubicacion: dic_dun01 (274, 114). Cheshire está esperando la caja de Bradium. Debes llevar los artículos de hoy a Cheshire, que está esperando en Bifrost."
		},
		Summary = ""
	},
	[7211] = {
		Title = "Explora el bosque de niebla",
		Description = {
			"Inicio: NPC: Log Tunnel en Ubicacion: bif_fild01 (161, 355). Explora el bosque de niebla. El bosque de niebla te recuerda, por lo que si intentas forzar el reingreso puede que te rechace."
		},
		Summary = ""
	},
	[7212] = {
		Title = "Buscando a Loki",
		Description = {
			"Inicio: NPC: Log Tunnel en Ubicacion: bif_fild01 (161, 355). Por casualidad, conociste a alguien llamado Loki en el bosque y estás buscando a alguien. Jarani(¿nombre?) con el pelo morado. ¿Qué quiere decir esto? Si lo descubres, ¿deberías hacérselo saber a Loki?"
		},
		Summary = ""
	},
	[7213] = {
		Title = "Protector errante",
		Description = {
			"Inicio: NPC: Log Tunnel en Ubicacion: bif_fild01 (161, 355). Lo que Loki estaba buscando era al Guardián de Niddhog que deambulaba sin rumbo por la niebla. Una vez fuera del bosque, acordaron reunirse en Mora Village."
		},
		Summary = ""
	},
	[7214] = {
		Title = "Entrenamiento Avanzado en Comodo",
		Description = {
			"[Grupo Edén: Comodo Avanzado (Nv. 60-69) - Paso 1 de 5] Requisitos: Nivel Base: 60+. Siguiente mision: 7215 (Caza de Stalactic Golem). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Busca la cueva ubicada al norte. Hay alguien allí llamado Romeo. ¿Sabes? Como en Romeo, Romeo, ¿dónde estás que no te veo?"
		},
		Summary = "Encuentra a Romeo en Comodo"
	},
	[7215] = {
		Title = "Caza de Stalactic Golem",
		Description = {
			"[Grupo Edén: Comodo Avanzado (Nv. 60-69) - Paso 2 de 5] Requisitos: Nivel Base: 60+ | Mision previa: 7214 (Entrenamiento Avanzado en Comodo). Siguiente mision: 7216 (Más Caza de Golems). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Hay una cueva al norte de Comodo habitada por estos grandes monstruos. No debería ser difícil cazar 3 de ellos."
		},
		Summary = "Caza 3 Stalactic Golem"
	},
	[7216] = {
		Title = "Más Caza de Golems",
		Description = {
			"[Grupo Edén: Comodo Avanzado (Nv. 60-69) - Paso 3 de 5] Requisitos: Nivel Base: 60+ | Mision previa: 7215 (Caza de Stalactic Golem). Siguiente mision: 7217 (Objetos de campo). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Ahora que has demostrado tu valía, caza 10 Stalactic Golems más para que los viajeros puedan transitar seguros por la cueva, luego infórmale a Romeo, quien espera en el campo al norte de la Cueva de Comodo."
		},
		Summary = "Caza 10 Stalactic Golem"
	},
	[7217] = {
		Title = "Objetos de campo",
		Description = {
			"[Grupo Edén: Comodo Avanzado (Nv. 60-69) - Paso 4 de 5] Requisitos: Nivel Base: 60+ | Mision previa: 7216 (Más Caza de Golems). Siguiente mision: 7218 (Informar al Instructor Ur). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). El instructor Romeo te pidió que le lleves 5 Shoulder Protector y 7 Sharp Leaf cazando Wootans y Dryads en el campo al norte de la Cueva de Comodo."
		},
		Summary = "7 Sharp Leaf, 5 Shoulder Protector"
	},
	[7218] = {
		Title = "Informar al Instructor Ur",
		Description = {
			"[Grupo Edén: Comodo Avanzado (Nv. 60-69) - Paso 5 de 5] Requisitos: Nivel Base: 60+ | Mision previa: 7217 (Objetos de campo). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Tus tareas de la Fase 1 han terminado por ahora, así que regresa a la Sede del Grupo del Paraíso y habla con el Instructor Ur."
		},
		Summary = "Habla con el Instructor Ur"
	},
	[7219] = {
		Title = "Entrenamiento Avanzado en Glast Heim",
		Description = {
			"[Grupo Edén: Glast Heim Avanzado (Nv. 70-79) - Paso 1 de 4] Requisitos: Nivel Base: 70+. Siguiente mision: 7220 (Caza de Wraith). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Cerca de Geffen existe un área conocida como Glast Heim, infestada de no-muertos y monstruos fantasma. Encuentra a Johan en Glast Heim."
		},
		Summary = "Encuentra a Johan en Glast Heim"
	},
	[7220] = {
		Title = "Caza de Wraith",
		Description = {
			"[Grupo Edén: Glast Heim Avanzado (Nv. 70-79) - Paso 2 de 4] Requisitos: Nivel Base: 70+ | Mision previa: 7219 (Entrenamiento Avanzado en Glast Heim). Siguiente mision: 7221 (Caza de Evil Druid). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Ayuda a limpiar la Abadía cazando los Wraiths que habitan en su interior."
		},
		Summary = "Caza 20 Wraith"
	},
	[7221] = {
		Title = "Caza de Evil Druid",
		Description = {
			"[Grupo Edén: Glast Heim Avanzado (Nv. 70-79) - Paso 3 de 4] Requisitos: Nivel Base: 70+ | Mision previa: 7220 (Caza de Wraith). Siguiente mision: 7222 (Informar al Instructor Ur). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Otro monstruo problemático en la Abadía son los Evil Druids. Cázalos dentro de la Abadía y regresa con Johan."
		},
		Summary = "Caza 10 Evil Druid"
	},
	[7222] = {
		Title = "Informar al Instructor Ur",
		Description = {
			"[Grupo Edén: Glast Heim Avanzado (Nv. 70-79) - Paso 4 de 4] Requisitos: Nivel Base: 70+ | Mision previa: 7221 (Caza de Evil Druid). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Tu cacería en Glast Heim ha ayudado a purificar la Abadía. Regresa a la Sede del Grupo del Paraíso y habla con el Instructor Ur."
		},
		Summary = "Habla con el Instructor Ur"
	},
	[7223] = {
		Title = "Entrenamiento Avanzado en Einbroch",
		Description = {
			"[Grupo Edén: Einbroch Avanzado (Nv. 80-89) - Paso 1 de 6] Requisitos: Nivel Base: 80+. Siguiente mision: 7224 (Caza de Porcellio). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). La ciudad industrial de Einbroch, al este de Lighthalzen, es donde se llevará a cabo la siguiente misión de entrenamiento. Encuentra al Instructor Despachado Kiren en el campo al sur de Einbroch."
		},
		Summary = "Encuentra a Kiren al sur de Einbroch"
	},
	[7224] = {
		Title = "Caza de Porcellio",
		Description = {
			"[Grupo Edén: Einbroch Avanzado (Nv. 80-89) - Paso 2 de 6] Requisitos: Nivel Base: 80+ | Mision previa: 7223 (Entrenamiento Avanzado en Einbroch). Siguiente mision: 7225 (Fase 3, Segunda Parte - Una Pesadilla). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Como calentamiento, encuentra y caza 30 monstruos Porcellio que se arrastran por los campos de Einbroch."
		},
		Summary = "Caza 30 Porcellio"
	},
	[7225] = {
		Title = "Fase 3, Segunda Parte - Una Pesadilla",
		Description = {
			"[Grupo Edén: Einbroch Avanzado (Nv. 80-89) - Paso 3 de 6] Requisitos: Nivel Base: 80+ | Mision previa: 7224 (Caza de Porcellio). Siguiente mision: 7226 (Caza de Venomous). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Era una tarea de entrenamiento que reflejaba al 100% las quejas de los residentes de Einbroch para eliminar a Noxious, pero Kiren canceló unilateralmente la petición."
		},
		Summary = "No tienes que matar a Noxious"
	},
	[7226] = {
		Title = "Caza de Venomous",
		Description = {
			"[Grupo Edén: Einbroch Avanzado (Nv. 80-89) - Paso 4 de 6] Requisitos: Nivel Base: 80+ | Mision previa: 7225 (Fase 3, Segunda Parte - Una Pesadilla). Siguiente mision: 7227 (Caza de Teddy Bear). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Existen monstruos gaseosos verdes conocidos como Venomous que han estado aterrorizando a los trabajadores al norte de Einbroch."
		},
		Summary = "Caza 30 Venomous"
	},
	[7227] = {
		Title = "Caza de Teddy Bear",
		Description = {
			"[Grupo Edén: Einbroch Avanzado (Nv. 80-89) - Paso 5 de 6] Requisitos: Nivel Base: 80+ | Mision previa: 7226 (Caza de Venomous). Siguiente mision: 7228 (Informar al Instructor Ur). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Estos ositos de peluche no son los tiernos juguetes para niños. Caza 5 de ellos rápidamente en el campo al norte de Einbroch."
		},
		Summary = "Caza 5 Teddy Bear"
	},
	[7228] = {
		Title = "Informar al Instructor Ur",
		Description = {
			"[Grupo Edén: Einbroch Avanzado (Nv. 80-89) - Paso 6 de 6] Requisitos: Nivel Base: 80+ | Mision previa: 7227 (Caza de Teddy Bear). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Tu labor en el área de Einbroch ha concluido. Regresa a la Sede del Grupo del Paraíso y habla con el Instructor Ur."
		},
		Summary = "Habla con el Instructor Ur"
	},
	[7229] = {
		Title = "Entrenamiento Avanzado en Ice Cave",
		Description = {
			"[Grupo Edén: Cueva de Hielo / Ice Cave (Nv. 90-99) - Paso 1 de 4] Requisitos: Nivel Base: 90+. Siguiente mision: 7230 (Caza de Siroma). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Hay una Cueva de Hielo si viajas hacia el norte desde Rachel. Es una larga caminata, pero valdrá la pena si logras completarla. Encuentra a la Instructora Despachada Naomi en la Cueva de Hielo."
		},
		Summary = "Encuentra a Naomi en Ice Cave"
	},
	[7230] = {
		Title = "Caza de Siroma",
		Description = {
			"[Grupo Edén: Cueva de Hielo / Ice Cave (Nv. 90-99) - Paso 2 de 4] Requisitos: Nivel Base: 90+ | Mision previa: 7229 (Entrenamiento Avanzado en Ice Cave). Siguiente mision: 7231 (Caza y Recolección). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Podrías confundirlos con bolas gigantes de nieve, pero en realidad son monstruos disfrazados."
		},
		Summary = "Caza 30 Siroma"
	},
	[7231] = {
		Title = "Caza y Recolección",
		Description = {
			"[Grupo Edén: Cueva de Hielo / Ice Cave (Nv. 90-99) - Paso 3 de 4] Requisitos: Nivel Base: 90+ | Mision previa: 7230 (Caza de Siroma). Siguiente mision: 7232 (Informar al Instructor Ur). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Ahora que le agarraste el ritmo, caza 30 Siromas más y trae 30 Ice Cubic, 1 Sweet Sauce y 1 Milk."
		},
		Summary = "Caza 30 Siroma y lleva 30 Ice Cubic, 1 Sweet Sauce y 1 Milk a Naomi"
	},
	[7232] = {
		Title = "Informar al Instructor Ur",
		Description = {
			"[Grupo Edén: Cueva de Hielo / Ice Cave (Nv. 90-99) - Paso 4 de 4] Requisitos: Nivel Base: 90+ | Mision previa: 7231 (Caza y Recolección). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Has terminado la cacería en Ice Cave. Regresa a la Sede del Grupo del Paraíso y habla con el Instructor Ur."
		},
		Summary = "Habla con el Instructor Ur"
	},
	[7233] = {
		Title = "Entrenamiento Avanzado en Ash Vacuum",
		Description = {
			"[Grupo Edén: Ash Vacuum (3ra Clase, Nv. 100+) - Paso 1 de 5] Requisitos: Nivel Base: 100+. Siguiente mision: 7234 (El favor de Margaret). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Dado que perteneces a una tercera clase (3rd Class), deberías poder enfrentarte a los monstruos de Ash Vacuum con facilidad. Encuentra a Margaret en el Campamento de Expedición de Midgard."
		},
		Summary = "Encuentra a Margaret en el Campamento de Midgard"
	},
	[7234] = {
		Title = "El favor de Margaret",
		Description = {
			"[Grupo Edén: Ash Vacuum (3ra Clase, Nv. 100+) - Paso 2 de 5] Requisitos: Nivel Base: 100+ | Mision previa: 7233 (Entrenamiento Avanzado en Ash Vacuum). Siguiente mision: 7235 (Caza de Nepenthes). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Margaret te pidió que encuentres a los Instructores Despachados Meeru y Mine. Se encuentran en los campos justo al oeste y este del Campamento de Expedición de Midgard."
		},
		Summary = "Completa las misiones de Meeru y Mine y regresa con Margaret"
	},
	[7235] = {
		Title = "Caza de Nepenthes",
		Description = {
			"[Grupo Edén: Ash Vacuum (3ra Clase, Nv. 100+) - Paso 3 de 5] Requisitos: Nivel Base: 100+ | Mision previa: 7234 (El favor de Margaret). Siguiente mision: 7236 (Caza de Pinguicula). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Meeru te pidió cazar 1 monstruo Nepenthes en el campo de Manuk y regresar con él."
		},
		Summary = "Caza 1 Nepenthes"
	},
	[7236] = {
		Title = "Caza de Pinguicula",
		Description = {
			"[Grupo Edén: Ash Vacuum (3ra Clase, Nv. 100+) - Paso 4 de 5] Requisitos: Nivel Base: 100+ | Mision previa: 7235 (Caza de Nepenthes). Siguiente mision: 7237 (Informar al Instructor Ur). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Mine te pidió que caces 5 monstruos Pinguicula en su lugar."
		},
		Summary = "Caza 5 Pinguicula"
	},
	[7237] = {
		Title = "Informar al Instructor Ur",
		Description = {
			"[Grupo Edén: Ash Vacuum (3ra Clase, Nv. 100+) - Paso 5 de 5] Requisitos: Nivel Base: 100+ | Mision previa: 7236 (Caza de Pinguicula). Inicio: NPC: Instructor Ur en Ubicacion: Sede del Grupo Edén (moc_para01). Tu entrenamiento en Ash Vacuum ha finalizado. Regresa a la Sede del Grupo del Paraíso y habla con el Instructor Ur."
		},
		Summary = "Habla con el Instructor Ur"
	},
	[7238] = {
		Title = "Recados para Thorn (fácil)",
		Description = {
			"Thorn necesita materiales de refinamiento, así que llévale 20 Iron Ore y 10 Iron."
		},
		Summary = "Reúne 20 Iron Ore y 10 Iron"
	},
	[7239] = {
		Title = "Recados para Thorn (difícil)",
		Description = {
			"Thorn necesita materiales de refinamiento, así que llévale 20 Used Iron Plate."
		},
		Summary = "Reúne 20 Used Iron Plate"
	},
	[7240] = {
		Title = "Mejora de Equipamiento",
		Description = {
			"Inicio: NPC: Blacksmith Thorn en Ubicacion: moc_para01 (111, 83). Lleva tu nuevo equipamiento del Grupo del Paraíso a Thorn y pídele que lo refuerce por ti para recibir una bonificación aleatoria."
		},
		Summary = "Mejora con Thorn"
	},
	[7241] = {
		Title = "Tiempo de espera para Thorn",
		Description = {
			"Inicio: NPC: Blacksmith Thorn en Ubicacion: moc_para01 (111, 83). Regresa con Thorn tras esperar 24 horas."
		},
		Summary = "Espera 24 horas"
	},
	[7242] = {
		Title = "Juega con el gato bebé",
		Description = {
			"Inicio: NPC: Expert Cat en Ubicacion: malangdo (165, 223). La petición de Rato, un experto marinero de gatos en Malangdo. Él se preocupa por los gatos bebés, así que te pidió que los encontraras y jugaras con ellos. Ve a buscar esos gatos bebés. Son Rosy la blanca, Roku la negra y la dorada Charo."
		},
		Summary = ""
	},
	[7243] = {
		Title = "Brújula Nyadventure-Duruduru",
		Description = {
			"Recibiste la tarjeta de Aventura A de los gatos bebés que se hacían llamar \"Meow Bravery Team\". La tarjeta parece necesaria para operar algunos dispositivos fabricados por ellos. Si insertas la tarjeta en la Brújula inicial, el juego comenzará."
		},
		Summary = ""
	},
	[7244] = {
		Title = "Carrera Nyadventure-Duruduru",
		Description = {
			"Inicio: NPC: Beginning Compass en Ubicacion: malangdo (212, 204). La carrera Duruduru Compass ha comenzado. Tienes que terminar la carrera en el orden correcto dentro de un tiempo limitado. El orden de la brújula es (Llama Roja) -> (Llama Azul) -> (Llama Dorada) -> (Bosque) -> (Nube)."
		},
		Summary = ""
	},
	[7245] = {
		Title = "Carrera Nyadventure-Duruduru",
		Description = {
			"Inicio: NPC: Beginning Compass en Ubicacion: malangdo (212, 204). La carrera Duruduru Compass ha comenzado. Tienes que terminar la carrera en el orden correcto dentro de un tiempo limitado. El orden de la brújula es (Llama Dorada) -> (Llama Azul) -> (Nube) -> (Bosque) -> (Llama Roja)."
		},
		Summary = ""
	},
	[7246] = {
		Title = "Nyadventure-Ya voy.",
		Description = {
			"Inicio: NPC: [Meow Team] Charo en Ubicacion: malangdo (211, 203). Charo dice que un gato detective está cerca del barco Navi que está en el centro de Malangdo. Ve a encontrarte con el detective y su amigo."
		},
		Summary = ""
	},
	[7247] = {
		Title = "Nyadventure-¡Detén la explosión!",
		Description = {
			"Homnya, un gato dudoso que se hacía llamar un \"verdadero detective\" y su amigo Nyangson dicen que si la máquina de enfrente explota, todo Malangdo quedará destruido. Entonces te piden que detengas la máquina."
		},
		Summary = ""
	},
	[7249] = {
		Title = "Nyadventure-Bang! Nos vemos la próxima vez",
		Description = {
			"Inicio: NPC: Noisy Machine en Ubicacion: malangdo (174, 175). Según Homnya y Nyangson, esta máquina llamada Bang causa un problema cada minuto. Nunca se sabe cuándo estará en problemas. Mañana vuelve a comprobar la máquina."
		},
		Summary = ""
	},
	[7250] = {
		Title = "¿Tesoro escondido de Nyadventure?",
		Description = {
			"Inicio: NPC: Cat Detective en Ubicacion: malangdo (172, 178). Cuando cesó la explosión, Homnya y Nyangson te brindan información útil. Hablan de atesorar algo. Homnya dice que el tesoro está dentro del barco Navi. Puede que sea sólo una broma, pero aun así vale la pena intentarlo."
		},
		Summary = ""
	},
	[7251] = {
		Title = "Nyadventure-La primera pieza de pintura.",
		Description = {
			"La pieza de pintura que encontraste en la caja del barco Navi."
		},
		Summary = ""
	},
	[7252] = {
		Title = "Nyadventure-La segunda pieza de pintura.",
		Description = {
			"La pieza de pintura que se puso en el libro en la sala de reuniones del barco Navi."
		},
		Summary = ""
	},
	[7253] = {
		Title = "Nyadventure-La tercera pieza de pintura",
		Description = {
			"El cuadro que encontraste debajo de la vieja cama en la cabina de la tripulación."
		},
		Summary = ""
	},
	[7254] = {
		Title = "Nyadventure-La cuarta pieza de pintura",
		Description = {
			"La pieza de Pintura que encontraste en la concha decorativa de la habitación del capitán."
		},
		Summary = ""
	},
	[7255] = {
		Title = "Nyadventure-La Quinta pieza de Pintura",
		Description = {
			"La pieza de pintura que encontraste en la grieta del pilar de madera."
		},
		Summary = ""
	},
	[7256] = {
		Title = "Nyadventure-La sexta pieza de pintura",
		Description = {
			"La pieza de pintura que encontraste en la ventana de ventilación en el piso de la cabina."
		},
		Summary = ""
	},
	[7257] = {
		Title = "Nyadventure-Race, ¡vuelve mañana!",
		Description = {
			"Duruduru Race es buena si solo corres una vez al día. Si lo quieres, vuelve más tarde."
		},
		Summary = ""
	},
	[7258] = {
		Title = "Nyadventure-Pintura completada",
		Description = {
			"Inicio: NPC: Cat Detective en Ubicacion: malangdo (172, 178). Las piezas que encontraste en el barco son más de 6. Parece una pintura completa. Ve con Charo, Rosy Roku y hazles saber esto."
		},
		Summary = ""
	},
	[7259] = {
		Title = "Regalo del equipo Mew Bravery",
		Description = {
			"Charo, Rosy y Roku dicen que quieren entregarle a Rato los cuadros encontrados. Llévale el cuadro a Rato para transmitirle el amor de los gatos bebés (aunque el cuadro esté destrozado)."
		},
		Summary = ""
	},
	[7260] = {
		Title = "El origen de los errores",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). Cleanyang llora en voz alta diciendo que los insectos aparecen una y otra vez aunque limpia el barco por completo. Ayúdalo. Inspecciona el barco Navi meticulosamente."
		},
		Summary = ""
	},
	[7261] = {
		Title = "Recoge la galleta del barco del gato: la habitación del capitán",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). En un rincón de la habitación del capitán, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7262] = {
		Title = "Recoge la cabina de la tripulación de galletas del barco de gato",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). En la habitación del marinero, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7263] = {
		Title = "Recoja la sala de reuniones de galletas Cat's Ship",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). En algún lugar de la sala de reuniones, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7264] = {
		Title = "Al Chef Nyas",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). Cleanyang limpió todo el barco, pero el problema eran las galletas duras de gato que se mantenían fuera de su alcance. Deberías decirle a Nyas la verdad y aclarar a Cleanyang la acusación falsa."
		},
		Summary = "Hablando con Nyas"
	},
	[7265] = {
		Title = "La ira del Chef Nyas",
		Description = {
			"Inicio: NPC: Chef Nyas en Ubicacion: mal_in02 (187, 58). Cuando le contaste la historia de la galleta y los insectos, el chef se enojó mucho. Será mejor que hables con él un poco más tarde."
		},
		Summary = "Hablando con Nyas"
	},
	[7266] = {
		Title = "Declaración del Chef Nyas",
		Description = {
			"Inicio: NPC: Chef Nyas en Ubicacion: mal_in02 (187, 58). Nyas decidió por sí mismo y declaró que a partir de ahora al menos una comida al día será pan comido. Te pidió que trajeras 10 bolsas de cereales y 1 botella de salsa salada para hacer las galletas."
		},
		Summary = "10 bolsas de cereales, 1 botella de salsa salada y entrega el mensaje a Cleanyang."
	},
	[7267] = {
		Title = "Hora señalada con Cleanyang",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). Para resolver el incidente de las galletas duras del gato, trabajarás con Cleanyang. Regrese a Cleanyang a la hora acordada."
		},
		Summary = ""
	},
	[7268] = {
		Title = "¡Encuentra las galletas duras del gato!",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). Vas a recoger las galletas que los gatos del barco empezaron a esconder. Si se toman las galletas, los insectos también desaparecerán. Concéntrate en los 9 lugares donde se ven con frecuencia las galletas."
		},
		Summary = ""
	},
	[7269] = {
		Title = "Recoger área de descanso de galletas de Cat's Ship",
		Description = {
			"Inicio: NPC: Cleanyang en Ubicacion: mal_in02 (76, 63). En la maleza del área de descanso al aire libre, descubriste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7270] = {
		Title = "Recoge el área de arena y galletas de Cat's Ship",
		Description = {
			"En un extraño montón de arena, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7271] = {
		Title = "Recoge la galleta de barco de gato: debajo de las escaleras.",
		Description = {
			"Inicio: NPC: Strange Pile of Sand en Ubicacion: malangdo (133, 134). En la esquina debajo de las escaleras, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7272] = {
		Title = "Recoge el rincón de galletas Cat's Ship de la torre Cat",
		Description = {
			"Inicio: NPC: Strange Pile of Sand en Ubicacion: malangdo (133, 134). En la esquina de la torre para gatos, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7273] = {
		Title = "Recoge el rincón de galletas del barco de gato del casillero",
		Description = {
			"Inicio: NPC: Strange Pile of Sand en Ubicacion: malangdo (133, 134). En el espacio entre el casillero y la pared, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7274] = {
		Title = "Recoge la galleta del barco del gato: punto de apoyo de la torre del gato",
		Description = {
			"Inicio: NPC: Strange Pile of Sand en Ubicacion: malangdo (133, 134). En el hueco entre el punto de apoyo para los pies y el suelo, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7275] = {
		Title = "Recoge la tumba de arena y galletas del barco del gato",
		Description = {
			"En una tumba de arena, encontraste una galleta dura de gato que estaba escondida. La galleta estaba toda cubierta de insectos. Esos bichos deben estar ahí para la galleta."
		},
		Summary = ""
	},
	[7276] = {
		Title = "Promesa de entregar más comida",
		Description = {
			"Inicio: NPC: Chef Nyas en Ubicacion: mal_in02 (187, 58). El chef Nyas quiere que le entregues el ingrediente de la galleta todos los días y de alguna comida nueva. De todos modos, vuelve con él siempre que puedas."
		},
		Summary = ""
	},
	[7281] = {
		Title = "Lista de diligencias de Nyas",
		Description = {
			"El chef Nyas te ordenó que trajeras 10 bolsas de cereales y 1 botella de salsa salada. Y también quiere que consigas la comida a continuación por su curiosidad por la comida humana."
		},
		Summary = "10 bolsas de cereales, 1 botella de salsa salada, 1 zumo de uva con miel"
	},
