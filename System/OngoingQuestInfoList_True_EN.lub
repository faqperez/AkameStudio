	},
	[7489] = {
		Title = "Plan de liquidación silenciosa",
		Description = {
			"En el letrero de tareas diversas, se te pidió que derrotaras en secreto a un Familiar. Derrota al Familiar en la mazmorra piramidal al oeste de Marruecos."
		},
		Summary = "Liquidación de Familiares"
	},
	[7490] = {
		Title = "Sopa de champiñones llamando recuerdos",
		Description = {
			"El letrero de tareas diversas te pide que encuentres setas. Reúnete con Mash cerca del oasis y muévete a la granja de hongos, regresa con 3 hongos pegajosos de pelo escarlata."
