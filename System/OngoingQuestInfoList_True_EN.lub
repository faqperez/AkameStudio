	[14464] = {
		Title = "La fiesta dura toda la noche",
		Description = {
			"¡Gracias por hacerme un favor! Una vez que termine la fiesta necesitaremos decoraciones nuevamente, ¿podrías venir mañana?"
		},
		Summary = "esperando un dia"
	},
	[14465] = {
		Title = "Los chicos todavía están callados",
		Description = {
			"Gracias por manejarlo tan limpiamente. Me gustaría que mañana vuelvas a liderar el camino."
		},
		Summary = "esperando un dia"
	},
	[14466] = {
		Title = "Una semana de descanso",
		Description = {
			"Estás agotado después de terminar la solicitud. Parece que necesitas descansar aproximadamente una semana."
		},
		Summary = "Una semana de descanso"
	},
	[14467] = {
		Title = "Una semana de descanso",
		Description = {
			"Estás agotado después de terminar la solicitud. Parece que necesitas descansar aproximadamente una semana."
		},
		Summary = "Una semana de descanso"
	},
	[14468] = {
		Title = "Una semana de descanso",
		Description = {
			"Estás agotado después de terminar la solicitud. Parece que necesitas descansar aproximadamente una semana."
		},
		Summary = "Una semana de descanso"
	},
	[14469] = {
		Title = "Mire alrededor de la familia Walther",
		Description = {
			"Inicio: NPC: Ian Walther en Ubicacion: prt_cas_q (20, 184). La familia Wigner parece bastante tranquila. Mira a tu alrededor y encuentra a Isenhonor que parecía molesta."
		},
		Summary = "Mira a tu alrededor"
	},
	[14470] = {
		Title = "En busca del caballero guardián",
		Description = {
			"Inicio: NPC: Isenhonor Walther en Ubicacion: prt_cas_q (14, 184). Puede que mi Caballero Guardián no sepa nada. Si tienes que conocerlo, puedes ir a nuestra mansión en el sur de Alberta."
		},
		Summary = "A Alberta"
	},
	[14471] = {
		Title = "A la prisión real",
		Description = {
			"Inicio: NPC: Guardian Knight en Ubicacion: alberta (187, 147). Debe haber un ladrón llamado Big Foot atrapado en la prisión del Palacio Prontera. Quizás escuches algo de él. Por favor dígale a Isenhonor que estaré esperando su pedido como siempre."
		},
		Summary = "A la prisión real"
	},
	[14472] = {
		Title = "Pie Grande Gourmet",
		Description = {
			"Inicio: NPC: Bigfoot en Ubicacion: prt_pri00 (57, 119). Quiero comer 3 Bao fritos picantes y 1 ensalada verde. Tienes que traérmelos para escuchar mi historia."
		},
		Summary = "trae la comida"
	},
	[14473] = {
		Title = "a las venas",
		Description = {
			"Inicio: NPC: Bigfoot en Ubicacion: prt_pri00 (57, 119). Estaba en Venas. ¡Realmente estaba en Veins!"
		},
		Summary = "a las venas"
	},
	[14474] = {
		Title = "Informe a Isenhonor",
		Description = {
			"Inicio: NPC: K en Ubicacion: veins (156, 160). Has recibido la carta enviada por Isenarm de su Caballero Guardián. Volvamos ahora a Isenhonor."
		},
		Summary = "Informe a Isenhonor"
	},
	[14475] = {
		Title = "A Jürgen",
		Description = {
			"Inicio: NPC: Levuiere Wigner en Ubicacion: prt_cas_q (82, 21). Habla más con Jurgen el candidato al trono."
		},
		Summary = "A Jürgen"
	},
	[14476] = {
		Title = "A Levuiere y su esposa",
		Description = {
			"Inicio: NPC: Jurgen Wigner en Ubicacion: prt_cas_q (95, 9). ¿Por qué no vas a tomar una taza de té con mis padres si tienes tiempo? Realmente disfrutan contando las historias de las aventuras."
		},
		Summary = "A Levuiere y su esposa"
	},
	[14477] = {
		Title = "¿Qué está pasando?",
		Description = {
			"Inicio: NPC: Levuiere Wigner en Ubicacion: prt_cas_q (82, 21). Katrin, ¿le ha pasado algo a mi bebé? No podría vivir si le hubiera pasado algo."
		},
		Summary = "A Katrina"
	},
	[14478] = {
		Title = "Buscando la pista",
		Description = {
			"Inicio: NPC: Katrin Wigner en Ubicacion: prt_cas_q (96, 7). Una criada estaba aquí para limpiar la habitación. Vamos a preguntarle sobre el paradero de la caja."
		},
		Summary = "A la cocina real"
	},
	[14479] = {
		Title = "Limpieza de disculpa",
		Description = {
			"Inicio: NPC: Maid en Ubicacion: prt_cas (322, 216). ¿Quién más estaba ahí? No lo sé... Quizás lo recuerde si este lugar vuelve a estar limpio. ¿Me lo limpiarías? Ah, gracias. Primero debes limpiar el moho de la pared, quitar la grasa y limpiar el piso."
		},
		Summary = "empecemos a limpiar"
	},
	[14480] = {
		Title = "Conquista la grasa",
		Description = {
			"Inicio: NPC: Sticky Wall en Ubicacion: prt_cas (339, 198). Necesitas la mezcla de naranja y alcohol para limpiar la grasa. Trae 1 Naranja y 1 Alcohol."
		},
		Summary = "Consigue los materiales para la limpieza."
	},
	[14481] = {
		Title = "Conquista el molde",
		Description = {
			"Inicio: NPC: Dark and Damp Wall en Ubicacion: prt_cas (339, 212). No puedes deshacerte del moho sin el poder de su propia especie y el poder de Dios. ¡Trae 1 Polvo de Molde y 1 Agua Bendita!"
		},
		Summary = "Consigue los materiales para la limpieza."
	},
	[14482] = {
		Title = "Conquista la suciedad del diablo",
		Description = {
			"Inicio: NPC: Pitch-black Floor en Ubicacion: prt_cas (309, 215). ¡Para eliminar el objetivo, necesitas 1 limón y 1 arena en polvo! ¡Ve a buscarlos ahora! ¡Ir!"
		},
		Summary = "Consigue los materiales para la limpieza."
	},
	[14483] = {
		Title = "Informar la finalización de la limpieza",
		Description = {
			"Inicio: NPC: Pitch-black Floor en Ubicacion: prt_cas (309, 215). La limpieza está completa. Ve a ver a la criada para informar y escuchar su historia."
		},
		Summary = "a la criada"
	},
	[14484] = {
		Title = "Había un repartidor de muebles",
		Description = {
			"Inicio: NPC: Maid en Ubicacion: prt_cas (322, 216). Había un señor entregando los muebles todo el día. Por eso tuve que quedarme allí todo el día para limpiar la habitación. Debe estar cerca de la oficina del pueblo. Hay muchas tiendas en la zona."
		},
		Summary = "Encuentra al repartidor"
	},
	[14485] = {
		Title = "estoy molesto",
		Description = {
			"Inicio: NPC: Furniture Deliveryman en Ubicacion: prontera (68, 68). Oh, he sido bueno toda mi vida, ¿y esto es lo que obtengo? Oh, no tengo fuerzas para vivir... Sin embargo, 3 rebanadas de cabeza de buey pueden animarme."
		},
		Summary = "Comida para el alma"
	},
	[14486] = {
		Title = "Escuché la historia",
		Description = {
			"Inicio: NPC: Furniture Deliveryman en Ubicacion: prontera (68, 68). Has oído la historia. Volvamos al palacio para informarle a Jurgen."
		},
		Summary = "A Jürgen"
	},
	[14487] = {
		Title = "Por favor encuentre la muestra de la memoria",
		Description = {
			"Inicio: NPC: Jurgen Wigner en Ubicacion: prt_cas_q (95, 9). Para animar a mi hermana, es posible que tengamos que traerle las cosas que su hermana aprecia. Traigamos 10 piedras de mar y 1 rosa marchita. Puedes conseguir las Piedras del Mar cuando cazas la Medusa."
		},
		Summary = "Encuentra la ficha de la memoria"
	},
	[14488] = {
		Title = "Por favor entrega mi amor",
		Description = {
			"Inicio: NPC: Jurgen Wigner en Ubicacion: prt_cas_q (95, 9). Por favor, hazle saber de mi amor por ella. Por favor, ayúdame."
		},
		Summary = "a la criada"
	},
	[14489] = {
		Title = "Tengo que bajarlo",
		Description = {
			"Inicio: NPC: Maid en Ubicacion: prt_cas (322, 216). Nunca esperé esto y me siento presionado. Además, tengo una razón por la que no puedo ver a nadie ahora. Por favor, dígale mis palabras sin herir sus sentimientos."
		},
		Summary = "A Jürgen"
	},
	[14490] = {
		Title = "Mi amor una vez más",
		Description = {
			"Inicio: NPC: Jurgen Wigner en Ubicacion: prt_cas_q (95, 9). Quiero mostrarle mi corazón tan ancho como el mar y mi pasión eterna. Por favor, entrega mi amor por ella con 15 piedras marinas que se pueden adquirir al cazar Medusa y 1 rosa marchita."
		},
		Summary = "Regalo para la doncella"
	},
	[14491] = {
		Title = "Tengo que bajarlo de nuevo",
		Description = {
			"Inicio: NPC: Maid en Ubicacion: prt_cas (322, 216). Lo siento... Pero en realidad... Por favor, díselo al Príncipe Wigner sin herir sus sentimientos."
		},
		Summary = "A Jürgen"
	},
	[14492] = {
		Title = "Hay un lado positivo",
		Description = {
			"Inicio: NPC: Jurgen Wigner en Ubicacion: prt_cas_q (95, 9). ¿Volverías más tarde? El tiempo justo para ella para que no se sienta presionada sin olvidarme. Después de un tiempo, ¡me gustaría volver a entregarle mi corazón!"
		},
		Summary = "Por favor vuelve otra vez"
	},
	[14493] = {
		Title = "hoy me siento",
		Description = {
			"Inicio: NPC: Jurgen Wigner en Ubicacion: prt_cas_q (95, 9). ¿Qué tengo que hacer? Mary me gusta aún más hoy. Por favor, entrega mi amor por ella con 15 piedras marinas que se pueden adquirir al cazar Medusa y 1 rosa marchita."
		},
		Summary = "Regalo para la doncella"
	},
	[14494] = {
		Title = "Tengo que bajarlo de nuevo",
		Description = {
			"Inicio: NPC: Maid en Ubicacion: prt_cas (322, 216). Por favor, realmente aprecio sus sentimientos. Sin embargo, no puedo aceptarlo. Por favor díselo sin herir sus sentimientos."
		},
		Summary = "A Jürgen"
	},
	[14495] = {
		Title = "al lobo",
		Description = {
			"Inicio: NPC: Maximilian Roegenburg en Ubicacion: prt_cas_q (90, 186). Escuchemos la historia de la familia de Wolf Roegenburg."
		},
		Summary = "al lobo"
	},
	[14496] = {
		Title = "a isaac",
		Description = {
			"Inicio: NPC: Wolf Roegenburg en Ubicacion: prt_cas_q (96, 186). Si conoces a Isaac de la familia Wigner, entrégale lo que te pedí. La residencia Wigner se encuentra al final del pasillo."
		},
		Summary = "a isaac"
	},
	[14497] = {
		Title = "Entrega para lobo",
		Description = {
			"Inicio: NPC: Isaac Wigner en Ubicacion: prt_cas_q (94, 7). Por favor, entregue la caja a Wolf. Hay que tener cuidado con eso. Es peligroso."
		},
		Summary = "Entrega para lobo"
	},
	[14498] = {
		Title = "cual rumor",
		Description = {
			"Inicio: NPC: Wolf Roegenburg en Ubicacion: prt_cas_q (96, 186). Si hay un mal rumor sobre nuestra familia dando vueltas en Prontera, no puedo simplemente esperar y ver. Necesito saber cuál es el rumor a punto de abordarlo. Por favor recopile los rumores por mí. Es posible que los escuche de niños pequeños."
		},
		Summary = "Recoge los rumores"
	},
	[14499] = {
		Title = "Ponte a prueba",
		Description = {
			"Inicio: NPC: Myer Roegenburg en Ubicacion: prt_cas_q (92, 182). Demuestre que es elegible para escuchar la historia. ¡Caza 33 Majoruros! ¡Y trae el libro de historia de Rune Midgarts de la biblioteca! ¡Oh, también necesito 12 paños de seda suave!"
		},
		Summary = "Ponte a prueba"
	},
	[14500] = {
		Title = "Completar la consulta del libro.",
		Description = {
			"Inicio: NPC: Uptight Librarian en Ubicacion: prt_cas (343, 67). Has consultado el libro de historia de Rune Midgarts."
		},
		Summary = "Completar la consulta del libro."
	},
	[14501] = {
		Title = "Informe a lobo",
		Description = {
			"Inicio: NPC: Myer Roegenburg en Ubicacion: prt_cas_q (92, 182). Ya que has oído el rumor, vayamos a ver a Wolf y le contemos toda la historia."
		},
		Summary = "Informe a lobo"
	},
	[14502] = {
		Title = "a isaac",
		Description = {
			"Inicio: NPC: Wolf Roegenburg en Ubicacion: prt_cas_q (96, 186). Por favor, entregue este documento a Isaac. Tengo muchas cosas que hacer a partir de ahora. Entonces te estoy defendiendo."
		},
		Summary = "a isaac"
	},
	[14503] = {
		Title = "Informe a lobo",
		Description = {
			"Inicio: NPC: Isaac Wigner en Ubicacion: prt_cas_q (94, 7). Por favor, dígale a Wolf que respeto su decisión y confío en él como siempre."
		},
		Summary = "al lobo"
	},
	[14504] = {
		Title = "En busca de Helmut",
		Description = {
			"Inicio: NPC: Wolf Roegenburg en Ubicacion: prt_cas_q (96, 186). ¿Convencerías a Helmut y me lo traerías? Estaría en la guarnición fronteriza de Schwaltzvalt."
		},
		Summary = "En busca de Helmut"
	},
	[14505] = {
		Title = "no volveré",
		Description = {
			"Inicio: NPC: Helmut Roegenburg en Ubicacion: yuno_fild01 (242, 175). Pertenezco aquí. Por favor, díselo a mi abuelo."
		},
		Summary = "A Maximiliano"
	},
	[14506] = {
		Title = "Las cosas resultaron así",
		Description = {
			"Inicio: NPC: Maximilian Roegenburg en Ubicacion: prt_cas_q (90, 186). Por favor, dígale a Myer, quien dejó la casa, que las cosas han resultado así en casa. Puede huir si uno de los miembros de la familia va allí."
		},
		Summary = "a myer"
	},
	[14507] = {
		Title = "A Maximiliano",
		Description = {
			"Inicio: NPC: Myer Roegenburg en Ubicacion: prt_cas_q (92, 182). Resultó bien. Todo está bien ahora. Por favor, dile que iré a visitarlo cuando termine el banquete."
		},
		Summary = "A Maximiliano"
	},
	[14508] = {
		Title = "Joya y tela",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). Por favor trae 3 perlas y 50 mechones de cabello suave."
		},
		Summary = "Joya y tela"
	},
	[14509] = {
		Title = "Todavía lo logro",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). Aún estoy en proceso de realizarlo con lo que me has traído. Decidiré qué hacer después de terminar el trabajo. ¿Volvería después del amanecer?"
		},
		Summary = "Por favor espera"
	},
	[14510] = {
		Title = "Vestido rosa con forma de pétalo",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). ¡Haré un vestido tan hermoso como un pétalo de rosa! ¿Traerías 15 paños suaves y sedosos, 30 hierbas rojas y 10 hierbas blancas para teñir la tela?"
		},
		Summary = "Pétalo rosa"
	},
	[14511] = {
		Title = "Hermosa decoración floral.",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). Lo decoraré con flores humildes pero hermosas. Por favor, consígueme 5 flores bonitas, 5 flores puras y 5 flores misteriosas."
		},
		Summary = "Flores en el jardín"
	},
	[14512] = {
		Title = "Vestido del cielo nocturno",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). ¡Haré un vestido tan oscuro como el cielo nocturno! Necesito tela más oscura que el cielo nocturno. ¿Traerías 20 piezas de tela negra? Por favor."
		},
		Summary = "Cielo nocturno negro"
	},
	[14513] = {
		Title = "Mantón del Sol Ardiente",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). Quiero hacer un chal que se parezca al sol abrasador en el cielo. Creo que necesito 20 pelos calientes para hacerlo."
		},
		Summary = "Mantón del Sol"
	},
	[14514] = {
		Title = "paso del hada",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). Haré un vestido tan aireado y elegante como el paso de un hada. ¡Uno precioso! Necesito 5 espléndidas alas de hada. Bastaría con hacer un vestido elegante."
		},
		Summary = "paso del hada"
	},
	[14515] = {
		Title = "Estrella chispeante",
		Description = {
			"Inicio: NPC: Agnes Roegenburg en Ubicacion: prt_cas_q (96, 184). ¡Quiero rociar el vestido con estadísticas brillantes! Por favor, consígueme polvos de 5 estrellas para decorar el vestido."
		},
		Summary = "Estrella chispeante"
	},
	[14516] = {
		Title = "Sombra sospechosa",
		Description = {
			"Inicio: NPC: Ian Walther en Ubicacion: prt_cas_q (20, 184). Escuché la conversación entre una persona sospechosa e Ian."
		},
		Summary = "Sombra sospechosa"
	},
	[14517] = {
		Title = "Entrega de refrigerios a medianoche",
		Description = {
			"Entregaste el refrigerio de medianoche"
		},
		Summary = "Entrega de refrigerios a medianoche"
	},
	[14518] = {
		Title = "Enfriamiento de chicle",
		Description = {
			"Puede utilizar el servicio efecto chicle dos veces antes de la hora de reinicio todos los días."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[14518] = {
		Title = "Enfriamiento de chicle",
		Description = {
			"Puede utilizar el servicio efecto chicle dos veces antes de la hora de reinicio todos los días."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[14519] = {
		Title = "Enfriamiento del manual de batalla",
		Description = {
			"Puedes utilizar el servicio de efecto JOB Battle Manual dos veces antes de la hora de reinicio todos los días."
		},
		Summary = "Se reinicia a las 04:00"
	},
	[14519] = {
		Title = "Enfriamiento del manual de batalla",
		Description = {
			"Puedes utilizar el servicio de efecto JOB Battle Manual dos veces antes de la hora de reinicio todos los días."
		},
		Summary = "Se reinicia a las 04:00"
	},
