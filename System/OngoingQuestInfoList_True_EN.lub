		},
		Summary = ""
	},
	[13017] = {
		Title = "Solicitud del lobo del desierto",
		Description = {
			"La cueva de hielo está directamente al norte de Rachel. El problema es que los lobos asustan a los turistas cuando se dirigen a ver la cueva de hielo."
		},
		Summary = "Caza 30 lobos del desierto y regresa a Gelkah."
