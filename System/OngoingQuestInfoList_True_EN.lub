	[1013] = {
		Title = "Cambio de trabajo a ladrón",
		Description = {
			"Inicio: NPC: Thief Guide en Ubicacion: moc_prydb1 (39, 129). Roba setas de la granja de Shibu. Reúne 2 tipos de hongos: ^0000FFOrange Net Mushroom^000000 por 3 puntos y ^0000FFOrange Gooey Mushroom^000000 por 1 punto. Necesitas un total de 25 puntos para aprobar el examen. Dirígete hacia el Campo Oriental de las Pirámides."
		},
		Summary = "Recoger setas"
	},
	[1014] = {
		Title = "Cambio de trabajo a espadachín",
		Description = {
			"Inicio: NPC: Swordman en Ubicacion: izlude_in (74, 172). El propósito de esta prueba es confirmar si estás calificado o no para ser un espadachín. Ahora bien, las condiciones para realizar esta prueba son muy sencillas. Viajará a través de tres cursos y deberá llegar al punto de control final en ^FF000010 minutos^000000."
		},
		Summary = "Llega al punto de control final"
	},
	[1015] = {
		Title = "Tu primera búsqueda",
		Description = {
			"Has recibido un Bao. Es un panecillo sabroso que los eruditos orientales tradicionalmente comen antes de estudiar. Recientemente, estos eruditos han descubierto que un estómago lleno de Bao es la suma de toda la lógica."
		},
		Summary = "Habla con el tutor Cicero de Quest Guide y asegúrate de tener todavía el Bao"
	},
