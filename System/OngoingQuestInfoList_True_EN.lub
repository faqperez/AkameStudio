		},
		Summary = ""
	},
	[4344] = {
		Title = "Encuentra las madrigueras del conejo",
		Description = {
			"En la zona de Hugel hay varios pozos donde se esconden los ladrones de conejos."
		},
		Summary = ""
	},
	[4345] = {
		Title = "Temporizador de reinicio de Pascua",
		Description = {
			"Espere hasta que el temporizador haya expirado para volver a intentarlo."
		},
		Summary = ""
	},
	[4357] = {
		Title = "Cazar a Santa Lunático",
		Description = {
			"Derrota a 3 Santa Lunatic, cerca de los campos de prontera y geffen."
		},
		Summary = ""
	},
	[4358] = {
