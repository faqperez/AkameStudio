	[12269] = {
		Title = "Caza celacanto violento",
		Description = {
			"¡Héroe de Culvert, fijamos una semana de caza ^0000ffViolent Celacanto^000000 y alzamos la voz! ¡Te daré sólo una semana para terminar este trabajo! ¡Termiante todos en modo difícil en la mazmorra de alcantarilla!"
		},
		Summary = "Caza 1 celacanto violento: aparece aleatoriamente en el modo difícil de Culvert Dungeon"
	},
	[12270] = {
		Title = "Cazar celacanto mutante",
		Description = {
			"¡El héroe de Culvert, fijamos una semana de caza ^0000ffMutant Coelacanth^000000 y alzamos la voz! ¡Te daré sólo una semana para terminar este trabajo! ¡Termiante todos en modo difícil en la mazmorra de alcantarilla!"
		},
		Summary = "Caza 1 celacanto mutante: aparece aleatoriamente en el modo difícil de Culvert Dungeon"
	},
	[12271] = {
		Title = "En curso servicio de alcantarilla general de un solo día",
		Description = {
			"Ya tienes 1 servicio solicitado. Como ya lo ha hecho, no podrá recibir una nueva solicitud durante un día."
		},
		Summary = "Estás a cargo de Culvert, normal por 1 día."
	},
	[12272] = {
		Title = "Servicio de un solo día de alcantarilla dura en progreso",
		Description = {
			"Ya tienes 1 servicio solicitado. Como ya lo ha hecho, no podrá recibir una nueva solicitud durante un día."
		},
		Summary = "Estás a cargo de Culvert, difícil durante 1 día."
	},
	[12273] = {
		Title = "En proceso servicio semanal de alcantarilla general",
		Description = {
			"Ya tienes 1 servicio solicitado. Como ya lo ha hecho, no podrá recibir una nueva solicitud durante 7 días."
		},
		Summary = "Estás a cargo de Culvert, normal durante 7 días."
	},
	[12274] = {
		Title = "Servicio semanal de alcantarilla dura en progreso",
		Description = {
			"Ya tienes 1 servicio solicitado. Como ya lo ha hecho, no podrá recibir una nueva solicitud durante 7 días."
		},
		Summary = "Estás a cargo de Culvert, duro durante 7 días."
	},
