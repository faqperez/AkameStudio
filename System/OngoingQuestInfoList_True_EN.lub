	},
	[1328] = {
		Title = "Artículos perdidos encontrados",
		Description = {
			"Inicio: NPC: Mrs. McPhy en Ubicacion: harboro1 (347, 65). Encontré lo que la señora McPhy busca dentro de uno de los agujeros que cavó Spotty. Debería volver con la señora McPhy."
		},
		Summary = "Regresar con la Sra. McPhy"
	},
	[1329] = {
		Title = "Manchado en el país de los sueños",
		Description = {
			"Inicio: NPC: Mrs. McPhy en Ubicacion: harboro1 (347, 65). Spotty parece haber terminado el día; está profundamente dormido. Debería volver mañana después de las 4:00 a. m. y preguntarle a la señora McPhy si necesita ayuda."
		},
		Summary = "Vuelva a visitar a la Sra. McPhy después de las 4:00 a. m. del día siguiente."
	},
	[1330] = {
		Title = "Los agujeros de Spotty",
		Description = {
			"Inicio: NPC: Mrs. McPhy en Ubicacion: harboro1 (347, 65). El señor McPhy me dirá dónde cree que están los agujeros de Spotty. Debería salir del pueblo y buscarlo."
		},
		Summary = "Busque al Sr. McPhy fuera del pueblo."
	},
	[1331] = {
		Title = "Vengador Manchado",
		Description = {
			"Inicio: NPC: Mr. McPhy en Ubicacion: harboro1 (344, 61). El señor McPhy, convencido de que los Buffalo Bandits habían hecho daño a Spotty, me pidió que me ocupara de ellos. Debería derrotar a 3 Buffalo Bandits de pelo amarillo, 3 de pelo negro y 3 de pelo blanco."
		},
		Summary = "Derrota a los bandidos de búfalo"
	},
	[1332] = {
		Title = "Sangre por sangre",
		Description = {
			"Inicio: NPC: Mr. McPhy en Ubicacion: harboro1 (344, 61). El Sr. McPhy aún no ha terminado de vengar a Spotty. Debería regresar con el Sr. McPhy en la ciudad después de las 4:00 a. m. del día siguiente."
		},
		Summary = "Vuelva a visitar al Sr. McPhy después de las 4:00 a. m. del día siguiente."
	},
	[1333] = {
		Title = "Dulce tentación",
		Description = {
			"Ayuda al hombre a luchar contra el olor dulce cazando el monstruo 5 Sweets Drops."
		},
		Summary = "Cuida 5 Gotas de Dulces"
	},
	[1334] = {
		Title = "La dulzura no dura mucho",
		Description = {
			"El hombre que luchaba recuperó la paz. Vamos a consultar con él nuevamente mañana después de las 4 a.m."
		},
		Summary = "Visita al hombre con lucha después de las 4 a.m."
	},
	[1335] = {
		Title = "Preciosa cesta de dulces",
		Description = {
			"Trae 5 dulces, 5 paletas y 3 dulces de garganta para adornar a Lorenzo."
		},
		Summary = "Entregar productos a Garnish"
	},
	[1336] = {
		Title = "Misión secreta: llenar la canasta de dulces.",
		Description = {
			"Garnish pide volver después de las 4 a. m., ya que su hijo podría descubrirlo."
		},
		Summary = "Visita Guarni Lorenzo después de las 4 a.m."
	},
	[1337] = {
		Title = "Dulces de la suerte",
		Description = {
			"Llévale 1 Lucky Cady, 1 Luck Lolipop y 1 Lucky Cookie a Miss Fortuna."
		},
		Summary = "Entregar mercancías a Miss Fortuna"
	},
	[1338] = {
		Title = "No más dulces",
		Description = {
			"La señorita Fortuna dice que querrá más dulces después de las 4 a. m."
		},
		Summary = "Visita Miss Fortuna después de las 4 a.m."
	},
