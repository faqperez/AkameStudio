	},
	[14644] = {
		Title = "Tengo suficiente por hoy",
		Description = {
			"La carne dura de marisco que trajiste todavía es abundante. Ven a buscarme de nuevo después de que hayan pasado las primeras horas de la mañana."
		},
		Summary = "Hora de reinicio 04:00"
	},
	[14645] = {
		Title = "¸ÀÀÖ´Â Á©¸®",
		Description = {
			"¸ÀÀÖ´Â Á©¸®.Î ¸¸µç ¼Ò½º°¡ Á¤¸\" º°¹ÌÁÒ. 10°³¸¸ °¡Á®´Ù ÁÖ¼¼¿ä. È¯\"óÀûÀÎ ¼Ò½ºÀÇ ¸ÀÀ\" º¸¿©?å¸±°Ô¿ä."
