		Summary = "Llévale 100 cueros de Comodo a Whitesmith, Gatti."
	},
	[5054] = {
		Title = "Arma Tradicional",
		Description = {
			"Inicio: NPC: Gatti en Ubicacion: dew_fild01 (127, 240). Si traes el Caress Hilt que hice, 100 Cuero de Comodo, 20 Acero y 10 Oridecon, haré el arma escrita en el manual de fabricación del arma."
