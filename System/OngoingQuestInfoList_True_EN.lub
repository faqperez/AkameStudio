	[1298] = {
		Title = "Gasolina! ¡Gas!",
		Description = {
			"Inicio: NPC: Frail Ghast en Ubicacion: rockrdg2 (295, 328). Ghast frente a la mina Rock Ridge me pidió que cazara a Gasters. Debería derrotar a 20 Gasters."
		},
		Summary = "Derrota a 20 gasteres."
	},
	[1299] = {
		Title = "Patrullar una vez al día",
		Description = {
			"Inicio: NPC: Frail Ghast en Ubicacion: rockrdg2 (295, 328). Ghast dijo que sólo necesita que cace a Gasters una vez al día, antes de que comience su turno de patrulla. Debería esperar hasta que su turno comience a las 4:00 a. m. del día siguiente."
		},
		Summary = "Vuelve a visitar Ghast después de las 4:00 a. m. del día siguiente."
	},
	[1300] = {
		Title = "Rastro de bienes de apoyo",
		Description = {
			"El servicio voluntario Helping Hand está intentando ayudar a los vecinos con Vin Chaud, pero la entrega de los ingredientes se retrasa. Para ayudar a Ballery, visita a las personas para descubrir qué pasó."
		},
		Summary = "Conozca a los partidarios de los ingredientes"
	},
	[1301] = {
		Title = "Rastro de bienes de apoyo-Geffen",
		Description = {
			"En Geffen, conozca al maestro cervecero Kantina y pregunte sobre el soporte para jugo de uva fermentado."
		},
		Summary = "encontrar Kantina"
	},
	[1302] = {
		Title = "Rastreo de bienes de apoyo-Marruecos",
		Description = {
			"En Marruecos, conozca al mayorista Brutaqual y pregunte sobre el soporte de Orange y Apple."
		},
		Summary = "encontrar Brutaqual"
	},
	[1303] = {
		Title = "Seguimiento de bienes de apoyo-Alberta",
		Description = {
			"En Alberta, conozca a Trader Curundu y pregunte sobre el soporte de Cinamon y Nutmeg."
		},
		Summary = "Encontrar Curundú"
	},
	[1304] = {
		Title = "Rastro de bienes de apoyo-Aldebaran",
		Description = {
			"En Aldebaran, reúnete con el comerciante de condimentos Askar y pregúntale sobre el soporte de Sugar."
		},
		Summary = "encontrar Askar"
	},
	[1305] = {
		Title = "Seguimiento de bienes de apoyo-Pago",
		Description = {
			"En Payon, conozca al propietario de la granja, Vinpa, y pregunte sobre el soporte para aplicar."
		},
		Summary = "encontrar vinpa"
	},
	[1306] = {
		Title = "La petición de Kantina",
		Description = {
			"Kantina dijo que Happy Santa Orc tomó todo el jugo de uva fermentado. Ayudemos a Kantina a recuperar 6 jugos de uva fermentados."
		},
		Summary = "Recoge 6 jugos de uva fermentados."
	},
	[1307] = {
		Title = "La petición de Curundú",
		Description = {
			"Los Santa Porings se están comiendo todos los cargos. Cuidemos de 3 Santa Poring mientras esperamos la entrega de soporte."
		},
		Summary = "Caza 3 Santa estudiando"
	},
	[1308] = {
		Title = "La petición de Askar",
		Description = {
			"La entrega de soporte está retrasada. Recojamos la bolsa de azúcar y entregámosla a Ballery."
		},
		Summary = "Entregar bolsa de azúcar a Ballery"
	},
	[1309] = {
		Title = "Comparte la calidez con una mano amiga",
		Description = {
			"Helping Hand tratando de compartir Vin Chaud a través de su sucursal. Recoge algunas leñas para ayudar a Helping Hand a asar Vin Chaud y entrega Vin Chaud en sus ramas."
		},
		Summary = "Comparte la calidez en el área designada."
	},
	[1310] = {
		Title = "Comparte la calidez en Izlude",
		Description = {
			"Conozca al miembro de la sucursal de Helping Hand Izlude, entregue 1 Vin Chaud y 3 Fire Woods."
		},
		Summary = "Entregar el producto al miembro de la sucursal de Izlude"
	},
