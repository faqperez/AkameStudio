	[7760] = {
		Title = "Esconder y buscar",
		Description = {
			"Inicio: NPC: Philopontess en Ubicacion: que_swat (145, 57). Parece que has encontrado aproximadamente al investigador oculto. Informemos a Tess, que está esperando en la base de operaciones."
		},
		Summary = "Habla con Tess"
	},
	[7761] = {
		Title = "Descanso para las quimeras",
		Description = {
			"Inicio: NPC: Yuslan en Ubicacion: que_swat (161, 53). La tripulación está teniendo dificultades para lidiar con los sujetos de prueba que corren salvajemente dentro del laboratorio. Eliminemos ^4d4dffQuimeras de tipo sustancia y Quimeras humanoides^000000, ^4d4dff10 de cada^000000."
		},
		Summary = "Eliminar quimeras"
	},
	[7762] = {
		Title = "Descanso para las quimeras - Enfriamiento",
		Description = {
			"Inicio: NPC: Yuslan en Ubicacion: que_swat (161, 53). Esta es una búsqueda diaria; podrás recibirlo y completarlo nuevamente una vez que expire el período de espera. Puedes aceptar la misión a través de Yuslan en la base de suministros capturada de Heart Hunter."
		},
		Summary = "Se reinicia a las 04:00"
	},
