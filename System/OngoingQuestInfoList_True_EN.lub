	},
	[11440] = {
		Title = "Guardia de Parepele",
		Description = {
			"Inicio: NPC: Basilisk Prisoner en Ubicacion: lasa_in01 (61, 91). Ve al este del (Bosque Raviol) y recolecta algunas Zarpas de Espino gigantes."
