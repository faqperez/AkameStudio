	[12316] = {
		Title = "Conociendo a Hugin",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). Finalmente conocí a Hugin por primera vez. Probablemente se acuerde de mí, pero no estoy seguro de que yo haría lo mismo."
		},
		Summary = "primer encuentro"
	},
	[12317] = {
		Title = "Rastro del viaje en el tiempo",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). Los viajes en el tiempo al Viejo Glast Heim están prohibidos durante 23 horas."
		},
		Summary = "Dimensión distorsionada"
	},
	[12318] = {
		Title = "Caza de almas corruptas",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). Encuentra y destruye el alma corrupta ubicada en Old Glast Heim 1F."
		},
		Summary = ""
	},
	[12319] = {
		Title = "Amdarais Hunt",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). Continúa hasta el segundo piso de Old Glast Heim y destruye Amdarais."
		},
		Summary = ""
	},
	[12320] = {
		Title = "Viajero del tiempo",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). El viaje en el tiempo al Viejo Glastheim está parcialmente terminado."
		},
		Summary = "Viaje en el tiempo del antiguo castillo"
	},
	[12321] = {
		Title = "Conquistador del tiempo",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). El viaje en el tiempo al Viejo Glastheim está completamente terminado."
		},
		Summary = "Viaje en el tiempo del antiguo castillo"
	},
	[12322] = {
		Title = "Distorsión espacial",
		Description = {
			"Inicio: NPC: Hugin en Ubicacion: glast_01 (204, 273). Hugin ha distorsionado el espacio dentro de Glastheim. Cualquier cosa puede pasar dentro de este castillo."
		},
		Summary = "Espacio distorsionado"
	},
