	},
	[10086] = {
		Title = "Escapar de la realidad al amplio mundo.",
		Description = {
			"¡Hemos recibido información útil! ¡Espera tener su propio hermano!"
		},
		Summary = "Sólo cuéntale sobre la historia de la hermandad. Si no conoces la historia, ve con los hermanos y tómate un tiempo con ellos. Entonces puedes contarle una historia."
	},
	[10087] = {
		Title = "Escapar de la realidad al amplio mundo.",
		Description = {
			"Le cuentas una historia, pero volvió a ponerse de mal humor. ¡No más avances!"
		},
		Summary = "El tiempo cura todas las heridas. Sigamos el consejo de su madre."
	},
	[10088] = {
		Title = "Escapar de la realidad al amplio mundo.",
		Description = {
			"Es bastante pesimista hacia la amistad."
		},
		Summary = "Cuéntale sobre tu amigo. Si no conoces ninguna historia sobre amigos, ve y vívela."
	},
	[10089] = {
