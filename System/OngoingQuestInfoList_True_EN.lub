	[60901] = {
		Title = "Chefs de hierro",
		Description = {
			"Habla con Lidia cuando estés listo para embarcarte en la misión."
		},
		Summary = ""
	},
	[60902] = {
		Title = "Enorme en Hugel",
		Description = {
			"Visita al chef Bobby en Hugel. Su tienda se encuentra en el segundo piso de la tienda de comestibles."
		},
		Summary = ""
	},
	[60903] = {
		Title = "Situación de los crustáceos",
		Description = {
			"Coseche 20 trozos de carne de almeja y 30 pinzas de la playa al sur de Hugel o de cualquier otro lugar y devuélvalos al chef Bobby cuando haya terminado."
		},
		Summary = ""
	},
	[60904] = {
		Title = "Llegando a Raquel",
		Description = {
			"Viaja a Payon y encuentra a Rachel en un restaurante en el lado este del pueblo de Payon."
		},
		Summary = ""
	},
	[60905] = {
		Title = "Hablar de pila",
		Description = {
			"Consigue 20 patatas, 20 carnes y 15 fresas para el menú de cena y postres de Rachel."
		},
		Summary = ""
	},
	[60906] = {
		Title = "Dolores de hambre en Louyang",
		Description = {
			"Hable con el chef Ming en el restaurante del noreste de la ciudad de Louyang."
		},
		Summary = ""
	},
	[60907] = {
		Title = "Ñame al vapor",
		Description = {
			"Cosecha 30 ñames de Grizzlies hambrientos en la mazmorra de primer nivel de Louyang."
		},
		Summary = ""
	},
	[60908] = {
		Title = "Casa Al De Baran Munch",
		Description = {
			"Habla con el chef Jacques, trabaja en un pequeño café en la parte este de Al De Baran."
		},
		Summary = ""
	},
	[60909] = {
		Title = "Disparo de pavo",
		Description = {
			"Caza 30 pavos en el mapa de puestos fronterizos al norte de Al De Baran. Termine con extremo prejuicio y regrese cuando la tarea esté completa."
		},
		Summary = ""
	},
	[60910] = {
		Title = "Convertirse en un maestro chef",
		Description = {
			"Regresa con Lidia en Prontera para recibir tu recompensa del Sindicato de Chefs."
		},
		Summary = ""
	},
	[60911] = {
		Title = "hombre de las estrellas",
		Description = {
			"Zeldys señala el cielo cubierto de estrellas. Estás pensando que la extraña historia de este tipo merece una mayor investigación."
		},
		Summary = ""
	},
	[60912] = {
		Title = "El maestro falsificador",
		Description = {
			"Encuentra al falsificador Mime en Mjolnir Dead Pit y pídele que forje un arma que pueda derrotar a la Espada Maldita."
		},
		Summary = ""
	},
	[60913] = {
		Title = "Materiales para armas de Mime",
		Description = {
			"Llévale los siguientes elementos a Mime: 3 acero, 20 escamas de dragón, 10 colas de dragón, 4 caninos de dragón, 1 anillo de diamantes."
		},
		Summary = ""
	},
	[60914] = {
