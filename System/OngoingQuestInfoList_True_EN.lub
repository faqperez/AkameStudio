		Summary = "Dueño de pub"
	},
	[18063] = {
		Title = "El pantano aislado",
		Description = {
			"Víctor te dice que le habló a Mikhail de un pantano aislado en una isla cercana. No es probable que Mikhail esté allí, pero tienes que comprobarlo por si acaso."
		},
		Summary = "encontrar el pantano"
	},
	[18064] = {
		Title = "De regreso al pueblo",
