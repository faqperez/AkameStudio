	[16354] = {
		Title = "Operación: Eliminación Segura",
		Description = {
			"Inicio: NPC: Elena Volkova en Ubicacion: sp_cor (180, 169). Introduzca el área y comience la operación especial. Asegure Elimina de manera segura, luego informe a Elena."
