		},
		Summary = ""
	},
	[6027] = {
		Title = "Indicador KVM",
		Description = {
			"Has recibido un indicador que muestra que has participado en KVM Battle. No podrás participar en ninguna otra batalla hasta que se apague el indicador."
		},
		Summary = "Espera para KVM Battle hasta que pase el límite de tiempo"
	},
	[7000] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"Inicio: NPC: Aile en Ubicacion: job_duncer (43, 93). Fuiste a la Escuela de Danza Comodo para convertirte en bailarina. Has completado el formulario de solicitud."
		},
		Summary = "Habla con Aile"
	},
	[7001] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"Ciertos materiales deben prepararse antes de comenzar la lección de baile. Confirme los materiales reunidos de Aile."
		},
		Summary = "Matrícula de 10,000 Zeny, 20 Sticky Mucus, 5 Red Potions, 3 Jellopy, 1 par de zapatos."
	},
	[7002] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"Ciertos materiales deben prepararse antes de comenzar la lección de baile. Confirme los materiales reunidos de Aile."
		},
		Summary = "Matrícula de 10.000 Zeny, 5 cáscaras de lombrices, 1 par de botas."
	},
	[7003] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"Ciertos materiales deben prepararse antes de comenzar la lección de baile. Confirme los materiales reunidos de Aile."
		},
		Summary = "Matrícula de 10.000 Zeny, 2 conchas de almeja, 5 pociones amarillas, 20 gelatinas, 10 pelos negros, 1 par de sandalias."
	},
	[7004] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"Prepárate con todos los materiales que necesitas. ¡Una entrevista de trabajo con Bijou te está esperando! ¡Debes pasar la entrevista!"
		},
		Summary = "Entrevista con Bijou"
	},
	[7005] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"¡Finalmente, es hora de realizar la prueba de baile! Debes bailar con los pasos dados durante el tiempo limitado. ¡No te pongas demasiado nervioso!"
		},
		Summary = "¡El último baile!"
	},
	[7006] = {
		Title = "¡Cambio de trabajo a bailarín!",
		Description = {
			"¡Tus pasos y ondas corporales fueron fantásticos! La instructora, Bijou, debe estar muy impresionada. Averigüemos qué piensa ella realmente..."
		},
		Summary = "Habla con Bijou"
	},
	[7007] = {
		Title = "Guerrero del Sol, la Luna y las Estrellas",
		Description = {
			"Inicio: NPC: Moohyun en Ubicacion: payon (215, 102). Puedes encontrar \"Moogang\" en Comodo, supuestamente en el lugar más cercano al cielo."
		},
		Summary = "Habla con \"Moogang\""
	},
	[7008] = {
		Title = "Guerrero del Sol, la Luna y las Estrellas - Naturaleza",
		Description = {
			"Avanza y reúne el poder de la naturaleza esparcido por todo el mundo. Tráeme pedazos de viento ventoso, tierra sólida, hielo helado y llamas ardientes."
		},
		Summary = "Viento fuerte, Gran naturaleza, Congelado místico, Corazón de llamas"
	},
	[7009] = {
		Title = "Guerrero del Sol, la Luna y las Estrellas - el Altar",
		Description = {
			"\"Te guiaré al altar. En el altar, habla con Daru, quien te servirá como guía para esa prueba. Después de completar la prueba, ven a hablar conmigo\"."
		},
		Summary = "Altar del Sol, la Luna y las Estrellas"
	},
	[7010] = {
		Title = "Guerrero del Sol, la Luna y las Estrellas - ¿Estrellas?",
		Description = {
			"\"Tráeme un trozo de estrella y la arena de una estrella...\""
		},
		Summary = "Un pedazo de estrella, la arena de una estrella."
	},
	[7011] = {
		Title = "Guerrero del Sol, la Luna y las Estrellas",
		Description = {
			"Si ya terminó y está satisfecho, regrese a \"Moogang\"."
		},
		Summary = "Habla con \"Moogang\""
	},
	[7012] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Inicio: NPC: Pursuit Party Leader en Ubicacion: mid_campin (68, 185). La conversación con Echinacea fue bastante unilateral. Te han asignado ser el asistente del Sr. Kidd, así que será mejor que vayas a hablar con él."
		},
		Summary = "Sr. Kidd"
	},
	[7013] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"...Usted ha expresado que no se siente cómodo haciendo las tareas del hogar y el Sr. Kidd le dice que tenga claro con Echinacea que no quiere esa tarea."
		},
		Summary = "Equinácea"
	},
	[7014] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"...Bueno, todavía era imposible conquistar a Echinacea. Deberías regresar y ayudar al Sr. Kidd pase lo que pase."
		},
		Summary = "Sr. Kidd"
	},
	[7015] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"La petición del señor Kidd fue más sencilla de lo que pensaba. En Southwest Morocc, debes encontrarte con Rin en la taberna subterránea."
		},
		Summary = "rin"
	},
	[7016] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Debes investigar la región donde Rin fue emboscada. El área está en algún lugar al oeste del Lago Abyss y al sur de la segunda colina desde la cima de la montaña..."
		},
		Summary = "Investiga el campo oeste del lago Abyss."
	},
	[7017] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Has encontrado un cristal sangriento de la oscuridad cerca del bosque de Hugel. Deberías informarle esto a Rin."
		},
		Summary = "Informe a Rin"
	},
	[7018] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Tienes el diario y un Cristal Sangriento de la Oscuridad de Rin. ¡Ahora es tu trabajo entregárselos al Sr. Kidd!"
		},
		Summary = "Entrega el diario y el cristal al Sr. Kidd."
	},
	[7019] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Le has entregado el diario y un cristal a Kidd, pero no puedes quitarte de la cabeza sus últimas palabras..."
		},
		Summary = ""
	},
	[7020] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"De repente, empezaste a sentirte furioso y no pudiste detener el impulso de golpear a esos enemigos."
		},
		Summary = "Detén todos los dientes de león"
	},
	[7021] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Has encontrado un pergamino mágico sellado de uno de los cuerpos de Dandelion Gang. Debe ser algo importante así que deberías llevárselo al Sr. Kidd."
		},
		Summary = "Informe al Sr. Kidd"
	},
	[7022] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Necesitas investigar el pergamino del hechizo mágico. Echinacea sabe a qué erudito consultar al respecto."
		},
		Summary = "Equinácea"
	},
	[7023] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Echinacea ha presentado a un erudito llamado \"Defaria\", pero ¿dónde está? ¿Es él quien hornea batatas?"
		},
		Summary = "Habla con Defaria"
	},
	[7024] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"El viejo erudito Defaria pidió algunos materiales para abrir el pergamino. 30 de cada Agua Bendita, Runa de la Oscuridad y Runa Sangrienta."
		},
		Summary = ""
	},
	[7025] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Necesitas conseguir todos los materiales necesarios. Defaria dijo: \"Estaré esperando tu regreso\"."
		},
		Summary = "Habla con Defaria"
	},
	[7026] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"El pergamino está abierto. Estos pergaminos son generalmente utilizados por organizaciones ^4d4dff para reunir a sus miembros^000000. Dice que deberías usarlo ahora, pero la cuestión es si deberías hablar primero con el Sr. Kidd."
		},
		Summary = ""
	},
	[7027] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Escuchaste una historia sospechosa mientras investigabas el edificio al que llegaste usando el pergamino. Escuchaste que los dientes de león están peleando entre sí."
		},
		Summary = "Informe al Sr. Kidd"
	},
	[7028] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Le contó al Sr. Kidd lo que escuchó desde el sótano de la casa vacía cerca de la frontera nacional. Habrá una disputa interna seria y sería el momento perfecto para atacarlos."
		},
		Summary = "Investiga la casa vacía cerca de la frontera nacional."
	},
	[7029] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Rayan Moore finalmente es atrapado. El Sr. Kidd lo llevará con Rin para que pueda interrogarlo. Obtenga más detalles del Sr. Kidd"
		},
		Summary = "Habla con el Sr. Kidd"
	},
	[7030] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"El Sr. Kidd te ha dado el Cristal Sangriento de la Oscuridad y un diario. Tu última tarea es llevarle el diario a Rin."
		},
		Summary = "Entrega el diario a Rin."
	},
	[7031] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Rayan ha escapado. ¿O podría ser Satan Morocc quien se lo llevó? Debes darle el número de patrón de la longitud de onda mágica a Echinacea con el diario."
		},
		Summary = "(SDHF92F-SDF)"
	},
	[7032] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Rayan ha escapado. ¿O podría ser Satan Morocc quien se lo llevó? Debes darle el número de patrón de la longitud de onda mágica a Echinacea con el diario."
		},
		Summary = "(VWNM94GVWN90)"
	},
	[7033] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Rayan ha escapado. ¿O podría ser Satan Morocc quien se lo llevó? Debes darle el número de patrón de la longitud de onda mágica a Echinacea con el diario."
		},
		Summary = "(CM3-TRDFGHE0)"
	},
	[7034] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Echinacea está analizando el número de patrón para detectar la fuerza de la longitud de onda mágica. Esto podría llevarnos a Rayan y tal vez incluso a Satán Marruecos..."
		},
		Summary = ""
	},
	[7035] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"Vaya al edificio con un detector de maná adjunto en el sur de este campamento y pregunte sobre los resultados del rastreo."
		},
		Summary = ""
	},
	[7036] = {
		Title = "Persiguiendo a Rayan Moore",
		Description = {
			"El rastreo falló, pero el gerente dice que, dado que la piedra aún está intacta, Rayan aún debe estar vivo en alguna parte. Preséntate ante Echinacea y pregúntale si tiene alguna idea sobre cómo localizar a Rayan Moore."
		},
		Summary = "Informe a la Equinácea"
	},
	[7037] = {
		Title = "¿Caso cerrado?",
		Description = {
			"Inicio: NPC: Pursuit Party Leader en Ubicacion: mid_campin (68, 185). El caso ya está cerrado, pero ¿qué es eso que todavía ronda en tu cabeza? Deberías preguntarle a alguien sobre la solicitud del diente de león porque la equinácea no está siendo de mucha ayuda."
		},
		Summary = ""
	},
	[7038] = {
		Title = "Pasión por las batatas al horno",
		Description = {
			"Has consultado a Defaria acerca de tu preocupación, pero todo lo que te tocó fue la tarea de reunir algunos materiales para hornear batatas..."
		},
		Summary = "20 batatas y 30 troncos"
	},
	[7039] = {
		Title = "Esquivando la conversación",
		Description = {
			"Cuestionaste a Defaria una y otra vez y pareció empezar a hablar de Jaskier. Pero volvió a cambiar de tema y le pidió que le llevara unas batatas al Sr. Kidd."
		},
		Summary = "Entrega 2 batatas al Sr. Kidd."
	},
	[7040] = {
		Title = "Esquivando la conversación",
		Description = {
			"Esta vez, la conversación se hizo un poco más profunda, pero al final, ¡lo único que te quedó fue la tarea de entregar las batatas otra vez...!"
		},
		Summary = "Entregar 2 batatas a Echinacea"
	},
	[7041] = {
		Title = "La política es para los políticos.",
		Description = {
			"Echinacea aconseja dejar de cuestionar los motivos de los políticos y confiar en que harán lo que sea mejor para mantener la paz. Regresa con Defaria y agradécele por las batatas."
		},
		Summary = "Defaria"
	},
	[7042] = {
		Title = "Trabajo a tiempo parcial - Feed de Tatacho",
		Description = {
			"Inicio: NPC: Breeder Taab en Ubicacion: mid_camp (143, 306). Por favor tráeme 50 pescado fresco. que ¡¯ volver a alimentar a los tatachoes. Estoy recién salido y necesitaré reabastecerme muy pronto. Puedes encontrarlos en Tatachoes en los campos."
		},
		Summary = "50 pescado fresco"
	},
	[7043] = {
		Title = "Trabajo a tiempo parcial - Feed de Cornus",
		Description = {
			"Inicio: NPC: Breeder Taab en Ubicacion: mid_camp (143, 306). Me acabo de quedar sin alimento para Cornuses. ¿Puedes traerme 30 hojas grandes y 30 raíces marrones? Puedes encontrarlos en Pinguiculas en los campos."
		},
		Summary = "30 grandes hojas y 30 raíces marrones"
	},
	[7044] = {
		Title = "Trabajo a tiempo parcial - Feed de Hillslion1",
		Description = {
			"Inicio: NPC: Breeder Taab en Ubicacion: mid_camp (143, 306). Me acabo de quedar sin alimento para Hillslions. Los estudiosos creen que estos tipos son miembros de la familia de los gatos. He estado intentando alimentarlos con varias cosas. Esta vez, me gustaría probar Monster¡¯s Feed. ¿Puedes traerme 20 alimentos para monstruos y 30 alimentos para mascotas?"
		},
		Summary = "20 alimentos para monstruos y 30 alimentos para mascotas"
	},
	[7045] = {
		Title = "Trabajo a tiempo parcial - Feed de Hillslion2",
		Description = {
			"Inicio: NPC: Breeder Taab en Ubicacion: mid_camp (143, 306). Esto es perfecto porque iba a probar una nueva alimentación para Hillslions. Probé Monster¡¯s Feed, pero no sé si les gustó o no. ¿Puedes traerme 50 carnes y 30 alimentos para mascotas?"
		},
		Summary = "50 carnes y 30 alimentos para mascotas"
	},
	[7046] = {
		Title = "Trabajo a tiempo parcial: alfombras cálidas",
		Description = {
			"Inicio: NPC: Breeder Taab en Ubicacion: mid_camp (143, 306). Siempre quise poner algo cálido en el suelo para mis criaturas. ¿Puedes traerme 30 trozos de piel?"
		},
		Summary = "30 trozos de piel"
	},
	[7047] = {
		Title = "Trabajo a tiempo parcial: ¡terminemos el día!",
		Description = {
			"Inicio: NPC: Breeder Taab en Ubicacion: mid_camp (143, 306). Parece que todo el trabajo a tiempo parcial está hecho por el día. Es posible que Taab tenga más trabajo para usted si regresa después de aproximadamente 5 horas..."
		},
		Summary = ""
	},
	[7048] = {
		Title = "Torre Thanatos - El favor de Burled",
		Description = {
			"Inicio: NPC: Entrance Guide en Ubicacion: tha_t02 (231, 161). Burled quiere descubrir por qué Rekenber Corporation está tan ansiosa por desarrollar la torre a pesar de todos esos sacrificios."
		},
		Summary = "Investiga el tercer piso de la torre."
	},
	[7049] = {
		Title = "Torre Thanatos - Torre Sellada",
		Description = {
			"Obtuviste la llave roja mientras investigabas Rune Device. El mensaje que viste cuando se abrió ha permanecido fuertemente en tu cabeza. Parece que hay algunos más de estos dispositivos."
		},
		Summary = "Busca otros dispositivos Rune dentro de la Torre"
	},
	[7050] = {
		Title = "Torre Thanatos - Torre Sellada",
		Description = {
			"Has encontrado la segunda llave del sello. Parece que quedan más focas. Debo encontrar la forma del Águila en el quinto piso."
		},
		Summary = "Busca la forma del Águila en el quinto piso."
	},
	[7051] = {
		Title = "Torre Thanatos - Torre Sellada",
		Description = {
			"Parece que la Torre Thanatos fue utilizada como puerta de paso. Tienes el presentimiento de que hay más sellos de este tipo para la puerta y algunas otras incógnitas."
		},
		Summary = "Busca en el sexto piso de la torre."
	},
	[7052] = {
		Title = "Torre Thanatos - Torre Sellada",
		Description = {
			"Tienes la cuarta llave. Parece que se ha forzado un pasaje al reino del diablo para conectarse a otro lugar. Quizás esto sea algo que tenga que ver con los monstruos que aparecen en la torre."
		},
		Summary = "Busca otro sello dentro de la torre."
	},
	[7053] = {
		Title = "Torre Thanatos - Lo que quieren es...",
		Description = {
			"Cuando se encontró la cuarta llave, también encontraste el diario de Varmunt. ¡Quizás este diario podría ser el que Rekenber estaba buscando! Debo contarle a Burled sobre esto."
		},
		Summary = "Entrega el diario de Varmunt a Burled."
	},
	[7054] = {
		Title = "El favor de Myu: ¡Enséñales una lección!",
		Description = {
			"Inicio: NPC: Myu en Ubicacion: gef_fild05 (80, 149). Tienes la misión de \"advertir\" al Kobold Archer que proteja el hogar de Wild Rose."
		},
		Summary = "Derrota a 1000 arqueros kobold"
	},
	[7055] = {
		Title = "El favor de Myu: ¡no el gato!",
		Description = {
			"Inicio: NPC: Myu en Ubicacion: gef_fild05 (80, 149). ¡Myu está pidiendo un favor más! Ya que estás protegiendo a Wild Rose, no debes dañar ni una sola Wild Rose...."
		},
		Summary = ""
	},
	[7056] = {
		Title = "Messenger - El favor de Arc",
		Description = {
			"Inicio: NPC: Splendide Guard en Ubicacion: spl_in01 (32, 306). En el puesto de Lapine, \"Splendide\", conociste a un Lapine, \"Arc\", que te pidió que encontraras a su amigo, \"Terra\". Él dice que Terra generalmente deja rastros al atar las plantas en nudos."
		},
		Summary = "Encuentra las huellas de Terra"
	},
	[7057] = {
		Title = "Mensajero - El favor de Arch",
		Description = {
			"Has encontrado un rastro cerca de Splendide. Parece que las huellas van en dirección sur. Sigamos buscando."
		},
		Summary = "Encuentra las huellas de Terra"
	},
	[7058] = {
		Title = "Messenger - El favor de Arc",
		Description = {
			"Caíste entre las raíces gigantes de un árbol. Has encontrado una tribu gigante llamada \"Sapha\", dura como rocas y grande como una montaña. Parece que no quedan más rastros de Terra."
		},
		Summary = "Reportar al Arco"
	},
	[7059] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"A Arc le preocupa que Terra se haya ido con Bradium del laboratorio sin permiso. Terra podría haber ido a la \"Sapha\" en esa \"Cueva\" con un Bradium."
		},
		Summary = "encontrar tierra"
	},
	[7060] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"Cuando llegaste para ver a Sapha, Terra ya se había ido hacía mucho tiempo. Trozos de mineral muy brillantes estaban esparcidos alrededor del gigante endurecido. Estas piezas deben ser el Bradium."
		},
		Summary = "Si Bradium está relacionado... ¿sería Sapha?"
	},
	[7061] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"En la ciudad de \"Sapha\" oíste algo sobre un \"Lapine\" capturado."
		},
		Summary = "Debes encontrar al Lapine capturado."
	},
	[7062] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"Has oído que el Lapine capturado en Manuk está herido. Quizás puedas verla si consigues algún remedio."
		},
		Summary = "Pregúntale a Arco"
	},
	[7063] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"Descubriste que \"Yggdrasil Berry\" es el mejor remedio para Lapine. Deberías recolectar algunas bayas de Yggdrasil alrededor del árbol gigantesco."
		},
		Summary = "Recoge al menos 6 bayas de Yggdrasil."
	},
	[7064] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"Has recogido la última baya de Yggdrasil. Debes entregárselos a Snorren en Manuk."
		},
		Summary = "Entrega las bayas de Yggdrasil a Snorren."
	},
	[7065] = {
		Title = "Messenger - El paradero de Terra",
		Description = {
			"Podrías hablar con el Lapine capturado con la ayuda de Snorren. Debes interpretar la conversación con el Lapine a Snorren y Luik."
		},
		Summary = "Habla con Lapine"
	},
	[7066] = {
		Title = "Messenger - Demuestre la verdad",
		Description = {
			"Snorren sospecha que la endurecida Sapha podría ser su amiga, \"Ogen\", y solicita ver la evidencia."
		},
		Summary = "Vuelve a la cueva y encuentra alguna evidencia."
	},
	[7067] = {
		Title = "Messenger - Demuestre la verdad",
		Description = {
			"Tienes algunos \"fragmentos de bradio\" del cuerpo endurecido del Sapha y un \"Shabby Muffler\". ¡Estas deberían ser pruebas suficientes!"
		},
		Summary = "Muestra la evidencia a Luik y Snorren."
	},
	[7068] = {
		Title = "Messenger - Demuestre la verdad",
		Description = {
			"Parece que el \"Shabby Muffler\" es el de un amigo de Snorren. También se demostró que Terra realmente estaba tratando de salvar a \"Ogen\" con \"fragmentos de Bradium\"."
		},
		Summary = "Ve a Ogen antes de que sea demasiado tarde."
	},
	[7069] = {
		Title = "Mensajero - ¡Demasiado tarde!",
		Description = {
			"Parece que es demasiado tarde para salvar a Ogen. Snorren le dio la espalda y comenzó a caminar de regreso al pueblo. Deberías recoger a Terra."
		},
		Summary = ""
	},
	[7070] = {
		Title = "Messenger - El regreso de Terra",
		Description = {
			"Snorren te dijo que Terra ha sido liberada."
		},
		Summary = ""
	},
	[7071] = {
		Title = "Mensajero - Invitación",
		Description = {
			"Arc te invitó a la residencia de Terra para hablar sobre los detalles. La casa de Terra es una de los cientos de Yai que cuelgan de las hojas, ubicada en el área sureste del puesto."
		},
		Summary = "Ir a Yai de Terra"
	},
	[7074] = {
		Title = "caza de ratas",
		Description = {
			"Inicio: NPC: Manuk Galtun en Ubicacion: manuk (252, 116). Encuentra y destruye a Rata en la cueva e informa a Strom."
		},
		Summary = ""
	},
	[7075] = {
		Title = "Caza de Duneyrr",
		Description = {
			"Inicio: NPC: Manuk Galtun en Ubicacion: manuk (252, 116). Encuentra y destruye al Duneyrr en la cueva e informa a Strom."
		},
		Summary = ""
	},
	[7076] = {
		Title = "Se busca: diente de león",
		Description = {
			"Inicio: NPC: Wanted Sign en Ubicacion: mid_camp (192, 239). Leíste un anuncio de búsqueda de la sociedad Dandelion que pedía como recompensa un cofre del tesoro."
		},
		Summary = ""
	},
	[7077] = {
		Title = "Recolectando huevos de dragón",
		Description = {
			"Inicio: NPC: Pet Breeder en Ubicacion: mid_camp (146, 306). Llévale 10 huevos de dragón a Pinedel para que pueda investigarlos."
		},
		Summary = ""
	},
	[7078] = {
		Title = "Recolectando huevos de dragón",
		Description = {
			"Inicio: NPC: Pet Breeder en Ubicacion: mid_camp (146, 306). Le has llevado los 10 huevos de Dragón a Pinedel, pero ahora tienes que esperar a que eclosionen antes de aceptar otra petición."
		},
		Summary = ""
	},
	[7079] = {
		Title = "Encontrar bradio refinado",
		Description = {
			"Inicio: NPC: Manuk Engineer en Ubicacion: man_in01 (378, 276). Caza Bradium Golems y lleva 20 Bradium refinado al ingeniero Manuk."
		},
		Summary = ""
	},
	[7080] = {
		Title = "Encontrar bradio refinado",
		Description = {
			"Inicio: NPC: Manuk Engineer en Ubicacion: man_in01 (378, 276). Has ayudado al ingeniero Manuk con su solicitud, pero debes esperar un día más antes de aceptar otra solicitud."
		},
		Summary = ""
	},
	[7081] = {
		Title = "Ayudando al artesano lapino",
		Description = {
			"Inicio: NPC: Laphine Craftsman en Ubicacion: spl_in01 (97, 313). Llévale al artesano de Lapine 15 lágrimas cristalizadas y 15 líquidos fluorescentes."
		},
		Summary = ""
	},
	[7082] = {
		Title = "Ayudando al artesano lapino",
		Description = {
			"Inicio: NPC: Laphine Craftsman en Ubicacion: spl_in01 (97, 313). Hiciste muy bien al encontrar las lágrimas cristalizadas y el líquido fluorescente. Tienen suficiente suministro para hoy."
		},
		Summary = ""
	},
